<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs thousands of fights with the shared combat rules to balance combat v2 by numbers (the game's
    docs/combat-v2-design.md, section 8). data/items.json is the public item list (/api/items).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RavenNest.Combat\RavenNest.Combat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="data\items.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
