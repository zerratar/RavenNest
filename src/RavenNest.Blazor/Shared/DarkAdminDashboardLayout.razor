@inherits LayoutComponentBase
@using RavenNest.Blazor.Components
@inject NavigationManager NavigationManager
@inject RavenNest.Blazor.Services.AuthService AuthService
@*
    The inline <style> block that used to sit here set a blue logout link and a green notification
    count, two more one off colours in a project that had 253 of them. Both are now whatever
    .rf-dash says they are, which is the point of having tokens.
*@
<div class="page rf-dash">
    @if (IsAdministrator)
    {
        <div class="sidebar">
            <NavMenu Dashboard="true" Administrator="true" Admin="true" />
        </div>

        <div class="main">
            <div class="rf-dash__notify">
                <NotificationIcon UserId="@session.UserId"></NotificationIcon>
            </div>

            <div class="content px-4">
                @Body
            </div>
        </div>
    }
</div>

@code {
    public static DarkAdminDashboardLayout Instance { get; private set; }
    private RavenNest.Models.SessionInfo session;
    protected override void OnInitialized()
    {
        Instance = this;
        session = AuthService.GetSession();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!IsAdministrator)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    public void UpdateSession()
    {
        session = AuthService.GetSession();
    }

    private bool IsAuthenticated => session != null && session.Authenticated;
    private bool IsAdministrator => IsAuthenticated && session.Administrator;
}
