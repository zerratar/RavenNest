@inherits LayoutComponentBase
@implements IDisposable
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject NavigationManager NavigationManager

@*
    The front page layout. .rf-front is what scopes ravenfall-front.css, the same way
    DashboardLayout's .rf-dash scopes ravenfall-dashboard.css.

    Note what is deliberately not here: nothing switches off site.css's h1::after separator image
    or its #ff7f00 headings for .rf-front as a whole. Most front pages have not been converted yet
    and are still drawn against those rules, so each converted page turns them off for itself.
*@
<div class="page front-page rf-front">
    <div class="main">
        <header class="rf-sitehead">
            <div class="rf-sitehead__inner">
                <a href="/" class="rf-sitehead__logo" aria-label="Ravenfall home">
                    <img src="/imgs/logo.png" alt="Ravenfall" />
                </a>

                <button type="button"
                        class="rf-btn rf-btn--small rf-sitehead__toggle"
                        aria-expanded="@(menuOpen ? "true" : "false")"
                        aria-controls="rf-site-menu"
                        @onclick="ToggleMenu">
                    <i class="fa-solid @(menuOpen ? "fa-xmark" : "fa-bars")" aria-hidden="true"></i>
                    Menu
                </button>

                <nav id="rf-site-menu" class="rf-sitenav @(menuOpen ? "is-open" : "")" aria-label="Main">
                    <NavLink class="rf-sitenav__link" href="/" Match="NavLinkMatch.All">Home</NavLink>

                    @*
                        Was a hover only dropdown with a hardcoded height, which meant it could not
                        be opened on a phone or from a keyboard at all. <details> gets both for
                        free and needs no script.
                    *@
                    <details class="rf-dd">
                        <summary class="rf-sitenav__link rf-dd__summary">
                            Game <i class="fa-solid fa-chevron-down rf-dd__caret" aria-hidden="true"></i>
                        </summary>
                        <div class="rf-dd__menu">
                            <NavLink class="rf-sitenav__link" href="/download" Match="NavLinkMatch.All">Download</NavLink>
                            <NavLink class="rf-sitenav__link" href="/commands" Match="NavLinkMatch.All">Command list</NavLink>
                            <NavLink class="rf-sitenav__link" href="/items" Match="NavLinkMatch.All">Item list</NavLink>
                            <NavLink class="rf-sitenav__link" href="/towns" Match="NavLinkMatch.All">Towns</NavLink>
                            <a class="rf-sitenav__link" href="https://www.youtube.com/watch?v=lTMs19hsvNc&ab_channel=Zerratar" target="_blank" rel="noopener">Game trailer</a>
                            <a class="rf-sitenav__link" href="http://ravenfall.fandom.com/" target="_blank" rel="noopener">Wiki</a>
                        </div>
                    </details>

                    @* Promoted out of the dropdown. These are the three pages a visitor actually
                       comes here for, and they were all buried one hover deep. *@
                    <NavLink class="rf-sitenav__link" href="/highscore" Match="NavLinkMatch.All">Highscore</NavLink>
                    <NavLink class="rf-sitenav__link" href="/marketplace" Match="NavLinkMatch.All">Marketplace</NavLink>
                    <NavLink class="rf-sitenav__link" href="/streams" Match="NavLinkMatch.All">Streams</NavLink>

                    @* SUPPORT, COMMUNITY and the Discord icon were three links to the same invite.
                       One of them is enough, and it is the icon in the social row. *@

                    @if (IsAuthenticated)
                    {
                        <NavLink class="rf-sitenav__link" href="/dashboard">Dashboard</NavLink>
                        if (IsAdministrator)
                        {
                            <NavLink class="rf-sitenav__link" href="/admin" Match="NavLinkMatch.All">Admin</NavLink>
                        }
                    }
                    else
                    {
                        <NavLink class="rf-sitenav__link" href="/login/redirect/characters" Match="NavLinkMatch.All">Dashboard</NavLink>
                    }

                    <div class="rf-sitenav__end">
                        <div class="rf-social">
                            <a class="rf-social__link" href="https://www.twitch.tv/zerratar" target="_blank" rel="noopener" aria-label="Ravenfall on Twitch" title="Twitch">
                                <i class="fab fa-twitch" aria-hidden="true"></i>
                            </a>
                            <a class="rf-social__link" href="https://discord.gg/gtfDts7" target="_blank" rel="noopener" aria-label="Ravenfall on Discord" title="Discord">
                                <i class="fab fa-discord" aria-hidden="true"></i>
                            </a>
                            <a class="rf-social__link" href="https://www.youtube.com/zerratar" target="_blank" rel="noopener" aria-label="Ravenfall on YouTube" title="YouTube">
                                <i class="fab fa-youtube" aria-hidden="true"></i>
                            </a>
                            <a class="rf-social__link" href="https://www.patreon.com/ravenfall" target="_blank" rel="noopener" aria-label="Ravenfall on Patreon" title="Patreon">
                                <i class="fab fa-patreon" aria-hidden="true"></i>
                            </a>
                        </div>

                        @if (IsAuthenticated)
                        {
                            <NotificationIcon UserId="@session.UserId"></NotificationIcon>
                            <NavLink class="rf-btn rf-btn--small" href="/logout" Match="NavLinkMatch.All">
                                <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Log out
                            </NavLink>
                        }
                        else
                        {
                            <NavLink class="rf-btn rf-btn--small" href="/login" Match="NavLinkMatch.All">
                                <i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i> Log in
                            </NavLink>
                        }
                    </div>
                </nav>
            </div>
        </header>

        <div class="content">
            @Body
        </div>

        @*
            The footer is the end of every page on the site and it carried no navigation: a logo,
            five icons and a copyright line marked up as an h3 so it would pick up a separator
            image. Someone who reaches the bottom of a page is looking for somewhere to go next.
        *@
        <footer class="rf-sitefoot">
            <div class="rf-sitefoot__inner">
                <div class="rf-sitefoot__brand">
                    <img class="rf-sitefoot__logo" src="/imgs/logo.png" alt="Ravenfall" />
                    <p class="rf-sitefoot__tag">
                        A Twitch integrated idle RPG your viewers play from chat while you stream.
                    </p>
                    <div class="rf-social">
                        <a class="rf-social__link" href="https://www.twitch.tv/zerratar" target="_blank" rel="noopener" aria-label="Ravenfall on Twitch" title="Twitch">
                            <i class="fab fa-twitch" aria-hidden="true"></i>
                        </a>
                        <a class="rf-social__link" href="https://discord.gg/gtfDts7" target="_blank" rel="noopener" aria-label="Ravenfall on Discord" title="Discord">
                            <i class="fab fa-discord" aria-hidden="true"></i>
                        </a>
                        <a class="rf-social__link" href="https://www.twitter.com/zerratar" target="_blank" rel="noopener" aria-label="Ravenfall on Twitter" title="Twitter">
                            <i class="fab fa-twitter" aria-hidden="true"></i>
                        </a>
                        <a class="rf-social__link" href="https://www.youtube.com/zerratar" target="_blank" rel="noopener" aria-label="Ravenfall on YouTube" title="YouTube">
                            <i class="fab fa-youtube" aria-hidden="true"></i>
                        </a>
                        <a class="rf-social__link" href="https://www.patreon.com/ravenfall" target="_blank" rel="noopener" aria-label="Ravenfall on Patreon" title="Patreon">
                            <i class="fab fa-patreon" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

                <nav class="rf-sitefoot__cols" aria-label="Footer">
                    <div class="rf-sitefoot__col">
                        <h2>Game</h2>
                        <ul>
                            <li><a href="/how-to-play">How to play</a></li>
                            <li><a href="/download">Download</a></li>
                            <li><a href="/commands">Command list</a></li>
                            <li><a href="/items">Item list</a></li>
                            <li><a href="/towns">Towns</a></li>
                        </ul>
                    </div>
                    <div class="rf-sitefoot__col">
                        <h2>Play</h2>
                        <ul>
                            <li><a href="/highscore">Highscore</a></li>
                            <li><a href="/marketplace">Marketplace</a></li>
                            <li><a href="/streams">Streams</a></li>
                            <li><a href="/calc">Experience calculator</a></li>
                        </ul>
                    </div>
                    <div class="rf-sitefoot__col">
                        <h2>Community</h2>
                        <ul>
                            <li><a href="https://discord.gg/gtfDts7" target="_blank" rel="noopener">Discord</a></li>
                            <li><a href="http://ravenfall.fandom.com/" target="_blank" rel="noopener">Wiki</a></li>
                            <li><a href="https://www.patreon.com/ravenfall" target="_blank" rel="noopener">Patreon</a></li>
                            <li><a href="/tiers">Patreon tiers</a></li>
                            <li><a href="/about">About Ravenfall</a></li>
                        </ul>
                    </div>
                    <div class="rf-sitefoot__col">
                        <h2>Your account</h2>
                        <ul>
                            @if (IsAuthenticated)
                            {
                                <li><a href="/dashboard">Dashboard</a></li>
                                <li><a href="/characters">Characters</a></li>
                                <li><a href="/logout">Log out</a></li>
                            }
                            else
                            {
                                <li><a href="/login">Log in</a></li>
                            }
                        </ul>
                    </div>
                </nav>
            </div>

            <div class="rf-sitefoot__legal">
                <p>Copyright &copy; @(DateTime.Now.Year) <a href="http://www.shinobytes.com/">shinobytes.com</a>, all rights reserved.</p>
                <p><a href="/cookies">How we use cookies</a></p>
            </div>
        </footer>

        @if (IsAuthenticated)
        {
            @* <TwitchStreams Session="session"></TwitchStreams> *@

            if (session.Administrator)
            {
                <AIAssistance></AIAssistance>
            }
        }
    </div>
</div>

@code {
    public static MainLayout Instance { get; private set; }
    private RavenNest.Models.SessionInfo session;
    private bool menuOpen;

    protected override void OnInitialized()
    {
        Instance = this;
        UpdateSession();

        // The layout is not recreated when you move between pages, so menuOpen survived the
        // navigation and the phone menu stayed open over whatever page you had just opened. It is
        // the layout that outlives the page, so it is the layout's job to close it.
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!menuOpen)
        {
            return;
        }

        menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void UpdateSession()
    {
        session = AuthService.GetSession();
    }

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private bool IsAdministrator => IsAuthenticated && session.Administrator;
    private bool IsAuthenticated => session != null && session.Authenticated;
}
