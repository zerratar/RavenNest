@inject RavenNest.Blazor.Services.AuthService AuthService
@using RavenNest.Blazor.Components

<div class="pl-4 navbar navbar-dark">
    <a class="navbar-brand" href=""><img src="/imgs/logo.png" /></a>
    @*
        The icon was <span class="navbar-toggler-icon">, which Bootstrap draws with a background
        image. This build does not ship that image, so the button rendered as an empty transparent
        box and the dashboard looked on a phone as though it had no menu control at all.
    *@
    <button class="navbar-toggler"
            aria-expanded="@((!collapseNavMenu).ToString().ToLowerInvariant())"
            aria-controls="rf-dash-nav"
            @onclick="ToggleNavMenu">
        <i class="fa-solid @(collapseNavMenu ? "fa-bars" : "fa-xmark")" aria-hidden="true"></i>
        Menu
    </button>
</div>

<div id="rf-dash-nav" class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <ul class="nav flex-column">
        @if (Dashboard)
        {
            @if (Admin)
            {
                <li class="nav-item">
                    <NavLink class="nav-link" href="/characters" Match="NavLinkMatch.All">
                        <span class="oi oi-arrow-left" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin" Match="NavLinkMatch.All">
                        <span class="oi oi-dashboard" aria-hidden="true"></span>&nbsp;Overview
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/others" Match="NavLinkMatch.All">
                        <span class="fa-solid fa-gear" aria-hidden="true"></span>&nbsp;Other Admin Tools
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/coc" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-file-signature" aria-hidden="true"></i>&nbsp;Code of Conduct
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/server" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-server"></i>&nbsp;Server
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/ravenbot-logs" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-memo-circle-info"></i>&nbsp;Ravenbot Logs
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/users" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-users"></i>&nbsp;Users
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/search" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-users"></i>&nbsp;Search for User
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/players" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-users-rays"></i>&nbsp;Players
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/economy" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-money-bill-trend-up"></i>&nbsp;Game Economy
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/items" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-sword"></i>&nbsp;Items
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/drops" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-fishing-rod"></i>&nbsp;Resources
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/sessions" Match="NavLinkMatch.All">
                        <i class="fa-brands fa-twitch"></i>&nbsp;Game Sessions
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/news" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-bullhorn"></i>&nbsp;News
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/admin/settings" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-sliders"></i>&nbsp;Server Settings
                    </NavLink>
                </li>
            }
            else
            {
                @*
                    Grouped by what the person is doing, not by which controller serves it.
                    A player opens this to look after their own characters, to do something with
                    other people, or to check their stream. A flat list of ten links made every
                    one of those feel equally likely, which is why nothing was findable.
                *@
                <li class="nav-item">
                    <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                        <span class="fas fa-home" aria-hidden="true"></span>&nbsp;Overview
                    </NavLink>
                </li>

                <li class="rf-nav-group">You</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/characters">
                        <span class="fas fa-users" aria-hidden="true"></span>&nbsp;Characters
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/stash" Match="NavLinkMatch.All">
                        <span class="fas fa-treasure-chest" aria-hidden="true"></span>&nbsp;Item Stash
                    </NavLink>
                </li>

                <li class="rf-nav-group">Together</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/clan" Match="NavLinkMatch.All">
                        <span class="fas fa-shield-alt" aria-hidden="true"></span>&nbsp;Clan
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/shop" Match="NavLinkMatch.All">
                        <span class="fas fa-shop" aria-hidden="true"></span>&nbsp;Vendor
                    </NavLink>
                </li>
                @*
                    Marketplace belongs here too, but as a dashboard page. Linking the front page
                    version throws you out of the dashboard entirely, so it is left out until the
                    dashboard version exists. The front page nav still carries it meanwhile.
                *@
                <li class="nav-item">
                    <NavLink class="nav-link" href="/loyalty" Match="NavLinkMatch.All">
                        <span class="fas fa-heart" aria-hidden="true"></span>&nbsp;Loyalty
                    </NavLink>
                </li>

                @*
                    Streaming tools are only relevant if you actually stream, so they are grouped
                    rather than mixed in with the pages every viewer uses. Bot stays visible even
                    with no active session: the reason to open it is usually that nothing is
                    running.
                *@
                <li class="rf-nav-group">Your stream</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/bot" Match="NavLinkMatch.All">
                        <span class="fas fa-robot" aria-hidden="true"></span>&nbsp;Bot
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/town" Match="NavLinkMatch.All">
                        <span class="fas fa-house-chimney" aria-hidden="true"></span>&nbsp;Town
                    </NavLink>
                </li>

                @if (IsAdministrator)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/admin" Match="NavLinkMatch.All">
                            <span class="fas fa-key" aria-hidden="true"></span>&nbsp;Admin
                        </NavLink>
                    </li>
                }
            }

            @if (session != null && session.Authenticated)
            {
                <li class="rf-nav-group">Account</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="oi oi-arrow-left" aria-hidden="true"></span>&nbsp;Back to site
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/patreon" Match="NavLinkMatch.All">
                        <span class="fa-brands fa-patreon" aria-hidden="true"></span>&nbsp;Patreon
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/password" Match="NavLinkMatch.All">
                        <span class="fas fa-key" aria-hidden="true"></span>&nbsp;Password
                    </NavLink>
                </li>
                <li class="nav-item login">
                    <NavLink class="nav-link" href="/logout">
                        <span class="oi oi-account-logout" aria-hidden="true"></span> logout
                    </NavLink>
                </li>
            }
        }
        else
        {
            <li class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Home
                </NavLink>
            </li>
            @if (IsAuthenticated)
            {
                <li class="nav-item">
                    <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                        <span class="oi oi-dashboard" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </li>
                @if (IsAdministrator)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/admin" Match="NavLinkMatch.All">
                            <span class="oi oi-key" aria-hidden="true"></span> Admin
                        </NavLink>
                    </li>
                }
            }
            <li class="nav-item">
                <NavLink class="nav-link" href="/how-to-play" Match="NavLinkMatch.All">
                    <span class="oi oi-info" aria-hidden="true"></span> How to play
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/download" Match="NavLinkMatch.All">
                    <span class="oi oi-cloud-download" aria-hidden="true"></span> Download
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/highscore" Match="NavLinkMatch.All">
                    <span class="oi oi-bar-chart" aria-hidden="true"></span> Highscore
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/marketplace" Match="NavLinkMatch.All">
                    <span class="oi oi-basket" aria-hidden="true"></span> Marketplace
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/items" Match="NavLinkMatch.All">
                    <span class="oi oi-magnifying-glass" aria-hidden="true"></span> Items
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/about" Match="NavLinkMatch.All">
                    <span class="oi oi-info" aria-hidden="true"></span> About
                </NavLink>
            </li>
            @*
                The Team and Credits pages are not linked. Both still ship the literal placeholder
                "ABC" where the ambassador and patron names should be, so until somebody fills them
                in they are better unreachable than wrong.
            *@
        }
    </ul>
</div>


@if (session != null && session.Authenticated)
{
    <div class="notifications">
        <NotificationIcon UserId="@session.UserId"></NotificationIcon>
    </div>
}

@code {
    /// <summary>
    /// Whether or not we should display the dashboard menu
    /// </summary>
    [Parameter]
    public bool Dashboard { get; set; }

    /// <summary>
    /// Whether or not the user is authenticated
    /// </summary>
    [Parameter]
    public bool Authenticated { get; set; }

    /// <summary>
    /// Whether or not the user is an administrator
    /// </summary>
    [Parameter]
    public bool Administrator { get; set; }

    /// <summary>
    /// Whether or not we should display the admin panel menu
    /// </summary>
    [Parameter]
    public bool Admin { get; set; }

    public static NavMenu Instance { get; private set; }

    private RavenNest.Models.SessionInfo session;
    private bool activeGame;

    private string MenuTitle => Dashboard ? "Dashboard" : "Ravenfall";

    /// <summary>
    ///     Starts collapsed, which only affects a phone.
    ///
    ///     It started expanded, from when this sidebar was a desktop only concern. Below 641px the
    ///     sidebar stacks above the page rather than beside it, so an expanded menu meant a screen
    ///     of navigation to scroll past before reaching the page you had opened.
    ///
    ///     Safe to default this way because site.css forces `.collapse { display: flex !important }`
    ///     above 641px, so the desktop sidebar ignores the class entirely and only the phone acts
    ///     on it.
    /// </summary>
    private bool collapseNavMenu = true;
    private string NavMenuCssClass => collapseNavMenu ? "nav-list collapse" : "nav-list";

    protected override void OnInitialized()
    {
        session = AuthService.GetSession();
        activeGame = AuthService.HasActiveGameSession();
        Instance = this;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private bool IsAdministrator => Administrator || session.Administrator;
    private bool IsAuthenticated => Authenticated;
}
