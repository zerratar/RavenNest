@inherits LayoutComponentBase
@using RavenNest.Blazor.Components
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject NavigationManager NavigationManager
@implements IDisposable

@*
    rf-dash--art turns on the scenery band. Deliberately not on .rf-dash itself:
    AdminLayout and DarkAdminDashboardLayout carry that class too and have no
    business growing a landscape.
*@
<div class="page dashboard rf-dash rf-dash--art" style="--rf-art-img: url('@ArtImage')">
    <div class="sidebar">
        <NavMenu Dashboard="true" />
    </div>

    @*
        The top bar is gone. It was 3.5rem tall on every dashboard page and held two things: a
        logout link the sidebar already carries under Account, and the notification bell. The bell
        floats at the top right, which is where it already appeared to be, and the page title now
        starts at the top of the page rather than under an empty strip.
    *@
    <div class="main">
        @if (IsAuthenticated)
        {
            <div class="rf-dash__notify">
                <NotificationIcon UserId="@session.UserId"></NotificationIcon>
            </div>
        }

        <div class="content px-4">
            @Body
        </div>

        @*     
        @if (IsAuthenticated)
        {
            <TwitchStreams Session="session"></TwitchStreams>

        if (session.Administrator)
            {
                <AIAssistance></AIAssistance>
            }
        }*@
    </div>
</div>

@code {
    public static DashboardLayout Instance { get; private set; }
    private RavenNest.Models.SessionInfo session;

    /// <summary>
    ///     Scenery per page, by first path segment.
    ///
    ///     Only the two that mean something are mapped. The rest of the set
    ///     (atria, away, eldara, ironhill, kyo) are island scenes rather than
    ///     page subjects, and guessing which page each belongs to would be
    ///     inventing meaning the art does not carry.
    /// </summary>
    private static readonly Dictionary<string, string> ArtByPage =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["town"] = "town",
        };

    private const string DefaultArt = "home";

    private string ArtImage
    {
        get
        {
            var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

            var cut = path.IndexOfAny(new[] { '/', '?', '#' });
            if (cut >= 0) path = path.Substring(0, cut);

            var name = ArtByPage.TryGetValue(path, out var art) ? art : DefaultArt;
            return "/imgs/dashboard/" + name + ".jpg";
        }
    }

    protected override void OnInitialized()
    {
        Instance = this;
        session = AuthService.GetSession();

        // The layout survives a route change, so the band would otherwise keep
        // whichever scene was showing when the dashboard was first opened.
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    public void UpdateSession()
    {
        session = AuthService.GetSession();
    }

    private bool IsAuthenticated => session != null && session.Authenticated;
}
