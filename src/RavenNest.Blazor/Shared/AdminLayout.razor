@inherits LayoutComponentBase
@using RavenNest.Blazor.Components
@inject NavigationManager NavigationManager
@inject RavenNest.Blazor.Services.AuthService AuthService
@*
    .rf-dash is the same scope DashboardLayout uses, and the admin panel wants all of it: the
    sidebar here is literally the same NavMenu component, and the legacy heading rules it switches
    off - the LineBreakWhite.png separator and the #ff7f00 headings - are as wrong here as they
    were on the dashboard. One class restyles the chrome of every admin page; each page still has
    to be converted on its own.
*@
<div class="page admin rf-dash">
    @if (IsAdministrator)
    {
        <div class="sidebar">
            <NavMenu Dashboard="true" Administrator="true" Admin="true" />
        </div>

        <div class="main">
            @* Same as the dashboard: the bar duplicated the sidebar's logout link. *@
            <div class="rf-dash__notify">
                <NotificationIcon UserId="@session.UserId"></NotificationIcon>
            </div>

            <div class="content px-4">
                @Body
            </div>

            @*
                The admin navigation has no link to /dashboard at all, so without this an
                administrator would have had to know the address to find the assistant.
            *@
            <AssistantChat />
        </div>

        <AIAssistance></AIAssistance>
    }
</div>

@code {
    public static AdminLayout Instance { get; private set; }
    private RavenNest.Models.SessionInfo session;
    protected override void OnInitialized()
    {
        Instance = this;
        session = AuthService.GetSession();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!IsAdministrator)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    public void UpdateSession()
    {
        session = AuthService.GetSession();
    }

    private bool IsAuthenticated => session != null && session.Authenticated;
    private bool IsAdministrator => IsAuthenticated && session.Administrator;
}
