@using RavenNest.BusinessLogic.Extended
@using RavenNest.BusinessLogic.Game
@using RavenNest.Models
@using RavenNest.Blazor.Services
@using Blazored.Typeahead
@using Gems = RavenNest.Combat.Gems
@using GemKind = RavenNest.Combat.GemKind
@using GemTier = RavenNest.Combat.GemTier
@using EquipmentSlot = RavenNest.BusinessLogic.Game.EquipmentSlot

@*
    A character's gear: the Equipment tab (the character with its slots around it, the wearable part of the bag
    beside it) and the Inventory tab (the whole bag, with a panel for the picked item). One component, because both
    are views of the same inventory and share every piece: the tiles, the item panel, the dialogs and the rules.

    Everything it does goes through an IGearBackend, and after each action it shows the character the backend
    answers with. The signed-out preview at /dev/gear-preview passes its own backend, so this exact page can be
    clicked through with a made up character.

    Phase 2 (an outfit per skill) has its places kept: the row of skill buttons above the character becomes the
    outfit picker, and the item panel's action list takes an "Add to outfit" button.
*@

@if (player == null)
{
    <LoadIndicator></LoadIndicator>
}
else
{
    <div class="rf-gear rf-gear--@ActiveView @(CanAct ? "can-act" : "is-readonly")" @ref="root"
         data-sel-slot="@(ActiveView == "equipment" && pickedSlot != EquipmentSlot.None ? GearRules.Get(pickedSlot)?.Key : null)">

        @if (View == null)
        {
            @* The admin pages show both views in one tab, so the switch between them is here. *@
            <div class="rf-tabs" role="tablist">
                <button type="button" role="tab" aria-selected="@(ActiveView == "equipment")" class="rf-tab @(ActiveView == "equipment" ? "is-active" : "")" @onclick='() => ownView = "equipment"'>Equipment</button>
                <button type="button" role="tab" aria-selected="@(ActiveView == "inventory")" class="rf-tab @(ActiveView == "inventory" ? "is-active" : "")" @onclick='() => ownView = "inventory"'>Inventory</button>
            </div>
        }

        @if (notice != null)
        {
            <div class="rf-gear-notice @(noticeBad ? "is-bad" : "is-good")" role="status">
                <i class="fa-solid @(noticeBad ? "fa-circle-exclamation" : "fa-circle-check")" aria-hidden="true"></i>
                <span>@notice</span>
                <button type="button" class="rf-gear-notice__close" aria-label="Dismiss" @onclick="() => notice = null">&times;</button>
            </div>
        }

        @if (ActiveView == "equipment")
        {
            @* The wrapper is what the layout measures: the same tab stands in a wide dashboard, a narrower front page and a phone. *@
            <div class="rf-gear-eqwrap">
            <div class="rf-gear-eq">
                <section class="rf-panel rf-gear-doll" aria-label="Equipment">
                    @*
                        The row of skills is the outfit picker: an outfit per skill (docs/outfits-design.md in the
                        game). Picking a skill whose outfit is not on shows that outfit in the slots, on the figure
                        and in the numbers. A visitor has no outfits to see: for them it picks the skill the numbers
                        are for, as before.
                    *@
                    <div class="rf-gear-skills" role="group" aria-label="@(OutfitsKnown ? "Outfits by skill" : "Dress for a skill")">
                        <div class="rf-gear-skills__head">
                            <span class="rf-gear-skills__label">@(OutfitsKnown ? "Outfits" : "Dress for")</span>
                            @if (HasMoreSkills)
                            {
                                <button type="button" class="rf-gear-skills__more" aria-expanded="@moreSkills"
                                        title="@(moreSkills ? "Show the fighting skills and the ones with an outfit" : "Woodcutting, Mining, Fishing and the other skills have outfits too")"
                                        @onclick="() => moreSkills = !moreSkills">
                                    @(moreSkills ? "Fewer skills" : "More skills")
                                    <i class="fa-solid @(moreSkills ? "fa-chevron-up" : "fa-chevron-down")" aria-hidden="true"></i>
                                </button>
                            }
                            @if (OutfitsKnown && outfits.Outfits.Count > 0)
                            {
                                <button type="button" class="rf-gear-skills__more rf-gear-skills__all" @onclick="OpenOverview"
                                        title="Every outfit at once, with its pieces, pet and main number; start one outfit from another">
                                    <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i> All outfits
                                </button>
                            }
                            @if (TrainingNow != null)
                            {
                                <span class="rf-gear-skills__now"><i class="rf-gear-skills__dot" aria-hidden="true"></i> Training now: <b>@TrainingNow</b></span>
                            }
                        </div>
                        @{
                            var pickerSkills = PickerSkills();
                            var tileCount = pickerSkills.Count + (OutfitsKnown ? 1 : 0);
                        }
                        <div class="rf-gear-skills__row @(OutfitsKnown ? "is-outfits" : "")"
                             style="--rf-cols-wide: @Columns(tileCount, 10); --rf-cols-mid: @Columns(tileCount, 4); --rf-cols-narrow: @Columns(tileCount, 4)">
                            @if (OutfitsKnown)
                            {
                                @* "Now" is the gear worn this moment; every skill after it is that skill's outfit *@
                                var nowOutfit = WornOutfitSkill != Skill.None ? GearRules.SkillName(WornOutfitSkill) : null;
                                <button type="button" class="rf-gear-skill rf-gear-skill--now @(!dressFor.HasValue ? "is-on" : "")" aria-pressed="@(!dressFor.HasValue)"
                                        title="@("What you wear right now" + (nowOutfit != null ? " (your " + nowOutfit + " outfit is on)" : "") + ". Equipping here puts it on at once, whatever you train.")"
                                        @onclick="PickNow">
                                    <span class="rf-gear-skill__pic"><i class="fa-solid fa-user-check" aria-hidden="true"></i></span>
                                    <span class="rf-gear-skill__words">
                                        <span class="rf-gear-skill__name">Now</span>
                                        @if (nowOutfit != null)
                                        {
                                            <span class="rf-gear-skill__state">@nowOutfit on</span>
                                        }
                                    </span>
                                </button>
                            }
                            @foreach (var skill in pickerSkills)
                            {
                                var s = skill;
                                var on = dressFor.HasValue && (OutfitsKnown ? OutfitRules.Normalize(dressFor.Value) == s : dressFor == s);
                                var has = OutfitsKnown && outfits.Find(s) != null;
                                var isOn = OutfitsKnown && WornOutfitSkill == s && (has || TrainedOutfitSkill == s);
                                var trained = IsTrainedSkill(s);
                                var name = GearRules.SkillName(s);
                                var icon = GearRules.SkillIcon(s);
                                var state = SkillState(s);
                                <button type="button" class="rf-gear-skill @(on ? "is-on" : "") @(trained ? "is-trained" : "") @(has ? "has-outfit" : "") @(isOn ? "is-worn" : "")"
                                        aria-pressed="@on"
                                        title="@(!OutfitsKnown ? (trained ? name + " (training now)" : "Numbers and best gear for " + name) : isOn ? name + ": this outfit is on" + (trained ? " (training now)" : "") : has ? name + ": an outfit is saved for it" + (trained ? " (training now)" : "") : name + ": no outfit yet" + (trained ? " (training now)" : ""))"
                                        @onclick="() => PickSkill(s)">
                                    <span class="rf-gear-skill__pic">
                                        @if (icon != null)
                                        {
                                            <i class="@icon" aria-hidden="true"></i>
                                        }
                                        else
                                        {
                                            <img src="@GearRules.SkillPicture(s)" alt="" draggable="false" />
                                        }
                                    </span>
                                    <span class="rf-gear-skill__words">
                                        <span class="rf-gear-skill__name">@name</span>
                                        @if (state != null)
                                        {
                                            <span class="rf-gear-skill__state @(isOn ? "is-worn" : trained ? "is-trained" : "")">@state</span>
                                        }
                                    </span>
                                </button>
                            }
                        </div>

                        @if (OutfitsKnown)
                        {
                            var outfitName = GearRules.SkillName(OutfitSkill);
                            var shownOutfit = ShownOutfit;
                            var diff = DiffCount;
                            var wornName = GearRules.SkillName(WornOutfitSkill);
                            var trainedName = GearRules.SkillName(TrainedOutfitSkill);
                            <div class="rf-gear-outfit @(LooksAtOutfit ? "is-viewing" : "") @(ProposalView ? "is-proposed" : "")" aria-live="polite">
                                <i class="rf-gear-outfit__icon fa-solid @(ProposalView ? "fa-wand-magic-sparkles" : LooksAtOutfit ? "fa-eye" : "fa-shirt")" aria-hidden="true"></i>
                                <div class="rf-gear-outfit__text">
                                    @if (CanAct && !HasGear)
                                    {
                                        <b>Nothing to wear yet</b>
                                        <span>This character has no weapons, armor or jewelry. Buy some at the Vendor: they show up in the bag, and outfits and "equip best" work from there.</span>
                                    }
                                    else if (!SkillTab)
                                    {
                                        if (WornOutfitSkill == Skill.None)
                                        {
                                            <b>Now: what you wear</b>
                                            <span>Equipping here puts it on in the game at once. Pick a skill to set up its outfit.</span>
                                        }
                                        else if (WornByHand)
                                        {
                                            <b>Now: your @wornName outfit is on (put on by hand)</b>
                                            <span>You train @trainedName; @(outfits.Follow ? "it changes back when training changes." : "it stays on, since outfits do not change with training.") Equipping here puts it on in the game at once.</span>
                                        }
                                        else if (WornOutfit == null)
                                        {
                                            <b>Now: what you wear for @wornName</b>
                                            <span>No @wornName outfit is saved yet: what you wear becomes it when training changes. Equipping here puts it on in the game at once.</span>
                                        }
                                        else
                                        {
                                            <b>Now: your @wornName outfit is on</b>
                                            <span>What you wear this moment. Equipping here puts it on in the game at once. Pick a skill to set up its outfit.</span>
                                        }
                                    }
                                    else if (NoOutfitYet)
                                    {
                                        <b>No @outfitName outfit yet@(ProposalView ? ": proposed" : "")</b>
                                        @if (NoOutfitYetIsOn)
                                        {
                                            <span>You train @outfitName, so its outfit is the one that is on: making it from your best gear puts that gear on now.@(ProposalView ? " The slots show what it would pick. Nothing is saved yet." : "")</span>
                                        }
                                        else if (ProposalView)
                                        {
                                            <span>The slots, the figure and the numbers show what making it from your best gear would pick (@(diff == 0 ? "the same as what you wear" : Plural(diff, "piece") + (diff == 1 ? " differs" : " differ") + " from what you wear")). Nothing is saved until you press the button, and nothing you wear changes.</span>
                                        }
                                        else
                                        {
                                            <span>Make one from your best gear, or add pieces to start one. Nothing you wear changes.</span>
                                        }
                                    }
                                    else if (OutfitIsOn)
                                    {
                                        <b>@outfitName outfit: on</b>
                                        <span>@OutfitSummary(shownOutfit). @(diff == 0 ? "It is what you wear, so changes here go on in the game too." : Plural(diff, "slot") + (diff == 1 ? " differs" : " differ") + " from what you wear (changed by hand on Now). Changes here go on in the game too.")</span>
                                    }
                                    else
                                    {
                                        <b>@outfitName outfit: not on</b>
                                        <span>@OutfitSummary(shownOutfit). @(diff == 0 ? "The same as what you wear." : Plural(diff, "piece") + (diff == 1 ? " differs" : " differ") + " from what you wear.") Changes here are saved to this outfit; what you wear stays as it is until you train @outfitName or put it on.</span>
                                    }
                                </div>
                                <div class="rf-gear-outfit__acts">
                                    @if (Stable.Count > 0 && SkillTab && OutfitSkill != Skill.None && HasGear)
                                    {
                                        var petNow = shownOutfit?.Pet ?? Guid.Empty;
                                        <label class="rf-gear-outfit__pet" title="The battle pet that goes out with this outfit (not the Pet slot, which is a look)">
                                            <span><i class="fa-solid fa-paw" aria-hidden="true"></i> Battle pet</span>
                                            <select class="rf-input" value="@(petNow == Guid.Empty ? "" : petNow.ToString())" @onchange="x => SetOutfitPet(x.Value?.ToString())">
                                                <option value="">Whichever is out</option>
                                                @foreach (var pet in Stable)
                                                {
                                                    <option value="@pet.Id">@pet.Name</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                    @if (OutfitView && !OutfitIsOn)
                                    {
                                        <button type="button" class="rf-btn" title="Every slot that is not pinned gets your best piece for @outfitName. Nothing you wear changes." @onclick="FillOutfitBest">
                                            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Refill with best
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (HasGear)
                            {
                                <div class="rf-gear-switches">
                                    <label class="rf-switch" title="On: starting to train another skill puts that skill's outfit on. A skill without an outfit keeps what is worn.">
                                        <input type="checkbox" checked="@outfits.Follow" @onchange="x => SetFollow(x.Value is bool b && b)" />
                                        <span class="rf-switch__track" aria-hidden="true"></span>
                                        <span class="rf-switch__state">Change outfit when training changes</span>
                                    </label>
                                    <label class="rf-switch" title="On: a better piece that arrives goes into the outfits it is better for. Pinned slots are left alone.">
                                        <input type="checkbox" checked="@outfits.Upgrade" @onchange="x => SetUpgrade(x.Value is bool b && b)" />
                                        <span class="rf-switch__track" aria-hidden="true"></span>
                                        <span class="rf-switch__state">Put better gear on automatically</span>
                                    </label>
                                </div>
                            }
                        }
                    </div>

                    @{
                        var drifted = CanAct ? DriftedSlots() : new List<GearSlot>();
                    }
                    @if (drifted.Count > 0)
                    {
                        @* Now and the outfit that is on, kept in step: gear changed by hand here is not in the outfit until it is saved *@
                        var keptBy = GearRules.SkillName(WornOutfitSkill);
                        <div class="rf-gear-drift" role="status">
                            <i class="rf-gear-drift__icon fa-solid fa-code-compare" aria-hidden="true"></i>
                            <div class="rf-gear-drift__text">
                                <b>@Plural(drifted.Count, "change") not in your @keptBy outfit</b>
                                <span>
                                    @string.Join(", ", drifted.Take(3).Select(x => x.Label + ": " + (worn.TryGetValue(x.Slot, out var w) ? w.Name : "nothing") + " (the outfit has " + (KeptIn(WornOutfit, x.Slot)?.Name ?? "nothing") + ")"))@(drifted.Count > 3 ? ", and " + (drifted.Count - 3) + " more" : "").
                                    The outfit puts its own pieces back when it next goes on.
                                </span>
                            </div>
                            <div class="rf-gear-drift__acts">
                                <button type="button" class="rf-btn rf-btn--small rf-btn--primary" title="Each slot marked here takes what you wear now; a pinned slot stays pinned" @onclick="SaveWornToOutfit">
                                    <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save to the @keptBy outfit
                                </button>
                                <button type="button" class="rf-btn rf-btn--small" title="The outfit's own pieces go back on" @onclick="PutOutfitBack">
                                    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Put the outfit back
                                </button>
                            </div>
                        </div>
                    }

                    <div class="rf-gear-figure">
                        <div class="rf-gear-slots">
                            @foreach (var slot in GearRules.Left)
                            {
                                @SlotTile(slot)
                            }
                        </div>

                        <div class="rf-gear-stage @(figureState)">
                            <div class="rf-gear-stage__canvas" @ref="stageHost"></div>
                            @* shown by the script while a piece's model is on its way *@
                            <span class="rf-gear-stage__arriving" aria-hidden="true"><i class="fa-solid fa-circle-notch"></i></span>
                            <div class="rf-gear-stage__still" aria-hidden="true"><i class="fa-solid fa-person"></i></div>
                            <div class="rf-gear-stage__plate">
                                <span class="rf-gear-stage__name">@player.Name</span>
                                <span class="rf-gear-stage__level">Combat level @player.CombatLevel</span>
                            </div>
                            <div class="rf-gear-stage__boat">
                                @if (figureDressed || CanAct)
                                {
                                    @* how the figure stands is the viewer's own; the helmet and cape are the character's, as in the game *@
                                    <div class="rf-gear-stage__tools">
                                        @if (figureDressed)
                                        {
                                            <button type="button" class="rf-gear-stage__tool @(relaxed ? "" : "is-on")" aria-pressed="@(!relaxed)"
                                                    title="@(relaxed ? "Standing at ease. Press to stand in the stance of the weapon, as in a fight." : "In the stance of the weapon, as in a fight. Press to stand at ease with empty hands.")"
                                                    @onclick="() => SetRelaxed(!relaxed)">
                                                <i class="fa-solid @(relaxed ? "fa-person" : "fa-khanda")" aria-hidden="true"></i>
                                                <span>@(relaxed ? "At ease" : "Combat")</span>
                                            </button>
                                        }
                                        @if (CanAct)
                                        {
                                            <button type="button" class="rf-gear-stage__tool @(HelmetShown ? "is-on" : "")" aria-pressed="@HelmetShown"
                                                    title="@(HelmetShown ? "Your helmet shows, here and in the game. Press to hide it (the same as !toggle helmet)." : "Your helmet is hidden, here and in the game. Press to show it (the same as !toggle helmet).")"
                                                    @onclick="() => SetHelmet(!HelmetShown)">
                                                <i class="fa-solid @(HelmetShown ? "fa-helmet-un" : "fa-eye-slash")" aria-hidden="true"></i>
                                                <span>Helmet</span>
                                            </button>
                                            @if (HasCape)
                                            {
                                                <button type="button" class="rf-gear-stage__tool @(CapeShown ? "is-on" : "")" aria-pressed="@CapeShown"
                                                        title="@(CapeShown ? "Your cape shows, here and in the game. Press to hide it (the same as !toggle cape)." : "Your cape is hidden, here and in the game. Press to show it (the same as !toggle cape).")"
                                                        @onclick="() => SetCape(!CapeShown)">
                                                    <i class="fa-solid @(CapeShown ? "fa-flag" : "fa-eye-slash")" aria-hidden="true"></i>
                                                    <span>Cape</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                                @if (!figureDressed && (figureState == "is-3d" || figureState == "is-flat"))
                                {
                                    <span class="rf-gear-stage__note" title="The character's own look, from the Customize tab. What it wears is in the slots around it.">Shown without gear</span>
                                }
                                @SlotTile(GearRules.Boat)
                            </div>
                        </div>

                        <div class="rf-gear-slots">
                            @foreach (var slot in GearRules.Right)
                            {
                                @SlotTile(slot)
                            }
                        </div>
                    </div>

                    @* What is picked, and what can be done with it. Always there, so nothing below it jumps. *@
                    <div class="rf-gear-pick" aria-live="polite">
                        @PickBar()
                    </div>

                    @if (ProposalView)
                    {
                        <p class="rf-gear-stats__whose is-proposed"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> The numbers with the proposed @GearRules.SkillName(OutfitSkill) outfit (not saved)</p>
                    }
                    else if (OutfitView)
                    {
                        <p class="rf-gear-stats__whose"><i class="fa-solid fa-eye" aria-hidden="true"></i> The numbers with the @GearRules.SkillName(OutfitSkill) outfit on</p>
                    }
                    else if (OutfitsKnown && !dressFor.HasValue && EffectiveSkill != Skill.None)
                    {
                        <p class="rf-gear-stats__whose is-now"><i class="fa-solid fa-user-check" aria-hidden="true"></i> As worn now, counted for @SkillWord</p>
                    }
                    <div class="rf-gear-stats @(ProposalView ? "is-proposed" : "")" aria-label="@(LooksAtOutfit ? "Combat numbers with the outfit on" : "Combat numbers as worn")">
                        <div class="rf-gear-stat">
                            <span class="rf-gear-stat__label"><i class="fa-solid fa-heart" aria-hidden="true"></i> Health</span>
                            <span class="rf-gear-stat__value">@GearSheet.Number(sheet.MaxHealth)</span>
                        </div>
                        <div class="rf-gear-stat">
                            <span class="rf-gear-stat__label"><i class="fa-solid fa-shield" aria-hidden="true"></i> Armor</span>
                            <span class="rf-gear-stat__value">@GearSheet.Number(sheet.Armor)</span>
                            <span class="rf-gear-stat__note">cuts @GearSheet.Percent(sheet.ArmorCut)</span>
                        </div>
                        <div class="rf-gear-stat">
                            <span class="rf-gear-stat__label"><i class="fa-solid fa-hand-fist" aria-hidden="true"></i> Power</span>
                            <span class="rf-gear-stat__value">@GearSheet.Number(sheet.Power)</span>
                            <span class="rf-gear-stat__note">@sheet.StyleName</span>
                        </div>
                        @* Six numbers whatever the skill: a heal has no accuracy, so its crit takes two places. *@
                        @if (sheet.Style != RavenNest.Combat.AttackStyle.Healing)
                        {
                            <div class="rf-gear-stat">
                                <span class="rf-gear-stat__label"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> Accuracy</span>
                                <span class="rf-gear-stat__value">@GearSheet.Number(sheet.Accuracy)</span>
                            </div>
                            <div class="rf-gear-stat">
                                <span class="rf-gear-stat__label"><i class="fa-solid fa-burst" aria-hidden="true"></i> Max hit</span>
                                <span class="rf-gear-stat__value">@GearSheet.Number(sheet.MaxHit)</span>
                            </div>
                            <div class="rf-gear-stat">
                                <span class="rf-gear-stat__label"><i class="fa-solid fa-star" aria-hidden="true"></i> Crit</span>
                                <span class="rf-gear-stat__value">@GearSheet.Percent(sheet.Sheet.CritChance)</span>
                                <span class="rf-gear-stat__note">@GearSheet.Percent(sheet.Sheet.CritDamage) damage</span>
                            </div>
                        }
                        else
                        {
                            <div class="rf-gear-stat">
                                <span class="rf-gear-stat__label"><i class="fa-solid fa-burst" aria-hidden="true"></i> Max heal</span>
                                <span class="rf-gear-stat__value">@GearSheet.Number(sheet.MaxHit)</span>
                            </div>
                            <div class="rf-gear-stat">
                                <span class="rf-gear-stat__label"><i class="fa-solid fa-star" aria-hidden="true"></i> Crit</span>
                                <span class="rf-gear-stat__value">@GearSheet.Percent(sheet.Sheet.CritChance)</span>
                                <span class="rf-gear-stat__note">chance</span>
                            </div>
                            <div class="rf-gear-stat">
                                <span class="rf-gear-stat__label"><i class="fa-solid fa-star" aria-hidden="true"></i> Crit heal</span>
                                <span class="rf-gear-stat__value">@GearSheet.Percent(sheet.Sheet.CritDamage)</span>
                                <span class="rf-gear-stat__note">of a heal</span>
                            </div>
                        }
                    </div>

                    <div class="rf-gear-doll__foot">
                        <button type="button" class="rf-btn rf-gear-allstats" aria-expanded="@allStats" @onclick="() => allStats = !allStats">
                            <i class="fa-solid @(allStats ? "fa-chevron-up" : "fa-chevron-down")" aria-hidden="true"></i>
                            @(allStats ? "Fewer stats" : "All stats")
                        </button>
                        @if (CanAct && !HasGear)
                        {
                            NoteBigButton("vendor");
                            <a class="rf-btn rf-btn--primary rf-gear-best" href="/vendor">
                                <i class="fa-solid fa-store" aria-hidden="true"></i> Buy gear at the Vendor
                            </a>
                        }
                        else if (CanAct && OutfitIsOn)
                        {
                            NoteBigButton("fill-on:" + OutfitSkill);
                            <button type="button" class="rf-btn rf-btn--primary rf-gear-best" title="Every slot that is not pinned gets your best piece for @GearRules.SkillName(OutfitSkill), saved to the outfit. It is on, so it goes on in the game too." @onclick="() => PressBig(FillOutfitBest)">
                                <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                                Equip best for @GearRules.SkillName(OutfitSkill)
                            </button>
                        }
                        else if (CanAct && OutfitView)
                        {
                            var changes = DiffCount;
                            NoteBigButton("wear:" + OutfitSkill);
                            <button type="button" class="rf-btn rf-gear-best rf-gear-best--wear" title="Wear the @GearRules.SkillName(OutfitSkill) outfit now, whatever you train" @onclick="() => PressBig(WearOutfit)">
                                <i class="fa-solid fa-shirt" aria-hidden="true"></i>
                                Put the @GearRules.SkillName(OutfitSkill) outfit on now@(changes > 0 ? " (changes " + Plural(changes, "slot") + ")" : " (nothing changes)")
                            </button>
                        }
                        else if (CanAct && NoOutfitYet)
                        {
                            @* for a skill that is not worn, the big button makes its outfit: it used to be "equip best", which
                               changed the gear worn now and kept nothing for that skill *@
                            NoteBigButton("make:" + OutfitSkill);
                            <button type="button" class="rf-btn rf-btn--primary rf-gear-best"
                                    title="@(NoOutfitYetIsOn ? "Saves your best gear for " + GearRules.SkillName(OutfitSkill) + " as its outfit and puts it on: it is the outfit of what you train." : "Saves your best gear for " + GearRules.SkillName(OutfitSkill) + " as its outfit. Nothing you wear changes.")"
                                    @onclick="() => PressBig(FillOutfitBest)">
                                <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                                Make a @GearRules.SkillName(OutfitSkill) outfit from my best gear@(NoOutfitYetIsOn ? " and wear it" : "")
                            </button>
                        }
                        else if (CanAct)
                        {
                            var bestFor = OutfitsKnown && WornOutfitSkill != Skill.None ? GearRules.SkillName(WornOutfitSkill)
                                : dressFor.HasValue && GearRules.DressFor.Contains(dressFor.Value) ? dressFor.ToString() : TrainingNow;
                            NoteBigButton("best-now");
                            <button type="button" class="rf-btn rf-btn--primary rf-gear-best"
                                    title="@(OutfitsKnown && WornOutfitSkill != Skill.None ? "Every slot that is not pinned in your " + bestFor + " outfit gets your best piece for " + bestFor + ", and it goes on now." : "Puts on the best you own.")"
                                    @onclick="() => PressBig(EquipBest)">
                                <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                                @(bestFor != null ? "Equip best for " + bestFor : "Equip best")
                            </button>
                        }
                    </div>

                    @if (allStats)
                    {
                        <div class="rf-gear-sheet">
                            @foreach (var group in sheet.Groups())
                            {
                                <div class="rf-gear-sheet__group">
                                    <h4 class="rf-gear-sheet__title">@group.Heading</h4>
                                    @foreach (var row in group.Rows)
                                    {
                                        <div class="rf-gear-sheet__row">
                                            <span>@row.Label</span>
                                            <b class="@(row.Good ? "is-good" : row.Bad ? "is-bad" : "")">@row.Value</b>
                                        </div>
                                    }
                                </div>
                            }
                            <p class="rf-gear-sheet__note">
                                As worn, with enchantments, gems and skill tree passives. Food, potions and a battle pet's bonuses are not counted.
                                @if (sheet.ShieldLeftOut)
                                {
                                    <span> The shield is left out: the game does not count it while fighting with @sheet.StyleName.</span>
                                }
                            </p>
                        </div>
                    }
                </section>

                <section class="rf-panel rf-gear-bag" aria-label="Pieces to wear" data-gear-drop="bag">
                    <div class="rf-gear-bag__head">
                        <h3 class="rf-gear-bag__title"><i class="fa-solid fa-sack" aria-hidden="true"></i> Bag <span class="rf-gear-bag__count">@Plural(WearableCount, "piece") to wear</span></h3>
                        @CoinsLine()
                    </div>

                    <div class="rf-gear-bag__tools" hidden="@(WearableCount == 0)">
                        <SearchBox Placeholder="Search pieces" AriaLabel="Search the pieces to wear by name"
                                   Value="@wearSearch" ValueChanged="v => wearSearch = v ?? string.Empty" ClearSignal="@clearSignal" />
                        <label class="rf-gear-sort">
                            <span>Sort</span>
                            <select class="rf-input" value="@wearSort" @onchange="e => wearSort = e.Value?.ToString() ?? wearSort">
                                <option value="slot">By slot</option>
                                <option value="best">@(SkillWord.Length > 0 ? "Best for " + SkillWord : "Best first")</option>
                                <option value="rarity">Rarity</option>
                                <option value="name">Name</option>
                            </select>
                        </label>
                    </div>

                    @if (WearKinds.Count() > 2)
                    {
                        <div class="rf-gear-chips" role="group" aria-label="Filter pieces by kind">
                            @foreach (var k in WearKinds)
                            {
                                var kind = k;
                                <button type="button" class="rf-gear-chip @(wearKind == kind ? "is-on" : "")" aria-pressed="@(wearKind == kind)" @onclick="() => wearKind = kind">
                                    <span>@GearRules.KindLabel(kind)</span>
                                    <b>@WearKindCount(kind)</b>
                                </button>
                            }
                        </div>
                    }

                    @*
                        One line that is always there, so the grid never moves under the mouse: how to put a piece
                        on, or, with a slot picked, what the outlines mean.
                    *@
                    @if (WearableCount > 0)
                    {
                        <p class="rf-gear-fits @(pickedSlot != EquipmentSlot.None ? "is-on" : "")">
                            @if (pickedSlot != EquipmentSlot.None)
                            {
                                <span><i class="fa-solid fa-crosshairs" aria-hidden="true"></i> Outlined: what goes in the <b>@GearRules.Get(pickedSlot)?.Label.ToLowerInvariant()</b> slot</span>
                                <button type="button" class="rf-btn rf-btn--small" @onclick="ClearPick">Clear</button>
                            }
                            else if (CanAct && SkillTab)
                            {
                                <span><i class="fa-solid fa-hand-pointer" aria-hidden="true"></i> Pick a piece and press Add, or drag it onto its slot: it goes into the <b>@GearRules.SkillName(OutfitSkill)</b> outfit.</span>
                            }
                            else if (CanAct)
                            {
                                <span><i class="fa-solid fa-hand-pointer" aria-hidden="true"></i> Pick a piece and press Equip, or drag it onto its slot.</span>
                            }
                            else
                            {
                                <span><i class="fa-solid fa-hand-pointer" aria-hidden="true"></i> Pick a piece to look at it.</span>
                            }
                        </p>
                    }

                    @{
                        var pieces = WearablePieces();
                    }
                    @if (pieces.Count == 0)
                    {
                        <div class="rf-gear-empty">
                            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                            @if (WearableCount == 0)
                            {
                                <p><b>Nothing to wear in the bag.</b></p>
                                <p>Weapons, armor and jewelry this character finds or is sent show up here.</p>
                                @if (CanAct && !HasGear)
                                {
                                    <a class="rf-btn rf-btn--small" href="/vendor"><i class="fa-solid fa-store" aria-hidden="true"></i> Buy gear at the Vendor</a>
                                }
                            }
                            else
                            {
                                <p><b>Nothing matches that.</b></p>
                                <p>Try another kind or clear the search.</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="rf-gear-grid" @onpointerdown="p => lastPointer = p.PointerType">
                            @foreach (var e in pieces)
                            {
                                @Tile(e, true)
                            }
                        </div>
                    }


                    @if (WearableCount > 0)
                    {
                        <details class="rf-gear-legendbox">
                            <summary><i class="fa-solid fa-circle-info" aria-hidden="true"></i> What the marks mean</summary>
                            <ul class="rf-gear-legend">
                                <li><span class="rf-gear-mark rf-gear-mark--up"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></span> @(SkillTab ? "better than the piece in this outfit" : "better than what is worn") for @(SkillWord.Length > 0 ? SkillWord : "what you train")</li>
                                <li><span class="rf-gear-mark rf-gear-mark--outfit"><i class="fa-solid fa-shirt" aria-hidden="true"></i></span> @(SkillTab ? "in this outfit" : "in the outfit that is on, not worn")</li>
                                <li><span class="rf-gear-mark rf-gear-mark--pin"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i></span> pinned: nothing replaces it (on a slot)</li>
                                <li><span class="rf-gear-slot__badge">@(SkillTab ? "Changes" : "Not saved")</span> @(SkillTab ? "putting the outfit on changes this slot" : "worn, but not what the outfit keeps")</li>
                                <li><span class="rf-gear-mark rf-gear-mark--ench"><i class="fa-solid fa-sparkles" aria-hidden="true"></i></span> enchanted</li>
                                <li><span class="rf-gear-mark rf-gear-mark--skin"><i class="fa-solid fa-mask" aria-hidden="true"></i></span> wears a skin</li>
                                <li><span class="rf-gear-mark rf-gear-mark--lock"><i class="fa-solid fa-lock" aria-hidden="true"></i></span> cannot be worn yet</li>
                                <li><span class="rf-gear-dots"><i class="rf-gear-dot is-gem-ruby"></i><i class="rf-gear-dot"></i></span> gem sockets</li>
                            </ul>
                        </details>
                    }

                    @*
                        Where the bag is under the character (a phone, a narrow window), the picked piece and its
                        Equip button stay at the bottom of the screen while the bag is looked through: the line
                        under the character is a scroll away.
                    *@
                    @if (PickedEntry != null && !PickedEntry.Stack.Equipped && !detailOpen)
                    {
                        <div class="rf-gear-pick rf-gear-pick--float">
                            @PickBar()
                        </div>
                    }
                </section>
            </div>
            </div>
        }
        else
        {
            var visible = VisibleEntries();
            var pickedEntry = PickedEntry;

            <div class="rf-gear-inv @(pickedEntry != null && !several ? "has-pick" : "")">
                <section class="rf-panel rf-gear-invmain" aria-label="Inventory">
                    <div class="rf-gear-invtools">
                        <SearchBox Placeholder="Search items" AriaLabel="Search the inventory by item name"
                                   Value="@search" ValueChanged="OnSearch" ClearSignal="@clearSignal" />
                        <label class="rf-gear-sort">
                            <span>Sort</span>
                            <select class="rf-input" value="@sort" @onchange="e => sort = e.Value?.ToString() ?? sort">
                                <option value="best">Best first</option>
                                <option value="name">Name</option>
                                <option value="amount">Amount</option>
                                <option value="value">Vendor value</option>
                                <option value="kind">Kind</option>
                            </select>
                        </label>
                        @CoinsLine()
                    </div>

                    <div class="rf-gear-chips" role="group" aria-label="Filter items by kind">
                        @foreach (var k in Kinds)
                        {
                            var kind = k;
                            <button type="button" class="rf-gear-chip @(invKind == kind ? "is-on" : "")" aria-pressed="@(invKind == kind)" @onclick="() => PickKind(kind)">
                                <i class="@GearRules.KindIcon(kind)" aria-hidden="true"></i>
                                <span>@GearRules.KindLabel(kind)</span>
                                <b>@KindCount(kind)</b>
                            </button>
                        }
                    </div>

                    @{
                        var groups = GroupsOf(invKind);
                    }
                    @if (groups.Count > 1)
                    {
                        <div class="rf-gear-chips rf-gear-chips--sub" role="group" aria-label="Narrow the kind">
                            <button type="button" class="rf-gear-chip rf-gear-chip--sub @(invGroup == null ? "is-on" : "")" aria-pressed="@(invGroup == null)" @onclick="() => PickGroup(null)">Every @GearRules.KindLabel(invKind).ToLowerInvariant()</button>
                            @foreach (var g in groups)
                            {
                                var name = g;
                                <button type="button" class="rf-gear-chip rf-gear-chip--sub @(invGroup == name ? "is-on" : "")" aria-pressed="@(invGroup == name)" @onclick="() => PickGroup(name)">@name</button>
                            }
                        </div>
                    }

                    @if (visible.Count == 0)
                    {
                        <div class="rf-gear-empty">
                            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                            @if (entries.Count == 0)
                            {
                                <p><b>This bag is empty.</b></p>
                                <p>What the character finds, makes or is sent lands here.</p>
                            }
                            else
                            {
                                <p><b>Nothing matches that.</b></p>
                                <p>Try another kind or clear the search.</p>
                                <button type="button" class="rf-btn rf-btn--small" @onclick="ClearFilters">Clear filters</button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="rf-gear-grid rf-gear-grid--inv">
                            @foreach (var e in visible)
                            {
                                @Tile(e, false)
                            }
                        </div>
                    }

                    <div class="rf-gear-invfoot">
                        @if (several)
                        {
                            var chosen = SelectedEntries();
                            <div class="rf-gear-invfoot__text">
                                <b>@Plural(chosen.Count, "stack") picked</b>
                                <span>@Plural(chosen.Sum(x => x.Stack.Amount), "item"), worth @Coins(chosen.Where(x => x.CanSell).Sum(x => x.SellValue)) at the vendor</span>
                            </div>
                            <div class="rf-gear-invfoot__acts">
                                <button type="button" class="rf-btn rf-btn--small" @onclick="() => SelectAll(visible)">Pick all @visible.Count(x => x.CanMove) shown</button>
                                <button type="button" class="rf-btn rf-btn--small" disabled="@(chosen.Count == 0)" @onclick="() => selected.Clear()">Pick none</button>
                                <button type="button" class="rf-btn rf-btn--small" disabled="@(chosen.Count == 0)" @onclick="() => OpenSeveral(false)">
                                    <i class="fa-solid fa-box-archive" aria-hidden="true"></i> Send to stash
                                </button>
                                <button type="button" class="rf-btn rf-btn--small rf-btn--danger" disabled="@(!chosen.Any(x => x.CanSell))" @onclick="() => OpenSeveral(true)">
                                    <i class="fa-solid fa-coins" aria-hidden="true"></i> Sell
                                </button>
                                <button type="button" class="rf-btn rf-btn--small rf-btn--primary" @onclick="StopSeveral">Done</button>
                            </div>
                        }
                        else
                        {
                            <div class="rf-gear-invfoot__text">
                                <b><i class="fa-solid fa-sack" aria-hidden="true"></i> Bag: @Plural(entries.Count, "stack")</b>
                                <span>@Plural(entries.Sum(x => x.Stack.Amount), "item"), @WornCount worn@(visible.Count != entries.Count ? ", " + visible.Count + " shown" : "")</span>
                            </div>
                            <div class="rf-gear-invfoot__acts">
                                @if (IsAdmin)
                                {
                                    <button type="button" class="rf-btn rf-btn--small" @onclick="() => dialog = Dialog.AddItem">
                                        <i class="fa-solid fa-plus" aria-hidden="true"></i> Add item
                                    </button>
                                }
                                @if (CanAct && entries.Count > 0)
                                {
                                    <button type="button" class="rf-btn rf-btn--small" @onclick="StartSeveral">
                                        <i class="fa-regular fa-square-check" aria-hidden="true"></i> Select several
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </section>

                @* The picked item. Beside the grid on a wide screen, a sheet from the bottom on a phone. *@
                <aside class="rf-panel rf-gear-side @(pickedEntry != null && !several ? "is-open" : "")" aria-label="The picked item">
                    @if (several)
                    {
                        <div class="rf-gear-side__rest">
                            <i class="fa-regular fa-square-check" aria-hidden="true"></i>
                            <p><b>Picking several</b></p>
                            <p>Tap the stacks to send to the stash or to sell, then choose what to do with them below the grid. Worn pieces cannot be picked.</p>
                        </div>
                    }
                    else if (pickedEntry == null)
                    {
                        <div class="rf-gear-side__rest">
                            <i class="fa-solid fa-hand-pointer" aria-hidden="true"></i>
                            <p><b>Pick an item</b></p>
                            <p>Its stats, gems and what you can do with it show here.</p>
                            <ul class="rf-gear-legend">
                                <li><span class="rf-gear-mark rf-gear-mark--worn">E</span> worn now</li>
                                <li><span class="rf-gear-mark rf-gear-mark--up"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></span> better than what is worn</li>
                                <li><span class="rf-gear-mark rf-gear-mark--ench"><i class="fa-solid fa-sparkles" aria-hidden="true"></i></span> enchanted</li>
                                <li><span class="rf-gear-mark rf-gear-mark--skin"><i class="fa-solid fa-mask" aria-hidden="true"></i></span> wears a skin</li>
                                <li><span class="rf-gear-dots"><i class="rf-gear-dot is-gem-ruby"></i><i class="rf-gear-dot"></i></span> gem sockets</li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="rf-gear-side__close" aria-label="Close" @onclick="ClearPick">&times;</button>
                        @ItemPanel(pickedEntry)
                    }
                </aside>
                @if (pickedEntry != null && !several)
                {
                    <div class="rf-gear-sheetscrim" @onclick="ClearPick"></div>
                }
            </div>
        }
    </div>

    @*
        The cards shown beside a piece or a slot under the mouse (js/rf-gear.js copies them into a layer of its
        own): every worn piece and every piece of the bag that can be worn has one, drawn here with the same
        numbers as the item panel, so the two never disagree. A bag piece's card marks what would change against
        the piece worn in its slot, and the script puts that worn piece's card next to it.
    *@
    @if (ActiveView == "equipment")
    {
        <div class="rf-gear-tips" hidden aria-hidden="true">
            @foreach (var e in entries)
            {
                if (e.Slot == EquipmentSlot.None) continue;
                var against = e.Stack.Equipped && !SkillTab ? null : Against(e);
                <div data-tip-card="@e.Stack.Id" data-tip-slot="@GearRules.Get(e.Slot)?.Key" data-tip-with="@against?.Stack.Id"
                     data-look="@(e.Stack.Equipped ? null : FigureData(e))">
                    @TipCard(e, against)
                </div>
            }
        </div>
    }

    @* The Equipment tab opens the item panel over the page: a drawer on a wide screen, a sheet on a phone. *@
    @if (ActiveView == "equipment" && detailOpen && PickedEntry != null)
    {
        <div class="rf-gear-drawer-scrim" @onclick="() => detailOpen = false"></div>
        <aside class="rf-gear-drawer" role="dialog" aria-modal="true" aria-label="@PickedEntry.Name">
            <button type="button" class="rf-gear-side__close" aria-label="Close" @onclick="() => detailOpen = false">&times;</button>
            @ItemPanel(PickedEntry)
        </aside>
    }

    @*
        All outfits at once: each with its pieces as small tiles, the pinned count, its battle pet and the number that
        says most about it for its skill; open one, or start another skill's outfit from it (copied on the server).
    *@
    @if (overviewOpen && OutfitsKnown)
    {
        <div class="rf-modal-backdrop" @onclick="() => overviewOpen = false">
            <div class="rf-modal rf-modal--wide rf-gear-overview" role="dialog" aria-modal="true" aria-label="All outfits" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">All outfits</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="() => overviewOpen = false">&times;</button>
                </div>
                <p class="rf-meta">Every skill's saved outfit. Open one to change it, or start another skill's outfit from it: its pieces, pins and battle pet are copied.</p>
                <div class="rf-gear-ovlist">
                    @foreach (var outfit in outfits.Outfits.OrderBy(x => Array.IndexOf(GearRules.OutfitSkills, x.Skill)))
                    {
                        var o = outfit;
                        var name = GearRules.SkillName(o.Skill);
                        var state = SkillState(o.Skill);
                        var headline = Headline(o);
                        var pet = Stable.FirstOrDefault(x => x.Id == o.Pet);
                        var icon = GearRules.SkillIcon(o.Skill);
                        <article class="rf-gear-ov @(WornOutfitSkill == o.Skill ? "is-worn" : "")">
                            <header class="rf-gear-ov__head">
                                <span class="rf-gear-skill__pic">
                                    @if (icon != null)
                                    {
                                        <i class="@icon" aria-hidden="true"></i>
                                    }
                                    else
                                    {
                                        <img src="@GearRules.SkillPicture(o.Skill)" alt="" />
                                    }
                                </span>
                                <span class="rf-gear-ov__title">
                                    <b>@name</b>
                                    @if (state != null)
                                    {
                                        <span class="rf-gear-skill__state @(WornOutfitSkill == o.Skill ? "is-worn" : "")">@state</span>
                                    }
                                </span>
                                @if (headline.Value != null)
                                {
                                    <span class="rf-gear-ov__num"><small>@headline.Label</small> <b>@headline.Value</b></span>
                                }
                            </header>
                            <div class="rf-gear-ov__pieces">
                                @foreach (var slotOf in GearRules.All)
                                {
                                    var entry = o.Get(Wire(slotOf.Slot));
                                    if (entry == null) continue;
                                    var piece = PieceOf(entry);
                                    <span class="rf-gear-ov__piece @(piece?.RarityClass) @(piece == null ? "is-gone" : "")" title="@(slotOf.Label + ": " + (piece?.Name ?? "gone from the bag") + (entry.Pinned ? " (pinned)" : ""))">
                                        @if (piece != null)
                                        {
                                            @Picture(piece)
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-question" aria-hidden="true"></i>
                                        }
                                        @if (entry.Pinned)
                                        {
                                            <span class="rf-gear-mark rf-gear-mark--pin"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i></span>
                                        }
                                    </span>
                                }
                            </div>
                            <p class="rf-gear-ov__meta">@OutfitSummary(o)@(pet != null ? ". Battle pet: " + pet.Name : ". Battle pet: whichever is out")</p>
                            <div class="rf-gear-ov__acts">
                                <button type="button" class="rf-btn rf-btn--small" @onclick="() => { overviewOpen = false; dressFor = o.Skill; ClearPick(); Judge(); }">Open</button>
                                @if (copyFrom == o.Skill)
                                {
                                    <label class="rf-gear-ov__copy">
                                        <span>Into</span>
                                        <select class="rf-input" value="@(copyTo == Skill.None ? "" : ((int)copyTo).ToString())" @onchange="x => copyTo = int.TryParse(x.Value?.ToString(), out var n) ? (Skill)n : Skill.None">
                                            <option value="">Pick a skill</option>
                                            @foreach (var target in GearRules.OutfitSkills.Where(x => x != o.Skill))
                                            {
                                                <option value="@((int)target)">@GearRules.SkillName(target)@(outfits.Find(target) != null ? " (replaces its outfit)" : "")</option>
                                            }
                                        </select>
                                    </label>
                                    <button type="button" class="rf-btn rf-btn--small rf-btn--primary" disabled="@(copyTo == Skill.None)" @onclick="() => CopyOutfit(o.Skill, copyTo)">Copy</button>
                                    <button type="button" class="rf-btn rf-btn--small" @onclick="() => copyFrom = null">Cancel</button>
                                }
                                else
                                {
                                    <button type="button" class="rf-btn rf-btn--small" @onclick="() => { copyFrom = o.Skill; copyTo = Skill.None; }">
                                        <i class="fa-solid fa-copy" aria-hidden="true"></i> Start another outfit from this
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            </div>
        </div>
    }

    @if (dialog == Dialog.Sell && dialogEntry != null)
    {
        var e = dialogEntry;
        <div class="rf-modal-backdrop" @onclick="CloseDialog">
            <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Sell @e.Name" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">Sell @e.Name</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CloseDialog">&times;</button>
                </div>

                @if (e.Stack.Amount > 1)
                {
                    <label class="rf-field">
                        <span class="rf-label">How many of @e.Stack.Amount.ToString("N0")</span>
                        <input type="number" class="rf-input" min="1" max="@e.Stack.Amount" @bind="sellAmount" @bind:event="oninput" />
                    </label>
                    <div class="rf-actions">
                        @foreach (var amount in QuickAmounts(e.Stack.Amount))
                        {
                            var a = amount;
                            <button type="button" class="rf-btn rf-btn--small" @onclick="() => sellAmount = a">
                                @(a == e.Stack.Amount ? "All " + a.ToString("N0") : a.ToString("N0"))
                            </button>
                        }
                    </div>
                }

                <p class="rf-gear-confirm">
                    Sells <b>@ClampedSellAmount(e).ToString("N0")</b> @e.Name to the vendor for
                    <b class="rf-gear-price">@Coins(e.Item.ShopSellPrice * ClampedSellAmount(e))</b>.
                </p>
                <p class="rf-gear-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> A sale cannot be undone: sold items cannot be bought back.</p>

                <div class="rf-modal__foot">
                    <button type="button" class="rf-btn" @onclick="CloseDialog">Keep it</button>
                    <button type="button" class="rf-btn rf-btn--danger" @onclick="SellOne">Sell for @Coins(e.Item.ShopSellPrice * ClampedSellAmount(e))</button>
                </div>
            </div>
        </div>
    }

    @if (dialog == Dialog.SellSeveral || dialog == Dialog.StashSeveral)
    {
        var selling = dialog == Dialog.SellSeveral;
        var chosen = SelectedEntries();
        var acting = selling ? chosen.Where(x => x.CanSell).ToList() : chosen.Where(x => x.CanMove).ToList();
        var skipped = chosen.Count - acting.Count;
        <div class="rf-modal-backdrop" @onclick="CloseDialog">
            <div class="rf-modal" role="dialog" aria-modal="true" aria-label="@(selling ? "Sell the picked items" : "Send the picked items to the stash")" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">@(selling ? "Sell " : "Send ")@Plural(acting.Count, "stack")@(selling ? "?" : " to the stash?")</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CloseDialog">&times;</button>
                </div>

                <p class="rf-gear-confirm">
                    @if (selling)
                    {
                        <span>Sells <b>@Plural(acting.Count, "stack")</b> (@Plural(acting.Sum(x => x.Stack.Amount), "item")) to the vendor for <b class="rf-gear-price">@Coins(acting.Sum(x => x.SellValue))</b>.</span>
                    }
                    else
                    {
                        <span>Moves <b>@Plural(acting.Count, "stack")</b> (@Plural(acting.Sum(x => x.Stack.Amount), "item")) to your account's stash, where every character of yours can take them.</span>
                    }
                </p>

                <ul class="rf-gear-confirmlist">
                    @foreach (var e in acting.Take(8))
                    {
                        <li>
                            <span class="rf-gear-confirmlist__pic">@Picture(e)</span>
                            <span class="@e.RarityClass">@e.Name</span>
                            <b>@(e.Stack.Amount > 1 ? "x" + e.Stack.Amount.ToString("N0") : "")</b>
                            @if (selling)
                            {
                                <span class="rf-gear-confirmlist__worth">@Coins(e.SellValue)</span>
                            }
                        </li>
                    }
                    @if (acting.Count > 8)
                    {
                        <li class="rf-gear-confirmlist__more">and @Plural(acting.Count - 8, "more stack")</li>
                    }
                </ul>

                @if (skipped > 0)
                {
                    <p class="rf-meta">@Plural(skipped, "picked stack") @(skipped == 1 ? "is" : "are") left alone: @(selling ? "the vendor does not take streamer tokens, and a piece with a skin on it has to lose the skin first." : "they cannot be moved.")</p>
                }

                @if (selling)
                {
                    <p class="rf-gear-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> A sale cannot be undone: sold items cannot be bought back.</p>
                }
                else
                {
                    <p class="rf-meta">You can take them back from the Item Stash page at any time.</p>
                }

                <div class="rf-modal__foot">
                    <button type="button" class="rf-btn" @onclick="CloseDialog">@(selling ? "Keep them" : "Cancel")</button>
                    @if (selling)
                    {
                        <button type="button" class="rf-btn rf-btn--danger" disabled="@(acting.Count == 0)" @onclick="() => DoSeveral(true)">Sell @Plural(acting.Count, "stack") for @Coins(acting.Sum(x => x.SellValue))</button>
                    }
                    else
                    {
                        <button type="button" class="rf-btn rf-btn--primary" disabled="@(acting.Count == 0)" @onclick="() => DoSeveral(false)">Send @Plural(acting.Count, "stack")</button>
                    }
                </div>
            </div>
        </div>
    }

    @*
        The gem picker, for one socket of the picked item (opened by a socket row of the item panel). Gems and
        sockets work as !socket and !unsocket do in the game, for the character's owner.

        Taking a gem out, or socketing over one, usually destroys it. So the server first answers with the gem and
        the chance to keep it and changes nothing (NeedsConfirm); it is done on the confirm click, and only while
        that gem is still the one in the socket. The question and the result are shown inside the picker.
    *@
    @if (gemPickerSocket > 0 && PickedEntry != null && CanSocket)
    {
        var gemEntry = PickedEntry;
        var pickerSocket = gemEntry.Sockets.FirstOrDefault(x => x.Number == gemPickerSocket);
        if (pickerSocket != null && GemManager.TryGetSlot(gemEntry.Item, out var pickerSlot))
        {
            <GemPicker ItemName="@gemEntry.Name" ItemClass="@gemEntry.RarityClass"
                       Slot="pickerSlot" Socket="gemPickerSocket"
                       Current="@(pickerSocket.Empty ? null : PickerGem(pickerSocket.Kind, pickerSocket.Tier))"
                       Owned="OwnedGems()" KeepChance="gemKeepChance"
                       Confirm="PickerConfirm()" Result="gemResult" Error="@gemError"
                       OnSocket="SocketGem" OnRemove="TakeOutGem" OnConfirm="ConfirmGemChange"
                       OnCancel="CancelGemChange" OnBack="BackToGemList" OnClose="CloseGemPicker" />
        }
    }

    @*
        The skin picker (transmogrification): only what can stand in for this piece is listed, from the bag or
        from the stash. A stash item moves to this character first, because the server looks for the skin in the
        character's own inventory.
    *@
    @if (dialog == Dialog.Skin && PickedEntry != null)
    {
        var target = PickedEntry;
        var candidates = VisibleSkinCandidates;
        <div class="rf-modal-backdrop rf-modal-backdrop--stacked" @onclick="CloseDialog">
            <div class="rf-modal rf-modal--wide" role="dialog" aria-modal="true" aria-label="Choose a skin" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">A skin for @target.Name</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CloseDialog">&times;</button>
                </div>
                <p class="rf-meta">
                    The piece keeps its stats and takes the look of the item you choose. That item is used up: it comes back
                    only when the skin is removed or replaced.
                </p>

                <div class="rf-tabs" role="tablist">
                    <button type="button" role="tab" aria-selected="@(!skinFromStash)" class="rf-tab @(!skinFromStash ? "is-active" : "")" @onclick="() => SetSkinTab(false)">
                        Bag (@SkinCandidates(false).Count)
                    </button>
                    <button type="button" role="tab" aria-selected="@skinFromStash" class="rf-tab @(skinFromStash ? "is-active" : "")" @onclick="() => SetSkinTab(true)">
                        Stash (@SkinCandidates(true).Count)
                    </button>
                </div>

                <div class="rf-toolbar">
                    <input type="search" class="rf-input rf-search" placeholder="Search by name" aria-label="Search items to use as a skin"
                           value="@skinSearch" @oninput="e => skinSearch = e.Value?.ToString() ?? string.Empty" />
                </div>

                @if (skinFromStash)
                {
                    <p class="rf-meta">One taken from the stash moves to this character first, then it is used.</p>
                }

                @if (candidates.Count == 0)
                {
                    <div class="rf-banner rf-banner--warn">
                        <h3 class="rf-banner__title">Nothing here fits</h3>
                        <p>
                            @if (!string.IsNullOrWhiteSpace(skinSearch))
                            {
                                <span>Nothing matches that. Clear the search to see everything that fits.</span>
                            }
                            else
                            {
                                <span>
                                    @(skinFromStash ? "Your stash holds" : "This character carries") nothing that can be a skin for this piece.
                                    A skin has to be the same kind of item: a helmet takes a helmet, a hat or a hood. Enchanted items cannot be used.
                                </span>
                            }
                        </p>
                    </div>
                }
                else
                {
                    <div class="rf-gear-skins">
                        @foreach (var candidate in candidates)
                        {
                            var c = candidate;
                            var chosen = skinChoice != null && skinChoice.Item.Id == c.Item.Id && skinChoice.FromStash == c.FromStash;
                            <button type="button" class="rf-gear-skin @(chosen ? "is-on" : "") @ItemService.GetRarityClass(c.Item)" aria-pressed="@chosen" @onclick="() => skinChoice = c">
                                <span class="rf-gear-skin__pic"><img src="@ItemService.GetItemImage(c.Item.Id)" alt="" loading="lazy" /></span>
                                <span class="rf-gear-skin__name">@c.Item.Name</span>
                                <span class="rf-gear-skin__meta">@ItemService.GetTypeName(c.Item)@(c.Amount > 1 ? ", " + c.Amount.ToString("N0") + " owned" : "")</span>
                            </button>
                        }
                    </div>
                }

                @if (skinError != null)
                {
                    <div class="rf-banner rf-banner--bad">
                        <h3 class="rf-banner__title">That did not work</h3>
                        <p>@skinError</p>
                    </div>
                }

                <div class="rf-modal__foot rf-modal__foot--spread">
                    <span class="rf-meta">@(skinChoice == null ? "Nothing chosen yet." : skinChoice.Item.Name + " chosen.")</span>
                    <span class="rf-actions">
                        <button type="button" class="rf-btn" @onclick="CloseDialog">Cancel</button>
                        <button type="button" class="rf-btn rf-btn--primary" disabled="@(skinChoice == null)" @onclick="ApplySkin">
                            @(target.Stack.TransmogrificationId != null ? "Replace the skin" : "Use as skin")
                        </button>
                    </span>
                </div>
            </div>
        </div>
    }

    @if (dialog == Dialog.AddItem && IsAdmin)
    {
        <div class="rf-modal-backdrop" @onclick="CloseDialog">
            <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Add item" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">Add item</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CloseDialog">&times;</button>
                </div>
                <label class="rf-field">
                    <span class="rf-label">Search for an item</span>
                    <BlazoredTypeahead SearchMethod="SearchItem" @bind-Value="addItem">
                        <SelectedTemplate>@context.Name</SelectedTemplate>
                        <ResultTemplate>@context.Name</ResultTemplate>
                    </BlazoredTypeahead>
                </label>
                <label class="rf-field">
                    <span class="rf-label">Amount</span>
                    <input type="number" class="rf-input" min="1" @bind-value="addAmount" />
                </label>
                <div class="rf-actions">
                    @foreach (var quick in new[] { 1, 10, 100, 1000 })
                    {
                        var q = quick;
                        <button type="button" class="rf-btn rf-btn--small" @onclick="() => addAmount = q">@q</button>
                    }
                </div>
                @if (addItem != null)
                {
                    <p class="rf-meta">Adds <b>@addAmount</b> @addItem.Name to <b>@player.Name</b>.</p>
                }
                <div class="rf-modal__foot">
                    <button type="button" class="rf-btn" @onclick="CloseDialog">Cancel</button>
                    <button type="button" class="rf-btn rf-btn--primary" disabled="@(addItem == null)" @onclick="AddItem">Add</button>
                </div>
            </div>
        </div>
    }

    @*
        Administrators set an account's coins here (refunds, corrections). The server holds them in memory, so it
        works at once; a running game shows it within a minute. All the account's characters share them.
    *@
    @if (dialog == Dialog.Coins && IsAdmin)
    {
        <div class="rf-modal-backdrop" @onclick="CloseDialog">
            <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Set coins" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">Set coins</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CloseDialog">&times;</button>
                </div>
                <label class="rf-field">
                    <span class="rf-label">Coins for this account (now @coins.ToString("N0"))</span>
                    <input class="rf-input" type="text" inputmode="numeric" placeholder="10000000, 10m, or +500k / -500k to add or take" @bind="coinsText" />
                </label>
                <p class="rf-meta">Every character on the account shares these coins. The change is logged.</p>
                @if (coinsMessage != null)
                {
                    <p class="@(coinsError ? "rf-form__error" : "rf-form__ok")">@coinsMessage</p>
                }
                <div class="rf-modal__foot">
                    <button type="button" class="rf-btn" @onclick="CloseDialog">Close</button>
                    <button type="button" class="rf-btn rf-btn--primary" @onclick="SetCoins">Set coins</button>
                </div>
            </div>
        </div>
    }
}

@code {
    // ---- Pieces of markup both views share ----------------------------------------------------------------------

    private RenderFragment CoinsLine() => __builder =>
    {
        <div class="rf-gear-coins" title="@coins.ToString("N0") coins">
            <i class="fa-solid fa-coins" aria-hidden="true"></i>
            <span>@Utility.FormatAmount(coins)</span>
            @if (IsAdmin)
            {
                <button type="button" class="rf-btn rf-btn--small" @onclick="OpenCoins">Set coins</button>
            }
        </div>
    };

    // The item's picture, or a glyph of its kind where the game has none.
    private RenderFragment Picture(Entry e) => __builder =>
    {
        if (!string.IsNullOrEmpty(e.Picture))
        {
            <img src="@e.Picture" alt="" loading="lazy" draggable="false" />
        }
        else
        {
            <i class="rf-gear-nopic @GearRules.KindIcon(e.Kind)" aria-hidden="true"></i>
        }
    };

    private RenderFragment Dots(Entry e) => __builder =>
    {
        if (e.Sockets.Count > 0)
        {
            <span class="rf-gear-dots" title="@SocketsTitle(e)">
                @foreach (var socket in e.Sockets)
                {
                    <i class="rf-gear-dot @(socket.Empty ? "" : "is-gem-" + socket.Kind.ToString().ToLowerInvariant())"></i>
                }
            </span>
        }
    };

    // One slot around the character: what is in it, or what belongs there.
    private RenderFragment SlotTile(GearSlot slot) => __builder =>
    {
        var e = Shown(slot.Slot);
        var picked = pickedSlot == slot.Slot;
        var pinned = e != null && IsPinned(slot.Slot);
        var gone = IsGone(slot.Slot);
        var stays = StaysAsWorn(slot.Slot);
        var changes = SkillTab && Differs(slot.Slot);
        var drift = !SkillTab && CanAct && Drifted(slot.Slot);
        var proposed = ProposalView && !stays && IsOutfitSlot(slot.Slot);
        <button type="button"
                class="rf-gear-slot @(e == null ? "is-empty" : e.RarityClass) @(picked ? "is-picked" : "") @(stays ? "is-as-worn" : "") @(gone ? "is-gone" : "") @(proposed ? "is-proposed" : "") @(changes || drift ? "is-changed" : "")"
                data-slot="@slot.Key" data-gear-drop="@slot.Key"
                data-gear-drag="@(e != null && CanAct && e.Stack.Equipped && !SkillTab ? e.Stack.Id.ToString() : null)" data-gear-from="worn"
                data-tip="@(e != null ? e.Stack.Id.ToString() : null)"
                aria-pressed="@picked"
                aria-label="@((e == null ? slot.Label + ": empty" : slot.Label + ": " + e.Name) + (changes ? ", changes when the outfit goes on" : drift ? ", not what the outfit keeps" : proposed ? ", proposed" : ""))"
                title="@(e == null ? slot.Label + ": empty" : null)"
                @onclick="() => ClickSlot(slot)">
            <span class="rf-gear-slot__pic">
                @if (e != null)
                {
                    @Picture(e)
                    @if (e.Stack.TransmogrificationId != null)
                    {
                        <span class="rf-gear-mark rf-gear-mark--skin" title="Wears a skin"><i class="fa-solid fa-mask" aria-hidden="true"></i></span>
                    }
                    @if (e.Enchanted)
                    {
                        <span class="rf-gear-mark rf-gear-mark--ench" title="Enchanted"><i class="fa-solid fa-sparkles" aria-hidden="true"></i></span>
                    }
                    @if (pinned)
                    {
                        <span class="rf-gear-mark rf-gear-mark--pin" title="Pinned: nothing replaces it"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i></span>
                    }
                    @Dots(e)
                }
                else if (slot.Picture != null)
                {
                    <img class="rf-gear-slot__glyph" src="@slot.Picture" alt="" draggable="false" />
                }
                else
                {
                    <i class="rf-gear-slot__glyph @slot.Icon" aria-hidden="true"></i>
                }
            </span>
            @if (changes || drift)
            {
                <span class="rf-gear-slot__badge" title="@(changes ? "Putting the outfit on changes this slot" : "Worn now, but the outfit keeps " + (KeptIn(WornOutfit, slot.Slot)?.Name ?? "another piece") + " here")">@(changes ? "Changes" : "Not saved")</span>
            }
            <span class="rf-gear-slot__text">
                <span class="rf-gear-slot__label">@slot.Short</span>
                <span class="rf-gear-slot__name">@(gone ? "Gone from the bag" : e == null ? "Empty" : e.Name)</span>
                @if (stays && e != null)
                {
                    <span class="rf-gear-slot__note">Stays as worn</span>
                }
                else if (proposed && e != null)
                {
                    <span class="rf-gear-slot__note is-proposed">Proposed</span>
                }
            </span>
        </button>
    };

    // One stack of the bag. On the Equipment tab a piece can be dragged onto its slot.
    private RenderFragment Tile(Entry e, bool wearView) => __builder =>
    {
        var isPicked = !several && pickedId == e.Stack.Id;
        var isChosen = several && selected.Contains(e.Stack.Id);
        var slotKey = e.Slot == EquipmentSlot.None ? null : GearRules.Get(e.Slot)?.Key;
        <button type="button"
                class="rf-gear-tile @e.RarityClass @(isPicked ? "is-picked" : "") @(isChosen ? "is-chosen" : "") @(e.Stack.Equipped ? "is-worn" : "") @(several && !e.CanMove ? "is-locked" : "") @(wearView && !e.CanWear ? "is-barred" : "")"
                data-slot="@slotKey"
                data-gear-drag="@(wearView && CanAct && e.CanWear ? e.Stack.Id.ToString() : null)" data-gear-from="bag"
                data-tip="@(wearView ? e.Stack.Id.ToString() : null)"
                aria-pressed="@(isPicked || isChosen)"
                aria-label="@TileTitle(e)"
                title="@(wearView ? null : TileTitle(e))"
                @onclick="() => ClickTile(e, wearView)"
                @ondblclick="() => DoubleClickTile(e, wearView)">
            <span class="rf-gear-tile__pic">@Picture(e)</span>
            @if (e.Stack.Equipped)
            {
                <span class="rf-gear-mark rf-gear-mark--worn" title="Worn now">E</span>
            }
            <span class="rf-gear-tile__marks">
                @if (e.Upgrade)
                {
                    <span class="rf-gear-mark rf-gear-mark--up" title="@(e.BestPick ? "Equip best would pick this for " + SkillWord : SkillTab ? "Better than the piece in the " + GearRules.SkillName(OutfitSkill) + " outfit" : "Better than what is worn")"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></span>
                }
                @if (wearView && InOutfit(e))
                {
                    <span class="rf-gear-mark rf-gear-mark--outfit" title="@InOutfitTitle"><i class="fa-solid fa-shirt" aria-hidden="true"></i></span>
                }
                @if (e.Enchanted)
                {
                    <span class="rf-gear-mark rf-gear-mark--ench" title="Enchanted"><i class="fa-solid fa-sparkles" aria-hidden="true"></i></span>
                }
                @if (e.Stack.TransmogrificationId != null)
                {
                    <span class="rf-gear-mark rf-gear-mark--skin" title="Wears a skin"><i class="fa-solid fa-mask" aria-hidden="true"></i></span>
                }
                @if (wearView && !e.CanWear)
                {
                    <span class="rf-gear-mark rf-gear-mark--lock" title="@e.Blocked"><i class="fa-solid fa-lock" aria-hidden="true"></i></span>
                }
            </span>
            @Dots(e)
            @if (e.Stack.Amount > 1)
            {
                <span class="rf-gear-tile__amount">@Utility.FormatAmount(e.Stack.Amount)</span>
            }
            @if (several)
            {
                <span class="rf-gear-tile__check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
            }
        </button>
    };

    // The line under the character: what is picked and the one thing most likely wanted with it. In a skill's tab it
    // is about that outfit (compared with its piece, "Add to outfit", never "Equip now"); on "Now" about what is worn.
    private RenderFragment PickBar() => __builder =>
    {
        var e = PickedEntry;
        var slot = pickedSlot == EquipmentSlot.None ? null : GearRules.Get(pickedSlot);
        if (e != null)
        {
            var against = Against(e);
            var inSlot = Shown(e.Slot) == e;
            var outfitName = GearRules.SkillName(OutfitSkill);
            var keptOutfit = WornOutfit;
            var drifted = !SkillTab && e.Stack.Equipped && Drifted(e.Slot);
            var kept = drifted ? KeptIn(keptOutfit, e.Slot) : null;
            <span class="rf-gear-pick__pic @e.RarityClass">@Picture(e)</span>
            <span class="rf-gear-pick__text">
                <b class="@e.RarityClass">@e.Name</b>
                @if (SkillTab && LooksAtOutfit && inSlot)
                {
                    worn.TryGetValue(e.Slot, out var wornThere);
                    <span>
                        @(StaysAsWorn(e.Slot) ? "Not part of the " + outfitName + " outfit: stays as worn"
                            : ProposalView ? "Proposed for the " + outfitName + " outfit (not saved yet)"
                            : "In the " + outfitName + " outfit: " + (IsPinned(e.Slot) ? "pinned" : "best, a better piece takes its place"))@(Differs(e.Slot) ? "; you wear " + (wornThere?.Name ?? "nothing") + " there now" : "")
                    </span>
                }
                else if (drifted && kept != null)
                {
                    var keptPinned = keptOutfit.IsPinned(Wire(e.Slot));
                    <span>Worn: @slot?.Label. Your @GearRules.SkillName(WornOutfitSkill) outfit keeps @kept.Name here@(keptPinned ? " (pinned)" : "") and puts it back when it next goes on.</span>
                }
                else if (e.Stack.Equipped)
                {
                    <span>Worn: @slot?.Label@(!SkillTab && IsPinned(e.Slot) ? ", pinned in your " + GearRules.SkillName(WornOutfitSkill) + " outfit" : "")</span>
                }
                else if (!e.CanWear)
                {
                    <span class="is-bad"><i class="fa-solid fa-lock" aria-hidden="true"></i> @e.Blocked</span>
                }
                else if (against == null)
                {
                    <span>Goes in the empty @slot?.Label.ToLowerInvariant() slot@(SkillTab ? " of the " + outfitName + " outfit" : "")</span>
                }
                else
                {
                    var gains = Gains(e, against, e.Upgrade ? 1 : 2);
                    <span>Instead of @against.Name@(SkillTab && LooksAtOutfit && !StaysAsWorn(e.Slot) ? (ProposalView ? " (proposed)" : " (in the " + outfitName + " outfit)") : "")</span>
                    <span class="rf-gear-pick__gains">
                        @if (e.BestPick)
                        {
                            <em class="is-good"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> Equip best would pick this@(SkillWord.Length > 0 ? " for " + SkillWord : "")</em>
                        }
                        else if (e.Upgrade)
                        {
                            <em class="is-good"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> Better@(SkillWord.Length > 0 ? " for " + SkillWord : "")</em>
                        }
                        @foreach (var gain in gains)
                        {
                            <em class="@(gain.Delta > 0 ? "is-good" : "is-bad")">@gain.Text</em>
                        }
                        @if (gains.Count == 0 && !e.Upgrade)
                        {
                            <em class="is-same">The same stats</em>
                        }
                    </span>
                }
            </span>
            <span class="rf-gear-pick__acts">
                @{
                    var outfitSlot = CanAct && OutfitsKnown && OutfitSkill != Skill.None && IsOutfitSlot(e.Slot);
                    var slotOf = e.Slot;
                }
                @if (SkillTab)
                {
                    @* a skill's tab: what is done here goes into its outfit; nothing here puts gear on by itself *@
                    if (outfitSlot && inSlot && OutfitView && !StaysAsWorn(e.Slot))
                    {
                        var isPinned = IsPinned(e.Slot);
                        <button type="button" class="rf-btn rf-btn--small @(isPinned ? "is-on" : "")" aria-pressed="@isPinned"
                                title="@(isPinned ? "Pinned for " + outfitName + ": nothing replaces it. Press to leave the slot to the best piece again." : "Keep this piece in the " + outfitName + " outfit whatever else arrives")"
                                @onclick="() => PinSlot(slotOf, !isPinned)">
                            <i class="fa-solid fa-thumbtack" aria-hidden="true"></i> @(isPinned ? "Unpin" : "Pin")
                        </button>
                        <button type="button" class="rf-btn rf-btn--small" title="Take the slot out of this outfit: what is worn there stays" @onclick="() => ClearOutfitSlot(slotOf)">Leave out</button>
                    }
                    else if (outfitSlot && (!inSlot || StaysAsWorn(e.Slot) || ProposalView || NoOutfitYet) && e.CanWear)
                    {
                        <button type="button" class="rf-btn rf-btn--small rf-btn--primary" @onclick="() => AddToOutfit(e)">
                            <i class="fa-solid fa-thumbtack" aria-hidden="true"></i> Add to @outfitName outfit
                        </button>
                    }
                }
                else if (CanAct && e.Stack.Equipped)
                {
                    if (drifted && kept != null)
                    {
                        <button type="button" class="rf-btn rf-btn--small rf-btn--primary" title="The outfit that is on takes this piece for the slot (its pin stays)" @onclick="() => KeepInWornOutfit(slotOf)">
                            Keep @e.Name in the @GearRules.SkillName(WornOutfitSkill) outfit
                        </button>
                        <button type="button" class="rf-btn rf-btn--small" @onclick="() => PutKeptBack(slotOf)">Put @kept.Name back</button>
                    }
                    else if (outfitSlot && WornOutfitSkill != Skill.None)
                    {
                        var isPinned = IsPinned(e.Slot);
                        var wornName = GearRules.SkillName(WornOutfitSkill);
                        <button type="button" class="rf-btn rf-btn--small @(isPinned ? "is-on" : "")" aria-pressed="@isPinned"
                                title="@(isPinned ? "Pinned in your " + wornName + " outfit: nothing replaces it. Press to leave the slot to the best piece again." : "Keep this piece in your " + wornName + " outfit whatever else arrives")"
                                @onclick="() => PinSlot(slotOf, !isPinned)">
                            <i class="fa-solid fa-thumbtack" aria-hidden="true"></i> @(isPinned ? "Unpin" : "Pin")
                        </button>
                    }
                    <button type="button" class="rf-btn rf-btn--small" @onclick="() => Unequip(e)">Take off</button>
                }
                else if (CanAct && e.CanWear && !e.Stack.Equipped)
                {
                    <button type="button" class="rf-btn rf-btn--small rf-btn--primary" @onclick="() => Equip(e)">Equip</button>
                }
                <button type="button" class="rf-btn rf-btn--small" @onclick="() => detailOpen = true">Details</button>
            </span>
        }
        else if (slot != null)
        {
            var fitting = entries.Count(x => !x.Stack.Equipped && x.Slot == pickedSlot);
            <span class="rf-gear-pick__pic is-empty">
                @if (slot.Picture != null)
                {
                    <img class="rf-gear-slot__glyph" src="@slot.Picture" alt="" />
                }
                else
                {
                    <i class="rf-gear-slot__glyph @slot.Icon" aria-hidden="true"></i>
                }
            </span>
            <span class="rf-gear-pick__text">
                <b>@slot.Label: empty</b>
                <span>@(fitting == 0 ? "Nothing in the bag goes here." : Plural(fitting, "piece") + " in the bag " + (fitting == 1 ? "goes" : "go") + " here.")</span>
            </span>
        }
        else
        {
            <span class="rf-gear-pick__hint">
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                @(!CanAct ? "Pick a slot or a piece to look at it." : SkillTab ? "Pick a slot or a piece: what you do here goes into the " + GearRules.SkillName(OutfitSkill) + " outfit." : "Pick a slot to see what goes in it, or a piece to see what it would change.")
            </span>
        }
    };

    // One piece as a card for the mouse: what it is, its numbers, gems, enchantments and requirements. With a worn
    // piece to compare against, every number carries what would change (the rows are the item panel's own).
    private RenderFragment TipCard(Entry e, Entry against) => __builder =>
    {
        var item = e.Item;
        var line = GearRules.LineOf(item);
        var rows = against != null ? Compare(e, against) : null;
        var stats = against == null ? StatsOf(e) : null;
        var armorHealth = RavenNest.Combat.CombatMath.IsArmorPiece((int)item.Type) ? RavenNest.Combat.CombatMath.ArmorHealth(item.ArmorPower) : 0;
        var enchantments = e.Enchanted ? ItemService.GetItemEnchantments(e.Stack) : null;
        var skin = e.Stack.TransmogrificationId != null ? ItemService.GetItem(e.Stack.TransmogrificationId.Value) : null;
        <div class="rf-gear-tipcard @(e.Stack.Equipped ? "is-worn" : "is-bag")">
            <div class="rf-gear-tipcard__label">@AgainstLabel(e)</div>
            <div class="rf-gear-tipcard__head">
                <span class="rf-gear-tipcard__pic @e.RarityClass">@Picture(e)</span>
                <span class="rf-gear-tipcard__title">
                    <b class="rf-gear-tipcard__name @e.RarityClass">@e.Name</b>
                    <span class="rf-gear-tipcard__what"><em class="@e.RarityClass">@ItemService.GetRarityName(item)</em> @What(e)@(line != null ? ". " + line : "")</span>
                </span>
            </div>

            <div class="rf-gear-tipcard__rows">
                @if (rows != null)
                {
                    foreach (var row in rows)
                    {
                        <div class="rf-gear-tipcard__row">
                            <span>@row.Label</span>
                            <b>
                                @row.This
                                @if (row.Delta != 0)
                                {
                                    <em class="@(row.Delta > 0 ? "is-good" : "is-bad")">@row.Change</em>
                                }
                            </b>
                        </div>
                    }
                }
                else
                {
                    foreach (var stat in stats)
                    {
                        <div class="rf-gear-tipcard__row">
                            <span>@stat.Label</span>
                            <b>@stat.Text(stat.Total)</b>
                        </div>
                    }
                    if (armorHealth > 0)
                    {
                        <div class="rf-gear-tipcard__row">
                            <span>Health</span>
                            <b>@armorHealth.ToString("N0")</b>
                        </div>
                    }
                }
            </div>

            @if (e.Sockets.Count > 0 || enchantments != null || skin != null)
            {
                <div class="rf-gear-tipcard__more">
                    @foreach (var socket in e.Sockets)
                    {
                        <div class="rf-gear-tipcard__gem">
                            <i class="rf-gear-dot @(socket.Empty ? "" : "is-gem-" + socket.Kind.ToString().ToLowerInvariant())"></i>
                            @if (socket.Empty)
                            {
                                <span>Empty socket</span>
                            }
                            else
                            {
                                <span><b>@socket.Name</b> <em class="is-good">@socket.Bonus</em></span>
                            }
                        </div>
                    }
                    @if (enchantments != null)
                    {
                        foreach (var enchantment in enchantments)
                        {
                            <div class="rf-gear-tipcard__gem">
                                <i class="fa-solid fa-sparkles" aria-hidden="true"></i>
                                <span><b>@EnchantmentName(enchantment)</b> <em class="is-good">+@EnchantmentValue(enchantment)</em></span>
                            </div>
                        }
                    }
                    @if (skin != null)
                    {
                        <div class="rf-gear-tipcard__gem">
                            <i class="fa-solid fa-mask" aria-hidden="true"></i>
                            <span>Looks like <b>@skin.Name</b></span>
                        </div>
                    }
                </div>
            }

            @{
                var requirements = Requirements(item);
            }
            @if (requirements.Count > 0)
            {
                <div class="rf-gear-tipcard__needs">
                    @foreach (var requirement in requirements)
                    {
                        <span class="@(requirement.Met ? "" : "is-bad")">
                            @if (!requirement.Met)
                            {
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                            }
                            Requires @requirement.Skill @requirement.Level
                        </span>
                    }
                </div>
            }

            @if (!e.Stack.Equipped && Shown(e.Slot) != e)
            {
                if (e.BestPick)
                {
                    <div class="rf-gear-tipcard__verdict is-good"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> Equip best would pick this@(SkillWord.Length > 0 ? " for " + SkillWord : "")</div>
                }
                else if (e.Upgrade && against != null)
                {
                    <div class="rf-gear-tipcard__verdict is-good"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> Better than @against.Name@(SkillWord.Length > 0 ? " for " + SkillWord : "")</div>
                }
                else if (against == null && e.CanWear)
                {
                    <div class="rf-gear-tipcard__verdict">@(SkillTab ? "The " + GearRules.SkillName(OutfitSkill) + " outfit has nothing in the " + GearRules.Get(e.Slot)?.Label.ToLowerInvariant() + " slot" : "Nothing is worn in the " + GearRules.Get(e.Slot)?.Label.ToLowerInvariant() + " slot")</div>
                }
            }
        </div>
    };

    // Everything about one item: what it is, how it compares, its gems and enchantments, and what can be done.
    private RenderFragment ItemPanel(Entry e) => __builder =>
    {
        var item = e.Item;
        var skin = e.Stack.TransmogrificationId != null ? ItemService.GetItem(e.Stack.TransmogrificationId.Value) : null;
        var wornNow = ActiveView == "equipment" ? (e.Stack.Equipped && !SkillTab ? null : Against(e))
            : (e.Slot != EquipmentSlot.None && !e.Stack.Equipped && worn.TryGetValue(e.Slot, out var w) ? w : null);
        var fromOutfit = ActiveView == "equipment" && wornNow != null && SkillTab && LooksAtOutfit && !StaysAsWorn(e.Slot);
        var stats = StatsOf(e);
        var enchantments = e.Enchanted ? ItemService.GetItemEnchantments(e.Stack) : null;
        var requirements = Requirements(item);
        var line = GearRules.LineOf(item);
        var armorHealth = RavenNest.Combat.CombatMath.IsArmorPiece((int)item.Type) ? RavenNest.Combat.CombatMath.ArmorHealth(item.ArmorPower) : 0;

        <div class="rf-gear-item">
            <div class="rf-gear-item__head">
                <span class="rf-gear-item__pic @e.RarityClass">
                    @Picture(e)
                    @if (e.Stack.Amount > 1)
                    {
                        <span class="rf-gear-tile__amount">@Utility.FormatAmount(e.Stack.Amount)</span>
                    }
                    @if (skin != null)
                    {
                        <span class="rf-gear-item__skin" title="Looks like @skin.Name in the game"><img src="@ItemService.GetItemImage(skin.Id)" alt="" /></span>
                    }
                </span>
                <div class="rf-gear-item__title">
                    <h3 class="rf-gear-item__name @e.RarityClass">@e.Name</h3>
                    <div class="rf-gear-item__badges">
                        <span class="rf-badge @e.RarityClass">@ItemService.GetRarityName(item)</span>
                        @if (e.Stack.Equipped)
                        {
                            <span class="rf-badge rf-badge--good">Worn</span>
                        }
                        @if (e.Enchanted)
                        {
                            <span class="rf-badge rf-badge--gold"><i class="fa-solid fa-sparkles" aria-hidden="true"></i> Enchanted</span>
                        }
                        @if (skin != null)
                        {
                            <span class="rf-badge rf-badge--gold"><i class="fa-solid fa-mask" aria-hidden="true"></i> Skin: @skin.Name</span>
                        }
                        @if (e.Stack.Soulbound)
                        {
                            <span class="rf-badge rf-badge--warn"><i class="fa-solid fa-link" aria-hidden="true"></i> Soulbound</span>
                        }
                    </div>
                    <p class="rf-gear-item__what">@What(e)@(line != null ? ". " + line : "")</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(item.Description))
            {
                <p class="rf-gear-item__desc">@item.Description</p>
            }

            @if (wornNow != null)
            {
                var rows = Compare(e, wornNow);
                <div class="rf-gear-compare">
                    <div class="rf-gear-compare__head">
                        <span></span>
                        <span>This</span>
                        <span>@(fromOutfit ? (ProposalView ? "Proposed" : "Outfit") : "Worn")</span>
                        <span>Change</span>
                    </div>
                    @foreach (var row in rows)
                    {
                        <div class="rf-gear-compare__row">
                            <span>@row.Label</span>
                            <b>@row.This</b>
                            <span>@row.Worn</span>
                            <b class="@(row.Delta > 0 ? "is-good" : row.Delta < 0 ? "is-bad" : "is-same")">@row.Change</b>
                        </div>
                    }
                    <p class="rf-gear-compare__with">Compared with @(fromOutfit ? (ProposalView ? "the proposed " : "") + wornNow.Name + (ProposalView ? "" : " in the " + GearRules.SkillName(OutfitSkill) + " outfit") : "the worn " + wornNow.Name)@(WornExtras(wornNow)).</p>
                    @if (e.BestPick)
                    {
                        <p class="rf-gear-compare__verdict"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> "Equip best" would pick this@(SkillWord.Length > 0 ? " for " + SkillWord : "").</p>
                    }
                    else if (e.Upgrade)
                    {
                        <p class="rf-gear-compare__verdict"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> Better than @wornNow.Name@(SkillWord.Length > 0 ? " for " + SkillWord : "").</p>
                    }
                </div>
            }
            else if (stats.Count > 0 || armorHealth > 0)
            {
                <div class="rf-gear-facts">
                    @foreach (var stat in stats)
                    {
                        <div class="rf-gear-facts__row">
                            <span>@stat.Label</span>
                            <b>
                                @stat.Text(stat.Value)
                                @if (stat.Bonus > 0)
                                {
                                    <em class="is-good" title="From its enchantment">+@stat.Text(stat.Bonus)</em>
                                }
                            </b>
                        </div>
                    }
                    @if (armorHealth > 0)
                    {
                        <div class="rf-gear-facts__row">
                            <span>Health from its armor</span>
                            <b><em class="is-good">+@armorHealth.ToString("N0")</em></b>
                        </div>
                    }
                </div>
                @if (e.Slot != EquipmentSlot.None && !e.Stack.Equipped)
                {
                    <p class="rf-gear-compare__with">Nothing is worn in the @GearRules.Get(e.Slot)?.Label.ToLowerInvariant() slot.</p>
                }
            }

            @*
                Gems in the sockets. For the character's owner each socket is the control itself: the row opens the
                gem picker for that socket. Everyone else reads them as plain rows.
            *@
            @if (GemManager.TryGetSlot(item, out _))
            {
                <div class="rf-gear-block">
                    <h4 class="rf-gear-block__title">Gem sockets@(e.Sockets.Count > 0 ? " (" + e.Sockets.Count + ")" : "")</h4>
                    @if (e.Sockets.Count == 0)
                    {
                        <p class="rf-gear-block__none">None. Pieces like this get their first socket at item level 25.</p>
                    }
                    else if (CanSocket)
                    {
                        <div class="rf-gear-sockets">
                            @foreach (var socket in e.Sockets)
                            {
                                var number = socket.Number;
                                <GemSocketButton Number="number" Name="@socket.Name" Bonus="@socket.Bonus"
                                                 Icon="@(socket.Empty ? null : ItemService.GetItemImage(socket.GemId.Value))"
                                                 OnClick="() => OpenGemPicker(number)" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="rf-gear-facts">
                            @foreach (var socket in e.Sockets)
                            {
                                <div class="rf-gear-facts__row">
                                    <span>Socket @socket.Number</span>
                                    @if (socket.Empty)
                                    {
                                        <b class="is-same">Empty</b>
                                    }
                                    else
                                    {
                                        <b>@socket.Name <em class="is-good">@socket.Bonus</em></b>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (enchantments != null && enchantments.Count > 0)
            {
                <div class="rf-gear-block">
                    <h4 class="rf-gear-block__title">Enchantments</h4>
                    <div class="rf-gear-facts">
                        @foreach (var enchantment in enchantments)
                        {
                            <div class="rf-gear-facts__row">
                                <span>@EnchantmentName(enchantment)</span>
                                <b><em class="is-good">+@EnchantmentValue(enchantment)</em></b>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (requirements.Count > 0 || item.ShopSellPrice > 0)
            {
                <div class="rf-gear-block">
                    <div class="rf-gear-facts">
                        @foreach (var requirement in requirements)
                        {
                            <div class="rf-gear-facts__row">
                                <span>Requires @requirement.Skill</span>
                                <b class="@(requirement.Met ? "" : "is-bad")">@requirement.Level@(requirement.Met ? "" : " (has " + requirement.Has + ")")</b>
                            </div>
                        }
                        @if (item.ShopSellPrice > 0)
                        {
                            <div class="rf-gear-facts__row">
                                <span>Vendor price</span>
                                <b>@Coins(item.ShopSellPrice)@(e.Stack.Amount > 1 ? " each" : "")</b>
                            </div>
                        }
                    </div>
                </div>
            }

            @* The Equip button is always there for a wearable piece: when it cannot be worn, this says why. *@
            @if (e.Slot != EquipmentSlot.None && !e.CanWear && !e.Stack.Equipped)
            {
                <p class="rf-gear-blocked"><i class="fa-solid fa-lock" aria-hidden="true"></i> @player.Name cannot wear this yet. @e.Blocked</p>
            }

            @if (CanAct)
            {
                <div class="rf-gear-acts">
                    @if (ActiveView == "equipment" && SkillTab)
                    {
                        @* a skill's tab changes its outfit only: the piece goes into it, and nothing is put on here *@
                        if (IsOutfitSlot(e.Slot) && e.CanWear && (Shown(e.Slot) != e || ProposalView || StaysAsWorn(e.Slot)))
                        {
                            <button type="button" class="rf-btn rf-btn--primary rf-gear-acts__main" @onclick="() => AddToOutfit(e)">
                                <i class="fa-solid fa-thumbtack" aria-hidden="true"></i> Add to @GearRules.SkillName(OutfitSkill) outfit
                            </button>
                        }
                    }
                    else if (e.Stack.Equipped)
                    {
                        <button type="button" class="rf-btn rf-btn--primary rf-gear-acts__main" @onclick="() => Unequip(e)">Take off</button>
                    }
                    else if (e.Slot != EquipmentSlot.None && e.CanWear)
                    {
                        <button type="button" class="rf-btn rf-btn--primary rf-gear-acts__main" @onclick="() => Equip(e)">Equip</button>
                    }

                    @if (ActiveView == "equipment" && !SkillTab && OutfitsKnown && OutfitSkill != Skill.None && IsOutfitSlot(e.Slot) && e.CanWear && Shown(e.Slot) != e)
                    {
                        <button type="button" class="rf-btn" title="Keeps this piece in that outfit whatever else arrives@(OutfitSkill == WornOutfitSkill ? "; the outfit is on, so it is put on now" : "")" @onclick="() => AddToOutfit(e)">
                            <i class="fa-solid fa-thumbtack" aria-hidden="true"></i> Pin in @GearRules.SkillName(OutfitSkill) outfit
                        </button>
                    }

                    <button type="button" class="rf-btn" @onclick="() => SendToStash(e)">
                        <i class="fa-solid fa-box-archive" aria-hidden="true"></i> Send to stash
                    </button>
                    @foreach (var other in OtherCharacters)
                    {
                        var to = other;
                        <button type="button" class="rf-btn" @onclick="() => SendToCharacter(e, to)">
                            <i class="fa-solid fa-user-group" aria-hidden="true"></i> Send to @to.Name (@to.Alias)
                        </button>
                    }

                    @if (CanSkin(e))
                    {
                        @if (skin != null)
                        {
                            <button type="button" class="rf-btn" @onclick="() => OpenSkins(e)"><i class="fa-solid fa-mask" aria-hidden="true"></i> Replace the skin</button>
                            <button type="button" class="rf-btn" @onclick="() => RemoveSkin(e)"><i class="fa-solid fa-mask" aria-hidden="true"></i> Remove the skin</button>
                        }
                        else
                        {
                            <button type="button" class="rf-btn" @onclick="() => OpenSkins(e)"><i class="fa-solid fa-mask" aria-hidden="true"></i> Change its look</button>
                        }
                    }

                    @if (e.CanSell)
                    {
                        <button type="button" class="rf-btn rf-btn--danger" @onclick="() => OpenSell(e)">
                            <i class="fa-solid fa-coins" aria-hidden="true"></i> Sell
                        </button>
                    }
                    else if (!e.Stack.Equipped && e.WhyNotSell != null)
                    {
                        <p class="rf-gear-acts__note">@e.WhyNotSell</p>
                    }
                </div>
            }
        </div>
    };
}
