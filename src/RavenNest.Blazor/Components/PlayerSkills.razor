@using RavenNest.BusinessLogic
@using RavenNest.BusinessLogic.Extended
@using System.Globalization
@using System.Timers
@using RavenNest.BusinessLogic.Game;

@inject RavenNest.Blazor.Services.PlayerService PlayerService
@inject RavenNest.Blazor.Services.AuthService AuthService

@*
    The skill list, and nothing else.

    Everything that used to sit above it - the headline stats, the "Right now" panel, the next
    level block, the in game settings and the resources - moved to PlayerOverview and its own tab.
    It had grown to about half a screen, so the twenty rows this tab is named after started below
    the fold.

    Rendered inside PlayerView on /characters and /inspect, and directly by the admin panel, so
    like PlayerView its styling lives in ravenfall-components.css rather than behind .rf-dash.
*@
<div class="rf-skills">

    @if (CanModify)
    {
        <div class="rf-skills__admin">
            <button type="button" class="rf-btn rf-btn--small" @onclick="()=> Unstuck()">
                <i class="fa-solid fa-person-falling-burst"></i> Unstuck the player
            </button>
            @if (Player.UserId != session.UserId)
            {
                <button type="button" class="rf-btn rf-btn--small" @onclick="()=> CloneSkillsAndStateToMain()">
                    <i class="fa fa-arrow-to-bottom"></i> Clone stats to Main
                </button>
            }
            <button type="button" class="rf-btn rf-btn--small rf-btn--danger" @onclick="()=> ResetSkills()">
                <i class="fa-regular fa-repeat"></i> Reset skills
            </button>
        </div>
    }

    @if (skills != null)
    {
        <section class="rf-panel">
            @*
                Combat level and total level stay here as one line rather than as stat tiles. They
                are the summary of this list, so they belong with it, and a line of text costs
                twenty pixels where the tiles cost ninety and pushed the list down again.
            *@
            <p class="rf-skills__summary">
                <span>Combat level <b>@Player.CombatLevel</b></span>
                <span>Total level <b>@TotalLevel.ToString("N0")</b></span>
                @if (Player.State?.ExpPerHour > 0)
                {
                    <span title="@Player.State.ExpPerHour exp per hour">Gaining <b>@Utility.FormatExp(Player.State.ExpPerHour ?? 0)</b> exp/hour</span>
                }
            </p>

            @* Twenty skills in a fixed order is fine when you know what you are looking for and
               useless when the question is "what am I closest to levelling". *@
            <div class="rf-filters">
                <button type="button" class="rf-filter @(sortOrder == SkillSort.Game ? "is-active" : "")" @onclick="()=> SetSort(SkillSort.Game)">In game order</button>
                <button type="button" class="rf-filter @(sortOrder == SkillSort.Level ? "is-active" : "")" @onclick="()=> SetSort(SkillSort.Level)">Highest level</button>
                <button type="button" class="rf-filter @(sortOrder == SkillSort.Closest ? "is-active" : "")" @onclick="()=> SetSort(SkillSort.Closest)">Closest to levelling</button>
            </div>

            <ul class="rf-skills__list">
                @foreach (var skill in SortedSkills)
                {
                    var isActive = IsTrainingSkill(skill);
                    <li class="rf-skill @(CanModify ? "rf-skill--editable" : "") @(isActive ? "is-training" : "")">
                        <span class="rf-skill__name">
                            @skill.Name
                            @if (isActive)
                            {
                                @* The wording says what the highlight says, so the row still reads
                                   in greyscale and for a colour blind player. *@
                                <span class="rf-skill__tag">Training</span>
                            }
                        </span>

                        <span class="rf-skill__bar" title="@ProgressTitle(skill)">
                            <span class="rf-skill__fill" style="@BarWidth(skill.Percent)"></span>
                        </span>

                        @* "12.4K to 73" answers how much grinding is left. The bar already answers
                           how far along you are, so repeating it as a percentage here spent a
                           column on nothing. The exact figures are on the tooltip. *@
                        <span class="rf-skill__next" title="@ProgressTitle(skill)">
                            @if (SkillProgress.IsMaxLevel(skill))
                            {
                                <span class="rf-skill__max">Max</span>
                            }
                            else
                            {
                                @Utility.FormatExp(SkillProgress.ExpToNextLevel(skill))
                                <span class="rf-skill__next-to">to @(skill.Level + 1)</span>
                            }
                        </span>

                        @if (skill.Name == "Health")
                        {
                            <span class="rf-skill__level" title="Current health out of maximum">
                                @currentHealth<span class="rf-skill__level-max"> / @skill.Level</span>
                            </span>
                        }
                        else
                        {
                            <span class="rf-skill__level">@skill.Level</span>
                        }

                        @if (CanModify)
                        {
                            <button type="button" class="rf-btn rf-btn--small" title="Edit @skill.Name" @onclick="()=> ShowModifySkill(skill)">
                                <i class="fa fa-pen"></i>
                            </button>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (modifySkillDialogVisible && modifyingSkill != null)
    {
        <div class="rf-modal-backdrop">
            <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Edit @modifyingSkill.Name">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">@modifyingSkill.Name</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="HideModifySkill">&times;</button>
                </div>

                <label class="rf-field">
                    <span class="rf-label">Level</span>
                    <input type="number" class="rf-input" value="@modifyingSkill.Level" @onchange="OnLevelModified" />
                </label>

                <label class="rf-field">
                    <span class="rf-label">Experience %</span>
                    <input type="number" class="rf-input" value="@((int)(modifyingSkill.Percent * 100))" @onchange="OnExperienceModified" />
                </label>

                <div class="rf-modal__foot">
                    <button type="button" class="rf-btn" @onclick="HideModifySkill">Cancel</button>
                    <button type="button" class="rf-btn rf-btn--primary" @onclick="ApplyModifySkill">Save</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public WebsitePlayer Player { get; set; }

    [Parameter]
    public bool CanManage { get; set; }

    private TrainingSkill trainingSkill;
    private int currentHealth;

    private RavenNest.Models.SessionInfo session;

    private bool isSailing;
    private bool modifySkillDialogVisible;
    private int modifyingSkillLevel = 0;
    private int modifyingSkillExperiencePercent = 0;
    private PlayerSkill modifyingSkill;

    private IReadOnlyList<PlayerSkill> skills;
    private SkillSort sortOrder = SkillSort.Game;

    private bool CanModify => session != null && session.Administrator;

    private int TotalLevel => skills == null ? 0 : skills.Sum(x => x.Level);

    private IEnumerable<PlayerSkill> SortedSkills
    {
        get
        {
            if (skills == null)
                return Enumerable.Empty<PlayerSkill>();

            switch (sortOrder)
            {
                case SkillSort.Level:
                    return skills.OrderByDescending(x => x.Level).ThenByDescending(x => x.Percent);
                case SkillSort.Closest:
                    // Skills already at the cap have nothing left to close on, so they sort last
                    // rather than sorting first on a remainder of zero.
                    return skills
                        .OrderBy(x => SkillProgress.IsMaxLevel(x) ? 1 : 0)
                        .ThenBy(SkillProgress.ExpToNextLevel);
                default:
                    return skills;
            }
        }
    }

    private void SetSort(SkillSort order)
    {
        sortOrder = order;
    }

    private string ExactExp(double value)
    {
        return Math.Round(value).ToString("N0");
    }

    private string ProgressTitle(PlayerSkill skill)
    {
        if (SkillProgress.IsMaxLevel(skill))
            return skill.Name + " is at the level cap";

        var forLevel = GameMath.ExperienceForLevel(skill.Level + 1);
        return $"{Math.Round(skill.Percent * 100, 2)}% - {ExactExp(skill.Experience)} of {ExactExp(forLevel)} exp toward level {skill.Level + 1}";
    }

    protected override void OnParametersSet()
    {
        if (Player == null)
            return;

        if (Player.State != null)
        {
            trainingSkill = PlayerService.GetTrainingSkill(Player.State);
            isSailing = trainingSkill == null && string.IsNullOrEmpty(Player.State.Island);
            currentHealth = Player.State.Health;
        }
        else
        {
            currentHealth = Player.Skills?.HealthLevel ?? 0;
        }

        skills = Player.Skills?.AsList();
    }

    protected override void OnInitialized()
    {
        session = AuthService.GetSession();
    }

    private void OnLevelModified(ChangeEventArgs evt)
    {
        if (evt.Value != null && int.TryParse(evt.Value?.ToString() ?? modifyingSkill.Level.ToString(), out var newLevel))
        {
            modifyingSkillLevel = newLevel;
        }
    }

    private void OnExperienceModified(ChangeEventArgs evt)
    {
        if (evt.Value != null && int.TryParse(evt.Value?.ToString() ?? "0", out var newExpPercent))
        {
            modifyingSkillExperiencePercent = newExpPercent;
        }
    }

    public async void ResetSkills()
    {
        var result = await PlayerService.ResetPlayerSkillsAsync(Player.Id);

        if (result)
        {
            this.Player = await PlayerService.GetPlayerAsync(Player.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    public async void CloneSkillsAndStateToMain()
    {
        var result = await PlayerService.CloneSkillsAndStateToMainAsync(Player.Id);

        if (result)
        {
            this.Player = await PlayerService.GetPlayerAsync(Player.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    public async void Unstuck()
    {
        await PlayerService.UnstuckPlayerAsync(Player.Id);
    }

    public async void ApplyModifySkill()
    {
        var result = await PlayerService.UpdatePlayerSkillAsync(Player.Id, modifyingSkill.Name, modifyingSkillLevel, modifyingSkillExperiencePercent / 100f);

        HideModifySkill();

        if (result)
        {
            this.Player = await PlayerService.GetPlayerAsync(Player.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    public void HideModifySkill()
    {
        modifySkillDialogVisible = false;
        modifyingSkill = null;
    }

    public void ShowModifySkill(PlayerSkill skill)
    {
        modifySkillDialogVisible = true;
        modifyingSkill = skill;
        modifyingSkillLevel = skill.Level;
        modifyingSkillExperiencePercent = (int)(skill.Percent * 100);
    }

    private bool IsTrainingSkill(PlayerSkill skill)
    {
        return RavenNest.Blazor.Services.TrainingSkills.IsTraining(skill, trainingSkill, isSailing);
    }

    // The old bar was a fixed 100px box with the fill set to "{percent}px", so it only looked
    // like a percentage because the box happened to be 100px wide. Invariant culture matters
    // here: a Swedish locale would emit "43,2%", which is not a CSS length.
    private string BarWidth(double percent)
    {
        var clamped = Math.Clamp(percent * 100d, 0d, 100d);
        return "width: " + clamped.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private enum SkillSort
    {
        Game,
        Level,
        Closest
    }
}
