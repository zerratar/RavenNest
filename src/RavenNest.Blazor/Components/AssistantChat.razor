@using RavenNest.BusinessLogic.AI
@using RavenNest.Blazor.Services.Assistant
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject PlayerAssistant Assistant
@inject NavigationManager Navigation

@*
    A bubble in the bottom right corner that opens a chat about your own characters.

    Floating rather than sitting in a page, because it is not about any one page: it answers the
    same questions wherever you happen to be, and a panel parked on the dashboard is one nobody
    finds from anywhere else.

    The part that matters is the confirmation. The assistant can propose moving items, and a
    proposal is all it is: nothing runs until the button below it is pressed, and the sentence on
    the card is written from the arguments of the call that will actually run rather than from
    anything the assistant said about it. So what is agreed to is what happens.

    Everything it can see belongs to the person signed in. It has no way to name anybody else.
*@

@if (visible)
{
    <div class="rf-assistant">
        @if (open)
        {
            <div class="rf-assistant__panel" id="rf-assistant-panel">
                <div class="rf-assistant__head">
                    <h2 class="rf-assistant__title">Ask about your characters</h2>
                    <span class="rf-meta">
                        @(isAdmin ? asked + " asked today" : remaining + " left today")
                    </span>
                </div>

                @if (adminOnly)
                {
                    @*
                        Said out loud, because an admin looking at a working chat box has no other
                        way to tell whether players can see it too, and "I thought it was live" is
                        the wrong thing to find out from a support message.
                    *@
                    <p class="rf-assistant__note">
                        Only you can see this. Players get it when
                        <a href="/admin/settings">Let players use the assistant</a> is turned on.
                    </p>
                }

                <div class="rf-assistant__log" role="log" aria-live="polite">
                    @if (chat.Turns.Count == 0)
                    {
                        <p class="rf-meta">
                            Try "what is my second character carrying", "how many coins does each of
                            mine have", or "move my coal to my alt". It can only see your own
                            characters.
                        </p>
                    }

                    @foreach (var turn in chat.Turns)
                    {
                        <div class="rf-chat__turn @(turn.FromUser ? "rf-chat__turn--mine" : "")">
                            <span class="rf-chat__who">@(turn.FromUser ? "You" : "Assistant")</span>
                            <p class="rf-chat__text">@turn.Text</p>
                        </div>
                    }

                    @if (thinking)
                    {
                        <p class="rf-meta">Thinking.</p>
                    }

                    @if (chat.Error != null)
                    {
                        <div class="rf-banner rf-banner--bad" role="status">
                            <p>@chat.Error</p>
                        </div>
                    }
                </div>

                @if (chat.Pending != null)
                {
                    @*
                        Nothing has happened yet. Both buttons continue the conversation; only one
                        of them runs anything.
                    *@
                    <div class="rf-chat__confirm">
                        <p class="rf-chat__confirmtitle">This would change your items</p>
                        <p class="rf-chat__confirmwhat">@chat.Pending.Summary</p>
                        <div class="rf-actions">
                            <button type="button" class="rf-btn rf-btn--primary rf-btn--small" disabled="@thinking" @onclick="() => Resolve(true)">
                                Do it
                            </button>
                            <button type="button" class="rf-btn rf-btn--small" disabled="@thinking" @onclick="() => Resolve(false)">
                                No
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="rf-chat__ask">
                        <input class="rf-input"
                               placeholder="Ask something"
                               disabled="@(thinking || OutOfQuestions)"
                               @bind="draft"
                               @bind:event="oninput"
                               @onkeydown="OnKey" />
                        <button type="button" class="rf-btn rf-btn--primary rf-btn--small"
                                disabled="@(thinking || OutOfQuestions || string.IsNullOrWhiteSpace(draft))"
                                @onclick="Send">
                            Ask
                        </button>
                    </div>

                    @if (OutOfQuestions)
                    {
                        <p class="rf-meta">That is all the questions for today. It resets at midnight UTC.</p>
                    }
                }
            </div>
        }

        <button type="button"
                class="rf-assistant__bubble"
                aria-expanded="@(open ? "true" : "false")"
                aria-controls="rf-assistant-panel"
                title="@(open ? "Close the assistant" : "Ask about your characters")"
                @onclick="() => open = !open">
            <i class="fa-solid @(open ? "fa-xmark" : "fa-comment-dots")" aria-hidden="true"></i>
            <span class="rf-assistant__label">@(open ? "Close the assistant" : "Ask about your characters")</span>

            @if (!open && chat.Pending != null)
            {
                @*
                    Closing the panel with something waiting would otherwise hide the fact that the
                    assistant is stuck mid answer, and it stays stuck until it is answered.
                *@
                <span class="rf-assistant__dot" aria-hidden="true"></span>
                <span class="rf-assistant__label">Waiting for you to confirm something</span>
            }
        </button>
    </div>
}

@code {
    private bool visible;
    private bool isAdmin;
    private bool adminOnly;
    private bool open;
    private Guid userId;
    private AiConversation chat;
    private string draft;
    private bool thinking;
    private int remaining;
    private int asked;

    /// <summary>Only players run out. See PlayerAssistant.TryUse.</summary>
    private bool OutOfQuestions => !isAdmin && remaining == 0;

    protected override void OnInitialized()
    {
        var session = AuthService.GetSession();
        if (session == null || !Assistant.IsAvailableTo(session.Administrator)) return;

        isAdmin = session.Administrator;
        adminOnly = isAdmin && !Assistant.IsOnForEveryone;
        userId = session.UserId;
        chat = Assistant.StartFor(userId, isAdmin);
        Recount();
        visible = true;
    }

    private void Recount()
    {
        asked = Assistant.AskedToday(userId);
        remaining = Assistant.RemainingToday(userId);
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Send();
    }

    private async Task Send()
    {
        if (thinking || string.IsNullOrWhiteSpace(draft)) return;

        // Counted before the call, not after. A question that fails still cost a request, and
        // counting only successes would make failures free to repeat.
        if (!Assistant.TryUse(userId, isAdmin))
        {
            Recount();
            return;
        }

        var text = draft;
        draft = "";
        thinking = true;

        try
        {
            await chat.AskAsync(text, WhereTheyAre());
        }
        finally
        {
            thinking = false;
            Recount();
        }
    }

    /// <summary>
    ///     Which page the question was asked from, in words.
    /// </summary>
    /// <remarks>
    ///     Read at the moment of asking rather than when the widget was created. It lives in the
    ///     layout, so one conversation spans every page somebody walks through, and the answer to
    ///     "what about this one" depends on where they were standing when they asked.
    ///
    ///     <para>
    ///     Where they are, not what is on the screen. The assistant still has to look things up
    ///     with a tool, and a page name is a hint about what a vague question means rather than a
    ///     substitute for the data.
    ///     </para>
    /// </remarks>
    private string WhereTheyAre()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);

        var cut = path.IndexOfAny(new[] { '?', '#' });
        if (cut >= 0) path = path.Substring(0, cut);

        path = path.TrimEnd('/');
        if (path.Length == 0) return "the site overview";

        // Longest match first, so /clan-invites is not read as /clan.
        foreach (var known in Pages)
        {
            if (path.Equals(known.Key, StringComparison.OrdinalIgnoreCase) ||
                path.StartsWith(known.Key + "/", StringComparison.OrdinalIgnoreCase))
            {
                return known.Value;
            }
        }

        return "the page at /" + path;
    }

    /// <summary>
    ///     Only pages worth naming. A route the assistant has nothing to say about is better sent
    ///     as its path than dressed up as a description that implies it can help there.
    /// </summary>
    private static readonly List<KeyValuePair<string, string>> Pages = new List<KeyValuePair<string, string>>
    {
        new KeyValuePair<string, string>("clan-invites", "their clan invitations"),
        new KeyValuePair<string, string>("marketplace", "the marketplace, where players sell to each other"),
        new KeyValuePair<string, string>("notifications", "their notifications"),
        new KeyValuePair<string, string>("characters", "the list of their characters"),
        new KeyValuePair<string, string>("character", "one of their characters in detail"),
        new KeyValuePair<string, string>("dashboard", "their dashboard overview"),
        new KeyValuePair<string, string>("inventory", "a character's inventory"),
        new KeyValuePair<string, string>("loyalty", "their loyalty with each streamer"),
        new KeyValuePair<string, string>("patreon", "their Patreon subscription"),
        new KeyValuePair<string, string>("highscore", "the highscore tables"),
        new KeyValuePair<string, string>("stash", "their item stash, which holds what no character is carrying"),
        new KeyValuePair<string, string>("items", "the item catalogue"),
        new KeyValuePair<string, string>("clan", "their clan"),
        new KeyValuePair<string, string>("shop", "the vendor, where items are bought and sold for coins"),
        new KeyValuePair<string, string>("town", "their town"),
        new KeyValuePair<string, string>("bot", "their stream and bot settings"),
        new KeyValuePair<string, string>("admin", "an administration page"),
    };

    private async Task Resolve(bool approved)
    {
        if (thinking) return;

        thinking = true;
        try
        {
            await chat.ResolveAsync(approved);
        }
        finally
        {
            thinking = false;
        }
    }
}
