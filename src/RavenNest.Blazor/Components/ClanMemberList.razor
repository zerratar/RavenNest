@using RavenNest.Models
@using RavenNest.Blazor.Services
@using Blazored.Typeahead
@using RavenNest.BusinessLogic.Game
@inject RavenNest.Blazor.Services.ClanService ClanService
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.PlayerService PlayerService
@inject NavigationManager NavigationManager

@if (members == null)
{
    <LoadIndicator></LoadIndicator>
}
else
{
    <div class="rf-toolbar">
        @* A roster of a hundred characters had no way to find one. *@
        <input type="search"
               class="rf-input rf-search"
               placeholder="Search members"
               aria-label="Search clan members by name"
               value="@search"
               @oninput="OnSearchChanged" />

        @*
            Who is actually playing right now was never on this page, and it is the thing a clan
            most wants from a member list. The character is locked to the session it joined, so
            the answer was one join away the whole time.
        *@
        @if (PlayingCount > 0)
        {
            <button type="button"
                    class="rf-filter @(onlineOnly ? "is-active" : "")"
                    aria-pressed="@onlineOnly"
                    @onclick="ToggleOnlineOnly">
                <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i>
                <span>@PlayingCount playing now</span>
            </button>
        }

        <span class="rf-meta">Showing @Visible.Count of @members.Count</span>

        @if (CanInvite)
        {
            <button type="button" class="rf-btn rf-btn--small rf-btn--primary rf-toolbar__end" @onclick="ShowInvitePlayer">
                <i class="fas fa-user-plus" aria-hidden="true"></i> Invite a character
            </button>
        }
    </div>

    @if (Visible.Count == 0)
    {
        <p class="rf-meta">Nothing matches that.</p>
    }
    else
    {
        <div class="rf-scroll-x">
            <table class="rf-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="rf-th rf-th--static">Character</span></th>
                        <th scope="col"><span class="rf-th rf-th--static">Rank</span></th>
                        <th scope="col"><span class="rf-th rf-th--static">Joined</span></th>
                        <th scope="col"><span class="rf-th rf-th--static">Now</span></th>
                        @if (ShowManageColumn)
                        {
                            <th scope="col"><span class="rf-th rf-th--static">Manage</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Visible)
                    {
                        <tr>
                            <td>
                                <div class="rf-item">
                                    <span class="rf-item__img">
                                        <img src="/api/twitch/logo/@(item.Player.Twitch?.PlatformId)" alt="" loading="lazy" />
                                    </span>
                                    <span class="rf-item__body">
                                        <a class="rf-item__name" href="/inspect/@item.Player.Id">@GetPlayerName(item.Player)</a>
                                        @* Combat level was in the data and shown on neither clan screen. *@
                                        <span class="rf-item__meta">Combat level @PlayerService.GetCombatLevel(item.Player)</span>
                                    </span>
                                </div>
                            </td>
                            <td>
                                @if (item.InvitationPending)
                                {
                                    <span class="rf-badge rf-badge--warn">Invited</span>
                                }
                                else if (savingChanges && rankEditPlayerId == item.Player.Id)
                                {
                                    <LoadIndicator></LoadIndicator>
                                }
                                else if (rankEditPlayerId == item.Player.Id)
                                {
                                    <div class="rf-actions">
                                        <select class="rf-input" aria-label="Rank" @onchange="SelectedRoleChanged">
                                            @foreach (var role in AssignableRoles)
                                            {
                                                <option value="@role.Id" selected="@(role.Id == item.Player.ClanRole?.Id)">@role.Name</option>
                                            }
                                        </select>
                                        <button type="button" class="rf-btn rf-btn--small rf-btn--primary" @onclick="UpdatePlayerRole">Save</button>
                                        <button type="button" class="rf-btn rf-btn--small" @onclick="CancelEditPlayerRole">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <span class="rf-table__quiet">@(item.Player.ClanRole?.Name ?? "Member")</span>
                                    @if (CanChangeRank(item))
                                    {
                                        <button type="button" class="rf-iconbtn" title="Change rank" @onclick="(()=>rankEditPlayerId=item.Player.Id)">
                                            <i class="fas fa-pencil" aria-hidden="true"></i>
                                        </button>
                                    }
                                }
                            </td>
                            <td class="rf-table__quiet">
                                @if (item.InvitationPending)
                                {
                                    <span>Not yet</span>
                                }
                                else
                                {
                                    @* Was a raw timestamp. Nobody counts back from 2024-03-04 12:33:21. *@
                                    <span title="@(item.Player.ClanRole?.Joined?.ToString("f"))">@JoinedText(item.Player.ClanRole?.Joined)</span>
                                }
                            </td>
                            <td>
                                @if (item.IsPlaying)
                                {
                                    <a class="rf-badge rf-badge--good" href="https://www.twitch.tv/@item.PlayingOn" target="_blank" title="Playing on @(item.PlayingOn)'s stream">
                                        <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i> @item.PlayingOn
                                    </a>
                                }
                                else
                                {
                                    <span class="rf-table__quiet">Not playing</span>
                                }
                            </td>
                            @if (ShowManageColumn)
                            {
                                <td>
                                    @if (confirmingRemoval == item.Player.Id)
                                    {
                                        <div class="rf-actions">
                                            <span class="rf-meta">Sure?</span>
                                            <button type="button" class="rf-btn rf-btn--small rf-btn--danger" @onclick="(()=>ConfirmRemove(item))">Yes</button>
                                            <button type="button" class="rf-btn rf-btn--small" @onclick="CancelRemove">No</button>
                                        </div>
                                    }
                                    else if (CanRemove(item))
                                    {
                                        @* Removing someone used to happen on the first click. *@
                                        <button type="button" class="rf-btn rf-btn--small" @onclick="(()=>confirmingRemoval=item.Player.Id)">
                                            @(item.InvitationPending ? "Cancel invite" : "Remove")
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (invitePlayerVisible)
    {
        <div class="rf-modal-backdrop" @onclick="HideInvitePlayer">
            <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Invite a character" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">Invite a character</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="HideInvitePlayer">&times;</button>
                </div>

                <label class="rf-field">
                    <span class="rf-label">Search for a character</span>
                    <Autocomplete SearchMethod="@SearchPlayer" @bind-Value="@selectedPlayer">
                        <SelectedTemplate>
                            @context.UserName (Level @PlayerService.GetCombatLevel(context) #@context.CharacterIndex)
                        </SelectedTemplate>
                        <ResultTemplate>
                            @context.UserName (Level @PlayerService.GetCombatLevel(context) #@context.CharacterIndex)
                        </ResultTemplate>
                        <NotFoundTemplate>
                            No character found
                        </NotFoundTemplate>
                    </Autocomplete>
                </label>
                <p class="rf-meta">Only characters that are not already in a clan can be invited.</p>

                <div class="rf-modal__foot">
                    <button type="button" class="rf-btn" @onclick="HideInvitePlayer">Cancel</button>
                    @if (selectedPlayer != null)
                    {
                        <button type="button" class="rf-btn rf-btn--primary" @onclick="SendInvite">Send invite</button>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid ClanId { get; set; }

    /// <summary>
    ///     Which of the signed in user's characters is acting in this clan. The rank belongs to the
    ///     character, so this is what decides what the buttons are allowed to do. Null only when the
    ///     user owns the clan without having joined it.
    /// </summary>
    [Parameter]
    public Guid? ActingCharacterId { get; set; }

    [Parameter]
    public bool CanManage { get; set; }

    private bool savingChanges;
    private bool invitePlayerVisible;
    private Guid? rankEditPlayerId;
    private Guid? targetRoleId;
    private Guid? confirmingRemoval;
    private string search = "";
    private bool onlineOnly;

    private Player selectedPlayer;

    // Each action is its own permission. Gating them all behind one flag was how the site ended
    // up with a Remove button that the server then refused.
    private TypedClanRolePermissions perms;
    private int myRoleLevel;

    private bool CanInvite => perms?.CanCreateInvite == true;

    private bool ShowManageColumn =>
        perms != null && (perms.CanCreateInvite || perms.CanDeleteInvite || perms.CanKickMembers
            || perms.CanKickAllMembers || perms.CanAssignRoles || perms.CanAssignAllRoles);

    private static int LevelOf(ClanMember m) => m.Player.ClanRole?.Level ?? 0;

    private bool CanRemove(ClanMember m)
    {
        if (perms == null) return false;
        if (m.InvitationPending) return perms.CanDeleteInvite;
        return perms.CanKickAllMembers || (perms.CanKickMembers && LevelOf(m) < myRoleLevel);
    }

    private bool CanChangeRank(ClanMember m)
    {
        if (perms == null || m.InvitationPending) return false;
        return perms.CanAssignAllRoles || (perms.CanAssignRoles && LevelOf(m) < myRoleLevel);
    }

    // You cannot promote anyone into a rank at or above your own unless you hold the sudo variant.
    private IEnumerable<ClanRole> AssignableRoles =>
        roles == null
            ? Enumerable.Empty<ClanRole>()
            : (perms?.CanAssignAllRoles == true ? roles : roles.Where(x => x.Level < myRoleLevel));

    IReadOnlyList<ClanMember> members = null;

    IReadOnlyList<ClanRole> roles = null;

    private int PlayingCount => members?.Count(x => x.IsPlaying) ?? 0;

    // Playing first, then rank, then strength. A member list is read to find someone to play with.
    private IReadOnlyList<ClanMember> Visible
    {
        get
        {
            if (members == null)
                return Array.Empty<ClanMember>();

            IEnumerable<ClanMember> q = members;

            if (onlineOnly)
                q = q.Where(x => x.IsPlaying);

            if (!string.IsNullOrWhiteSpace(search))
            {
                var needle = search.Trim();
                q = q.Where(x => (x.Player.Name ?? "").Contains(needle, StringComparison.OrdinalIgnoreCase));
            }

            return q
                .OrderByDescending(x => x.IsPlaying)
                .ThenBy(x => x.InvitationPending ? 1 : 0)
                .ThenByDescending(x => x.Player.ClanRole?.Level ?? 0)
                .ThenByDescending(x => PlayerService.GetCombatLevel(x.Player))
                .ToList();
        }
    }

    protected override void OnInitialized()
    {
        members = ClanService.GetMembers(ClanId);
        roles = ClanService.GetRoles(ClanId);
        perms = ClanService.GetMyPermissions(ClanId, ActingCharacterId);

        var session = AuthService.GetSession();
        var me = members?.FirstOrDefault(x => !x.InvitationPending && x.Player.UserId == session.UserId);
        // The owner outranks every rank, and holds the sudo permissions anyway.
        myRoleLevel = perms != null && perms.CanKickAllMembers && perms.CanAssignAllRoles
            ? int.MaxValue
            : (me?.Player.ClanRole?.Level ?? -1);
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
    }

    private void ToggleOnlineOnly()
    {
        onlineOnly = !onlineOnly;
    }

    private static string JoinedText(DateTime? joined)
    {
        if (joined == null || joined.Value <= DateTime.UnixEpoch)
            return "Unknown";

        var days = (int)(DateTime.UtcNow - joined.Value).TotalDays;
        if (days < 1) return "Today";
        if (days == 1) return "Yesterday";
        if (days < 30) return days + " days ago";
        if (days < 365) return Math.Max(1, days / 30) + " months ago";

        var years = days / 365;
        return years == 1 ? "A year ago" : years + " years ago";
    }

    private string GetPlayerName(Player player)
    {
        var name = player.Name;
        if (!string.IsNullOrEmpty(player.Identifier))
            name += " (" + player.Identifier + ")";
        if (player.CharacterIndex > 0)
            name += " #" + player.CharacterIndex;
        return name;
    }

    private void SelectedRoleChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (Guid.TryParse(id, out var roleId))
            targetRoleId = roleId;
    }

    private void CancelEditPlayerRole()
    {
        savingChanges = false;
        rankEditPlayerId = null;
        targetRoleId = null;

        InvokeAsync(this.StateHasChanged);
    }

    private async void UpdatePlayerRole()
    {
        savingChanges = true;
        try
        {
            if (targetRoleId != null && rankEditPlayerId != null)
            {
                members = await ClanService.UpdateMemberRoleAsync(ClanId, rankEditPlayerId.Value, targetRoleId.Value, ActingCharacterId);
            }
        }
        finally
        {
            CancelEditPlayerRole();
        }
    }

    private void HideInvitePlayer()
    {
        invitePlayerVisible = false;
    }

    private void ShowInvitePlayer()
    {
        invitePlayerVisible = true;
    }

    private void SendInvite()
    {
        if (selectedPlayer == null)
            return;

        invitePlayerVisible = false;
        members = ClanService.InvitePlayer(ClanId, selectedPlayer.Id, ActingCharacterId);
        selectedPlayer = null;
    }

    private void CancelRemove()
    {
        confirmingRemoval = null;
    }

    private void ConfirmRemove(ClanMember member)
    {
        confirmingRemoval = null;

        members = member.InvitationPending
            ? ClanService.RemoveInvite(ClanId, member.Player.Id, ActingCharacterId)
            : ClanService.RemoveMember(ClanId, member.Player.Id, ActingCharacterId);
    }

    private async Task<IEnumerable<Player>> SearchPlayer(string searchText)
    {
        var result = (await PlayerService.SearchForPlayersAsync(searchText));
        return result.Where(x => x.Clan?.Id == null).ToList();
    }
}
