@using RavenNest.Combat
@using RavenNest.BusinessLogic.Game
@inject SkillTreeManager SkillTrees
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject NavigationManager Navigation

@*
    The skill trees on the character page (combat v2, the game's docs/combat-skills-design.md, section 6). The map
    (SkillTreeStage) carries it all: the points and the respec in its corner, the picked skill's panel beside it, the
    loadout along the bottom. "Planner" in the map's corner tries changes on a copy, with the character's levels or
    others, saved in this browser; nothing in it reaches the character. Chat has !tree, !learn, !loadout and !respec. The
    rules are RavenNest.Combat's; the server saves through SkillTreeManager and tells the game.
*@
@if (info == null)
{
    <LoadIndicator></LoadIndicator>
}
else
{
    <div class="rf-trees">
        <div class="rf-trees__views" role="tablist">
            <button type="button" role="tab" class="rf-tab @(listView ? "" : "is-active")" aria-selected="@(!listView)" @onclick="() => listView = false">Map</button>
            <button type="button" role="tab" class="rf-tab @(listView ? "is-active" : "")" aria-selected="@listView" @onclick="() => listView = true">List</button>
        </div>

        <div style="@(listView ? "display:none" : "")">
            @if (planner)
            {
                <SkillTreeStage Key="Player.Id" Build="plan" Levels="PlanLevel" Earned="planEarned" CanEdit="true" Planner="true"
                                LevelValues="planLevels" OnLevels="SetPlanLevels" OnReset="ResetPlan" OnLoadPlan="LoadPlan" ShareLink="PlanLink"
                                ShowModeToggle="true" PlannerChanged="SetPlanner"
                                OnLearn="PlanLearn" OnLower="PlanLower" OnSlot="PlanSlot" OnRule="PlanRule"
                                Note="Planner: try changes here, nothing reaches your character." />
            }
            else
            {
                <SkillTreeStage Key="Player.Id" Build="build" Levels="levels" Earned="info.Earned" CanEdit="canManage"
                                RespecLabel="@(canManage ? RespecPrice : null)" OnRespec="Respec"
                                ShowModeToggle="true" PlannerChanged="SetPlanner"
                                OnLearn="Learn" OnSlot="SetSlot" OnRule="SetRule" Message="@message" />
            }
            <p class="rf-meta rf-trees__hint">Drag to move, scroll or pinch to zoom, tap a star to see its skill. Diamonds are active skills, circles passives, hexagons the special ones; a gold number is the active's loadout slot.</p>
        </div>

        @if (listView)
        {
            <div class="rf-trees__grid">
                @foreach (SkillTree tree in Enum.GetValues(typeof(SkillTree)))
                {
                    var skill = RavenNest.Combat.SkillTrees.SkillOf(tree);
                    var level = levels(skill);
                    <div class="rf-panel rf-trees__tree">
                        <h3 class="rf-panel__title"><img class="rf-trees__tree-icon" src="/imgs/skills/tree-@(tree.ToString().ToLowerInvariant()).webp" alt="" /> @tree <span class="rf-meta">@skill @level</span></h3>
                        @foreach (var node in RavenNest.Combat.SkillTrees.Of(tree).OrderBy(n => n.Tier))
                        {
                            var rank = build.Rank(node.Id);
                            var open = level >= node.RequiredLevel;
                            var reason = build.CanRaise(node.Id, levels, info.Earned);
                            <div class="rf-trees__node @(rank > 0 ? "is-learned" : "") @(open ? "" : "is-locked")">
                                <div class="rf-trees__node-head">
                                    <strong>@node.Name</strong>
                                    <span class="rf-chip">@(node.IsActive ? "Active" : node.MaxRank > 1 ? $"{rank}/{node.MaxRank}" : rank > 0 ? "Learned" : "Passive")</span>
                                </div>
                                <div class="rf-trees__node-text">@node.Description</div>
                                <div class="rf-meta">
                                    @if (node.IsActive) { <span>Every @node.Active.Cooldown s. </span> }
                                    <span>@skill @node.RequiredLevel, @node.Cost point@(node.Cost == 1 ? "" : "s")@(node.MaxRank > 1 ? " a rank" : "").</span>
                                </div>
                                @if (canManage && rank < node.MaxRank)
                                {
                                    <button type="button" class="rf-btn rf-btn--small" disabled="@(reason != null)" title="@reason" @onclick="() => Learn(node.Id)">Learn</button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public RavenNest.BusinessLogic.Extended.WebsitePlayer Player { get; set; }

    [Parameter]
    public bool CanManage { get; set; }

    private RavenNest.Models.SkillBuildInfo info;
    private SkillBuild build = new SkillBuild();
    private Func<CombatSkill, int> levels = _ => 1;
    private bool canManage;
    private bool listView;
    private string message;

    // the planner: a copy of the build with levels of one's choosing
    private bool planner;
    private SkillBuild plan = new SkillBuild();
    private int[] planLevels = Enumerable.Repeat(1, 8).ToArray();
    private int planEarned;

    private string RespecPrice => info.FreeRespecs > 0 ? "free" : info.TomesOfForgetting > 0 ? "a Tome of Forgetting" : info.RespecCost.ToString("N0") + " coins";

    protected override void OnParametersSet()
    {
        var session = AuthService.GetSession();
        canManage = CanManage && session != null && SkillTrees.Owns(session.UserId, Player.Id);
        Load(SkillTrees.Get(Player.Id));
    }

    private void Load(RavenNest.Models.SkillBuildInfo next)
    {
        if (next == null) return;
        info = next;
        build = SkillBuild.Parse(info.Build);
        levels = SkillTrees.LevelsOf(Player.Id);
    }

    private void Apply(RavenNest.Models.SkillBuildResult result, string done)
    {
        if (result == null) { message = "That did not go through. Try again in a moment."; return; }
        Load(result.Info);
        message = result.Success ? done : result.Message;
    }

    private void Learn(string id)
    {
        if (!canManage) return;
        var node = RavenNest.Combat.SkillTrees.Get(id);
        Apply(SkillTrees.Raise(Player.Id, id), "Learned " + node?.Name + ".");
    }

    private void SetSlot((int Slot, string Id) pick)
    {
        if (!canManage) return;
        Apply(SkillTrees.SetLoadout(Player.Id, pick.Slot + 1, string.IsNullOrEmpty(pick.Id) ? null : pick.Id), "Loadout saved.");
    }

    private void SetRule((string Id, SkillUse Rule) pick)
    {
        if (!canManage) return;
        Apply(SkillTrees.SetRule(Player.Id, pick.Id, pick.Rule), "Saved when " + RavenNest.Combat.SkillTrees.Get(pick.Id)?.Name + " is used.");
    }

    private void Respec()
    {
        if (!canManage) return;
        Apply(SkillTrees.Respec(Player.Id), "Every point is back to spend.");
    }

    // ---- the planner ----

    private int PlanLevel(CombatSkill skill) => planLevels[(int)skill];

    private void SetPlanner(bool on)
    {
        if (on && !planner)
        {
            plan = SkillBuild.Parse(build.ToString());
            planLevels = Enum.GetValues(typeof(CombatSkill)).Cast<CombatSkill>().Select(s => Math.Max(1, levels(s))).ToArray();
            Recount();
        }
        planner = on;
    }

    private void Recount() => planEarned = RavenNest.Combat.SkillTrees.EarnedPoints(planLevels.Sum());

    private void SetPlanLevels(int[] next)
    {
        planLevels = next;
        Recount();
        plan.Clean();
    }

    private void ResetPlan() => plan.Reset();

    private void LoadPlan(string text)
    {
        plan = SkillBuild.Parse(text);
        Recount();
    }

    private string PlanLink() => Navigation.ToAbsoluteUri("/skill-trees").ToString() + "?build=" + Uri.EscapeDataString(plan.ToString()) + "&levels=" + string.Join(",", planLevels);

    private void PlanLearn(string id)
    {
        if (plan.Raise(id, PlanLevel, planEarned) != null) return;
        var node = RavenNest.Combat.SkillTrees.Get(id);
        if (node.IsActive && plan.Rank(id) == 1) FillFreeSlot(plan, id);
    }

    private void PlanLower(string id) => plan.Lower(id);

    private void PlanSlot((int Slot, string Id) pick)
    {
        if (string.IsNullOrEmpty(pick.Id)) plan.ClearSlot(pick.Slot); else plan.SetLoadout(pick.Slot, pick.Id);
    }

    private void PlanRule((string Id, SkillUse Rule) pick) => plan.SetRule(pick.Id, pick.Rule);

    /// <summary>A new active goes into the first free slot, as the server does.</summary>
    public static void FillFreeSlot(SkillBuild b, string id)
    {
        for (var slot = 0; slot < b.LoadoutSlots; ++slot)
        {
            if (slot >= b.Loadout.Count || string.IsNullOrEmpty(b.Loadout[slot])) { b.SetLoadout(slot, id); break; }
        }
    }
}
