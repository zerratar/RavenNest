    /// <summary>
    ///     Applies the chosen skin, moving it out of the stash first when that is where it is.
    /// </summary>
    /// <remarks>
    ///     PlayerInventory.AddTransmogrification resolves the skin with GetUnequippedItem, which
    ///     only looks at the character's own inventory. A stash item therefore has to be sent
    ///     across before it can be used, and if that send fails there is no point attempting the
    ///     transmogrification: it would return false and take the dialog down as though it had
    ///     worked.
    /// </remarks>
    private void ApplySelectedSkin()
    {
        if (selectedSkin == null) return;

        skinPickerError = null;

        if (selectedSkinFromStash != null)
        {
            if (!PlayerService.SendToCharacter(Player.Id, selectedSkinFromStash, 1))
            {
                skinPickerError = "That item could not be moved out of your stash, so nothing was changed.";
                return;
            }

            selectedSkinFromStash = null;
        }

        Player = PlayerService.AddTransmogrification(Player.Id, itemDetailsDialogItem, selectedSkin.Id);
        CloseItemDetails();
    }

