@using RavenNest.BusinessLogic.Extended
@using RavenNest.BusinessLogic.Game
@using RavenNest.Models
@using RavenNest.Blazor.Services
@using Blazored.Typeahead
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.PlayerService PlayerService
@inject RavenNest.Blazor.Services.ItemService ItemService

@*
    Shares its item vocabulary with the stash page: the same filter list, the same rarity bands,
    the same item cell. The two used to be separate implementations of the same screen, which is
    how they ended up with different labels for the same category.
*@
<div class="rf-inv">
    <div class="rf-inv__head">
        <div class="rf-tabs" role="tablist">
            <button type="button" role="tab" aria-selected="@(activeTab == "equipment")" class="rf-tab @(activeTab == "equipment" ? "is-active" : "")" @onclick="() => SetEquipmentTab()">Equipment</button>
            <button type="button" role="tab" aria-selected="@(activeTab == "inventory")" class="rf-tab @(activeTab == "inventory" ? "is-active" : "")" @onclick="() => SetInventoryTab()">Inventory</button>
        </div>
        <div class="rf-inv__coins" title="@coins.ToString("N0") coins">
            <i class="fa-solid fa-coins" aria-hidden="true"></i>
            <span>@Utility.FormatAmount(coins)</span>
        </div>
    </div>

    @if (activeTab == "equipment")
    {
        <div class="rf-gear">
            <section class="rf-panel">
                <h3 class="rf-panel__title">Equipped</h3>
                @*
                    Slots were image squares with a label and nothing else, so working out what was
                    actually equipped meant clicking each one. The name is right there in the data.
                *@
                <div class="rf-slots">
                    @foreach (var slot in GetItemSlots())
                    {
                        var equipped = GetEquippedItemForSlot(slot);
                        var equippedItem = equipped == null ? null : ItemService.GetItem(equipped.ItemId);
                        var label = GetEquipmentSlotName(slot);

                        <button type="button"
                                class="rf-slot @(equipped == null ? "is-empty" : "")"
                                title="@(equipped == null ? label + ": empty" : label + ": " + GetItemName(equipped))"
                                disabled="@(equipped == null)"
                                @onclick="() => ShowItemDetails(equipped)">
                            <span class="rf-slot__label">@label</span>
                            @if (equipped != null)
                            {
                                <span class="rf-slot__img">
                                    <img src="@GetItemImage(equipped.TransmogrificationId ?? equipped.ItemId, equipped.Tag)" alt="" loading="lazy" />
                                    @if (equipped.TransmogrificationId != null)
                                    {
                                        <span class="rf-slot__mark" title="Transmogrified"><i class="fa-solid fa-mask" aria-hidden="true"></i></span>
                                    }
                                    @if (!string.IsNullOrEmpty(equipped.Enchantment))
                                    {
                                        <span class="rf-slot__mark rf-slot__mark--enchant" title="Enchanted"><i class="fa-solid fa-sparkles" aria-hidden="true"></i></span>
                                    }
                                </span>
                                <span class="rf-slot__name @ItemService.GetRarityClass(equippedItem)">@GetItemName(equipped)</span>
                            }
                            else
                            {
                                <span class="rf-slot__img rf-slot__img--empty"><i class="fa-regular fa-square" aria-hidden="true"></i></span>
                                <span class="rf-slot__name">Empty</span>
                            }
                        </button>
                    }
                </div>
            </section>

            <section class="rf-panel">
                <h3 class="rf-panel__title">Total stats</h3>
                @if (EquippedStats.Count == 0)
                {
                    <p class="rf-meta">Nothing equipped, so no bonuses.</p>
                }
                else
                {
                    @*
                        A label and a number, not a facts grid. rf-facts reserves a fixed label
                        column, and this panel is the narrow third of the gear layout, so the value
                        column was left about one character wide and every number broke down the
                        page a digit at a time: 2,626 rendered as five stacked lines.
                    *@
                    <div class="rf-statlist">
                        @foreach (var stat in EquippedStats)
                        {
                            <div class="rf-statlist__row">
                                <span class="rf-statlist__label">@stat.Key</span>
                                <span class="rf-statlist__value">@stat.Value.ToString("N0")</span>
                            </div>
                        }
                    </div>
                }

                @*
                    An empty slot is free stats you are not wearing, and nothing said which ones
                    were empty without counting the squares.
                *@
                @if (EmptySlotNames.Count > 0)
                {
                    <p class="rf-meta rf-gear__gaps">
                        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                        @EmptySlotNames.Count of @GetItemSlots().Length slots are empty:
                        <b>@string.Join(", ", EmptySlotNames)</b>
                    </p>
                }
            </section>
        </div>
    }
    else if (activeTab == "inventory")
    {
        <section class="rf-panel">
            <div class="rf-toolbar">
                @* An inventory of a few hundred items had no way to find one by name. *@
                <input type="search"
                       class="rf-input rf-search"
                       placeholder="Search by name"
                       aria-label="Search inventory by item name"
                       value="@search"
                       @oninput="OnSearchChanged" />
                @if (!string.IsNullOrWhiteSpace(search) || itemFilter != ItemFilter.All)
                {
                    <button type="button" class="rf-btn rf-btn--small" @onclick="ClearFilters">Clear filters</button>
                }
                <span class="rf-meta">Showing @VisibleItems.Count of @GetInventoryItems().Count</span>
            </div>

            @* One shared list with the stash page rather than nineteen blocks in each. *@
            <div class="rf-filters" role="group" aria-label="Filter items by category">
                @foreach (var f in ItemFilterOptions.All)
                {
                    <button type="button"
                            class="rf-filter @(itemFilter == f.Filter ? "is-active" : "")"
                            aria-pressed="@(itemFilter == f.Filter)"
                            @onclick="() => SelectItemFilter(f.Filter)">
                        <i class="@f.Icon" aria-hidden="true"></i>
                        <span>@f.Label</span>
                    </button>
                }
            </div>

            @if (CanManage)
            {
                <div class="rf-actions rf-inv__bulk">
                    <button type="button" class="rf-btn rf-btn--small" @onclick="SendAllToStash">Send all to stash</button>
                    <button type="button" class="rf-btn rf-btn--small rf-btn--danger" @onclick="ShowVendorAllDialog">Vendor all (@GetVendorPrice())</button>
                    @if (CanModify)
                    {
                        <button type="button" class="rf-btn rf-btn--small" @onclick="ShowAddItem">Add item</button>
                    }
                </div>
            }

            @if (VisibleItems.Count == 0)
            {
                <p class="rf-meta">
                    @if (GetInventoryItems().Count == 0)
                    {
                        <span>Nothing in this character's inventory.</span>
                    }
                    else
                    {
                        <span>Nothing matches that. Try a different category or clear the search.</span>
                    }
                </p>
            }
            else
            {
                @*
                    The tiles carry their rarity as a bar along the bottom, so a legendary drop is
                    findable in a wall of two hundred squares without hovering every one. The title
                    gives the name, which the grid never did.
                *@
                <div class="rf-invgrid">
                    @foreach (var item in VisibleItems)
                    {
                        var i = ItemService.GetItem(item.ItemId);
                        <button type="button"
                                class="rf-tile @ItemService.GetRarityClass(i)"
                                title="@TileTitle(item, i)"
                                @onclick="(() => ShowItemDetails(item))">
                            <span class="rf-tile__img">
                                <img src="@GetItemImage(item.TransmogrificationId ?? item.ItemId, item.Tag)" alt="" loading="lazy" />
                                @if (item.TransmogrificationId != null)
                                {
                                    <span class="rf-tile__mark" title="Transmogrified"><i class="fa-solid fa-mask" aria-hidden="true"></i></span>
                                }
                                @if (!string.IsNullOrEmpty(item.Enchantment))
                                {
                                    <span class="rf-tile__mark rf-tile__mark--enchant" title="Enchanted"><i class="fa-solid fa-sparkles" aria-hidden="true"></i></span>
                                }
                            </span>
                            @if (item.Amount > 1)
                            {
                                <span class="rf-tile__amount">@GetItemAmount(item)</span>
                            }
                        </button>
                    }
                </div>
            }
        </section>
    }
</div>

@if (vendorAllConfirmationDialogVisible)
{
    <div class="rf-modal-backdrop" @onclick="CloseVendorAllDialog">
        <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Vendor all" @onclick:stopPropagation="true">
            <div class="rf-modal__head">
                <h2 class="rf-modal__title">Vendor everything shown</h2>
                <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CloseVendorAllDialog">&times;</button>
            </div>
            <p>
                This sells <b>@GetItemCountForVendor()</b> items in this category for
                <b class="rf-inv__price">@GetVendorPrice()</b>.
            </p>
            <p class="rf-meta">Vendored items cannot be bought back.</p>
            <div class="rf-modal__foot">
                <button type="button" class="rf-btn" @onclick="CloseVendorAllDialog">Cancel</button>
                <button type="button" class="rf-btn rf-btn--danger" @onclick="VendorAll">Vendor them</button>
            </div>
        </div>
    </div>
}

@if (vendorConfirmationDialogVisible)
{
    <div class="rf-modal-backdrop" @onclick="CloseVendorDialog">
        <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Vendor @GetItemName(vendorItem)" @onclick:stopPropagation="true">
            <div class="rf-modal__head">
                <h2 class="rf-modal__title">Vendor @GetItemName(vendorItem)</h2>
                <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CloseVendorDialog">&times;</button>
            </div>

            @if (canVendorMany)
            {
                <label class="rf-field">
                    <span class="rf-label">Amount</span>
                    <input type="number" class="rf-input" min="1" max="@vendorItem.Amount" @bind="vendorAmount" />
                </label>
                <div class="rf-actions">
                    @foreach (var amount in quickButtons)
                    {
                        <button type="button" class="rf-btn rf-btn--small" @onclick="() => SetVendorAmount(amount)">
                            @(amount == vendorItem.Amount ? $"All ({Utility.FormatAmount(amount)})" : Utility.FormatAmount(amount))
                        </button>
                    }
                </div>
            }

            <p>
                This sells <b>@vendorAmount</b> @GetItemName(vendorItem) for
                <b class="rf-inv__price">@((ItemService.GetItem(vendorItem.ItemId).ShopSellPrice * vendorAmount).ToString("N0")) coins</b>.
            </p>
            <p class="rf-meta">Vendored items cannot be bought back.</p>

            <div class="rf-modal__foot">
                <button type="button" class="rf-btn" @onclick="CloseVendorDialog">Cancel</button>
                <button type="button" class="rf-btn rf-btn--danger" @onclick="Vendor">Vendor it</button>
            </div>
        </div>
    </div>
}

@if (itemDetailDialogVisible)
{
    var item = ItemService.GetItem(itemDetailsDialogItem.ItemId);
    var itemSkin = itemDetailsDialogItem.TransmogrificationId != null ? ItemService.GetItem(itemDetailsDialogItem.TransmogrificationId.Value) : null;
    var blocking = RequirementNote(item);

    <div class="rf-modal-backdrop" @onclick="CloseItemDetails">
        <div class="rf-modal rf-modal--wide" role="dialog" aria-modal="true" aria-label="@GetItemName()" @onclick:stopPropagation="true">
            <div class="rf-modal__head">
                <h2 class="rf-modal__title @ItemService.GetRarityClass(item)">@GetItemName()</h2>
                <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CloseItemDetails">&times;</button>
            </div>

            <div class="rf-itemview">
                <div class="rf-itemview__art">
                    <span class="rf-item__img rf-itemview__img">
                        <img src="@GetItemImage(itemDetailsDialogItem.ItemId, itemDetailsDialogItem.Tag)" alt="" />
                        @if (itemDetailsDialogItem.Amount > 1)
                        {
                            <span class="rf-item__amount">@GetItemAmount(itemDetailsDialogItem)</span>
                        }
                    </span>
                    @if (itemSkin != null)
                    {
                        <span class="rf-itemview__skin" title="Appearance in game">
                            <img src="@GetItemImage(itemSkin.Id, itemDetailsDialogItem.Tag)" alt="" />
                        </span>
                    }
                </div>

                <div class="rf-itemview__body">
                    <div class="rf-actions">
                        <span class="rf-badge @ItemService.GetRarityClass(item)">@ItemService.GetRarityName(item)</span>
                        @if (!string.IsNullOrEmpty(itemDetailsDialogItem.Enchantment))
                        {
                            <span class="rf-badge rf-badge--gold"><i class="fa-solid fa-sparkles" aria-hidden="true"></i> Enchanted</span>
                        }
                        @if (itemSkin != null)
                        {
                            <span class="rf-badge rf-badge--gold"><i class="fa-solid fa-mask" aria-hidden="true"></i> Transmogrified</span>
                        }
                        @if (itemDetailsDialogItem.Soulbound)
                        {
                            <span class="rf-badge rf-badge--warn"><i class="fa-solid fa-link" aria-hidden="true"></i> Soulbound</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(item?.Description))
                    {
                        <p class="rf-meta">@item.Description</p>
                    }

                    <dl class="rf-facts">
                        <dt>Type</dt>
                        <dd>@GetItemType()</dd>
                        <dt>Material</dt>
                        <dd>@(item == null ? "Unknown" : ItemService.GetMaterialName(item))</dd>

                        @{
                            var itemStats = GetItemStats();
                        }
                        @if (itemStats != null && itemStats.Count > 0)
                        {
                            @foreach (var stat in itemStats)
                            {
                                <dt>@stat.Name</dt>
                                <dd>
                                    @stat.Value
                                    @if (stat.Bonus > 0)
                                    {
                                        <span class="rf-itemview__bonus" title="Enchantment bonus">+@stat.Bonus</span>
                                    }
                                </dd>
                            }
                        }

                        @if (!string.IsNullOrEmpty(itemDetailsDialogItem.Enchantment))
                        {
                            @foreach (var stat in GetItemEnchantments())
                            {
                                <dt>@GetEnchantmentName(stat)</dt>
                                <dd><span class="rf-itemview__bonus">+@GetEnchantmentValue(stat)</span></dd>
                            }
                        }

                        @if (item != null && item.RequiredAttackLevel > 0)
                        {
                            <dt>Requires attack</dt>
                            <dd>@item.RequiredAttackLevel</dd>
                        }
                        @if (item != null && item.RequiredDefenseLevel > 0)
                        {
                            <dt>Requires defense</dt>
                            <dd>@item.RequiredDefenseLevel</dd>
                        }
                        @if (item != null && item.RequiredRangedLevel > 0)
                        {
                            <dt>Requires ranged</dt>
                            <dd>@item.RequiredRangedLevel</dd>
                        }
                        @if (item != null && item.RequiredMagicLevel > 0)
                        {
                            <dt>Requires magic or healing</dt>
                            <dd>@item.RequiredMagicLevel</dd>
                        }
                        @if (item != null && item.RequiredSlayerLevel > 0)
                        {
                            <dt>Requires slayer</dt>
                            <dd>@item.RequiredSlayerLevel</dd>
                        }
                        @if (item != null && item.ShopSellPrice > 0)
                        {
                            <dt>Vendor price</dt>
                            <dd>@item.ShopSellPrice.ToString("N0") coins each</dd>
                        }
                    </dl>

                    @*
                        The Equip button used to simply not be rendered when a requirement was not
                        met, which reads as a missing feature rather than an answer.
                    *@
                    @if (blocking != null && !itemDetailsDialogItem.Equipped)
                    {
                        <p class="rf-itemview__blocked">
                            <i class="fa-solid fa-lock" aria-hidden="true"></i>
                            @Player.Name cannot equip this yet. @blocking
                        </p>
                    }
                </div>
            </div>

            @if (CanManage)
            {
                <div class="rf-modal__foot rf-modal__foot--spread">
                    <div class="rf-actions">
                        @if (!itemDetailsDialogItem.Equipped && itemDetailsDialogItem.TransmogrificationId == null)
                        {
                            <button type="button" class="rf-btn rf-btn--small rf-btn--danger" @onclick="() => ShowVendorDialog(itemDetailsDialogItem)">Vendor</button>
                        }
                    </div>
                    <div class="rf-actions">
                        <button type="button" class="rf-btn rf-btn--small" @onclick="SendToStash">Send to stash</button>
                        @if (characters != null)
                        {
                            foreach (var plr in characters)
                            {
                                if (plr.Id == Player.Id) continue;
                                <button type="button" class="rf-btn rf-btn--small" @onclick="() => SendToCharacter(plr)">Send to @plr.Alias</button>
                            }
                        }
                        @if (itemDetailsDialogItem.Equipped)
                        {
                            <button type="button" class="rf-btn rf-btn--primary" @onclick="UnequipItem">Unequip</button>
                        }
                        else if (CanBeEquipped())
                        {
                            <button type="button" class="rf-btn rf-btn--primary" @onclick="EquipItem">Equip</button>
                        }
                    </div>
                </div>

                @if (CanBeTransmogrified(itemDetailsDialogItem))
                {
                    <div class="rf-itemview__transmog">
                        <h3 class="rf-panel__title">Transmogrification</h3>
                        <p class="rf-meta">
                            Change the appearance of this item using another item as a skin. The skin item is
                            removed until the transmogrification is cleared or replaced.
                        </p>
                        @if (isTransmogrificationItemSelectorVisible)
                        {
                            <label class="rf-field">
                                <span class="rf-label">Item to use as a skin</span>
                                <BlazoredTypeahead SearchMethod="SearchSkinnableItem" @bind-Value="selectedSkin">
                                    <SelectedTemplate>
                                        @context.Name
                                    </SelectedTemplate>
                                    <ResultTemplate>
                                        @context.Name
                                    </ResultTemplate>
                                </BlazoredTypeahead>
                            </label>
                            @if (selectedSkin != null)
                            {
                                <div class="rf-item">
                                    <span class="rf-item__img">
                                        <img src="@GetItemImage(selectedSkin.Id, itemDetailsDialogItem.Tag)" alt="" />
                                    </span>
                                    <span class="rf-item__body">
                                        <span class="rf-item__name @ItemService.GetRarityClass(selectedSkin)">@GetItemName(selectedSkin)</span>
                                    </span>
                                </div>
                            }
                            <div class="rf-actions">
                                @if (itemSkin != null)
                                {
                                    <button type="button" class="rf-btn rf-btn--small rf-btn--primary" @onclick="ReplaceTransmogrification">Replace</button>
                                }
                                else
                                {
                                    <button type="button" class="rf-btn rf-btn--small rf-btn--primary" @onclick="AddTransmogrification">Apply</button>
                                }
                                <button type="button" class="rf-btn rf-btn--small" @onclick="HideApplyTransmogrificationDialog">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <div class="rf-actions">
                                @if (itemSkin != null)
                                {
                                    <button type="button" class="rf-btn rf-btn--small" @onclick="ShowApplyTransmogrificationDialog">Replace skin</button>
                                    <button type="button" class="rf-btn rf-btn--small" @onclick="RemoveTransmogrification">Remove skin</button>
                                }
                                else
                                {
                                    <button type="button" class="rf-btn rf-btn--small" @onclick="ShowApplyTransmogrificationDialog">Choose a skin</button>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@if (CanModify && addItemDialogVisible)
{
    <div class="rf-modal-backdrop" @onclick="HideAddItem">
        <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Add item" @onclick:stopPropagation="true">
            <div class="rf-modal__head">
                <h2 class="rf-modal__title">Add item</h2>
                <button type="button" class="rf-modal__close" aria-label="Close" @onclick="HideAddItem">&times;</button>
            </div>
            <label class="rf-field">
                <span class="rf-label">Search for an item</span>
                <BlazoredTypeahead SearchMethod="SearchItem" @bind-Value="selectedItem">
                    <SelectedTemplate>
                        @context.Name
                    </SelectedTemplate>
                    <ResultTemplate>
                        @context.Name
                    </ResultTemplate>
                </BlazoredTypeahead>
            </label>

            @* Granting a hundred of something used to mean a hundred clicks. *@
            <label class="rf-field">
                <span class="rf-label">Amount</span>
                <input type="number" class="rf-input" min="1" @bind-value="addItemAmount" />
            </label>
            <div class="rf-actions">
                @foreach (var quick in new[] { 1, 10, 100, 1000 })
                {
                    <button type="button" class="rf-btn rf-btn--small" @onclick="() => addItemAmount = quick">@quick</button>
                }
            </div>

            @if (selectedItem != null)
            {
                <p class="rf-meta">Adds <b>@addItemAmount</b> @selectedItem.Name to <b>@Player.Name</b>.</p>
            }
            <div class="rf-modal__foot">
                <button type="button" class="rf-btn" @onclick="HideAddItem">Cancel</button>
                @if (selectedItem != null)
                {
                    <button type="button" class="rf-btn rf-btn--primary" @onclick="AddItem">Add</button>
                }
            </div>
        </div>
    </div>
}
@code {
    [Parameter]
    public WebsitePlayer Player { get; set; }

    [Parameter]
    public bool CanManage { get; set; }

    private IReadOnlyList<WebsitePlayer> characters { get; set; }
    private SessionInfo session;

    private bool itemDetailDialogVisible;
    private bool isTransmogrificationItemSelectorVisible;
    private bool vendorConfirmationDialogVisible;
    private bool vendorAllConfirmationDialogVisible;
    private bool canVendorMany;

    private IReadOnlyList<Models.InventoryItem> itemsToVendor;
    private Models.InventoryItem itemDetailsDialogItem;
    private Models.InventoryItem vendorItem;
    // private Guid? itemSkinId;
    private Item selectedSkin;
    private long vendorAmount;

    private long vendorAllSum;
    private long giftOrSendAmount;
    private long coins;
    List<long> quickButtons = new List<long>();

    private Item selectedItem;
    private int addItemAmount = 1;
    private bool addItemDialogVisible;
    private bool CanModify => session != null && session.Administrator;
    private ItemFilter itemFilter = ItemFilter.All;

    private string activeTab = "equipment";
    private string search = "";

    /// <summary>
    ///     The category filter narrowed by the search box. Kept separate from
    ///     <see cref="GetInventoryItems"/> so the bulk vendor actions keep operating on the whole
    ///     category, which is what their wording promises, rather than on whatever happens to be
    ///     typed in the search box at the time.
    /// </summary>
    private IReadOnlyList<Models.InventoryItem> VisibleItems
    {
        get
        {
            var items = GetInventoryItems();
            if (string.IsNullOrWhiteSpace(search))
                return items;

            var needle = search.Trim();
            return items.Where(x => (GetItemName(x) ?? "").Contains(needle, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
    }

    private void ClearFilters()
    {
        search = "";
        SelectItemFilter(ItemFilter.All);
    }

    /// <summary>Names of the equipment slots with nothing in them.</summary>
    private List<string> EmptySlotNames =>
        GetItemSlots()
            .Where(x => GetEquippedItemForSlot(x) == null)
            .Select(GetEquipmentSlotName)
            .ToList();

    /// <summary>
    ///     The grid is images only, so without this there is no way to tell what anything is
    ///     without opening it one at a time.
    /// </summary>
    private string TileTitle(Models.InventoryItem entry, Item item)
    {
        var name = GetItemName(entry);
        var parts = new List<string>();
        if (entry.Amount > 1) parts.Add(GetItemAmount(entry));
        if (item != null) parts.Add(ItemService.GetRarityName(item));
        if (!string.IsNullOrEmpty(entry.Enchantment)) parts.Add("enchanted");
        if (entry.Soulbound) parts.Add("soulbound");

        return parts.Count == 0 ? name : name + " (" + string.Join(", ", parts) + ")";
    }

    /// <summary>
    ///     Null when this character meets every requirement on the item, otherwise what is
    ///     missing. Magic requirements are satisfied by either magic or healing, which is what the
    ///     in game tooltip has always said.
    /// </summary>
    private string RequirementNote(Item item)
    {
        if (item == null || Player?.Skills == null)
            return null;

        var missing = new List<string>();
        if (item.RequiredAttackLevel > Player.Skills.AttackLevel) missing.Add("Attack " + item.RequiredAttackLevel);
        if (item.RequiredDefenseLevel > Player.Skills.DefenseLevel) missing.Add("Defense " + item.RequiredDefenseLevel);
        if (item.RequiredRangedLevel > Player.Skills.RangedLevel) missing.Add("Ranged " + item.RequiredRangedLevel);
        if (item.RequiredSlayerLevel > Player.Skills.SlayerLevel) missing.Add("Slayer " + item.RequiredSlayerLevel);

        var magic = Math.Max(Player.Skills.MagicLevel, Player.Skills.HealingLevel);
        if (item.RequiredMagicLevel > magic) missing.Add("Magic " + item.RequiredMagicLevel);

        return missing.Count == 0 ? null : "Needs " + string.Join(", ", missing) + ".";
    }

