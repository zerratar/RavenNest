    public void AddItem()
    {
        if (selectedItem == null)
            return;

        HideAddItem();

        // Refused adds come back null, and assigning that would empty the page rather than
        // leave it as it was.
        var updated = PlayerService.AddItem(Player.Id, selectedItem, addItemAmount);
        if (updated != null) Player = updated;
        selectedItem = null;
        addItemAmount = 1;
    }

