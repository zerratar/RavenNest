    /// <summary>
    ///     Everything the character or the account holds that could stand in for this item.
    /// </summary>
    /// <remarks>
    ///     The eligibility is what the old autocomplete applied, only now it decides the list
    ///     rather than filtering what was typed. An item has to be the same kind, cannot be the
    ///     item itself, cannot already be its skin, and enchanted items are excluded because the
    ///     enchantment would be destroyed with the item.
    /// </remarks>
    private IReadOnlyList<SkinCandidate> SkinCandidates(bool fromStash)
    {
        var result = new List<SkinCandidate>();
        if (itemDetailsDialogItem == null) return result;

        var currentItem = ItemService.GetItem(itemDetailsDialogItem.ItemId);
        if (currentItem == null) return result;

        bool Eligible(Item item) =>
            item != null
            && item.Id != currentItem.Id
            && itemDetailsDialogItem.TransmogrificationId != item.Id
            && ItemService.CanTransmogrify(item, currentItem);

        if (fromStash)
        {
            foreach (var stashItem in stashItems ?? (IReadOnlyList<UserBankItem>)new List<UserBankItem>())
            {
                if (!string.IsNullOrEmpty(stashItem.Enchantment)) continue;

                var item = ItemService.GetItem(stashItem.ItemId);
                if (!Eligible(item)) continue;

                result.Add(new SkinCandidate(item, stashItem.Amount, true, stashItem));
            }
        }
        else
        {
            foreach (var invItem in Player.InventoryItems)
            {
                if (!string.IsNullOrEmpty(invItem.Enchantment)) continue;

                var item = ItemService.GetItem(invItem.ItemId);
                if (!Eligible(item)) continue;

                result.Add(new SkinCandidate(item, invItem.Amount, false, null));
            }
        }

        // One row per item rather than one per stack, so a player holding four of something does
        // not see it four times.
        return result
            .GroupBy(x => x.Item.Id)
            .Select(g => g.First() with { Amount = g.Sum(x => x.Amount) })
            .OrderBy(x => x.Item.Name)
            .ToList();
    }

    private IReadOnlyList<SkinCandidate> VisibleSkinCandidates
    {
        get
        {
            var all = SkinCandidates(skinPickerStashTab);
            if (string.IsNullOrWhiteSpace(skinPickerSearch)) return all;

            var needle = skinPickerSearch.Trim();
            return all
                .Where(x => (x.Item.Name ?? "").Contains(needle, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

