@using RavenNest.Combat
@inject RavenNest.BusinessLogic.Game.BattlePetManager Pets
@inject RavenNest.BusinessLogic.Data.GameData GameData

@*
    The character's battle pets (the game's docs/battle-pets-design.md): loads the stable, the Taming level, the
    stable's places and the clan's Rookery level, and PetStable draws them (the pet that is out with its level, role,
    element, skills and next evolution, the resting pets and eggs, and the creatures there are to tame).
    Read only; chat changes pets (!pets, !tame).
*@
<PetStable Stable="stable" TamingLevel="taming" Places="places" RookeryLevel="rookery" ExtraSkillSlots="extraSlots" />

@code {
    [Parameter]
    public RavenNest.BusinessLogic.Extended.WebsitePlayer Player { get; set; }

    private RavenNest.Models.BattlePet[] stable = Array.Empty<RavenNest.Models.BattlePet>();
    private int taming = 1;
    private int places;
    private int rookery;
    private int extraSlots;

    protected override void OnParametersSet()
    {
        stable = Pets.Stable(Player.Id);
        var character = GameData.GetCharacter(Player.Id);
        var skills = character != null ? GameData.GetCharacterSkills(character.SkillsId) : null;
        taming = Math.Max(1, skills?.TamingLevel ?? 1);
        places = character != null ? Pets.StableSize(character) : BattlePets.StableSize(taming);
        rookery = character != null ? RookeryLevel(character.Id) : 0;
        // Trick Training (the Beastmaster tree): one more skill slot for the pets
        extraSlots = SkillBuild.Parse(GameData.GetCharacterSkillBuild(Player.Id)?.Build).ExtraPetSkillSlots;
    }

    /// <summary>The level of the clan's Rookery (cheaper evolutions, quicker eggs), or 0 without a clan.</summary>
    private int RookeryLevel(Guid characterId)
    {
        var membership = GameData.GetClanMembership(characterId);
        if (membership == null) return 0;
        var skill = GameData.GetSkills().FirstOrDefault(x => x.Name == Rookery.Name);
        if (skill == null) return 0;
        return GameData.GetClanSkills(membership.ClanId)?.FirstOrDefault(x => x.SkillId == skill.Id)?.Level ?? 0;
    }
}
