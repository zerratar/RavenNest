@layout DashboardLayout
@page "/dashboard"
@using RavenNest
@using RavenNest.Models
@using RavenNest.BusinessLogic.Extended
@using RavenNest.BusinessLogic.Game
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.PlayerService PlayerService
@inject RavenNest.Blazor.Services.BotService BotService
@inject NavigationManager NavigationManager

@*
    The front door. This page used to be the single line "Welcome back, name", which meant the
    dashboard opened on nothing and every visit started with a hunt through the sidebar.

    It now answers the three questions someone actually arrives with: how are my characters, is
    my stream working, and where do I go next.
*@

<header class="rf-page-head">
    <h1 class="rf-page-title">Welcome back, @(session?.UserName)</h1>
    <p class="rf-page-subtitle">
        Everything you can do outside the game, in one place.
    </p>
</header>

@if (players == null)
{
    <LoadIndicator></LoadIndicator>
}
else
{
    @*
        Stream state leads, but only when there is something to say. A viewer who never streams
        should not open their dashboard to a warning about a bot they do not use.
    *@
    @if (bot != null && bot.HasTwitchAccount && bot.NameMismatch)
    {
        <div class="rf-banner rf-banner--warn">
            <h2 class="rf-banner__title">Your Twitch name has changed</h2>
            <p>
                Ravenfall still knows you as <strong>@bot.AccountName</strong>, so the bot is
                joining the wrong channel.
                <NavLink href="/bot">See what to do</NavLink>.
            </p>
        </div>
    }
    else if (bot != null && bot.HasActiveGameSession)
    {
        <div class="rf-banner rf-banner--good">
            <h2 class="rf-banner__title">Your stream is live</h2>
            <p>
                @(bot.BotInChannel
                    ? "The bot is in your channel and viewers can use commands."
                    : "The bot has not joined your channel yet.")
                <NavLink href="/bot">Bot status</NavLink>.
            </p>
        </div>
    }

    <div class="rf-stats">
        <div class="rf-stat">
            <div class="rf-stat__value">@players.Count</div>
            <div class="rf-stat__label">Characters</div>
        </div>
        <div class="rf-stat">
            <div class="rf-stat__value">@HighestLevel</div>
            <div class="rf-stat__label">Highest combat</div>
        </div>
        <div class="rf-stat">
            <div class="rf-stat__value">@(bot != null && bot.HasActiveGameSession ? "Live" : "Idle")</div>
            <div class="rf-stat__label">Your stream</div>
        </div>
    </div>

    <section class="rf-panel">
        <h2 class="rf-panel__title">Your characters</h2>
        @if (players.Count == 0)
        {
            <p class="rf-meta">
                No characters yet. Type <strong>!join</strong> in any channel running Ravenfall
                and one will be created for you.
            </p>
        }
        else
        {
            <div class="rf-charpick" style="margin-bottom:0">
                @foreach (var p in players)
                {
                    <NavLink class="rf-char" href="@($"/character/{p.Id}")">
                        <span class="rf-char__name">@p.Name</span>
                        <span class="rf-char__level">@PlayerService.GetCombatLevel(p)</span>
                        <span class="rf-char__slot">
                            Slot @p.CharacterIndex@(p.Identifier != null ? $" · {p.Identifier}" : "")
                        </span>
                    </NavLink>
                }
            </div>
        }
    </section>

    @*
        Auto join spending. A player lost 17 million coins in 12 days to auto join on a stream that ran
        raids and dungeons back to back (2026-11) without seeing it go. This shows what it costs them, their
        patron perk (free auto joins a day and a discount on the rest) and a limit of their own (also
        !auto limit in chat). Status layout: AutoJoinSpending.Status.
    *@
    @if (autoJoin != null)
    {
        <section class="rf-panel">
            <h2 class="rf-panel__title">Auto join</h2>
            <p class="rf-meta">
                Joining raids and dungeons automatically (<span class="rf-cmd">!auto raid on</span>,
                <span class="rf-cmd">!auto dungeon on</span>) costs @PlayerManager.AutoJoinRaidCost.ToString("N0") coins per raid
                and @PlayerManager.AutoJoinDungeonCost.ToString("N0") per dungeon. All your characters pay from the same coins.
            </p>
            @if (IsAutoJoinPatron)
            {
                <p class="rf-meta">
                    As a patron you get <b>@autoJoin[5] raids</b> and <b>@autoJoin[6] dungeons</b> free every day (UTC),
                    and @autoJoin[7]% off the rest: @autoJoin[8].ToString("N0") per raid, @autoJoin[9].ToString("N0") per dungeon.
                </p>
            }
            else
            {
                <p class="rf-meta">
                    Patrons get free auto joins every day and a discount on the rest. <NavLink href="/patreon">See the tiers</NavLink>.
                </p>
            }
            <div class="rf-stats">
                <div class="rf-stat">
                    <div class="rf-stat__value">@autoJoin[0].ToString("N0")</div>
                    <div class="rf-stat__label">Paid today</div>
                </div>
                <div class="rf-stat">
                    <div class="rf-stat__value">@autoJoin[1].ToString("N0")</div>
                    <div class="rf-stat__label">Paid in the last 7 days</div>
                </div>
                @if (IsAutoJoinPatron)
                {
                    <div class="rf-stat">
                        <div class="rf-stat__value">@autoJoin[3] + @autoJoin[4]</div>
                        <div class="rf-stat__label">Free left today (raids + dungeons)</div>
                    </div>
                }
                <div class="rf-stat">
                    <div class="rf-stat__value">@(autoJoin[2] < 0 ? "None" : autoJoin[2].ToString("N0"))</div>
                    <div class="rf-stat__label">Your daily limit</div>
                </div>
            </div>
            <label class="rf-field">
                <span class="rf-label">Your own daily limit</span>
                <input class="rf-input" type="text" inputmode="numeric" placeholder="No limit, for example 50000 or 50k" @bind="limitText" />
            </label>
            <p class="rf-meta">
                Paid auto joins stop for the rest of the day when the next one would pass your limit. Leave it empty for no limit.
                In chat: <span class="rf-cmd">!auto limit 50k</span>, <span class="rf-cmd">!auto limit off</span>.
            </p>
            <div class="rf-actions">
                <button type="button" class="rf-btn rf-btn--primary" @onclick="SaveAutoJoinLimit">Save limit</button>
                @if (autoJoin[2] >= 0)
                {
                    <button type="button" class="rf-btn" @onclick="RemoveAutoJoinLimit">Remove limit</button>
                }
                @if (limitMessage != null)
                {
                    <span class="@(limitError ? "rf-form__error" : "rf-form__ok")">@limitMessage</span>
                }
            </div>
        </section>
    }

    @*
        Destinations rather than a link list. Each one says what it is for, because half of these
        are pages people never found.
    *@
    <section class="rf-panel">
        <h2 class="rf-panel__title">Where to go</h2>
        <div class="rf-cards">
            <NavLink class="rf-card" href="/stash">
                <span class="rf-card__title">Item Stash</span>
                <span class="rf-card__body">Everything not carried by a character, and what it is worth.</span>
            </NavLink>
            <NavLink class="rf-card" href="/clan">
                <span class="rf-card__title">Clan</span>
                <span class="rf-card__body">Members, roles and invites for the clan you belong to.</span>
            </NavLink>
            <NavLink class="rf-card" href="/marketplace">
                <span class="rf-card__title">Marketplace</span>
                <span class="rf-card__body">Buy and sell with other players without waiting for a stream.</span>
            </NavLink>
            <NavLink class="rf-card" href="/loyalty">
                <span class="rf-card__title">Loyalty</span>
                <span class="rf-card__body">Time spent in each streamer's channel, and the rewards it earns.</span>
            </NavLink>
        </div>
    </section>
}

@code {
    private RavenNest.Models.SessionInfo session;
    private IReadOnlyList<WebsitePlayer> players;
    private RavenNest.Blazor.Services.BotStatus bot;
    private long[] autoJoin;
    private string limitText;
    private string limitMessage;
    private bool limitError;
    private bool IsAutoJoinPatron => autoJoin != null && (autoJoin[5] > 0 || autoJoin[6] > 0 || autoJoin[7] > 0);

    private int HighestLevel => players == null || players.Count == 0
        ? 0
        : players.Max(p => PlayerService.GetCombatLevel(p));

    protected override async Task OnInitializedAsync()
    {
        session = AuthService.GetSession();
        if (session == null || !session.Authenticated)
        {
            return;
        }

        players = await PlayerService.GetMyPlayersAsync();
        bot = BotService.GetBotStatus();
        autoJoin = PlayerService.GetAutoJoinStatus();
        limitText = autoJoin != null && autoJoin[2] >= 0 ? autoJoin[2].ToString() : "";
    }

    private void SaveAutoJoinLimit()
    {
        if (string.IsNullOrWhiteSpace(limitText)) { RemoveAutoJoinLimit(); return; }
        if (!AutoJoinSpending.TryParseLimit(limitText, out var limit))
        {
            limitError = true;
            limitMessage = "Type an amount of coins, like 50000 or 50k.";
            return;
        }
        autoJoin = PlayerService.SetAutoJoinLimit(limit);
        limitText = limit?.ToString() ?? "";
        limitError = false;
        limitMessage = limit == null ? "Limit removed." : "Limit saved.";
    }

    private void RemoveAutoJoinLimit()
    {
        autoJoin = PlayerService.SetAutoJoinLimit(null);
        limitText = "";
        limitError = false;
        limitMessage = "Limit removed.";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (session == null || !session.Authenticated)
        {
            NavigationManager.NavigateTo("/login/redirect/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        }
    }
}
