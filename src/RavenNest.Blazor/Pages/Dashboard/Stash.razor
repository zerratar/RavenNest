@layout DashboardLayout
@page "/stash"
@page "/inventory"
@using RavenNest.Blazor.Components
@using RavenNest.Blazor.Services
@using RavenNest.BusinessLogic.Extended
@using RavenNest.BusinessLogic.Game
@using RavenNest.Models
@using Blazored.Typeahead
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.PlayerService PlayerService
@inject RavenNest.Blazor.Services.UserService UserService
@inject RavenNest.Blazor.Services.ItemService ItemService
@inject NavigationManager NavigationManager

<header class="rf-page-head">
    <h1 class="rf-page-title">Item stash</h1>
    <p class="rf-page-subtitle">
        Shared storage. Anything in here can be sent to any of your characters.
    </p>
</header>

@if (!session.Authenticated)
{
    <p class="rf-meta">You don't seem to be logged in.</p>
}
else if (stash == null)
{
    <LoadIndicator></LoadIndicator>
}
else
{
    @*
        A stash is worth something and nobody could see how much. The count and the vendor value
        are both sums of data the page already had loaded.
    *@
    <div class="rf-stats">
        <div class="rf-stat">
            <div class="rf-stat__value">@Utility.FormatAmount(TotalItemCount)</div>
            <div class="rf-stat__label">Items stored</div>
        </div>
        <div class="rf-stat">
            <div class="rf-stat__value">@stash.Count.ToString("N0")</div>
            <div class="rf-stat__label">Distinct items</div>
        </div>
        <div class="rf-stat">
            <div class="rf-stat__value" title="@TotalVendorValue.ToString("N0") coins">@Utility.FormatAmount(TotalVendorValue)</div>
            <div class="rf-stat__label">Vendor value</div>
        </div>
    </div>

    @*
        Search. A stash with a few hundred distinct items had no way to find one short of reading
        the whole table, which is the single most common thing anyone comes to this page to do.
    *@
    <div class="rf-toolbar">
        <input type="search"
               class="rf-input rf-search"
               placeholder="Search by name"
               aria-label="Search stash by item name"
               value="@search"
               @oninput="OnSearchChanged" />
        @if (!string.IsNullOrWhiteSpace(search) || itemFilter != ItemFilter.All)
        {
            <button type="button" class="rf-btn rf-btn--small" @onclick="ClearFilters">Clear filters</button>
        }
        <span class="rf-meta">Showing @stashFiltered.Count of @stash.Count</span>
    </div>

    @*
        Driven from a shared list rather than nineteen hand written blocks. Adding a category used
        to mean copying eight lines of markup here and eight more in PlayerInventory; it is now one
        entry in ItemFilterOptions.
    *@
    <div class="rf-filters" role="group" aria-label="Filter items by category">
        @foreach (var f in ItemFilterOptions.All)
        {
            <button type="button"
                    class="rf-filter @(itemFilter == f.Filter ? "is-active" : "")"
                    aria-pressed="@(itemFilter == f.Filter)"
                    @onclick="() => SelectItemFilter(f.Filter)">
                <i class="@f.Icon" aria-hidden="true"></i>
                <span>@f.Label</span>
            </button>
        }
    </div>

    @if (stashFiltered.Count == 0)
    {
        <div class="rf-panel">
            <p class="rf-meta">
                @if (stash.Count == 0)
                {
                    <span>Looks quite empty in here. Items you send from a character will show up on this page.</span>
                }
                else
                {
                    <span>Nothing matches that. Try a different category or clear the search.</span>
                }
            </p>
        </div>
    }
    else
    {
        <div class="rf-panel">
            <TableView>
                <table class="rf-table">
                    <thead>
                        <tr>
                            <th scope="col" aria-sort="@AriaSort("name")">
                                <button type="button" class="rf-th" @onclick="SortByName">Item @(Indicator("name"))</button>
                            </th>
                            <th scope="col" aria-sort="@AriaSort("stats")">
                                <button type="button" class="rf-th" @onclick="SortByStats">Stats @(Indicator("stats"))</button>
                            </th>
                            <th scope="col" aria-sort="@AriaSort("lev-req")">
                                <button type="button" class="rf-th" @onclick="SortByLevelReq">Requires @(Indicator("lev-req"))</button>
                            </th>
                            <th scope="col" aria-sort="@AriaSort("category")">
                                <button type="button" class="rf-th" @onclick="SortByCategory">Category @(Indicator("category"))</button>
                            </th>
                            <th scope="col" aria-sort="@AriaSort("material")">
                                <button type="button" class="rf-th" @onclick="SortByMaterial">Material @(Indicator("material"))</button>
                            </th>
                            <th scope="col"><span class="rf-th rf-th--static">Send</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in stashFiltered)
                        {
                            var item = itemLookup[entry.ItemId];
                            <tr>
                                <td data-label="">
                                    <div class="rf-item">
                                        <span class="rf-item__img">
                                            <img src="@(ItemService.GetItemImage(item.Id.ToString(), item.Name))" alt="" loading="lazy" />
                                            @if (entry.Amount > 1)
                                            {
                                                <span class="rf-item__amount">@Utility.FormatAmount(entry.Amount)</span>
                                            }
                                        </span>
                                        <span class="rf-item__body">
                                            @*
                                                The rarity tokens have existed since the design system was built and
                                                had nothing using them. This is what they were for: picking the good
                                                thing out of a long list without reading it.
                                            *@
                                            <span class="rf-item__name @ItemService.GetRarityClass(item)">@(entry.Name ?? item.Name)</span>
                                            <span class="rf-item__meta">
                                                @ItemService.GetTypeName(item)
                                                @if (!string.IsNullOrEmpty(entry.Enchantment))
                                                {
                                                    <span class="rf-item__mark" title="@entry.Enchantment"><i class="fa-solid fa-sparkles" aria-hidden="true"></i> Enchanted</span>
                                                }
                                                @if (entry.Soulbound)
                                                {
                                                    <span class="rf-item__mark" title="Cannot be traded"><i class="fa-solid fa-link" aria-hidden="true"></i> Soulbound</span>
                                                }
                                            </span>
                                        </span>
                                    </div>
                                </td>
                                <td data-label="Stats">
                                    <div class="rf-chips">
                                        @if (item.WeaponAim > 0)
                                        {
                                            <span class="rf-chip" title="Weapon aim, increases your hit rate in melee"><i class="fas fa-crosshairs" aria-hidden="true"></i>@item.WeaponAim</span>
                                        }
                                        @if (item.WeaponPower > 0)
                                        {
                                            <span class="rf-chip" title="Weapon power, increases your maximum damage in melee"><i class="fas fa-swords" aria-hidden="true"></i>@item.WeaponPower</span>
                                        }
                                        @if (item.RangedAim > 0)
                                        {
                                            <span class="rf-chip" title="Ranged aim, increases your ranged hit rate"><i class="fas fa-crosshairs" aria-hidden="true"></i>@item.RangedAim</span>
                                        }
                                        @if (item.RangedPower > 0)
                                        {
                                            <span class="rf-chip" title="Ranged power, increases your ranged maximum damage"><i class="fas fa-bow-arrow" aria-hidden="true"></i>@item.RangedPower</span>
                                        }
                                        @if (item.MagicAim > 0)
                                        {
                                            <span class="rf-chip" title="Magic aim, increases your magic hit rate"><i class="fas fa-wand" aria-hidden="true"></i>@item.MagicAim</span>
                                        }
                                        @if (item.MagicPower > 0)
                                        {
                                            <span class="rf-chip" title="Magic power, increases your magic maximum damage"><i class="fas fa-hand-holding-magic" aria-hidden="true"></i>@item.MagicPower</span>
                                        }
                                        @if (item.ArmorPower > 0)
                                        {
                                            <span class="rf-chip" title="Armour power, decreases the hit rate of your attacker"><i class="fas fa-shield" aria-hidden="true"></i>@item.ArmorPower</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="Requires">
                                    <div class="rf-chips">
                                        @if (item.RequiredSlayerLevel > 0)
                                        {
                                            <span class="rf-chip" title="Required slayer level"><i class="fas fa-skull" aria-hidden="true"></i>@item.RequiredSlayerLevel</span>
                                        }
                                        @if (item.RequiredAttackLevel > 0)
                                        {
                                            <span class="rf-chip" title="Required attack level"><i class="fas fa-swords" aria-hidden="true"></i>@item.RequiredAttackLevel</span>
                                        }
                                        @if (item.RequiredDefenseLevel > 0)
                                        {
                                            <span class="rf-chip" title="Required defense level"><i class="fas fa-shield" aria-hidden="true"></i>@item.RequiredDefenseLevel</span>
                                        }
                                        @if (item.RequiredMagicLevel > 0)
                                        {
                                            <span class="rf-chip" title="Required magic or healing level"><i class="fas fa-hand-holding-magic" aria-hidden="true"></i>@item.RequiredMagicLevel</span>
                                        }
                                        @if (item.RequiredRangedLevel > 0)
                                        {
                                            <span class="rf-chip" title="Required ranged level"><i class="fas fa-bow-arrow" aria-hidden="true"></i>@item.RequiredRangedLevel</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="Category" class="rf-table__quiet">@item.Category</td>
                                <td data-label="Material" class="rf-table__quiet">@ItemService.GetMaterialName(item)</td>
                                <td data-label="">
                                    @*
                                        One button rather than one per character. With five characters the old row
                                        ended in five buttons, which is most of the width of the table spent on the
                                        same word repeated.
                                    *@
                                    <button type="button" class="rf-btn rf-btn--small" @onclick="() => ShowSendToCharacter(entry)">
                                        Send <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </TableView>
        </div>
    }

    @if (sendToCharacterDialogVisible && itemToSend != null)
    {
        <div class="rf-modal-backdrop" @onclick="HideSendToCharacter">
            <div class="rf-modal rf-modal--wide" role="dialog" aria-modal="true" aria-label="Send @GetItemName(itemToSend)" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">Send @GetItemName(itemToSend)</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="HideSendToCharacter">&times;</button>
                </div>

                @*
                    Picking the character is the decision, so it happens here with the information
                    needed to make it. Whether a character can actually use the thing you are
                    sending was never shown anywhere, and it is a comparison of two numbers the
                    page already holds.
                *@
                <span class="rf-label">Send to</span>
                <div class="rf-charpick rf-charpick--compact">
                    @foreach (var plr in characters ?? Enumerable.Empty<WebsitePlayer>())
                    {
                        var note = RequirementNote(plr, ItemService.GetItem(itemToSend.ItemId));
                        <button type="button"
                                class="rf-char @(targetCharacter?.Id == plr.Id ? "is-active" : "")"
                                @onclick="() => SelectTarget(plr)">
                            <span class="rf-char__name">@plr.Name</span>
                            <span class="rf-char__level">@PlayerService.GetCombatLevel(plr)</span>
                            <span class="rf-char__slot">
                                @if (note == null)
                                {
                                    <span>Can use this</span>
                                }
                                else
                                {
                                    <span class="rf-char__warn">@note</span>
                                }
                            </span>
                        </button>
                    }
                </div>

                @if (canSendMany)
                {
                    <label class="rf-field">
                        <span class="rf-label">Amount</span>
                        <input type="number" class="rf-input" min="1" max="@itemToSend.Amount" @bind="amountToSend" />
                    </label>
                    <div class="rf-actions">
                        @foreach (var amount in quickButtons)
                        {
                            <button type="button" class="rf-btn rf-btn--small" @onclick="() => SetSendAmount(amount)">
                                @(amount == itemToSend.Amount ? $"All ({Utility.FormatAmount(amount)})" : Utility.FormatAmount(amount))
                            </button>
                        }
                    </div>
                }

                <p class="rf-meta">
                    @if (targetCharacter == null)
                    {
                        <span>Pick a character to send to.</span>
                    }
                    else
                    {
                        <span>Sending <b>@Utility.FormatAmount(amountToSend)</b> @GetItemName(itemToSend) to <b>@targetCharacter.Name</b>.</span>
                    }
                </p>

                <div class="rf-modal__foot">
                    <button type="button" class="rf-btn" @onclick="HideSendToCharacter">Cancel</button>
                    <button type="button" class="rf-btn rf-btn--primary" disabled="@(targetCharacter == null)" @onclick="SendItems">Send</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private SessionInfo session;
    private WebsiteAdminUser currentUser;
    private IReadOnlyList<RavenNest.Models.UserBankItem> stash;
    private IReadOnlyList<RavenNest.Models.UserBankItem> stashFiltered;
    private Dictionary<Guid, RavenNest.Models.Item> itemLookup;

    private IReadOnlyList<WebsitePlayer> characters { get; set; }

    private string sort = "name";
    private BusinessLogic.Game.SortDirection sortDirection;
    private ItemFilter itemFilter = ItemFilter.All;
    private string search = "";

    private RavenNest.Models.UserBankItem itemToSend;
    private WebsitePlayer targetCharacter;

    private bool sendToCharacterDialogVisible;
    private bool canSendMany;
    private long amountToSend;

    private List<long> quickButtons = new();

    private long TotalItemCount => stash?.Sum(x => x.Amount) ?? 0;

    private long TotalVendorValue =>
        stash == null || itemLookup == null
            ? 0
            : stash.Sum(x => itemLookup.TryGetValue(x.ItemId, out var i) ? i.ShopSellPrice * x.Amount : 0);

    /// <summary>
    ///     Null when the character meets every requirement, otherwise what is missing. The magic
    ///     requirement is satisfied by either magic or healing, which is what the in game tooltip
    ///     has always said.
    /// </summary>
    private string RequirementNote(WebsitePlayer player, RavenNest.Models.Item item)
    {
        if (player?.Skills == null || item == null)
            return null;

        var missing = new List<string>();
        if (item.RequiredAttackLevel > player.Skills.AttackLevel) missing.Add("Attack " + item.RequiredAttackLevel);
        if (item.RequiredDefenseLevel > player.Skills.DefenseLevel) missing.Add("Defense " + item.RequiredDefenseLevel);
        if (item.RequiredRangedLevel > player.Skills.RangedLevel) missing.Add("Ranged " + item.RequiredRangedLevel);
        if (item.RequiredSlayerLevel > player.Skills.SlayerLevel) missing.Add("Slayer " + item.RequiredSlayerLevel);

        var magic = Math.Max(player.Skills.MagicLevel, player.Skills.HealingLevel);
        if (item.RequiredMagicLevel > magic) missing.Add("Magic " + item.RequiredMagicLevel);

        return missing.Count == 0 ? null : "Needs " + string.Join(", ", missing);
    }

    private void UpdateQuickButtons()
    {
        quickButtons.Clear();
        if (itemToSend == null)
        {
            return;
        }

        var maxAmount = itemToSend.Amount;
        if (maxAmount == 1)
        {
            return;
        }

        if (maxAmount > 1000)
        {
            quickButtons.Add(1000);
            if (maxAmount > 10000) quickButtons.Add(10000);
            if (maxAmount > 50000) quickButtons.Add(50000);
            if (maxAmount > 100000) quickButtons.Add(100000);
        }
        else
        {
            if (maxAmount > 1) quickButtons.Add(1);
            if (maxAmount > 2) quickButtons.Add(2);
            if (maxAmount > 5) quickButtons.Add(5);
            if (maxAmount > 10) quickButtons.Add(10);
        }

        if (maxAmount > 0)
        {
            quickButtons.Add(maxAmount); // Add the "All" button
        }
    }

    protected override async Task OnInitializedAsync()
    {
        session = AuthService.GetSession();
        characters = await PlayerService.GetMyPlayersAsync();

        if (session == null || !session.Authenticated)
        {
            return;
        }

        UpdateStashItems();
    }

    private void SelectItemFilter(ItemFilter newItemFilter)
    {
        itemFilter = newItemFilter;
        ApplyFilters();
        InvokeAsync(StateHasChanged);
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ClearFilters()
    {
        search = "";
        itemFilter = ItemFilter.All;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        stashFiltered = stash.Where(Filter).ToList();
    }

    private bool Filter(UserBankItem entry)
    {
        if (itemFilter != ItemFilter.All && ItemService.GetItemFilter(entry.ItemId) != itemFilter)
            return false;

        if (string.IsNullOrWhiteSpace(search))
            return true;

        var name = entry.Name ?? (itemLookup != null && itemLookup.TryGetValue(entry.ItemId, out var i) ? i.Name : null);
        return name != null && name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    public void ShowSendToCharacter(RavenNest.Models.UserBankItem item)
    {
        sendToCharacterDialogVisible = true;
        canSendMany = item.Amount > 1;
        itemToSend = item;
        amountToSend = item.Amount;
        // Preselect when there is only one character, because then there is no decision to make.
        targetCharacter = characters != null && characters.Count == 1 ? characters[0] : null;
        UpdateQuickButtons();
    }

    private void SelectTarget(WebsitePlayer player)
    {
        targetCharacter = player;
    }

    public string GetItemName(RavenNest.Models.UserBankItem i)
    {
        if (i == null) return null;
        return i.Name ?? ItemService.GetItem(i.ItemId)?.Name;
    }

    public void SetSendAmount(long amount)
    {
        amountToSend = amount;
    }

    public void SendItems()
    {
        if (targetCharacter == null)
        {
            return;
        }

        if (!PlayerService.SendToCharacter(targetCharacter.Id, itemToSend, amountToSend))
        {
            return;
        }

        sendToCharacterDialogVisible = false;

        UpdateStashItems();
        InvokeAsync(StateHasChanged);
    }

    public void HideSendToCharacter()
    {
        sendToCharacterDialogVisible = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (session == null || !session.Authenticated)
        {
            NavigationManager.NavigateTo("/login/redirect/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        }
    }

    private void UpdateStashItems()
    {
        if (session != null)
        {
            currentUser = UserService.GetCurrentUser();
        }

        if (currentUser != null)
        {
            this.stash = currentUser.Stash;
            if (stash != null)
            {
                this.itemLookup = stash.Select(x => x.ItemId).Distinct().Select(ItemService.GetItem).ToDictionary(x => x.Id, x => x);
            }
        }

        if (stash == null)
        {
            stash = new List<RavenNest.Models.UserBankItem>();
        }

        ApplyFilters();
    }

    private MarkupString Indicator(string value)
    {
        if (value != sort)
        {
            return (MarkupString)"";
        }

        return (MarkupString)(sortDirection == BusinessLogic.Game.SortDirection.Ascending ? "&uarr;" : "&darr;");
    }

    private string AriaSort(string value)
    {
        if (value != sort) return "none";
        return sortDirection == BusinessLogic.Game.SortDirection.Ascending ? "ascending" : "descending";
    }

    private async void SortByName()
    {
        SetSorting("name");
        await SortBy((b, x) => b.Name ?? x.Name);
    }

    private async void SortByLevelReq()
    {
        SetSorting("lev-req");
        await SortBy((b, x) => (x.RequiredAttackLevel + x.RequiredDefenseLevel + x.RequiredMagicLevel + x.RequiredRangedLevel + x.RequiredSlayerLevel));
    }

    private async void SortByCategory()
    {
        SetSorting("category");
        await SortBy((b, x) => (int)x.Category);
    }

    private async void SortByMaterial()
    {
        SetSorting("material");
        await SortBy((b, x) => ItemService.GetMaterialIndex(x));
    }

    private async void SortByStats()
    {
        SetSorting("stats");

        // NOTE: Not sorted by enchantment bonus yet.
        await SortBy((b, x) => (x.ArmorPower + x.MagicPower + x.RangedPower + x.WeaponPower + x.MagicAim + x.RangedAim + x.WeaponAim));
    }

    private async Task SortBy<T>(Func<UserBankItem, Models.Item, T> sort)
    {
        try
        {
            await Task.Run(() =>
            {
                if (sortDirection == BusinessLogic.Game.SortDirection.Descending)
                {
                    stashFiltered = stashFiltered.OrderByDescending(x => sort(x, ItemService.GetItem(x.ItemId))).ToList();
                    return;
                }
                stashFiltered = stashFiltered.OrderBy(x => sort(x, ItemService.GetItem(x.ItemId))).ToList();
            });
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void SetSorting(string value)
    {
        if (sort != value)
        {
            sortDirection = BusinessLogic.Game.SortDirection.Ascending;
        }
        else
        {
            sortDirection = (BusinessLogic.Game.SortDirection)(((int)sortDirection + 1) % Enum.GetValues(typeof(BusinessLogic.Game.SortDirection)).Length);
        }
        sort = value;
    }
}
