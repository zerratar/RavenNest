@layout DashboardLayout
@page "/patreon"
@page "/patreon/link"
@using RavenNest.Blazor.Services.Models
@using Microsoft.AspNetCore.WebUtilities
@using RavenNest.BusinessLogic.Extensions
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.PatreonService PatreonService

<header class="rf-page-head">
    <h1 class="rf-page-title">Patreon</h1>
    <p class="rf-page-subtitle">
        Your pledge tier and what it unlocks in game.
    </p>
</header>

@if (!session.Authenticated)
{
    <p class="rf-meta">You don't seem to be logged in.</p>
}
else
{
    @if (!linkedToPatreon)
    {
        <div class="rf-panel rf-panel--accent">
            <h2 class="rf-panel__title">Patreon is not linked</h2>
            <p class="rf-meta">
                Linking your Patreon account is what tells Ravenfall which tier you are on. Rewards
                are applied automatically once it is linked.
            </p>
            <button type="button" class="rf-btn rf-btn--primary" @onclick="LoginToPatreon">
                <i class="fab fa-patreon" aria-hidden="true"></i> Link Patreon
            </button>
        </div>
    }

    @if (patreonTierIndex > 0 || linkedToPatreon)
    {
        <section class="rf-panel">
            <div class="rf-patron">
                <img class="rf-patron__avatar" src="@patreonProfilePicture" alt="" />
                <div class="rf-patron__id">
                    <h2 class="rf-patron__name">@patreonFullName</h2>
                    @if (!string.IsNullOrEmpty(patreonTitle))
                    {
                        <p class="rf-patron__tier">@patreonTitle</p>
                    }
                </div>
                @if (patreonTierIndex > 0)
                {
                    <span class="rf-badge rf-badge--gold">Tier @patreonTierIndex</span>
                }
            </div>

            @if (patreonTierIndex == 0)
            {
                <p class="rf-meta">
                    You are not showing as a patron. If you already pledged, unlink and connect with
                    Patreon again, which refreshes the tier.
                </p>
                <div class="rf-actions">
                    <a class="rf-btn rf-btn--primary" href="https://www.patreon.com/ravenfall" target="_blank">Visit the Patreon page</a>
                </div>
            }
            else
            {
                @*
                    Was a bullet list with a class per reward and no indication of what any of them
                    do. Same conditions, but each one now says what it changes.
                *@
                <h3 class="rf-panel__title rf-patron__heading">What your tier unlocks</h3>
                <ul class="rf-perks">
                    <li class="rf-perk">
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        <span><b>Clans.</b> You can found a clan and invite characters to it.</span>
                    </li>
                    @*
                        Read from PatreonTiers rather than written out per tier here. The hand
                        written version had drifted from what the game grants: it listed no
                        experience perk at all for Rune, which gets 3x, and listed Dragon as 3x
                        when it gets 5x. Both pages that describe tiers now read the same list.

                        House counts are a floor rather than a bonus: the tier guarantees that many
                        plots however low the town level, and a town that has levelled past them
                        keeps what it earned, which is why it says "at least".
                    *@
                    @if (CurrentTier != null)
                    {
                        <li class="rf-perk">
                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                            <span><b>@CurrentTier.ExpMultiplier&times; experience</b> for your characters.</span>
                        </li>

                        @if (CurrentTier.VillageHouses > 0)
                        {
                            <li class="rf-perk">
                                <i class="fa-solid fa-check" aria-hidden="true"></i>
                                <span>
                                    <b>At least @CurrentTier.VillageHouses town plots</b>, whatever
                                    your town level.
                                    @if (CurrentTier.VillageHouses < MaxVillageHouses)
                                    {
                                        <span>
                                            The last @(MaxVillageHouses - CurrentTier.VillageHouses)
                                            are earned by levelling your town, one every ten levels
                                            up to @GameMath.MaxVillageLevel.
                                        </span>
                                    }
                                </span>
                            </li>
                        }
                    }
                    @if (patreonTierIndex >= 1)
                    {
                        <li class="rf-perk">
                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                            <span><b>2x village experience</b>, which levels your village faster.</span>
                        </li>
                    }
                    @if (patreonTierIndex >= 3)
                    {
                        <li class="rf-perk">
                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                            <span>
                                <b>AI chatbot</b> features on the official bot, set up on your
                                <a href="/bot">Bot page</a>.
                            </span>
                        </li>
                    }
                </ul>
            }

            @if (linkedToPatreon)
            {
                <div class="rf-patron__unlink">
                    @if (confirmingUnlink)
                    {
                        <p class="rf-meta">Unlink Patreon? Your rewards stay; only the stored tokens are removed.</p>
                        <div class="rf-actions">
                            <button type="button" class="rf-btn rf-btn--small rf-btn--danger" @onclick="RemovePatreonLink">Yes, unlink</button>
                            <button type="button" class="rf-btn rf-btn--small" @onclick="() => confirmingUnlink = false">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="rf-btn rf-btn--small" @onclick="() => confirmingUnlink = true">
                            <i class="fab fa-patreon" aria-hidden="true"></i> Unlink Patreon
                        </button>
                    }
                </div>
            }
        </section>
    }

    @*
        The chatbot controls used to sit here. They configure the official bot, so they moved to the
        Bot page: this page is for seeing what you are paying for, not for operating it.
    *@
}

@code {
    private RavenNest.Models.SessionInfo session;
    private bool patreonLinkInitiated;

    private bool IsLinkingPatreon => NavigationManager.Uri.Contains("patreon/link", StringComparison.OrdinalIgnoreCase);

    private bool linkedToPatreon;
    private string patreonFullName;
    private string patreonTitle;
    private string patreonProfilePicture;
    private int patreonTierIndex;
    private bool reloadAfterRender;
    private bool confirmingUnlink;

    /// <summary>
    ///     The most plots a town can hold: one per ten town levels, up to the maximum town level.
    ///     Derived rather than written into the copy, because the copy having a number of its own
    ///     is how this page came to claim the top tier unlocked all of them when it grants 30.
    ///     GetOrCreateVillageHouses works it out the same way.
    /// </summary>
    private static int MaxVillageHouses => GameMath.MaxVillageLevel / 10;

    /// <summary>
    ///     What this account's tier grants, from the shared list rather than from copy written
    ///     out per tier on this page, which had drifted from what the game actually gives.
    /// </summary>
    private PatreonTierInfo CurrentTier => PatreonTiers.Get(patreonTierIndex);

    protected override async Task OnInitializedAsync()
    {
        session = AuthService.GetSession();

        // Shared with the Bot page, which gates the chatbot controls on it, so the tier this page
        // lists perks against and the tier that grants them cannot disagree.
        patreonTierIndex = PatreonService.GetEffectiveTier();
        patreonFullName = session.UserName;
        patreonProfilePicture = "/api/twitch/logo/" + session.TwitchUserId;
        if (session.Patreon != null)
        {
            patreonTitle = session.Patreon.PledgeTitle;
            patreonProfilePicture = session.Patreon.ProfilePicture;
            patreonFullName = session.Patreon.FullName;
            linkedToPatreon = true;
        }

        if (string.IsNullOrEmpty(patreonTitle) && patreonTierIndex > 0)
        {
            patreonTitle = await GetPatreonTitleByTierAsync(patreonTierIndex);
        }

        await HandlePatreonToken();
    }

    private async Task HandlePatreonToken()
    {
        reloadAfterRender = false;

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var queryString = uri.Query;
        if (string.IsNullOrEmpty(queryString))
        {
            return;
        }

        var atn = "code";
        queryString = queryString.Substring(1);
        var parsedQuery = System.Web.HttpUtility.ParseQueryString(queryString);

        var code = parsedQuery.Get(atn);
        var error = parsedQuery.Get("error");
        var state = parsedQuery.Get("state");
        var error_description = parsedQuery.Get("error_description");

        if (!string.IsNullOrEmpty(code))
        {
            var result = await PatreonService.LinkAsync(code);
            if (result != null)
            {
                session.Patreon = ModelMapper.Map(result);
            }
        }

        reloadAfterRender = true;
    }


    private async Task<string> GetPatreonTitleByTierAsync(int tierLevel)
    {
        var tier = await PatreonService.GetPatreonTierAsync(tierLevel);
        if (tier != null)
        {
            return tier.Title;
        }

        return "???";
    }

    private async Task RemovePatreonLink()
    {
        await PatreonService.UnlinkAsync();
        session.Patreon = null;
        linkedToPatreon = false;
        await InvokeAsync(StateHasChanged);
    }

    private void LoginToPatreon()
    {
        patreonLinkInitiated = true;
        var url = PatreonService.GetPatreonLoginUrl();
        if (!string.IsNullOrEmpty(url))
        {
            NavigationManager.NavigateTo(url, true);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (reloadAfterRender)
        {
            NavigationManager.NavigateTo("/patreon");
            return;
        }
        if (session == null || !session.Authenticated)
        {
            NavigationManager.NavigateTo("/login/redirect/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        }
    }

    private bool HasQueryParams()
    {
        string fragment = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Fragment;
        if (!string.IsNullOrEmpty(fragment))
            return fragment.Substring(0, 1).Contains("?") || fragment.Substring(0, 1).Contains("#");

        return false;
    }
}
