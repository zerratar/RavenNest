@layout DashboardLayout
@page "/clan"
@page "/clan/ranks"
@using RavenNest.Blazor.Components
@using RavenNest.Blazor.Services
@using RavenNest.BusinessLogic
@using RavenNest.BusinessLogic.Game
@inject RavenNest.Blazor.Services.ClanService ClanService
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.LogoService LogoService
@inject NavigationManager NavigationManager

<header class="rf-page-head">
    <h1 class="rf-page-title">Clan</h1>
    <p class="rf-page-subtitle">
        Your clan's level, its skills, and everyone in it.
    </p>
</header>

@if (!session.Authenticated)
{
    <p class="rf-meta">You don't seem to be logged in.</p>
}
else if (clan == null)
{
    @if (session.Tier == 0 && !session.Administrator && !session.Moderator)
    {
        <div class="rf-banner rf-banner--warn">
            <h2 class="rf-banner__title">You cannot create a clan yet</h2>
            <p>
                Founding a clan needs at least the Mithril tier on
                <a href="https://www.patreon.com/ravenfall" target="_blank">Patreon</a>.
                You can still join one: ask a clan owner to invite your character, and the invite
                will show up on your <a href="/clan-invites">invites page</a>.
            </p>
        </div>
    }
    else
    {
        <div class="rf-panel rf-panel--accent">
            <h2 class="rf-panel__title">Create a clan</h2>
            <p class="rf-meta">
                Clan members share clan skills and a clan level that everyone's play contributes to.
                Names can be changed twice for free afterwards.
            </p>
            <EditForm Model="@createClan" OnValidSubmit="@HandleCreateClan">
                <DataAnnotationsValidator />
                <label class="rf-field">
                    <span class="rf-label">Clan name</span>
                    <InputText id="name" class="rf-input" placeholder="Clan name" @bind-Value="createClan.Name" />
                </label>
                <ValidationSummary />
                @if (!string.IsNullOrEmpty(clanError))
                {
                    <p class="rf-form__error">@clanError</p>
                }
                <button type="submit" class="rf-btn rf-btn--primary">Create clan</button>
            </EditForm>
        </div>
    }
}
else
{
    <div class="rf-clan">
        @if (!string.IsNullOrEmpty(clan.Logo))
        {
            <img src="@clan.Logo" class="rf-clan__logo" alt="@clan.Name" />
        }
        else
        {
            <img src="/api/twitch/logo/@clan.OwnerUserId" class="rf-clan__logo" alt="@clan.Name" />
        }

        <div class="rf-clan__id">
            @if (editingClanName)
            {
                <div class="rf-actions">
                    <input type="text" class="rf-input" placeholder="Enter a new clan name" aria-label="Clan name" @bind-value="clan.Name" />
                    <button type="button" class="rf-btn rf-btn--small rf-btn--primary" @onclick="UpdateAlias">Save</button>
                    <button type="button" class="rf-btn rf-btn--small" @onclick="CancelEditAlias">Cancel</button>
                </div>
                @if (nameChangeCount < 2)
                {
                    <p class="rf-meta"><b>@(2 - nameChangeCount)</b> free name changes left.</p>
                }
                @if (!string.IsNullOrEmpty(clanError))
                {
                    <p class="rf-form__error">@clanError</p>
                }
            }
            else
            {
                <h2 class="rf-clan__name">
                    @clan.Name
                    @if (canRenameClan)
                    {
                        <button type="button" class="rf-iconbtn" title="Change clan name" @onclick="EditClanName">
                            <i class="fas fa-pen" aria-hidden="true"></i>
                        </button>
                    }
                </h2>
                <p class="rf-clan__level">Clan level <b>@clan.Level</b></p>
                @if (!string.IsNullOrEmpty(changeNameSuccess))
                {
                    <p class="rf-form__ok">@changeNameSuccess</p>
                }
            }
        </div>

        @if (canManageMembers)
        {
            <button type="button" class="rf-btn rf-btn--small" title="Refresh the clan logo from Twitch" disabled="@reloadingClanLogo" @onclick="ReloadClanLogo">
                <i class="fas fa-sync" aria-hidden="true"></i> @(reloadingClanLogo ? "Refreshing" : "Refresh logo")
            </button>
        }
    </div>

    @*
        Clan progress and clan skills were both on the wire and rendered nowhere on this page. The
        character's clan tab already shows them, which made the management page the less informative
        of the two views of the same clan.
    *@
    <section class="rf-panel">
        <h3 class="rf-panel__title">Clan progress</h3>
        <div class="rf-next">
            <div class="rf-next__head">
                <span class="rf-label">Next clan level</span>
                <span class="rf-next__skill">Level <b>@(clan.Level + 1)</b></span>
            </div>
            <div class="rf-skill__bar rf-next__bar">
                <span class="rf-skill__fill" style="@Bar(ClanLevelProgress)"></span>
            </div>
            <div class="rf-next__foot">
                <span>@Utility.FormatExp(ClanExpToNextLevel) exp to go</span>
                <span class="rf-meta">@Math.Round(ClanLevelProgress * 100, 1)% of the way</span>
            </div>
        </div>
    </section>

    @if (ClanSkills.Count > 0)
    {
        <section class="rf-panel">
            <h3 class="rf-panel__title">Clan skills</h3>
            <ul class="rf-skills__list">
                @foreach (var skill in ClanSkills)
                {
                    <li class="rf-skill">
                        <span class="rf-skill__name">@skill.Name</span>
                        <span class="rf-skill__bar" title="@ClanSkillTitle(skill)">
                            <span class="rf-skill__fill" style="@Bar(SkillProgressOf(skill))"></span>
                        </span>
                        <span class="rf-skill__next" title="@ClanSkillTitle(skill)">
                            @if (skill.MaxLevel > 0 && skill.Level >= skill.MaxLevel)
                            {
                                <span class="rf-skill__max">Max</span>
                            }
                            else
                            {
                                @Utility.FormatExp(Math.Max(0, GameMath.ExperienceForLevel(skill.Level + 1) - skill.Experience))
                                <span class="rf-skill__next-to">to @(skill.Level + 1)</span>
                            }
                        </span>
                        <span class="rf-skill__level">
                            @skill.Level@if (skill.MaxLevel > 0)
                            {
                                <span class="rf-skill__level-max"> / @skill.MaxLevel</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="rf-panel">
        <div class="rf-tabs" role="tablist">
            <button type="button" role="tab" aria-selected="@(!showRanks)" class="rf-tab @(!showRanks ? "is-active" : "")" @onclick="ShowMembers">Members</button>
            <button type="button" role="tab" aria-selected="@showRanks" class="rf-tab @(showRanks ? "is-active" : "")" @onclick="ShowRanks">Ranks</button>
        </div>

        @if (showRanks)
        {
            <ClanRoleList ClanId="@clan.Id" CanManage="@canEditRanks"></ClanRoleList>
        }
        else
        {
            <ClanMemberList ClanId="@clan.Id" CanManage="@canManageMembers"></ClanMemberList>
        }
    </section>

    @if (showGetMoreNameChanges)
    {
        <div class="rf-modal-backdrop" @onclick="CloseNameChangeInfo">
            <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Name change unavailable" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">No free name changes left</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CloseNameChangeInfo">&times;</button>
                </div>
                <p class="rf-meta">
                    You have used both free clan name changes. Contact Ravenfall staff on Discord if
                    you need another.
                </p>
                <div class="rf-modal__foot">
                    <button type="button" class="rf-btn" @onclick="CloseNameChangeInfo">Close</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private const string ClanAlreadyExists = "A clan with the same name already exists.";
    private bool canChangeClanName;
    private RavenNest.Models.SessionInfo session;
    private RavenNest.Models.Clan clan;
    private string oldClanName;
    private int nameChangeCount;
    private bool reloadingClanLogo;
    private bool canManageMembers;
    private bool canEditRanks;
    private bool canRenameClan;
    private RavenNest.BusinessLogic.Game.TypedClanRolePermissions myPermissions;
    private bool editingClanName;
    private bool showRanks;
    private bool showGetMoreNameChanges;
    private string clanError;
    private string changeNameSuccess;

    private CreateClanModel createClan = new CreateClanModel();

    private IReadOnlyList<RavenNest.Models.ClanSkill> ClanSkills =>
        clan?.ClanSkills?.Where(x => x != null).ToList()
        ?? (IReadOnlyList<RavenNest.Models.ClanSkill>)Array.Empty<RavenNest.Models.ClanSkill>();

    // Clan experience counts progress within the current clan level, the same way a character
    // skill does, so the next level is what it is measured against.
    private double ClanLevelProgress
    {
        get
        {
            if (clan == null) return 0;
            var forNext = GameMath.ExperienceForLevel(clan.Level + 1);
            if (forNext <= 0) return 0;
            return Math.Clamp(clan.Experience / forNext, 0d, 1d);
        }
    }

    private double ClanExpToNextLevel =>
        clan == null ? 0 : Math.Max(0, GameMath.ExperienceForLevel(clan.Level + 1) - clan.Experience);

    private static double SkillProgressOf(RavenNest.Models.ClanSkill skill)
    {
        var forNext = GameMath.ExperienceForLevel(skill.Level + 1);
        if (forNext <= 0) return 0;
        return Math.Clamp(skill.Experience / forNext, 0d, 1d);
    }

    private string Bar(double progress)
    {
        var clamped = Math.Clamp(progress * 100d, 0d, 100d);
        return "width: " + clamped.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private string ClanSkillTitle(RavenNest.Models.ClanSkill skill)
    {
        var forNext = GameMath.ExperienceForLevel(skill.Level + 1);
        return $"{Math.Round(skill.Experience).ToString("N0")} of {Math.Round(forNext).ToString("N0")} exp toward level {skill.Level + 1}";
    }

    private void CloseNameChangeInfo()
    {
        showGetMoreNameChanges = false;
        InvokeAsync(StateHasChanged);
    }

    private void EditClanName()
    {
        if (!canChangeClanName)
        {
            showGetMoreNameChanges = true;
            return;
        }

        oldClanName = clan.Name;
        editingClanName = true;
    }

    private void CancelEditAlias()
    {
        if (!canChangeClanName)
            return;

        clan.Name = oldClanName;
        editingClanName = false;
    }

    private async void ReloadClanLogo()
    {
        reloadingClanLogo = true;
        await InvokeAsync(StateHasChanged);

        if (this.clan != null)
        {
            await LogoService.UpdateClanLogoAsync(this.clan.OwnerUserId);
            reloadingClanLogo = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateAlias()
    {
        if (!canChangeClanName)
            return;

        changeNameSuccess = "";
        clanError = "";

        if (string.IsNullOrEmpty(clan.Name))
        {
            clanError = "Clan name cannot be empty";
            return;
        }

        if (clan.Name.Length > 40)
        {
            clanError = "Clan name is too long. It cannot exceed 40 characters.";
            return;
        }

        if (ClanService.UpdateClanName(clan.Id, clan.Name))
        {
            editingClanName = false;
            changeNameSuccess = "Name updated. You may need to !leave and !join in game for it to take effect.";
            canChangeClanName = ClanService.CanChangeClanName(clan.Id);
            nameChangeCount = ClanService.GetNameChangeCount(clan.Id);
        }
        else
        {
            clanError = ClanAlreadyExists;
        }
        InvokeAsync(StateHasChanged);
    }

    private void ShowMembers()
    {
        showRanks = false;
    }
    private void ShowRanks()
    {
        showRanks = true;
    }

    protected override void OnInitialized()
    {
        showRanks = NavigationManager.Uri.ToString().IndexOf("ranks", StringComparison.OrdinalIgnoreCase) > 0;
        session = AuthService.GetSession();
        if (session == null || session.UserName == null)
        {
            return;
        }

        canChangeClanName = session.CanChangeClanName;

        // Members who did not found their clan used to be shown the create a clan form.
        clan = ClanService.GetMyClan();
        if (clan != null)
        {
            // Was "are you the founder". The clan role permissions have existed in ClanManager all
            // along and the site simply never read them, so every rank below owner was decoration.
            myPermissions = ClanService.GetMyPermissions(clan.Id);
            canManageMembers = myPermissions != null && (myPermissions.CanCreateInvite || myPermissions.CanKickMembers || myPermissions.CanAssignRoles);
            canEditRanks = myPermissions != null && myPermissions.CanRenameClanRole;
            canRenameClan = myPermissions != null && myPermissions.CanRenameClan;
            nameChangeCount = ClanService.GetNameChangeCount(clan.Id);
            oldClanName = clan.Name;
        }
    }

    private void HandleCreateClan()
    {
        clan = ClanService.CreateClan(createClan);
        if (clan == null)
        {
            clanError = ClanAlreadyExists;
            return;
        }
        myPermissions = ClanService.GetMyPermissions(clan.Id);
        canManageMembers = true;
        canEditRanks = true;
        canRenameClan = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (session == null || !session.Authenticated)
        {
            NavigationManager.NavigateTo("/login/redirect/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        }
    }
}
