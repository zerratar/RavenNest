@layout DashboardLayout
@page "/boats"
@using RavenNest.Blazor.Services
@using RavenNest.Models
@inject AuthService AuthService
@inject BoatService BoatService
@inject NavigationManager NavigationManager

@* The signed in player's boats; the page itself is the BoatDesigner component. *@

<BoatDesigner Boats="boats" SetLook="Save" SetEquipped="Equip" Clan="b => BoatService.ClanOf(b.CharacterId)" />

@code {
    private RavenNest.Models.SessionInfo session;
    private IReadOnlyList<BoatLookResult> boats;

    protected override void OnInitialized()
    {
        session = AuthService.GetSession();
        if (session == null || !session.Authenticated) return;
        boats = BoatService.GetBoats() ?? new List<BoatLookResult>();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && (session == null || !session.Authenticated))
        {
            NavigationManager.NavigateTo("/login/redirect/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        }
    }

    private BoatLookResult Save(BoatLookResult boat, string slot, int variant) =>
        BoatService.SetLook(boat.CharacterId, boat.InventoryItemId, slot, variant);

    private string Equip(BoatLookResult boat, bool equip) =>
        BoatService.SetEquipped(boat.CharacterId, boat.InventoryItemId, equip);
}
