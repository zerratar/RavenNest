@layout DashboardLayout
@page "/quests"
@using RavenNest.Blazor.Services
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.QuestPageService QuestPageService
@inject NavigationManager NavigationManager

@*
    Quests (the game's docs/quests-design.md) as the website shows them: where each character stands, read only.
    Quests are taken, handed in and given up in chat, so every card that can be acted on names the command.
    New players get a short guide at the top, folded once they have done a few dailies.
*@

<header class="rf-page-head">
    <h1 class="rf-page-title">Quests</h1>
    <p class="rf-page-subtitle">
        Your characters' quests, quest chains and achievements, and the quests of the stream they play in.
        Quests are taken in chat; this page shows where you stand.
    </p>
</header>

@if (loading)
{
    <p class="rf-meta">Loading your quests...</p>
}
else if (data == null || (data.Characters.Count == 0 && data.Streamer == null))
{
    <div class="rf-panel rf-panel--accent">
        <h2 class="rf-panel__title">No characters yet</h2>
        <p>Join a stream that plays Ravenfall with <span class="rf-cmd">!join</span>, then type <span class="rf-cmd">!quest</span> to see today's quests.</p>
    </div>
}
else
{
    <details class="qp-guide" open="@(TotalDailies < 5)">
        <summary><i class="fa-solid fa-circle-question" aria-hidden="true"></i> How quests work</summary>
        <div class="qp-guide__grid">
            <div>
                <h3>Daily and weekly quests</h3>
                <p>Every day three new quests are offered, and one bigger quest each week. Take one in chat with
                    <span class="rf-cmd">!quest accept 1</span> (or <span class="rf-cmd">weekly</span>), then just play:
                    progress counts by itself. Up to three at a time; finishing dailies on following days builds a streak.</p>
            </div>
            <div>
                <h3>Quest chains</h3>
                <p>Short stories told by the tavern's quest giver, a step at a time. Begin one with
                    <span class="rf-cmd">!quest begin &lt;name&gt;</span>. Steps ask you to bring items
                    (<span class="rf-cmd">!quest deliver</span>), sail somewhere or answer a riddle. Each ends with a title,
                    and a piece of decor for the village of the stream you finish it in.</p>
            </div>
            <div>
                <h3>Achievements and titles</h3>
                <p>Achievements count what you do anyway: wood chopped, raids won, quests done. Each has a bronze, silver
                    and gold tier, and every tier gives a title. Wear one on your name tag with
                    <span class="rf-cmd">!title 2</span>, or none with <span class="rf-cmd">!title off</span>.</p>
            </div>
            <div>
                <h3>Stream bounties</h3>
                <p>Streamers post their own quests: a bounty for the first few players to reach a target, or a goal the
                    whole stream works on together. They show under the character playing in that stream.</p>
            </div>
        </div>
    </details>

    @foreach (var error in data.Errors)
    {
        <div class="rf-banner rf-banner--warn"><p>Could not read the quests of @error</p></div>
    }

    @if (data.Characters.Count > 0)
    {
        <div class="rf-tabs" role="tablist" aria-label="Characters">
            @foreach (var c in data.Characters)
            {
                var current = c;
                <button type="button" role="tab" class="rf-tab @(current == character ? "is-active" : "")" aria-selected="@(current == character)" @onclick="() => character = current">
                    @current.Name
                    @if (current.StreamName != null)
                    {
                        <span class="qp-live" title="Playing in @current.StreamName's stream"></span>
                    }
                </button>
            }
        </div>
    }

    @if (character != null)
    {
        var c = character;
        <div class="rf-stats">
            <div class="rf-stat">
                <div class="rf-stat__value">@c.Streak <i class="fa-solid fa-fire qp-flame @(c.Streak > 0 ? "is-lit" : "")" aria-hidden="true"></i></div>
                <div class="rf-stat__label">Day streak</div>
            </div>
            <div class="rf-stat">
                <div class="rf-stat__value">@c.DailiesCompleted.ToString("N0")</div>
                <div class="rf-stat__label">Dailies done</div>
            </div>
            <div class="rf-stat">
                <div class="rf-stat__value qp-medals">
                    <span class="qp-medal qp-medal--3" title="Gold">@c.Achievements.Count(a => a.Tier >= 3)</span>
                    <span class="qp-medal qp-medal--2" title="Silver">@c.Achievements.Count(a => a.Tier == 2)</span>
                    <span class="qp-medal qp-medal--1" title="Bronze">@c.Achievements.Count(a => a.Tier == 1)</span>
                </div>
                <div class="rf-stat__label">Achievement medals</div>
            </div>
            <div class="rf-stat">
                <div class="rf-stat__value qp-title">@(c.Title ?? "None")</div>
                <div class="rf-stat__label">Title worn</div>
            </div>
        </div>
        @if (c.StreamName != null)
        {
            <p class="rf-meta qp-where"><span class="qp-live"></span> Playing in <strong>@c.StreamName</strong>'s stream now.</p>
        }

        <section class="rf-panel">
            <div class="rf-panel__head">
                <h2 class="rf-panel__title">Today</h2>
                <span class="rf-meta">New offers at midnight UTC, a new weekly quest every Monday</span>
            </div>
            @if (c.Taken.Count == 0 && c.Offers.Count == 0 && c.Weekly == null && c.Seasonal == null)
            {
                <p class="rf-meta">Nothing yet today. Type <span class="rf-cmd">!quest</span> in a stream to get today's offers.</p>
            }
            else
            {
                <div class="qp-quests">
                    @foreach (var q in c.Taken)
                    {
                        @QuestCard(q)
                    }
                    @if (c.Weekly != null)
                    {
                        @QuestCard(c.Weekly)
                    }
                    @if (c.Seasonal != null)
                    {
                        @QuestCard(c.Seasonal)
                    }
                    @foreach (var q in c.Offers)
                    {
                        @QuestCard(q)
                    }
                </div>
            }
        </section>

        @if (c.StreamQuests.Count > 0)
        {
            <section class="rf-panel">
                <div class="rf-panel__head">
                    <h2 class="rf-panel__title">@c.StreamName's quests</h2>
                    <span class="rf-meta">Posted by the streamer; your progress counts while you play there</span>
                </div>
                <div class="qp-quests">
                    @foreach (var b in c.StreamQuests)
                    {
                        @BountyCard(b, true)
                    }
                </div>
            </section>
        }

        @if (c.Chains.Count > 0)
        {
            <section class="rf-panel">
                <div class="rf-panel__head">
                    <h2 class="rf-panel__title">Quest chains</h2>
                    <span class="rf-meta">@c.Chains.Count(ch => ch.State == 2) of @c.Chains.Count told &middot; one at a time</span>
                </div>
                <div class="qp-chains">
                    @foreach (var ch in c.Chains.OrderBy(ch => ch.State == 1 ? 0 : ch.State == 0 ? 1 : ch.State == 5 ? 2 : 3))
                    {
                        <article class="qp-chain @ChainClass(ch)">
                            <div class="qp-chain__head">
                                <h3 class="qp-chain__name">@ch.Name</h3>
                                @ChainBadge(ch)
                            </div>
                            <div class="qp-steps" aria-label="Step @(Math.Min(ch.Step + 1, ch.Steps)) of @ch.Steps">
                                @for (var i = 0; i < ch.Steps; i++)
                                {
                                    <span class="qp-step @(ch.State == 2 || i < ch.Step ? "is-done" : ch.State == 1 && i == ch.Step ? "is-now" : "")"></span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(ch.Story))
                            {
                                <blockquote class="qp-story">@ch.Story</blockquote>
                            }
                            @if (!string.IsNullOrEmpty(ch.Task))
                            {
                                <div class="qp-task">
                                    <span>@ch.Task</span>
                                    @if (ch.Amount > 1)
                                    {
                                        <span class="qp-count">@ch.Progress.ToString("N0") / @ch.Amount.ToString("N0")</span>
                                    }
                                </div>
                                @if (ch.Amount > 1)
                                {
                                    @Bar((double)ch.Progress / ch.Amount)
                                }
                            }
                            @if (!string.IsNullOrEmpty(ch.Ending))
                            {
                                <p class="qp-ending">@ch.Ending</p>
                            }
                            @if (ch.RewardTitle != null || ch.RewardDecor != null)
                            {
                            <div class="qp-rewards">
                                @if (ch.RewardDecorKey != null)
                                {
                                    <img class="qp-decor" src="/images/decor/@(ch.RewardDecorKey).png" alt="" loading="lazy" onerror="this.style.display='none'" />
                                }
                                <div>
                                    @if (ch.RewardTitle != null)
                                    {
                                        <div><i class="fa-solid fa-crown" aria-hidden="true"></i> Title: <strong>@ch.RewardTitle</strong></div>
                                    }
                                    @if (ch.RewardDecor != null)
                                    {
                                        <div><i class="fa-solid fa-tree" aria-hidden="true"></i> Village decor: <strong>@ch.RewardDecor</strong></div>
                                    }
                                </div>
                            </div>
                            }
                            @if (ch.Command != null)
                            {
                                <div class="qp-cmdline">Begin it in chat: <span class="rf-cmd">@ch.Command</span></div>
                            }
                        </article>
                    }
                </div>
            </section>
        }

        @if (c.Achievements.Count > 0)
        {
            <section class="rf-panel">
                <div class="rf-panel__head">
                    <h2 class="rf-panel__title">Achievements</h2>
                    <span class="rf-meta">Bronze, silver and gold; every tier gives a title</span>
                </div>
                <div class="qp-achievements">
                    @foreach (var a in c.Achievements)
                    {
                        <article class="qp-ach @(a.Tier >= 3 ? "is-gold" : "")">
                            <div class="qp-ach__head">
                                <span class="qp-ach__name">@a.Name</span>
                                <span class="qp-pips" aria-label="Tier @a.Tier of 3">
                                    @for (var t = 1; t <= 3; t++)
                                    {
                                        <span class="qp-pip qp-pip--@t @(a.Tier >= t ? "is-on" : "")"></span>
                                    }
                                </span>
                            </div>
                            @if (a.Next > 0)
                            {
                                @Bar(a.Share)
                                <div class="qp-ach__foot">
                                    <span>@a.Progress.ToString("N0") / @a.Next.ToString("N0")</span>
                                    <span>Next: @a.TierTitles[Math.Min(a.Tier, 2)]</span>
                                </div>
                            }
                            else
                            {
                                <div class="qp-ach__foot"><span>All three tiers</span><span>@a.TierTitles[2]</span></div>
                            }
                        </article>
                    }
                </div>
                @if (c.Titles.Count > 0)
                {
                    <h3 class="qp-sub">Titles earned</h3>
                    <div class="rf-chips">
                        @foreach (var t in c.Titles)
                        {
                            <span class="rf-chip @(t.Worn ? "qp-worn" : "")" title="@(t.Worn ? "Worn" : "Wear it with !title " + t.Number)">
                                <b>@t.Number.</b> @t.Text @(t.Worn ? "(worn)" : "")
                            </span>
                        }
                    </div>
                    <p class="rf-meta">Wear one with <span class="rf-cmd">!title 2</span> (its number), or none with <span class="rf-cmd">!title off</span>.</p>
                }
            </section>
        }
    }

    @if (data.Streamer != null)
    {
        var s = data.Streamer;
        <h2 class="qp-part"><i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i> Your stream</h2>

        <div class="rf-stats">
            <div class="rf-stat">
                <div class="rf-stat__value">@s.Stories.Count(x => x.State == 2) / @s.Stories.Count</div>
                <div class="rf-stat__label">Village stories told</div>
            </div>
            <div class="rf-stat">
                <div class="rf-stat__value">@(s.HeroWaves > 0 ? s.HeroWaves + " waves" : "None yet")</div>
                <div class="rf-stat__label">Best hero mode run@(s.HeroRank > 0 ? " (#" + s.HeroRank + ")" : "")</div>
            </div>
            <div class="rf-stat">
                <div class="rf-stat__value">@s.LoyaltyLeft.ToString("N0") / @s.LoyaltyWeekly.ToString("N0")</div>
                <div class="rf-stat__label">Loyalty points left for quests this week</div>
            </div>
        </div>

        <section class="rf-panel">
            <div class="rf-panel__head">
                <h2 class="rf-panel__title">Village stories</h2>
                <span class="rf-meta">Quests for you as the village's leader; your viewers do the work</span>
            </div>
            <div class="qp-chains">
                @foreach (var st in s.Stories.OrderBy(x => x.State == 1 ? 0 : x.State == 0 ? 1 : 2))
                {
                    <article class="qp-chain @(st.State == 1 ? "is-active" : st.State == 2 ? "is-done" : "")">
                        <div class="qp-chain__head">
                            <h3 class="qp-chain__name">@st.Name</h3>
                            @if (st.State == 1)
                            {
                                <span class="rf-badge rf-badge--gold">Step @(st.Step + 1) of @st.Steps</span>
                            }
                            else if (st.State == 2)
                            {
                                <span class="rf-badge rf-badge--good">Finished</span>
                            }
                            else
                            {
                                <span class="rf-badge rf-badge--quiet">Not begun</span>
                            }
                        </div>
                        <div class="qp-steps">
                            @for (var i = 0; i < st.Steps; i++)
                            {
                                <span class="qp-step @(st.State == 2 || i < st.Step ? "is-done" : st.State == 1 && i == st.Step ? "is-now" : "")"></span>
                            }
                        </div>
                        @if (st.State == 1 && !string.IsNullOrEmpty(st.Line))
                        {
                            <blockquote class="qp-story">@st.Line</blockquote>
                        }
                        else if (st.State == 0 && !string.IsNullOrEmpty(st.Hook))
                        {
                            <p class="qp-ending">@st.Hook</p>
                        }
                        @if (!string.IsNullOrEmpty(st.Task))
                        {
                            <div class="qp-task">
                                <span>@st.Task</span>
                                @if (st.Amount > 0)
                                {
                                    <span class="qp-count">@st.Progress.ToString("N0") / @st.Amount.ToString("N0")</span>
                                }
                            </div>
                            @if (st.Amount > 0)
                            {
                                @Bar(st.Share)
                            }
                        }
                        @if (st.Helpers.Length > 0)
                        {
                            <p class="rf-meta">Top helpers: @string.Join(", ", st.Helpers)</p>
                        }
                    </article>
                }
            </div>
            <p class="rf-meta">Begin, talk and choose in the game's quest window (its Village tab).</p>
            @if (s.Unlocks.Count > 0)
            {
                <h3 class="qp-sub">Unlocked for your stream</h3>
                <div class="rf-chips">
                    @foreach (var u in s.Unlocks)
                    {
                        <span class="rf-chip">@u</span>
                    }
                </div>
            }
        </section>

        <section class="rf-panel">
            <div class="rf-panel__head">
                <h2 class="rf-panel__title">Quests you posted</h2>
                <span class="rf-meta">Bounties and stream goals, from the game's quest window</span>
            </div>
            @if (s.Quests.Count == 0)
            {
                <p class="rf-meta">None yet. Post a bounty or a stream goal from the quest window's second tab in the game.</p>
            }
            else
            {
                <div class="qp-quests">
                    @foreach (var b in s.Quests)
                    {
                        @BountyCard(b, false)
                    }
                </div>
            }
        </section>

        @if (s.HeroWaves > 0)
        {
            <p class="rf-meta">
                Best hero mode run: <strong>@s.HeroWaves waves</strong>, @s.HeroKills.ToString("N0") enemies,
                @(s.HeroSeconds / 60):@((s.HeroSeconds % 60).ToString("00"))@(s.HeroRank > 0 ? ", #" + s.HeroRank + " among all streamers" : "").
                Decor and titles come at 10, 25 and 50 waves; see your <a href="/town#decor">town's decor</a>.
            </p>
        }
    }
}

@code {
    private RavenNest.Models.SessionInfo session;
    private QuestPageData data;
    private QuestPageCharacter character;
    private bool loading = true;

    private long TotalDailies => data?.Characters.Sum(c => c.DailiesCompleted) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        session = AuthService.GetSession();
        if (session == null || !session.Authenticated) { loading = false; return; }
        data = await QuestPageService.GetAsync(session.UserId);
        // the character with something going on first: in a stream, or with quests taken
        character = data.Characters.OrderByDescending(c => c.StreamName != null).ThenByDescending(c => c.Taken.Count).FirstOrDefault();
        loading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (session == null || !session.Authenticated)
        {
            NavigationManager.NavigateTo("/login/redirect/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        }
    }

    private RenderFragment Bar(double share) => @<div class="qp-bar"><span class="qp-bar__fill" style="width: @((Math.Clamp(share, 0, 1) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>;

    private RenderFragment QuestCard(QuestPageQuest q) => __builder =>
    {
        var done = q.State == 2;
        <article class="qp-quest @(q.Kind == 1 ? "is-weekly" : q.Kind == 2 ? "is-seasonal" : "") @(q.State == 0 ? "is-offer" : "") @(done ? "is-done" : "")">
            <div class="qp-quest__head">
                <span class="qp-kind">@(q.Kind == 1 ? "Weekly" : q.Kind == 2 ? "Seasonal" : "Daily")</span>
                <span class="rf-badge @(done ? "rf-badge--good" : q.State == 1 ? "rf-badge--gold" : "rf-badge--quiet")">@(done ? "Done" : q.State == 1 ? "Taken" : "On offer")</span>
            </div>
            <div class="qp-quest__text">@q.Text</div>
            @if (q.State == 1 || done)
            {
                @Bar(q.Share)
                <div class="qp-quest__foot">
                    <span>@q.Progress.ToString("N0") / @q.Amount.ToString("N0")</span>
                    <span>@Left(q.Expires)</span>
                </div>
            }
            <div class="qp-reward"><i class="fa-solid fa-coins" aria-hidden="true"></i> @q.Reward</div>
            @if (q.Command != null)
            {
                <div class="qp-cmdline">Take it: <span class="rf-cmd">@q.Command</span></div>
            }
        </article>
    };

    private RenderFragment BountyCard(QuestPageBounty b, bool mine) => __builder =>
    {
        var running = b.State == 1;
        <article class="qp-quest @(b.Goal ? "is-goal" : "") @(running ? "" : "is-done")">
            <div class="qp-quest__head">
                <span class="qp-kind">@(b.Goal ? "Stream goal" : "Bounty")</span>
                <span class="rf-badge @(running ? "rf-badge--gold" : b.State == 2 || b.State == 5 ? "rf-badge--good" : "rf-badge--quiet")">@BountyState(b)</span>
            </div>
            <div class="qp-quest__text">@b.Name</div>
            @if (!string.IsNullOrEmpty(b.Description))
            {
                <p class="qp-desc">@b.Description</p>
            }
            <div class="qp-task"><span>@b.Task</span><span class="qp-count">@b.Progress.ToString("N0") / @b.Amount.ToString("N0")</span></div>
            @Bar(b.Share)
            <div class="qp-quest__foot">
                <span>@(b.Goal ? b.Helpers + " helping" : b.Claimed + " of " + b.Winners + " rewards claimed")</span>
                <span>@(running ? Left(b.Ends) : "")</span>
            </div>
            @if (!string.IsNullOrEmpty(b.Reward))
            {
                <div class="qp-reward"><i class="fa-solid fa-gift" aria-hidden="true"></i> @b.Reward</div>
            }
            @if (mine && b.YouClaimed)
            {
                <div class="qp-cmdline"><i class="fa-solid fa-check" aria-hidden="true"></i> You claimed yours</div>
            }
        </article>
    };

    private static string BountyState(QuestPageBounty b) => b.State switch
    {
        1 => "Running",
        2 => "Done",
        3 => "Out of time",
        4 => "Stopped",
        5 => "All claimed",
        _ => "",
    };

    private static string ChainClass(QuestPageChain ch) => ch.State == 1 ? "is-active" : ch.State == 2 ? "is-done" : ch.State == 5 ? "is-seasonal" : "";

    private RenderFragment ChainBadge(QuestPageChain ch) => __builder =>
    {
        switch (ch.State)
        {
            case 1: <span class="rf-badge rf-badge--gold">Step @(ch.Step + 1) of @ch.Steps</span> break;
            case 2: <span class="rf-badge rf-badge--good">Finished</span> break;
            case 5: <span class="rf-badge rf-badge--quiet">@(ch.Event == "halloween" ? "Halloween only" : ch.Event == "christmas" ? "Christmas only" : "Not now")</span> break;
            default: <span class="rf-badge rf-badge--quiet">@ch.Steps steps</span> break;
        }
    };

    /// <summary>"5 h left", "2 days left": how long a quest or bounty runs.</summary>
    private static string Left(DateTime ends)
    {
        var left = ends - DateTime.UtcNow;
        if (left <= TimeSpan.Zero) return "Ended";
        if (left.TotalDays >= 2) return Math.Floor(left.TotalDays) + " days left";
        if (left.TotalHours >= 1) return Math.Floor(left.TotalHours) + " h left";
        return Math.Max(1, (int)left.TotalMinutes) + " min left";
    }
}
