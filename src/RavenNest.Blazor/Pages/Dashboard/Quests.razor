@layout DashboardLayout
@page "/quests"
@using RavenNest.Blazor.Services
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.QuestPageService QuestPageService
@inject NavigationManager NavigationManager

@* The signed in player's quests; the page itself is the QuestBoard component. *@

<QuestBoard Data="data" Loading="loading" StreamerName="@session?.UserName" StartTab="@startTab" />

@code {
    private RavenNest.Models.SessionInfo session;
    private QuestPageData data;
    private bool loading = true;
    private string startTab;

    protected override async Task OnInitializedAsync()
    {
        session = AuthService.GetSession();
        startTab = QueryValue("tab");
        if (session == null || !session.Authenticated) { loading = false; return; }
        data = await QuestPageService.GetAsync(session.UserId);
        loading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (session == null || !session.Authenticated)
        {
            NavigationManager.NavigateTo("/login/redirect/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        }
    }

    private string QueryValue(string key)
    {
        var pair = new Uri(NavigationManager.Uri).Query.TrimStart('?').Split('&').Select(p => p.Split('=')).FirstOrDefault(p => p[0] == key);
        return pair != null && pair.Length == 2 ? Uri.UnescapeDataString(pair[1]) : null;
    }
}
