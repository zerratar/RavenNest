@layout DashboardLayout
@page "/session"
@inject NavigationManager NavigationManager

@*
    Folded into the Bot page.

    This route existed to show your active game session and never got past
    "this page is not done yet". Everything it was going to show, whether the session is running
    and whether the bot reached your channel, is now on /bot and is actually built. Kept as a
    redirect so old links and bookmarks still land somewhere useful.
*@

@code {
    protected override void OnInitialized()
    {
        NavigationManager.NavigateTo("/bot", replace: true);
    }
}
