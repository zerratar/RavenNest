@using System.ComponentModel.DataAnnotations
@using RavenNest.Blazor.Services
@using RavenNest.BusinessLogic.Data
@using RavenNest.DataModels
@using Microsoft.Extensions.Logging

@*
    One line of a log. The severity is a badge with the level written in it rather than only a row
    colour, so a warning is still a warning in a screenshot, in greyscale, and to a reader who
    cannot pick the shade of brown out from the shade of red.
*@
<tr class="rf-log__row @RowClass">
    <td class="rf-log__time">@DataContext.LogDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
    <td><span class="rf-badge @BadgeClass">@Label</span></td>
    <td class="rf-log__message">@DataContext.Message</td>
</tr>

@code {
    [Parameter]
    public LogEntry DataContext { get; set; }

    private string RowClass { get; set; } = "";
    private string BadgeClass { get; set; } = "";
    private string Label { get; set; } = "";

    protected override void OnParametersSet()
    {
        // Was OnInitialized, so a row reused for a different entry as the list grew kept the first
        // entry's severity styling.
        FormatLogLevel(DataContext?.LogLevel ?? LogLevel.Information);
    }

    private void FormatLogLevel(LogLevel level)
    {
        Label = level.ToString().ToUpperInvariant();
        RowClass = "";
        BadgeClass = "";

        switch (level)
        {
            case LogLevel.Warning:
                RowClass = "is-warning";
                BadgeClass = "rf-badge--warn";
                break;

            case LogLevel.Error:
                RowClass = "is-error";
                BadgeClass = "rf-badge--bad";
                break;

            case LogLevel.Critical:
                Label = "CRITICAL";
                RowClass = "is-error";
                BadgeClass = "rf-badge--bad";
                break;
        }
    }
}
