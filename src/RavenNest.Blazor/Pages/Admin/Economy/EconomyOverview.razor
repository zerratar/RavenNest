@layout AdminLayout
@page "/admin/economy"
@using Blazorise
@using Blazorise.Charts
@using RavenNest.BusinessLogic.Game

@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.EconomyService EconomyService
@inject RavenNest.BusinessLogic.Data.GameData GameData;

@if (isAdmin)
{
    <header class="rf-page-head">
        <h1 class="rf-page-title">Game economy</h1>
        <p class="rf-page-subtitle">
            Coins are the only resource the game still uses, so this is the whole of it.
        </p>
    </header>

    <EconomyNav Current="overview"></EconomyNav>

    @if (loadFailed)
    {
        @*
            The load used to be wrapped in a catch that discarded the exception and let the page
            render as though nothing had happened, so a failure looked like an economy with no
            coins in it. It says so now.
        *@
        <div class="rf-banner rf-banner--bad">
            <div class="rf-banner__title">The figures below could not be built</div>
            <p>Reading the accounts failed part way through, so what is shown is incomplete.</p>
        </div>
    }

    <div class="rf-stats">
        <div class="rf-stat">
            <div class="rf-stat__value" title="@totalCoins.ToString("N0") coins">@Utility.FormatAmount(totalCoins)</div>
            <div class="rf-stat__label">Coins in the game</div>
        </div>
        <div class="rf-stat">
            <div class="rf-stat__value" title="@averageCoins.ToString("N0") coins">@Utility.FormatAmount(averageCoins)</div>
            <div class="rf-stat__label">Average per account</div>
        </div>
        <div class="rf-stat">
            <div class="rf-stat__value" title="@medianCoins.ToString("N0") coins">@Utility.FormatAmount(medianCoins)</div>
            <div class="rf-stat__label">Median per account</div>
        </div>
        <div class="rf-stat">
            <div class="rf-stat__value">@accountsCounted.ToString("N0")</div>
            <div class="rf-stat__label">Accounts counted</div>
        </div>
    </div>

    @*
        The average and the median are both here on purpose. A handful of accounts hold most of the
        coins in any game economy, so an average on its own says almost nothing about what a normal
        player has, and the gap between the two is the interesting number.
    *@

    <section class="rf-panel">
        <h2 class="rf-panel__title">Average coins by account age</h2>
        <p class="rf-meta">
            Each point is the average balance of the accounts created that many days ago.
        </p>
        <LineChart TItem="double" Data="@lineChartData" Options="@lineChartOptions"></LineChart>
    </section>

    <section class="rf-panel">
        <h2 class="rf-panel__title">Richest accounts</h2>
        @if (topRichestUsers == null)
        {
            <LoadIndicator></LoadIndicator>
        }
        else
        {
            <div class="rf-scroll-x">
                <table class="rf-table">
                    <thead>
                        <tr>
                            <th scope="col"><span class="rf-th rf-th--static">Account</span></th>
                            <th scope="col"><span class="rf-th rf-th--static">Coins</span></th>
                            <th scope="col"><span class="rf-th rf-th--static">Share of all coins</span></th>
                            <th scope="col"><span class="rf-th rf-th--static">Account age</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in topRichestUsers)
                        {
                            var coins = GameData.GetResources(user)?.Coins ?? 0;
                            <tr>
                                <td>
                                    <a class="rf-item__name" href="/admin/user/@user.Id">@user.UserName</a>
                                </td>
                                <td class="rf-price__value" title="@coins.ToString("N0") coins">@Utility.FormatAmount(coins)</td>
                                @*
                                    Being told an account holds 4.2T means nothing without knowing
                                    what fraction of the game that is, and the total is right here.
                                *@
                                <td class="rf-table__quiet">@ShareOfTotal(coins)</td>
                                <td class="rf-table__quiet">@AccountAge(user.Created)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private IReadOnlyList<RavenNest.DataModels.User> topRichestUsers;

    private bool isAdmin;
    private bool loadFailed;

    private double totalCoins;
    private double averageCoins;
    private double medianCoins;
    private int accountsCounted;

    // The chart library takes colour strings rather than CSS, so this repeats --rf-gold by hand.
    private const string ChartGold = "#e8a33d";

    private ChartData<double> lineChartData = new()
        {
            Labels = new(),
            Datasets = new()
        };

    private LineChartOptions lineChartOptions = new LineChartOptions
        {
            Responsive = true,
            Scales = new ChartScales
            {
                X = new ChartAxis
                {
                    Title = new ChartScaleTitle { Text = new IndexableOption<string>("Account age in days") }
                },
                Y = new ChartAxis
                {
                    Title = new ChartScaleTitle { Text = new IndexableOption<string>("Average coins") }
                }
            }
        };

    private RavenNest.Models.SessionInfo session;

    protected override async Task OnInitializedAsync()
    {
        session = AuthService.GetSession();
        isAdmin = session != null && session.Administrator;
        topRichestUsers = await EconomyService.GetTopRichestPlayers(10);

        try
        {
            BuildEconomy();
        }
        catch
        {
            loadFailed = true;
        }
    }

    /// <summary>
    ///     Coins are stored per account, not per character.
    ///
    ///     This walked every character and added its account's balance to the total, so an account
    ///     with five characters had its coins counted five times: the reported total was inflated
    ///     by however many characters people happen to have, and the "average per player" divided
    ///     that inflated total by the character count. Both numbers were wrong and neither was
    ///     wrong by a constant factor, so they could not even be compared over time.
    ///
    ///     Walking accounts instead is both correct and cheaper, since it is one resource lookup
    ///     per account rather than one per character.
    /// </summary>
    private void BuildEconomy()
    {
        var users = GameData.GetUsers();
        var coinsByAccountAge = new Dictionary<int, (double coins, int count)>();
        var balances = new List<double>();
        var today = DateTime.UtcNow.Date;

        foreach (var user in users)
        {
            var resources = GameData.GetResources(user);
            if (resources == null)
            {
                // An account can have no resources row. It is not an error, it is an account that
                // has never held anything.
                continue;
            }

            var coins = resources.Coins;
            totalCoins += coins;
            balances.Add(coins);

            var days = Math.Max(0, (today - user.Created.Date).Days);
            if (coinsByAccountAge.TryGetValue(days, out var bucket))
            {
                coinsByAccountAge[days] = (bucket.coins + coins, bucket.count + 1);
            }
            else
            {
                coinsByAccountAge[days] = (coins, 1);
            }
        }

        accountsCounted = balances.Count;
        averageCoins = accountsCounted == 0 ? 0 : totalCoins / accountsCounted;

        if (accountsCounted > 0)
        {
            balances.Sort();
            medianCoins = accountsCounted % 2 == 1
                ? balances[accountsCounted / 2]
                : (balances[(accountsCounted / 2) - 1] + balances[accountsCounted / 2]) / 2d;
        }

        var lineDataSet = new LineChartDataset<double>
            {
                Label = "Average coins",
                BorderColor = ChartGold,
                PointBackgroundColor = ChartGold,
                PointBorderColor = ChartGold,
                PointRadius = 1,
                Fill = false,
                Data = new List<double>()
            };

        lineChartData.Labels = new List<object>();

        foreach (var kvp in coinsByAccountAge.OrderBy(kvp => kvp.Key))
        {
            var (coins, count) = kvp.Value;
            lineDataSet.Data.Add(coins / count);
            lineChartData.Labels.Add(kvp.Key.ToString());
        }

        lineChartData.Datasets.Clear();
        lineChartData.Datasets.Add(lineDataSet);
    }

    private string ShareOfTotal(double coins)
    {
        if (totalCoins <= 0) return "n/a";
        var pct = coins / totalCoins * 100d;
        return pct < 0.01 ? "under 0.01%" : Math.Round(pct, 2) + "%";
    }

    private static string AccountAge(DateTime created)
    {
        var days = (int)(DateTime.UtcNow - created).TotalDays;
        if (days < 1) return "today";
        if (days < 60) return days + " days";
        if (days < 730) return (days / 30) + " months";
        return (days / 365) + " years";
    }
}
