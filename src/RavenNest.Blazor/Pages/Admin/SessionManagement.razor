@layout AdminLayout
@page "/admin/sessions"
@using RavenNest.BusinessLogic.Extensions
@using RavenNest.BusinessLogic.Game
@using RavenNest.BusinessLogic.Messages
@using RavenNest.Models
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.BusinessLogic.Data.GameData GameData
@inject RavenNest.Blazor.Services.PlayerService PlayerService
@inject RavenNest.Blazor.Services.SessionService SessionService
@implements IDisposable
@inject IJSRuntime JS

@if (isAdmin)
{
    <div>
        <label>Hide Inactive Sessions</label>
        <input type="checkbox" value="@activeSessionsOnly" @onchange="ev => ActiveSessionsOnlyChanged(ev.Value)">
    </div>
    @if (gameSessions == null || loading)
    {
        <h1>Game Sessions</h1>
        <LoadIndicator></LoadIndicator>
    }
    else
    {
        <h1>Game Sessions (@gameSessions.Count)</h1>
        <table class="table">
            <thead>
                <tr>
                    <th>Owner</th>
                    <th>Status</th>
                    <th>Started</th>
                    <th>Exp Req</th>
                    <th>State Req</th>
                    <th>Uptime</th>
                    <th>Admin</th>
                    <th>Mod</th>
                    <th>Client Version</th>
                    <th>Players (@gameSessions.Sum(x => x != null && x.Players != null ? x.Players.Count : 0))</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in gameSessions)
                {
                    @if (session == null)
                    {
                        continue;
                    }
                    <tr class="table-row">
                        <td><span>Twitch: @session.TwitchUserId</span> <span>@session.UserName</span></td>
                        <td>@GetSessionStatus(session.Status)</td>
                        <td>@session.Started</td>
                        <td>@GetLastUpdateStringShort(session.LastExpRequest)</td>
                        <td>@GetLastUpdateStringShort(session.LastStateRequest)</td>
                        <td>@GetUptime(session)</td>
                        <td>@session.AdminPrivileges</td>
                        <td>@session.ModPrivileges</td>
                        <td>@session.ClientVersion</td>
                        <td @onclick="() => ShowPlayerList(session)">@session.Players.Count</td>
                        <td>
                            @if (GameVersion.IsLessThanOrEquals("0.9.4.2a", session.ClientVersion))
                            {
                                var logState = GetDownloadState(DownloadType.Log, session);
                                <button title="Request player log file"
                                        class="inline-button"
                                        @onclick="(() => RequestPlayerLog(session))"
                                        disabled="@(logState != null && logState.IsProcessing)">
                                    <i class="fa-regular fa-circle-down"></i> player.log
                                    @if (logState != null && logState.IsProcessing)
                                    {
                                        <span class="spinner"></span>
                                    }
                                </button>
                                @if (logState != null && !string.IsNullOrEmpty(logState.Status))
                                {
                                    <span class="processing-status @((logState.Failed ? "error" : ""))">@logState.Status</span>
                                }

                                var stateDl = GetDownloadState(DownloadType.State, session);
                                <button title="Request player state file"
                                        class="inline-button"
                                        @onclick="(() => RequestPlayerState(session))"
                                        disabled="@(stateDl != null && stateDl.IsProcessing)">
                                    <i class="fa-regular fa-circle-down"></i> player.state
                                    @if (stateDl != null && stateDl.IsProcessing)
                                    {
                                        <span class="spinner"></span>
                                    }
                                </button>
                                @if (stateDl != null && !string.IsNullOrEmpty(stateDl.Status))
                                {
                                    <span class="processing-status @((stateDl.Failed ? "error" : ""))">@stateDl.Status</span>
                                }

                            }

                            <button title="(TEST) Make this user initiate a Raid against our game session" class="inline-button raid" @onclick="(() => RaidOurSession(session))"><i class="fa-solid fa-people-group"></i> Raid</button>
                            <button title="(TEST) Make this user initiate a Raid War against our game session" class="inline-button raidwar" @onclick="(() => RaidWarOurSession(session))"><i class="fa-solid fa-swords"></i> War</button>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    }

    @if (playerListVisible)
    {
        <div class="player-list-modal">
            <div class="player-list-modal-header">
                @if (inspectingSession != null)
                {
                    <h3>@(inspectingSession.UserName + " - " + (inspectingSession.Players?.Count ?? 0) + " players")</h3>
                }
                <div @onclick="HidePlayerList" class="btn-close">&times;</div>
            </div>
            <div class="player-list">
                @if (inspectingSession != null)
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>User Name</th>
                                <th>Administrator</th>
                                <th>Moderator</th>
                                <th>Last Req</th>
                                <th>Last Saved</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (inspectingSession.Players != null)
                                {
                                    foreach (var player in inspectingSession.Players)
                                    {
                                        <tr class="table-row">
                                            <td>@player.UserName</td>
                                            <td>@player.IsAdmin</td>
                                            <td>@player.IsModerator</td>
                                            <td>
                                                <div class="last-updated">@GetLastUpdateStringShort(player.LastExpSaveRequest)</div>
                                            </td>
                                            <td>
                                                <div class="last-updated">@GetLastUpdateStringShort(player.LastExpUpdate)</div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}

@code {
    private RavenNest.Models.SessionInfo session;
    private RavenNest.Models.GameSession inspectingSession;
    private bool isAdmin;
    private bool playerListVisible;
    private bool loading = false;

    private IReadOnlyList<RavenNest.Models.GameSession> gameSessions;
    private DateTime UtcNow = DateTime.UtcNow;
    private IMessageBusSubscription downloadLogHandler, downloadStateHandler;
    private bool activeSessionsOnly = true;

    private Dictionary<string, DownloadState> downloadStates = new();

    private class DownloadState
    {
        public bool IsProcessing { get; set; }
        public bool DownloadReady { get; set; }
        public string Status { get; set; }
        public DateTime StartTime { get; set; }
        public Guid RequestId { get; set; }
        public bool Failed { get; set; }
    }

    private enum DownloadType
    {
        Log,
        State
    }

    private static string GetKey(DownloadType downloadType, GameSession session)
    {
        return $"{downloadType.ToString().ToLower()}_{session.Id}";
    }

    private static string GetKey(DownloadType downloadType, Guid sessionId)
    {
        return $"{downloadType.ToString().ToLower()}_{sessionId}";
    }

    private DownloadState? GetDownloadState(DownloadType downloadType, GameSession session)
    {
        var key = GetKey(downloadType, session);
        downloadStates.TryGetValue(key, out var state);
        return state;
    }

    protected override void OnInitialized()
    {
        session = AuthService.GetSession();
        isAdmin = session != null && session.Administrator;
        if (isAdmin)
        {
            activeSessionsOnly = true;
            if (downloadLogHandler != null)
            {
                downloadLogHandler.Unsubscribe();
            }

            if (downloadStateHandler != null)
            {
                downloadStateHandler.Unsubscribe();
            }

            downloadLogHandler = MessageBus.Shared.Subscribe<FileUploadedMessage>("LogUploaded", OnLogFileAvailable);
            downloadStateHandler = MessageBus.Shared.Subscribe<FileUploadedMessage>("StateUploaded", OnStateFileAvailable);

            LoadGameSessionsAsync();
        }
    }

    private async void OnStateFileAvailable(FileUploadedMessage message)
    {
        if (message == null || message.SessionId == Guid.Empty)
            return;
        var key = GetKey(DownloadType.State, message.SessionId);
        if (!downloadStates.TryGetValue(key, out var state))
            return;
        state.Status = "";//"Downloading state file...";
        var stateBytes = await System.IO.File.ReadAllBytesAsync(message.FilePath);
        if (stateBytes != null)
        {
            var base64 = Convert.ToBase64String(stateBytes);
            await JS.InvokeVoidAsync("downloadFileFromBytes", $"playerstate_{message.SessionId}.state", base64);
            state.Status = "";//"Download started.";
            state.DownloadReady = true;
        }
        else
        {
            state.Status = "Failed to download state file";
            state.Failed = true;
        }
        state.IsProcessing = false;
        await InvokeAsync(StateHasChanged);
    }


    private async void OnLogFileAvailable(FileUploadedMessage message)
    {
        if (message == null || message.SessionId == Guid.Empty)
            return;

        var key = GetKey(DownloadType.Log, message.SessionId);
        if (!downloadStates.TryGetValue(key, out var state))
            return;

        state.Status = "";//"Downloading log file...";
        var logBytes = await System.IO.File.ReadAllBytesAsync(message.FilePath);
        if (logBytes != null)
        {
            var base64 = Convert.ToBase64String(logBytes);
            await JS.InvokeVoidAsync("downloadFileFromBytes", $"playerlog_{message.SessionId}.log", base64);

            state.Status = "";//"Download started.";
            state.DownloadReady = true;
        }
        else
        {
            state.Status = "Failed to download log file";
            state.Failed = true;
        }
        state.IsProcessing = false;

        await InvokeAsync(StateHasChanged);
    }

    private async void ActiveSessionsOnlyChanged(object value)
    {
        activeSessionsOnly = (bool)value;
        await LoadGameSessionsAsync();
    }

    private void RequestPlayerState(RavenNest.Models.GameSession session)
    {
        var key = GetKey(DownloadType.State, session);
        if (downloadStates.TryGetValue(key, out var state))
        {
            if (state.IsProcessing && (DateTime.UtcNow - state.StartTime).TotalSeconds < 10)
            {
                // Already processing, block
                return;
            }
        }
        // Create new or reset state
        var reqId = Guid.NewGuid();
        downloadStates[key] = new DownloadState
        {
            IsProcessing = true,
            DownloadReady = false,
            Failed = false,
            Status = "Awaiting state file from Client...",
            StartTime = DateTime.UtcNow,
            RequestId = reqId
        };
        StateHasChanged();
        var evt = GameData.CreateSessionEvent(Models.GameEventType.GameStateRequest, session.Id,
            new GameStateRequest
            {
                RequestId = reqId
            });
        GameData.SendGameEventImmediately(evt);
        // Timeout unblocks after 10s if not finished
        _ = Task.Run(async () =>
        {
            await Task.Delay(10000);
            if (downloadStates.TryGetValue(key, out var s)
                && s.IsProcessing
                && !s.DownloadReady
                && (DateTime.UtcNow - s.StartTime).TotalSeconds >= 10)
            {
                s.Status = "Timeout – try again.";
                s.IsProcessing = false;
                s.Failed = true;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void RequestPlayerLog(RavenNest.Models.GameSession session)
    {
        var key = GetKey(DownloadType.Log, session);
        if (downloadStates.TryGetValue(key, out var state))
        {
            if (state.IsProcessing && (DateTime.UtcNow - state.StartTime).TotalSeconds < 10)
            {
                // Already processing, block
                return;
            }
        }

        // Create new or reset state
        var reqId = Guid.NewGuid();
        downloadStates[key] = new DownloadState
        {
            IsProcessing = true,
            DownloadReady = false,
            Failed = false,
            Status = "Awaiting log file from Client...",
            StartTime = DateTime.UtcNow,
            RequestId = reqId
        };
        StateHasChanged();

        var evt = GameData.CreateSessionEvent(Models.GameEventType.PlayerLogRequest, session.Id,
            new PlayerLogRequest
            {
                RequestId = reqId,
                LogFile = "ravenfall.log",
                Type = PlayerLogRequestType.Current
            });

        GameData.SendGameEventImmediately(evt);

        // Timeout unblocks after 10s if not finished
        _ = Task.Run(async () =>
        {
            await Task.Delay(10000);
            if (downloadStates.TryGetValue(key, out var s)
                && s.IsProcessing
                && !s.DownloadReady
                && (DateTime.UtcNow - s.StartTime).TotalSeconds >= 10)
            {
                s.Status = "Timeout – try again.";
                s.IsProcessing = false;
                s.Failed = true;
                await InvokeAsync(StateHasChanged);
            }
        });
    }


    private void RaidOurSession(RavenNest.Models.GameSession session)
    {
        SessionService.InitiateRaid(session);
    }

    private void RaidWarOurSession(RavenNest.Models.GameSession session)
    {
        SessionService.InitiateRaidWar(session);
    }


    public string GetLastUpdateStringShort(DateTime update)
    {
        var elapsed = UtcNow - update;
        if (update <= DateTime.UnixEpoch)
        {
            return "";
        }

        if (elapsed.TotalHours >= 24)
        {
            return (int)elapsed.TotalDays + " days ago";
        }

        if (elapsed.TotalHours >= 1)
        {
            return (int)elapsed.TotalHours + " hours ago";
        }

        if (elapsed.TotalMinutes >= 1)
        {
            return (int)elapsed.TotalMinutes + " minutes ago";
        }

        return (int)elapsed.TotalSeconds + " seconds ago";
    }

    public string GetLastUpdateString(DateTime update)
    {
        var elapsed = UtcNow - update;
        if (update <= DateTime.UnixEpoch)
        {
            return "";
        }

        var prefix = "Exp Last updated: ";
        return prefix + GetLastUpdateStringShort(update);
    }

    private void HidePlayerList()
    {
        playerListVisible = false;
        InvokeAsync(StateHasChanged);
    }

    private void ShowPlayerList(RavenNest.Models.GameSession data)
    {
        inspectingSession = data;
        inspectingSession.AvgSaveTime = TimeSpan.FromSeconds(data.Players.Average(x => (UtcNow - x.LastExpUpdate).TotalSeconds));
        playerListVisible = true;
        InvokeAsync(StateHasChanged);
    }

    private string GetUptime(RavenNest.Models.GameSession session)
    {
        return FormatTime(DateTime.UtcNow - session.Started);
    }

    private string FormatTime(TimeSpan time)
    {
        if (time.TotalSeconds < 60) return "<1 minute";
        if (time.TotalMinutes < 60)
            return (int)Math.Floor(time.TotalMinutes) + " minutes";
        if (time.TotalHours < 24)
            return Math.Round(time.TotalHours, 2) + " hours";
        return $"{time.Days} days, {time.Hours} hours, {time.Minutes} minutes";
    }

    private string GetSessionStatus(int status)
    {
        if (status == 0)
        {
            return "Active";
        }

        return "Ended";
    }

    public void Dispose()
    {
        if (downloadLogHandler != null)
        {
            MessageBus.Shared.Unsubscribe(downloadLogHandler);
        }

        if (downloadStateHandler != null)
        {
            MessageBus.Shared.Unsubscribe(downloadStateHandler);
        }

    }

    private async Task LoadGameSessionsAsync()
    {
        loading = true;
        gameSessions = await SessionService.GetGameSessionsAsync(activeSessionsOnly);
        loading = false;
        UtcNow = DateTime.UtcNow;
        await InvokeAsync(StateHasChanged);
    }
}
