@layout AdminLayout
@page "/admin/sessions"
@using RavenNest.BusinessLogic.Extensions
@using RavenNest.BusinessLogic.Game
@using RavenNest.BusinessLogic.Messages
@using RavenNest.Models
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.BusinessLogic.Data.GameData GameData
@inject RavenNest.Blazor.Services.PlayerService PlayerService
@inject RavenNest.Blazor.Services.SessionService SessionService
@implements IDisposable
@inject IJSRuntime JS

@if (isAdmin)
{
    <header class="rf-page-head">
        <h1 class="rf-page-title">Game sessions</h1>
        <p class="rf-page-subtitle">Every stream connected to the game, and who is playing on it.</p>
    </header>

    @if (gameSessions == null || loading)
    {
        <LoadIndicator></LoadIndicator>
    }
    else
    {
        @*
            Three numbers the page had and never stated. How many streams are up and how many
            people are in the game is the question this screen exists to answer, and it was left
            to be counted off the table.
        *@
        <div class="rf-stats">
            <div class="rf-stat">
                <div class="rf-stat__value">@gameSessions.Count</div>
                <div class="rf-stat__label">@(activeSessionsOnly ? "Active sessions" : "Sessions")</div>
            </div>
            <div class="rf-stat">
                <div class="rf-stat__value">@TotalPlayers.ToString("N0")</div>
                <div class="rf-stat__label">Players in game</div>
            </div>
            <div class="rf-stat">
                <div class="rf-stat__value">@BusiestSessionName</div>
                <div class="rf-stat__label">Busiest stream</div>
            </div>
        </div>

        <div class="rf-toolbar">
            @*
                Was <input type="checkbox" value="@activeSessionsOnly">, which does not set a
                checkbox: it rendered unchecked whatever the filter was actually doing. That is the
                fourth copy of this same mistake in the admin panel.
            *@
            <label class="rf-check">
                <input type="checkbox" checked="@activeSessionsOnly" @onchange="ev => ActiveSessionsOnlyChanged(ev.Value)" />
                <span>Hide inactive sessions</span>
            </label>
        </div>

        @if (gameSessions.Count == 0)
        {
            <div class="rf-panel">
                <p class="rf-meta">
                    @(activeSessionsOnly ? "No streams are active right now." : "There are no sessions.")
                </p>
            </div>
        }
        else
        {
            <div class="rf-panel">
                <div class="rf-scroll-x">
                    <table class="rf-table">
                        <thead>
                            <tr>
                                <th scope="col"><span class="rf-th rf-th--static">Owner</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Status</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Uptime</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Last exp</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Last state</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Client</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Players</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in gameSessions)
                            {
                                @if (session == null)
                                {
                                    continue;
                                }

                                <tr>
                                    <td>
                                        <div class="rf-item">
                                            <span class="rf-item__body">
                                                <a class="rf-item__name" href="https://www.twitch.tv/@session.UserName" target="_blank" rel="noopener">
                                                    @session.UserName
                                                </a>
                                                <span class="rf-item__meta">
                                                    <span title="Twitch user id">@session.TwitchUserId</span>
                                                    @if (session.AdminPrivileges)
                                                    {
                                                        <span class="rf-item__mark">Admin</span>
                                                    }
                                                    @if (session.ModPrivileges)
                                                    {
                                                        <span class="rf-item__mark">Mod</span>
                                                    }
                                                </span>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var status = GetSessionStatus(session.Status);
                                        }
                                        <span class="rf-badge @(IsActive(session) ? "rf-badge--good" : "")">@status</span>
                                    </td>
                                    <td class="rf-table__quiet" title="Started @session.Started">@GetUptime(session)</td>
                                    <td class="rf-table__quiet">@GetLastUpdateStringShort(session.LastExpRequest)</td>
                                    <td class="rf-table__quiet">@GetLastUpdateStringShort(session.LastStateRequest)</td>
                                    <td class="rf-table__quiet">@session.ClientVersion</td>
                                    <td>
                                        @*
                                            The count was a td with a click handler on it, which no
                                            keyboard can reach and nothing announces as clickable.
                                        *@
                                        <button type="button" class="rf-btn rf-btn--small" @onclick="() => ShowPlayerList(session)">
                                            @(session.Players?.Count ?? 0) players
                                        </button>
                                    </td>
                                    <td>
                                        <div class="rf-actions">
                                            @if (GameVersion.IsLessThanOrEquals("0.9.4.2a", session.ClientVersion))
                                            {
                                                var logState = GetDownloadState(DownloadType.Log, session);
                                                <button type="button"
                                                        title="Request player log file"
                                                        class="rf-btn rf-btn--small"
                                                        @onclick="(() => RequestPlayerLog(session))"
                                                        disabled="@(logState != null && logState.IsProcessing)">
                                                    <i class="fa-regular fa-circle-down" aria-hidden="true"></i> player.log
                                                </button>
                                                @if (logState != null && !string.IsNullOrEmpty(logState.Status))
                                                {
                                                    <span class="rf-meta @(logState.Failed ? "rf-session__failed" : "")">@logState.Status</span>
                                                }

                                                var stateDl = GetDownloadState(DownloadType.State, session);
                                                <button type="button"
                                                        title="Request player state file"
                                                        class="rf-btn rf-btn--small"
                                                        @onclick="(() => RequestPlayerState(session))"
                                                        disabled="@(stateDl != null && stateDl.IsProcessing)">
                                                    <i class="fa-regular fa-circle-down" aria-hidden="true"></i> player.state
                                                </button>
                                                @if (stateDl != null && !string.IsNullOrEmpty(stateDl.Status))
                                                {
                                                    <span class="rf-meta @(stateDl.Failed ? "rf-session__failed" : "")">@stateDl.Status</span>
                                                }
                                            }

                                            @*
                                                These two fire a real in game event on somebody
                                                else's live stream, and they were labelled only by
                                                a title attribute nobody hovers.
                                            *@
                                            <button type="button" class="rf-btn rf-btn--small rf-btn--danger" @onclick="(() => ConfirmRaid(session, false))">
                                                Raid me
                                            </button>
                                            <button type="button" class="rf-btn rf-btn--small rf-btn--danger" @onclick="(() => ConfirmRaid(session, true))">
                                                War me
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    @if (playerListVisible && inspectingSession != null)
    {
        @*
            Was a bare div positioned by site.css with no backdrop, so it read as part of the page
            rather than as something opened over it.
        *@
        <div class="rf-modal-backdrop" @onclick="HidePlayerList">
            <div class="rf-modal rf-modal--wide" role="dialog" aria-modal="true" aria-label="Players in this session" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">
                        @inspectingSession.UserName
                        <span class="rf-meta">@(inspectingSession.Players?.Count ?? 0) players</span>
                    </h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="HidePlayerList">&times;</button>
                </div>

                @if (inspectingSession.Players == null || inspectingSession.Players.Count == 0)
                {
                    <p class="rf-meta">Nobody is playing on this stream.</p>
                }
                else
                {
                    <div class="rf-scroll-x">
                        <table class="rf-table">
                            <thead>
                                <tr>
                                    <th scope="col"><span class="rf-th rf-th--static">Player</span></th>
                                    <th scope="col"><span class="rf-th rf-th--static">Roles</span></th>
                                    <th scope="col"><span class="rf-th rf-th--static">Last request</span></th>
                                    <th scope="col"><span class="rf-th rf-th--static">Last saved</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var player in inspectingSession.Players)
                                {
                                    <tr>
                                        <td>@player.UserName</td>
                                        <td>
                                            @if (player.IsAdmin)
                                            {
                                                <span class="rf-badge rf-badge--gold">Admin</span>
                                            }
                                            @if (player.IsModerator)
                                            {
                                                <span class="rf-badge rf-badge--gold">Mod</span>
                                            }
                                            @if (!player.IsAdmin && !player.IsModerator)
                                            {
                                                <span class="rf-meta">Player</span>
                                            }
                                        </td>
                                        <td class="rf-table__quiet">@GetLastUpdateStringShort(player.LastExpSaveRequest)</td>
                                        <td class="rf-table__quiet">@GetLastUpdateStringShort(player.LastExpUpdate)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @if (raidTarget != null)
    {
        <div class="rf-modal-backdrop" @onclick="CancelRaid">
            <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Start a raid" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">@(raidIsWar ? "Start a raid war?" : "Start a raid?")</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CancelRaid">&times;</button>
                </div>
                <p>
                    This makes <b>@raidTarget.UserName</b> raid your own session, for real, on their
                    live stream. It is a test tool and their viewers will see it happen.
                </p>
                <div class="rf-modal__foot">
                    <button type="button" class="rf-btn" @onclick="CancelRaid">Cancel</button>
                    <button type="button" class="rf-btn rf-btn--danger" @onclick="ApplyRaid">
                        @(raidIsWar ? "Start the war" : "Start the raid")
                    </button>
                </div>
            </div>
        </div>
    }
}


@code {
    private RavenNest.Models.SessionInfo session;
    private RavenNest.Models.GameSession inspectingSession;
    private bool isAdmin;
    private bool playerListVisible;
    private bool loading = false;

    private IReadOnlyList<RavenNest.Models.GameSession> gameSessions;
    private DateTime UtcNow = DateTime.UtcNow;
    private IMessageBusSubscription downloadLogHandler, downloadStateHandler;
    private bool activeSessionsOnly = true;

    private Dictionary<string, DownloadState> downloadStates = new();

    private class DownloadState
    {
        public bool IsProcessing { get; set; }
        public bool DownloadReady { get; set; }
        public string Status { get; set; }
        public DateTime StartTime { get; set; }
        public Guid RequestId { get; set; }
        public bool Failed { get; set; }
    }

    private enum DownloadType
    {
        Log,
        State
    }

    private static string GetKey(DownloadType downloadType, GameSession session)
    {
        return $"{downloadType.ToString().ToLower()}_{session.Id}";
    }

    private static string GetKey(DownloadType downloadType, Guid sessionId)
    {
        return $"{downloadType.ToString().ToLower()}_{sessionId}";
    }

    private DownloadState? GetDownloadState(DownloadType downloadType, GameSession session)
    {
        var key = GetKey(downloadType, session);
        downloadStates.TryGetValue(key, out var state);
        return state;
    }

    protected override void OnInitialized()
    {
        session = AuthService.GetSession();
        isAdmin = session != null && session.Administrator;
        if (isAdmin)
        {
            activeSessionsOnly = true;
            if (downloadLogHandler != null)
            {
                downloadLogHandler.Unsubscribe();
            }

            if (downloadStateHandler != null)
            {
                downloadStateHandler.Unsubscribe();
            }

            downloadLogHandler = MessageBus.Shared.Subscribe<FileUploadedMessage>("LogUploaded", OnLogFileAvailable);
            downloadStateHandler = MessageBus.Shared.Subscribe<FileUploadedMessage>("StateUploaded", OnStateFileAvailable);

            LoadGameSessionsAsync();
        }
    }

    private async void OnStateFileAvailable(FileUploadedMessage message)
    {
        if (message == null || message.SessionId == Guid.Empty)
            return;
        var key = GetKey(DownloadType.State, message.SessionId);
        if (!downloadStates.TryGetValue(key, out var state))
            return;
        state.Status = "";//"Downloading state file...";
        var stateBytes = await System.IO.File.ReadAllBytesAsync(message.FilePath);
        if (stateBytes != null)
        {
            var base64 = Convert.ToBase64String(stateBytes);
            await JS.InvokeVoidAsync("downloadFileFromBytes", $"playerstate_{message.SessionId}.state", base64);
            state.Status = "";//"Download started.";
            state.DownloadReady = true;
        }
        else
        {
            state.Status = "Failed to download state file";
            state.Failed = true;
        }
        state.IsProcessing = false;
        await InvokeAsync(StateHasChanged);
    }


    private async void OnLogFileAvailable(FileUploadedMessage message)
    {
        if (message == null || message.SessionId == Guid.Empty)
            return;

        var key = GetKey(DownloadType.Log, message.SessionId);
        if (!downloadStates.TryGetValue(key, out var state))
            return;

        state.Status = "";//"Downloading log file...";
        var logBytes = await System.IO.File.ReadAllBytesAsync(message.FilePath);
        if (logBytes != null)
        {
            var base64 = Convert.ToBase64String(logBytes);
            await JS.InvokeVoidAsync("downloadFileFromBytes", $"playerlog_{message.SessionId}.log", base64);

            state.Status = "";//"Download started.";
            state.DownloadReady = true;
        }
        else
        {
            state.Status = "Failed to download log file";
            state.Failed = true;
        }
        state.IsProcessing = false;

        await InvokeAsync(StateHasChanged);
    }

    private async void ActiveSessionsOnlyChanged(object value)
    {
        activeSessionsOnly = (bool)value;
        await LoadGameSessionsAsync();
    }

    private void RequestPlayerState(RavenNest.Models.GameSession session)
    {
        var key = GetKey(DownloadType.State, session);
        if (downloadStates.TryGetValue(key, out var state))
        {
            if (state.IsProcessing && (DateTime.UtcNow - state.StartTime).TotalSeconds < 10)
            {
                // Already processing, block
                return;
            }
        }
        // Create new or reset state
        var reqId = Guid.NewGuid();
        downloadStates[key] = new DownloadState
        {
            IsProcessing = true,
            DownloadReady = false,
            Failed = false,
            Status = "Awaiting state file from Client...",
            StartTime = DateTime.UtcNow,
            RequestId = reqId
        };
        StateHasChanged();
        var evt = GameData.CreateSessionEvent(Models.GameEventType.GameStateRequest, session.Id,
            new GameStateRequest
            {
                RequestId = reqId
            });
        GameData.SendGameEventImmediately(evt);
        // Timeout unblocks after 10s if not finished
        _ = Task.Run(async () =>
        {
            await Task.Delay(10000);
            if (downloadStates.TryGetValue(key, out var s)
                && s.IsProcessing
                && !s.DownloadReady
                && (DateTime.UtcNow - s.StartTime).TotalSeconds >= 10)
            {
                s.Status = "Timeout – try again.";
                s.IsProcessing = false;
                s.Failed = true;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void RequestPlayerLog(RavenNest.Models.GameSession session)
    {
        var key = GetKey(DownloadType.Log, session);
        if (downloadStates.TryGetValue(key, out var state))
        {
            if (state.IsProcessing && (DateTime.UtcNow - state.StartTime).TotalSeconds < 10)
            {
                // Already processing, block
                return;
            }
        }

        // Create new or reset state
        var reqId = Guid.NewGuid();
        downloadStates[key] = new DownloadState
        {
            IsProcessing = true,
            DownloadReady = false,
            Failed = false,
            Status = "Awaiting log file from Client...",
            StartTime = DateTime.UtcNow,
            RequestId = reqId
        };
        StateHasChanged();

        var evt = GameData.CreateSessionEvent(Models.GameEventType.PlayerLogRequest, session.Id,
            new PlayerLogRequest
            {
                RequestId = reqId,
                LogFile = "ravenfall.log",
                Type = PlayerLogRequestType.Current
            });

        GameData.SendGameEventImmediately(evt);

        // Timeout unblocks after 10s if not finished
        _ = Task.Run(async () =>
        {
            await Task.Delay(10000);
            if (downloadStates.TryGetValue(key, out var s)
                && s.IsProcessing
                && !s.DownloadReady
                && (DateTime.UtcNow - s.StartTime).TotalSeconds >= 10)
            {
                s.Status = "Timeout – try again.";
                s.IsProcessing = false;
                s.Failed = true;
                await InvokeAsync(StateHasChanged);
            }
        });
    }


    private RavenNest.Models.GameSession raidTarget;
    private bool raidIsWar;

    /// <summary>
    ///     Both of these fire a real in game event on somebody else's live stream, and both used to
    ///     go off on the first click of a small button in a row of four, labelled only by a title
    ///     attribute nobody hovers.
    /// </summary>
    private void ConfirmRaid(RavenNest.Models.GameSession session, bool war)
    {
        raidTarget = session;
        raidIsWar = war;
    }

    private void CancelRaid()
    {
        raidTarget = null;
    }

    private void ApplyRaid()
    {
        var target = raidTarget;
        var war = raidIsWar;
        raidTarget = null;
        if (target == null) return;

        if (war)
        {
            SessionService.InitiateRaidWar(target);
        }
        else
        {
            SessionService.InitiateRaid(target);
        }

        InvokeAsync(StateHasChanged);
    }

    private int TotalPlayers =>
        gameSessions == null ? 0 : gameSessions.Sum(x => x?.Players?.Count ?? 0);

    private string BusiestSessionName
    {
        get
        {
            var top = gameSessions?
                .Where(x => x != null)
                .OrderByDescending(x => x.Players?.Count ?? 0)
                .FirstOrDefault();

            return top == null || (top.Players?.Count ?? 0) == 0 ? "n/a" : top.UserName;
        }
    }

    /// <summary>
    ///     Reads the same status GetSessionStatus prints rather than repeating the magic number, so
    ///     the badge and the word can never disagree.
    /// </summary>
    private bool IsActive(RavenNest.Models.GameSession session)
    {
        return session != null && GetSessionStatus(session.Status) == "Active";
    }


    public string GetLastUpdateStringShort(DateTime update)
    {
        var elapsed = UtcNow - update;
        if (update <= DateTime.UnixEpoch)
        {
            return "";
        }

        if (elapsed.TotalHours >= 24)
        {
            return (int)elapsed.TotalDays + " days ago";
        }

        if (elapsed.TotalHours >= 1)
        {
            return (int)elapsed.TotalHours + " hours ago";
        }

        if (elapsed.TotalMinutes >= 1)
        {
            return (int)elapsed.TotalMinutes + " minutes ago";
        }

        return (int)elapsed.TotalSeconds + " seconds ago";
    }

    public string GetLastUpdateString(DateTime update)
    {
        var elapsed = UtcNow - update;
        if (update <= DateTime.UnixEpoch)
        {
            return "";
        }

        var prefix = "Exp Last updated: ";
        return prefix + GetLastUpdateStringShort(update);
    }

    private void HidePlayerList()
    {
        playerListVisible = false;
        InvokeAsync(StateHasChanged);
    }

    private void ShowPlayerList(RavenNest.Models.GameSession data)
    {
        inspectingSession = data;
        inspectingSession.AvgSaveTime = TimeSpan.FromSeconds(data.Players.Average(x => (UtcNow - x.LastExpUpdate).TotalSeconds));
        playerListVisible = true;
        InvokeAsync(StateHasChanged);
    }

    private string GetUptime(RavenNest.Models.GameSession session)
    {
        return FormatTime(DateTime.UtcNow - session.Started);
    }

    private string FormatTime(TimeSpan time)
    {
        if (time.TotalSeconds < 60) return "<1 minute";
        if (time.TotalMinutes < 60)
            return (int)Math.Floor(time.TotalMinutes) + " minutes";
        if (time.TotalHours < 24)
            return Math.Round(time.TotalHours, 2) + " hours";
        return $"{time.Days} days, {time.Hours} hours, {time.Minutes} minutes";
    }

    private string GetSessionStatus(int status)
    {
        if (status == 0)
        {
            return "Active";
        }

        return "Ended";
    }

    public void Dispose()
    {
        if (downloadLogHandler != null)
        {
            MessageBus.Shared.Unsubscribe(downloadLogHandler);
        }

        if (downloadStateHandler != null)
        {
            MessageBus.Shared.Unsubscribe(downloadStateHandler);
        }

    }

    private async Task LoadGameSessionsAsync()
    {
        loading = true;
        gameSessions = await SessionService.GetGameSessionsAsync(activeSessionsOnly);
        loading = false;
        UtcNow = DateTime.UtcNow;
        await InvokeAsync(StateHasChanged);
    }
}
