@layout DarkAdminDashboardLayout
@page "/admin/display-ravenbot-log/{filename}"
@page "/admin/display-ravenbot-log/{filename}/{pageSize}"
@page "/admin/display-ravenbot-log/{filename}/{offset}/{pageSize}"
@using System.ComponentModel.DataAnnotations
@using RavenNest.BusinessLogic.Data
@using RavenNest.DataModels
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.ServerService ServerService

@if (isAdmin)
{
    <header class="rf-page-head">
        <h1 class="rf-page-title">@Filename</h1>
        <p class="rf-page-subtitle">
            <a href="/admin/ravenbot-logs">Back to the log list</a>
        </p>
    </header>

    @if (entries == null)
    {
        <LoadIndicator></LoadIndicator>
    }
    else if (entries.Count == 0)
    {
        <div class="rf-panel">
            <p class="rf-meta">This log file has no entries in it.</p>
        </div>
    }
    else
    {
        @*
            How much of the file you are looking at was never stated, only implied by two buttons
            with counts on them.
        *@
        <div class="rf-toolbar">
            <span class="rf-meta">Showing @entries.Count of @totalCount lines</span>
            @if (WarningCount > 0)
            {
                <span class="rf-badge rf-badge--warn">@WarningCount warnings</span>
            }
            @if (ErrorCount > 0)
            {
                <span class="rf-badge rf-badge--bad">@ErrorCount errors</span>
            }
        </div>

        <div class="rf-panel">
            <div class="rf-scroll-x">
                <table class="rf-table rf-log">
                    <thead>
                        <tr>
                            <th scope="col"><span class="rf-th rf-th--static">Time</span></th>
                            <th scope="col"><span class="rf-th rf-th--static">Level</span></th>
                            <th scope="col"><span class="rf-th rf-th--static">Message</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in entries)
                        {
                            <RavenbotLogDisplayLine DataContext="entry"></RavenbotLogDisplayLine>
                        }
                    </tbody>
                </table>
            </div>

            @*
                Was a row spanning the table with buttons in it, which is a table cell doing a
                toolbar's job. It sits under the table now.
            *@
            <div class="rf-pager">
                @if (loadingEntries)
                {
                    <span class="rf-meta">Loading, please wait</span>
                }
                else if (!hasReadAll)
                {
                    <button type="button" class="rf-btn rf-btn--small" @onclick="() => LoadMoreAsync()">
                        Load @LoadMoreCount more
                    </button>
                    <button type="button" class="rf-btn rf-btn--small" @onclick="() => LoadAllAsync()">
                        Load the remaining @LoadAllCount
                    </button>
                }
                else
                {
                    <span class="rf-meta">That is the whole file.</span>
                    <button type="button" class="rf-btn rf-btn--small" @onclick="() => LoadMoreAsync()">Refresh</button>
                }
            </div>
        </div>
    }
}


@code {
    private RavenNest.Models.SessionInfo session;
    private List<RavenNest.Blazor.Services.LogEntry> entries;

    private bool isAdmin;

    [Parameter]
    public string Filename { get; set; }

    [Parameter]
    public int Offset { get; set; }

    [Parameter]
    public int PageSize { get; set; }

    private bool loadingEntries;

    private int totalCount = 0;
    private bool hasReadAll = false;

    /// <summary>
    ///     What is actually wrong in the part of the file loaded so far. A log viewer that makes
    ///     you scroll to find the red lines is not doing very much for you.
    /// </summary>
    private int WarningCount =>
        entries?.Count(x => x.LogLevel == Microsoft.Extensions.Logging.LogLevel.Warning) ?? 0;

    private int ErrorCount =>
        entries?.Count(x => x.LogLevel == Microsoft.Extensions.Logging.LogLevel.Error
                         || x.LogLevel == Microsoft.Extensions.Logging.LogLevel.Critical) ?? 0;

    private int LoadAllCount
    {
        get
        {
            return totalCount - Offset;
        }
    }

    private int LoadMoreCount
    {
        get
        {
            var delta = totalCount - Offset;
            if (delta > PageSize) return PageSize;
            return PageSize - delta;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (PageSize == 0) PageSize = 100;
        session = AuthService.GetSession();
        isAdmin = session != null && session.Administrator;
        entries = new List<RavenNest.Blazor.Services.LogEntry>();
        await LoadMoreAsync();
    }

    private async Task LoadAllAsync()
    {
        loadingEntries = true;
        await InvokeAsync(StateHasChanged);
        await LoadAsync(Offset, int.MaxValue);
        loadingEntries = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadMoreAsync()
    {
        loadingEntries = true;
        await InvokeAsync(StateHasChanged);
        await LoadAsync(Offset, PageSize);
        loadingEntries = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync(int offset, int pageSize)
    {
        var collection = await ServerService.GetRavenbotLogEntriesAsync(Filename, offset, pageSize);
        if (collection.LogEntries.Count > 0)
        {
            entries.AddRange(collection.LogEntries);
            Offset += entries.Count;
            totalCount = collection.TotalCount;
            hasReadAll = Offset >= totalCount;
        }
        else
        {
            hasReadAll = true;
        }
    }
}