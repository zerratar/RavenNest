@layout AdminLayout
@page "/admin/coc"
@using RavenNest.Blazor.Services;
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.ServerService ServerService

@if (isAdmin)
{
    <header class="rf-page-head">
        <h1 class="rf-page-title">Code of conduct</h1>
        <p class="rf-page-subtitle">
            Shown in the game client when it is set to visible. There is one, and saving replaces it.
        </p>
    </header>

    @if (isLoading)
    {
        <LoadIndicator></LoadIndicator>
    }
    else
    {
        @*
            Status used to be one string called updateError, rendered in the error colour whether it
            said "Message cannot be null" or "Last modified: ..., revision: 4". A save that worked
            looked like a save that failed.
        *@
        @if (!string.IsNullOrEmpty(status))
        {
            <div class="rf-banner @(statusIsError ? "rf-banner--bad" : "rf-banner--good")">
                <div class="rf-banner__title">@(statusIsError ? "Not saved" : "Saved")</div>
                <p>@status</p>
            </div>
        }

        <section class="rf-panel">
            <EditForm Model="@updateCodeOfConduct" OnValidSubmit="@HandleUpdate">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label class="rf-field">
                    <span class="rf-label">Title</span>
                    <InputText id="header" class="rf-input" @bind-Value="updateCodeOfConduct.Title" />
                </label>

                <label class="rf-field">
                    <span class="rf-label">Message</span>
                    <InputTextArea rows="12" class="rf-input rf-textarea" id="name" @bind-Value="updateCodeOfConduct.Message" />
                </label>
                <p class="rf-meta">
                    The client renders Unity rich text.
                    <a href="https://docs.unity3d.com/Packages/com.unity.ugui@1.0/manual/StyledText.html" target="_blank" rel="noopener">See supported formatting</a>.
                </p>

                <label class="rf-check">
                    <InputCheckbox @bind-Value="updateCodeOfConduct.VisibleInClient" />
                    <span>Show it in the game client</span>
                </label>

                <div class="rf-actions rf-coc__actions">
                    <button class="rf-btn rf-btn--primary" type="submit">Save</button>
                    @*
                        Clearing the message and saving deletes the code of conduct. That was true
                        before and nothing said so; it was mentioned only in the text of the error
                        you got when it had already happened.
                    *@
                    @if (string.IsNullOrWhiteSpace(updateCodeOfConduct.Message))
                    {
                        <span class="rf-meta">Saving with an empty message deletes the code of conduct.</span>
                    }
                </div>
            </EditForm>
        </section>
    }

    @if (confirmingDelete)
    {
        <div class="rf-modal-backdrop" @onclick="CancelDelete">
            <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Delete the code of conduct" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">Delete the code of conduct?</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CancelDelete">&times;</button>
                </div>
                <p>
                    The message is empty, and saving it that way removes the code of conduct from the
                    game entirely. Players will stop seeing it.
                </p>
                <div class="rf-modal__foot">
                    <button type="button" class="rf-btn" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="rf-btn rf-btn--danger" @onclick="DeleteCoc">Delete it</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private UpdateCodeOfConduct updateCodeOfConduct = new UpdateCodeOfConduct();
    private RavenNest.Models.SessionInfo session;

    private string status = "";
    private bool statusIsError;
    private bool confirmingDelete;

    private bool isAdmin;
    private bool isLoading = true;

    private async Task HandleUpdate()
    {
        if (string.IsNullOrWhiteSpace(updateCodeOfConduct.Message))
        {
            // Deleting is a real outcome of pressing Save, so it asks rather than telling you
            // afterwards.
            confirmingDelete = true;
            return;
        }

        var result = await ServerService.UpdateCodeOfConduct(updateCodeOfConduct);
        if (result != null)
        {
            statusIsError = false;
            status = "Last modified " + result.LastModified + ", revision " + result.Revision + ".";
        }
        else
        {
            statusIsError = true;
            status = "The server did not accept the change.";
        }

        await InvokeAsync(StateHasChanged);
    }

    private void CancelDelete()
    {
        confirmingDelete = false;
    }

    private async Task DeleteCoc()
    {
        confirmingDelete = false;

        if (await ServerService.DeleteCodeOfConduct())
        {
            statusIsError = false;
            status = "The code of conduct was deleted. Players no longer see one.";
        }
        else
        {
            statusIsError = true;
            status = "There was nothing saved to delete.";
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        session = AuthService.GetSession();
        isAdmin = session != null && session.Administrator;
        await LoadCoc();
    }

    private async Task LoadCoc()
    {
        var coc = await ServerService.GetCodeOfConductAsync();
        if (coc != null)
        {
            updateCodeOfConduct.Title = coc.Title;
            updateCodeOfConduct.Message = coc.Message;
            updateCodeOfConduct.VisibleInClient = coc.VisibleInClient;
        }

        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }
}
