@layout AdminLayout
@page "/admin/items"
@using Microsoft.AspNetCore.Hosting;
@using RavenNest.BusinessLogic.Game;
@using RavenNest.Models;
@using System.IO;
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.ItemService ItemService
@inject IJSRuntime JsRuntime
@inject IWebHostEnvironment Environment

@if (isAdmin)
{

    @if (ItemEditorVisible)
    {
        @*
            The editor was its own modal implementation: a fixed background div, a close button
            made from a div, and a tab strip made from more divs, none of which a keyboard could
            reach. The shell is the shared modal and tab components now. The form inside it is
            three hundred lines of label and input rows and is styled by .rf-form rather than
            being rewritten row by row.
        *@
        <div class="rf-modal-backdrop" @onclick="(() => ItemEditorVisible = false)">
            <div class="rf-modal rf-modal--wide rf-itemedit" role="dialog" aria-modal="true" aria-label="Edit item" @onclick:stopPropagation="true">
                <div class="rf-modal__head">
                    <h2 class="rf-modal__title">@(string.IsNullOrEmpty(editedItem?.Name) ? "New item" : editedItem.Name)</h2>
                    <button type="button" class="rf-modal__close" aria-label="Close" @onclick="(() => ItemEditorVisible = false)">&times;</button>
                </div>
                <div class="tabs">
                    <div class="rf-tabs" role="tablist">
                        <button type="button" role="tab" aria-selected="@(activeTab == ItemEditTab.Form)" class="rf-tab @(activeTab == ItemEditTab.Form ? "is-active" : "")" @onclick="ShowForm">Form</button>
                        <button type="button" role="tab" aria-selected="@(activeTab == ItemEditTab.Json)" class="rf-tab @(activeTab == ItemEditTab.Json ? "is-active" : "")" @onclick="ShowJson">Json</button>
                    </div>

                    @if (activeTab == ItemEditTab.Json)
                    {
                        <div class="tab-content">
                            <textarea @bind="jsonPresentation" class="rf-input rf-textarea rf-itemedit__json"></textarea>
                        </div>
                    }

                    @if (activeTab == ItemEditTab.Form)
                    {
                        <div class="tab-content">
                            <EditForm class="rf-form" EditContext="context" OnValidSubmit="HandleSaveItem">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                <div class="edit-content">
                                    <div class="edit-section general">
                                        <h2>General</h2>

                                        <div class="input-row">
                                            @if (ItemImageExists())
                                            {
                                                <img src="@(ItemService.GetItemImage(editedItem.IdString, editedItem.Name))" class="item-image" />
                                            }
                                            else
                                            {
                                                <img src="https://placehold.co/100x100" class="item-image" />
                                            }

                                            <label class="input-label">Upload Image</label>
                                            <InputFile OnChange="@UploadImage" />
                                        </div>

                                        <div class="input-row">
                                            <label class="input-label">ID</label>
                                            <InputText id="name" @bind-Value="editedItem.IdString" />
                                        </div>

                                        <div class="input-row">
                                            <label class="input-label">Name</label>
                                            <InputText id="name" @bind-Value="editedItem.Name" />
                                        </div>
                                        <div class="input-row">
                                            <label class="input-label">Description</label>
                                            <InputText id="description" @bind-Value="editedItem.Description" />
                                        </div>


                                        <div class="input-row">
                                            <label class="input-label">Level</label>
                                            <InputNumber id="level" @bind-Value="editedItem.Level" />
                                        </div>


                                        <div class="input-row inline">
                                            <label class="input-label">Soulbound</label>
                                            <InputCheckbox id="soulbound" @bind-Value="editedItem.Soulbound" />
                                        </div>


                                        <div class="input-row">
                                            <label class="input-label">Category</label>
                                            <InputSelect id="itemCategory" @bind-Value="editedItem.Category">
                                                @foreach (var option in Enum.GetValues<ItemCategory>())
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </InputSelect>
                                        </div>


                                        <div class="input-row">
                                            <label class="input-label">Type (Sub Category)</label>
                                            <InputSelect id="itemType" @bind-Value="editedItem.Type">
                                                @foreach (var option in Enum.GetValues<ItemType>())
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </InputSelect>
                                        </div>


                                        <div class="input-row">
                                            <label class="input-label">Material (Used for ingame skinning, non-generic items only)</label>
                                            <InputSelect id="itemMaterial" @bind-Value="editedItem.Material">
                                                @foreach (var option in Enum.GetValues<ItemMaterial>())
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    @if (CanBeEquipped())
                                    {

                                        <div class="edit-section level-requirements">
                                            <h2>Level Requirements</h2>
                                            <div class="input-row">
                                                <label class="input-label">Required Attack Level</label>
                                                <InputNumber id="reqAttackLevel" @bind-Value="editedItem.RequiredAttackLevel" />
                                            </div>
                                            <div class="input-row">
                                                <label class="input-label">Required Defense Level</label>
                                                <InputNumber id="reqDefenseLevel" @bind-Value="editedItem.RequiredDefenseLevel" />
                                            </div>
                                            <div class="input-row">
                                                <label class="input-label">Required Magic or Healing Level</label>
                                                <InputNumber id="reqMagicLevel" @bind-Value="editedItem.RequiredMagicLevel" />
                                            </div>
                                            <div class="input-row">
                                                <label class="input-label">Required Ranged Level</label>
                                                <InputNumber id="reqRangedLevel" @bind-Value="editedItem.RequiredRangedLevel" />
                                            </div>
                                            <div class="input-row">
                                                <label class="input-label">Required Slayer Level</label>
                                                <InputNumber id="reqSlayerLevel" @bind-Value="editedItem.RequiredSlayerLevel" />
                                            </div>
                                        </div>

                                        <div class="edit-section appearance">
                                            <h2>Appearance</h2>
                                            <div class="input-row inline">
                                                <label class="input-label">Use Generic Model (Same model for all characters)</label>
                                                <InputCheckbox id="genericModel" @bind-Value="editedItem.IsGenericModel" />
                                            </div>


                                            @if (editedItem.IsGenericModel)
                                            {
                                                <div class="input-row">
                                                    <label class="input-label">Generic Prefab Path</label>
                                                    <InputText id="genericPrefab" @bind-Value="editedItem.GenericPrefab" />
                                                </div>

                                            }
                                            else
                                            {
                                                <div class="input-row">
                                                    <label class="input-label">Male Prefab Path</label>
                                                    <InputText id="malePrefab" @bind-Value="editedItem.MalePrefab" />
                                                </div>


                                                <div class="input-row">
                                                    <label class="input-label">Male Model Attributes</label>
                                                    <InputText id="maleModelId" @bind-Value="editedItem.MaleModelId" />
                                                </div>


                                                <div class="input-row">
                                                    <label class="input-label">Female Prefab Path</label>
                                                    <InputText id="femalePrefab" @bind-Value="editedItem.FemalePrefab" />
                                                </div>

                                                <div class="input-row">
                                                    <label class="input-label">Female Model Attributes</label>
                                                    <InputText id="femaleModelId" @bind-Value="editedItem.FemaleModelId" />
                                                </div>
                                            }
                                        </div>

                                        <div class="edit-section stats">
                                            <h2>Item Stats</h2>
                                            @if (CanHaveDefensiveStats())
                                            {
                                                <div class="input-row">
                                                    <label class="input-label">Armor Power</label>
                                                    <InputNumber id="armorPower" @bind-Value="editedItem.ArmorPower" />
                                                </div>

                                            }
                                            @if (CanHaveOffensiveStats())
                                            {
                                                <div class="input-row">
                                                    <label class="input-label">Weapon Power</label>
                                                    <InputNumber id="weaponPower" @bind-Value="editedItem.WeaponPower" />
                                                </div>

                                                <div class="input-row">
                                                    <label class="input-label">Weapon Aim</label>
                                                    <InputNumber id="weaponAim" @bind-Value="editedItem.WeaponAim" />
                                                </div>

                                                <div class="input-row">
                                                    <label class="input-label">Magic Power</label>
                                                    <InputNumber id="magicPower" @bind-Value="editedItem.MagicPower" />
                                                </div>

                                                <div class="input-row">
                                                    <label class="input-label">Magic Aim</label>
                                                    <InputNumber id="magicAim" @bind-Value="editedItem.MagicAim" />
                                                </div>

                                                <div class="input-row">
                                                    <label class="input-label">Ranged Power</label>
                                                    <InputNumber id="rangedPower" @bind-Value="editedItem.RangedPower" />
                                                </div>

                                                <div class="input-row">
                                                    <label class="input-label">Ranged Aim</label>
                                                    <InputNumber id="rangedAim" @bind-Value="editedItem.RangedAim" />
                                                </div>
                                            }
                                        </div>
                                    }

                                    <div class="edit-section vendor">
                                        <h2>Vendor</h2>
                                        <div class="input-row">
                                            <label class="input-label">Shop Sell Price (How much do we get when !vendor?)</label>
                                            <InputNumber id="shopSellPrice" @bind-Value="editedItem.ShopSellPrice" />
                                        </div>

                                        <div class="input-row">
                                            <label class="input-label">Shop Buy Price (How much does it cost to buy?)</label>
                                            <InputNumber id="shopBuyPrice" @bind-Value="editedItem.ShopBuyPrice" />
                                        </div>
                                    </div>
                                    @*
                        <div class="edit-section crafting">
                        <h2>Crafting Requirements</h2>
                        <div class="input-row inline">
                        <label class="input-label">Is Craftable?</label>
                        <InputCheckbox id="craftable" @bind-Value="editedItem.Craftable" />
                        </div>
                        @if (editedItem.Craftable)
                        {
                        <div class="input-row">
                        <label class="input-label">Required Crafting Level</label>
                        <InputNumber id="craftingLevel" @bind-Value="editedItem.RequiredCraftingLevel" />
                        </div>
                        <div class="input-row">
                        <label class="input-label">Required Cooking Level</label>
                        <InputNumber id="craftingLevel" @bind-Value="editedItem.RequiredCookingLevel" />
                        </div>
                        <div class="crafting-resource-requirements">
                        <div class="input-row">
                        <label class="input-label">Ore Cost (WILL BE REMOVED!!)</label>
                        <InputNumber id="oreCost" @bind-Value="editedItem.OreCost" />
                        </div>
                        <div class="input-row">
                        <label class="input-label">Wood Cost (WILL BE REMOVED!!)</label>
                        <InputNumber id="woodCost" @bind-Value="editedItem.WoodCost" />
                        </div>
                        </div>
                        <div class="crafting-item-requirements">
                        @if (editedItem.CraftingRequirements != null)
                        {
                        foreach (var req in editedItem.CraftingRequirements)
                        {
                        <div class="crafting-requirement">

                        <div class="input-row">
                        <label class="input-label">Resource Item</label>
                        <InputSelect @bind-Value="req.ResourceItemId">
                        @foreach (var item in items.Where(x => x.Category == ItemCategory.Resource))
                        {
                        <option value="@item.Id">@item.Name</option>
                        }
                        </InputSelect>
                        </div>

                        <div class="input-row">
                        <label class="input-label">Amount</label>
                        <InputNumber @bind-Value="req.Amount" />
                        </div>

                        <div class="btn delete-crafting-requirement" @onclick="(() => RemoveCraftingRequirement(req))">
                        <i class="fas fa-trash"></i>
                        </div>
                        </div>
                        }
                        }
                        </div>
                        <div class="btn add-crafting-requirement" @onclick="AddCraftingRequirement">Add Crafting Requirement</div>
                        }
                        </div>*@
                                </div>
                                <div class="rf-modal__foot">
                                    <button type="button" class="rf-btn" @onclick="(() => ItemEditorVisible = false)">Cancel</button>
                                    <button type="submit" class="rf-btn rf-btn--primary">Save the item</button>
                                </div>
                            </EditForm>
                        </div>
                    }

                </div>
            </div>
        </div>
    }

    @if (items == null)
    {
        <LoadIndicator></LoadIndicator>
    }
    else
    {
        <header class="rf-page-head">
            <h1 class="rf-page-title">Items</h1>
            <p class="rf-page-subtitle">
                Every item definition in the game. Editing one changes it for everybody who holds it.
            </p>
        </header>

        @if (!string.IsNullOrEmpty(updateError))
        {
            <div class="rf-banner rf-banner--bad">
                <div class="rf-banner__title">That did not work</div>
                <p>@updateError</p>
            </div>
        }

        @*
            There was no way to search a list of every item in the game, only nineteen category
            buttons, so finding one item meant knowing its category and then reading the column.
        *@
        <div class="rf-toolbar">
            <SearchBox Placeholder="Search by name"
                       AriaLabel="Search items by name"
                       Value="@search"
                       ValueChanged="OnSearchChanged"
                       ClearSignal="@clearSignal" />
            @if (!string.IsNullOrWhiteSpace(search) || itemFilter != ItemFilter.All)
            {
                <button type="button" class="rf-btn rf-btn--small" @onclick="ClearFilters">Clear filters</button>
            }
            <span class="rf-meta">Showing @items.Count of @(availableItems?.Count ?? 0)</span>
            <button type="button" class="rf-btn rf-btn--primary" @onclick="CreateNewItem">
                <i class="fa-solid fa-plus" aria-hidden="true"></i> New item
            </button>
        </div>

        @*
            Driven from the shared list rather than nineteen hand written blocks, the same way the
            stash, the inventory and the marketplace are. This was the fourth copy.
        *@
        <div class="rf-filters" role="group" aria-label="Filter items by category">
            @foreach (var f in RavenNest.Blazor.Services.ItemFilterOptions.All)
            {
                <button type="button"
                        class="rf-filter @(itemFilter == f.Filter ? "is-active" : "")"
                        aria-pressed="@(itemFilter == f.Filter)"
                        @onclick="() => SelectItemFilter(f.Filter)">
                    <i class="@f.Icon" aria-hidden="true"></i>
                    <span>@f.Label</span>
                </button>
            }
        </div>

        @if (items.Count == 0)
        {
            <div class="rf-panel">
                <p class="rf-meta">Nothing matches that. Try a different category or clear the search.</p>
            </div>
        }
        else
        {
            <div class="rf-panel">
                <div class="rf-scroll-x">
                    <table class="rf-table">
                        <thead>
                            <tr>
                                <th scope="col"><span class="rf-th rf-th--static">Item</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Stats</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Requires</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Vendor</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Use and source</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr id="@item.Id">
                                    <td>
                                        <div class="rf-item">
                                            <span class="rf-item__img">
                                                <img src="@(ItemService.GetItemImage(item.Id.ToString(), item.Name))" alt="" loading="lazy" />
                                            </span>
                                            <span class="rf-item__body">
                                                <span class="rf-item__name @ItemService.GetRarityClass(item)">@item.Name</span>
                                                <span class="rf-item__meta">
                                                    @ItemService.GetTypeName(item)
                                                    <span>@ItemService.GetMaterialName(item)</span>
                                                    @if (item.Soulbound)
                                                    {
                                                        <span class="rf-item__mark" title="Cannot be traded"><i class="fa-solid fa-link" aria-hidden="true"></i> Soulbound</span>
                                                    }
                                                </span>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="rf-chips">
                                            @if (item.WeaponAim > 0)
                                            {
                                                <span class="rf-chip" title="Weapon aim, increases your hit rate in melee"><i class="fas fa-crosshairs" aria-hidden="true"></i>@item.WeaponAim</span>
                                            }
                                            @if (item.WeaponPower > 0)
                                            {
                                                <span class="rf-chip" title="Weapon power, increases your maximum damage in melee"><i class="fas fa-swords" aria-hidden="true"></i>@item.WeaponPower</span>
                                            }
                                            @if (item.RangedAim > 0)
                                            {
                                                <span class="rf-chip" title="Ranged aim, increases your ranged hit rate"><i class="fas fa-crosshairs" aria-hidden="true"></i>@item.RangedAim</span>
                                            }
                                            @if (item.RangedPower > 0)
                                            {
                                                <span class="rf-chip" title="Ranged power, increases your ranged maximum damage"><i class="fas fa-bow-arrow" aria-hidden="true"></i>@item.RangedPower</span>
                                            }
                                            @if (item.MagicAim > 0)
                                            {
                                                <span class="rf-chip" title="Magic aim, increases your magic hit rate"><i class="fas fa-wand" aria-hidden="true"></i>@item.MagicAim</span>
                                            }
                                            @if (item.MagicPower > 0)
                                            {
                                                <span class="rf-chip" title="Magic power, increases your magic maximum damage"><i class="fas fa-hand-holding-magic" aria-hidden="true"></i>@item.MagicPower</span>
                                            }
                                            @if (item.ArmorPower > 0)
                                            {
                                                <span class="rf-chip" title="Armour power, decreases the hit rate of your attacker"><i class="fas fa-shield" aria-hidden="true"></i>@item.ArmorPower</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="rf-chips">
                                            @if (item.RequiredSlayerLevel > 0)
                                            {
                                                <span class="rf-chip" title="Required slayer level"><i class="fas fa-skull" aria-hidden="true"></i>@item.RequiredSlayerLevel</span>
                                            }
                                            @if (item.RequiredAttackLevel > 0)
                                            {
                                                <span class="rf-chip" title="Required attack level"><i class="fas fa-swords" aria-hidden="true"></i>@item.RequiredAttackLevel</span>
                                            }
                                            @if (item.RequiredDefenseLevel > 0)
                                            {
                                                <span class="rf-chip" title="Required defense level"><i class="fas fa-shield" aria-hidden="true"></i>@item.RequiredDefenseLevel</span>
                                            }
                                            @if (item.RequiredMagicLevel > 0)
                                            {
                                                <span class="rf-chip" title="Required magic or healing level"><i class="fas fa-hand-holding-magic" aria-hidden="true"></i>@item.RequiredMagicLevel</span>
                                            }
                                            @if (item.RequiredRangedLevel > 0)
                                            {
                                                <span class="rf-chip" title="Required ranged level"><i class="fas fa-bow-arrow" aria-hidden="true"></i>@item.RequiredRangedLevel</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="rf-price__value" title="@item.ShopSellPrice.ToString("N0") coins when vendored">
                                            <img class="rf-price__coin" src="/favicon.png" alt="coins" />
                                            @Utility.FormatAmount(item.ShopSellPrice)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="rf-recipe">
                                            @{
                                                var drop = ItemService.GetResourceItemDrop(item.Id);
                                                if (drop != null)
                                                {
                                                    <span class="rf-recipe__line">
                                                        <span class="rf-label">Dropped from</span>
                                                        <span>@drop.RequiredSkill level @drop.LevelRequirement</span>
                                                    </span>
                                                }

                                                var itemRecipe = ItemService.GetItemRecipe(item.Id);
                                                if (itemRecipe != null)
                                                {
                                                    <span class="rf-recipe__line">
                                                        <span class="rf-label">Made with</span>
                                                        <span>@itemRecipe.RequiredSkill level @itemRecipe.RequiredLevel</span>
                                                    </span>
                                                    <span class="rf-chips">
                                                        @foreach (var req in itemRecipe.Ingredients)
                                                        {
                                                            @*
                                                                Was availableItems.First(...), which throws rather than
                                                                returning null when a recipe names an ingredient that
                                                                has since been deleted. One such recipe took the whole
                                                                item list down.
                                                            *@
                                                            var reqItem = availableItems.FirstOrDefault(x => x.Id == req.ItemId);
                                                            <a class="rf-chip" href="/items/@req.ItemId">
                                                                @(reqItem?.Name ?? "Deleted item") <b>x@(req.Amount)</b>
                                                            </a>
                                                        }
                                                    </span>
                                                }

                                                var itemRecipes = ItemService.GetItemRecipesByIngredient(item.Id);
                                                if (itemRecipes != null && itemRecipes.Count > 0)
                                                {
                                                    <span class="rf-recipe__line">
                                                        <span class="rf-label">Ingredient in</span>
                                                    </span>
                                                    <span class="rf-chips">
                                                        @foreach (var r in itemRecipes)
                                                        {
                                                            <a class="rf-chip" href="/items/@r.ItemId">@r.Name</a>
                                                        }
                                                    </span>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="rf-actions">
                                            <button type="button" class="rf-btn rf-btn--small" @onclick="(() => EditItem(item))">
                                                <i class="fas fa-edit" aria-hidden="true"></i> Edit
                                            </button>
                                            @*
                                                Both of these already asked before acting, through the
                                                browser's own confirm box. They ask in the panel's own
                                                dialog now, and the delete one names the item and says
                                                how many are held across the game, which is the
                                                difference between deleting something nobody has and
                                                deleting something four hundred players are carrying.
                                            *@
                                            <button type="button" class="rf-btn rf-btn--small" title="Clear this item from every inventory, stash, vendor and listing" @onclick="(() => ConfirmClearPossessions(item))">
                                                Wipe
                                            </button>
                                            <button type="button" class="rf-btn rf-btn--small rf-btn--danger" @onclick="(() => ConfirmDeleteItem(item))">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (itemToDelete != null)
        {
            <div class="rf-modal-backdrop" @onclick="CancelDeleteItem">
                <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Delete item" @onclick:stopPropagation="true">
                    <div class="rf-modal__head">
                        <h2 class="rf-modal__title">Delete @itemToDelete.Name?</h2>
                        <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CancelDeleteItem">&times;</button>
                    </div>
                    <p>
                        The item definition is removed from the game.
                        @if (deleteTargetPossessions > 0)
                        {
                            <b>@deleteTargetPossessions.ToString("N0") of them are held right now</b>
                            <text> across inventories, stashes, vendors and marketplace listings.</text>
                        }
                        else
                        {
                            <text>Nobody is holding one.</text>
                        }
                    </p>
                    <p class="rf-meta">This cannot be undone.</p>
                    <div class="rf-modal__foot">
                        <button type="button" class="rf-btn" @onclick="CancelDeleteItem">Keep it</button>
                        <button type="button" class="rf-btn rf-btn--danger" @onclick="DeleteItemConfirmed">Delete the item</button>
                    </div>
                </div>
            </div>
        }

        @if (itemToClear != null)
        {
            <div class="rf-modal-backdrop" @onclick="CancelClearPossessions">
                <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Clear possessions" @onclick:stopPropagation="true">
                    <div class="rf-modal__head">
                        <h2 class="rf-modal__title">Wipe every @itemToClear.Name?</h2>
                        <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CancelClearPossessions">&times;</button>
                    </div>
                    <p>
                        <b>@clearTargetPossessions.ToString("N0")</b> of these are removed from every
                        inventory, stash, vendor and marketplace listing in the game. The item itself
                        stays.
                    </p>
                    <p class="rf-meta">This cannot be undone.</p>
                    <div class="rf-modal__foot">
                        <button type="button" class="rf-btn" @onclick="CancelClearPossessions">Cancel</button>
                        <button type="button" class="rf-btn rf-btn--danger" @onclick="ClearPossessionsConfirmed">Wipe them</button>
                    </div>
                </div>
            </div>
        }
    }
}

@code {

    private ItemEdit editedItem = new ItemEdit();
    private EditContext context;

    private string updateError = "";
    private bool isAdmin;
    private bool ItemEditorVisible;

    private ItemEditTab activeTab;

    private string jsonPresentation;
    private string unmodifiedJson;

    private RavenNest.Models.SessionInfo session;
    private RavenNest.Models.ItemCollection availableItems;
    private RavenNest.Models.ItemCollection items;
    private ItemFilter itemFilter = ItemFilter.All;

    private void ShowForm()
    {
        if (unmodifiedJson != jsonPresentation)
        {
            // try rebuild item from json
            try
            {
                editedItem = Newtonsoft.Json.JsonConvert.DeserializeObject<ItemEdit>(jsonPresentation);
                CreateContext();
            }
            catch { }
        }
        activeTab = ItemEditTab.Form;
        StateHasChanged();
    }

    private void ShowJson()
    {
        unmodifiedJson = jsonPresentation;
        activeTab = ItemEditTab.Json;
    }

    private void CreateContext()
    {
        UpdateJsonPresentation();
        if (context != null)
        {
            context.OnFieldChanged -= OnFieldChanged;
        }
        context = new EditContext(editedItem);
        context.OnFieldChanged += OnFieldChanged;
    }

    private void OnFieldChanged(object sender, FieldChangedEventArgs evt)
    {
        UpdateJsonPresentation();
    }

    private void UpdateJsonPresentation()
    {
        jsonPresentation = Newtonsoft.Json.JsonConvert.SerializeObject(editedItem, Newtonsoft.Json.Formatting.Indented);
    }

    protected override async Task OnInitializedAsync()
    {
        CreateContext();
        session = AuthService.GetSession();
        isAdmin = session != null && session.Administrator;
        await LoadItems();
    }

    private string search = "";

    private RavenNest.Models.Item itemToDelete;
    private long deleteTargetPossessions;

    private RavenNest.Models.Item itemToClear;
    private long clearTargetPossessions;

    private void SelectItemFilter(ItemFilter newItemFilter)
    {
        itemFilter = newItemFilter;
        ApplyFilters();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    ///     Bumped to empty the search box. A counter rather than a value, because the box
    ///     is only ever written by the server on a deliberate clear. See SearchBox.
    /// </summary>
    private int clearSignal;

    private void OnSearchChanged(string value)
    {
        search = value ?? "";
        ApplyFilters();
    }

    private void ClearFilters()
    {
        clearSignal++;
        search = "";
        itemFilter = ItemFilter.All;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (availableItems == null)
        {
            return;
        }

        var needle = search?.Trim();
        items = new Models.ItemCollection(
            availableItems
                .Where(x => Filter(x))
                .Where(x => string.IsNullOrEmpty(needle)
                            || (x.Name ?? "").Contains(needle, StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Name));
    }

    /// <summary>
    ///     Both destructive actions here already asked before acting, through the browser's own
    ///     confirm box. They ask in the panel's own dialog now, and deleting names the item and says
    ///     how many exist across the game: deleting something nobody holds and deleting something
    ///     four hundred players are carrying are not the same decision, and the old prompt said
    ///     "Are you sure you want to delete this item?" without even naming which.
    /// </summary>
    private void ConfirmDeleteItem(RavenNest.Models.Item item)
    {
        itemToDelete = item;
        deleteTargetPossessions = ItemService.GetPossessionCount(item.Id);
    }

    private void CancelDeleteItem()
    {
        itemToDelete = null;
    }

    private async Task DeleteItemConfirmed()
    {
        var item = itemToDelete;
        itemToDelete = null;
        if (item == null) return;

        if (await ItemService.DeleteItemAsync(item.Id))
        {
            await LoadItems();
            updateError = "";
        }
        else
        {
            updateError = "The server would not delete " + item.Name + ".";
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ConfirmClearPossessions(RavenNest.Models.Item item)
    {
        clearTargetPossessions = ItemService.GetPossessionCount(item.Id);
        if (clearTargetPossessions == 0)
        {
            // The old version returned silently here, so pressing the button on an item nobody
            // holds looked exactly like the button being broken.
            updateError = "Nobody is holding a " + item.Name + ", so there is nothing to wipe.";
            return;
        }

        updateError = "";
        itemToClear = item;
    }

    private void CancelClearPossessions()
    {
        itemToClear = null;
    }

    private async Task ClearPossessionsConfirmed()
    {
        var item = itemToClear;
        itemToClear = null;
        if (item == null) return;

        await ItemService.ClearPossessionsAsync(item.Id);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    ///     Whether an image has already been uploaded for the item being edited.
    /// </summary>
    /// <remarks>
    ///     A new item has no name: CreateNewItem sets only the id. This called
    ///     editedItem.Name.ToLower() unguarded, so opening the editor with New item threw a
    ///     NullReferenceException during render. In Blazor Server that is not a missing image, it
    ///     is an unhandled exception in a render tree, which takes the whole circuit down.
    /// </remarks>
    private bool ItemImageExists()
    {
        if (editedItem == null) return false;

        var itemsFolder = Path.Combine(Environment.WebRootPath, "imgs", "items");

        if (!string.IsNullOrEmpty(editedItem.IdString) &&
            File.Exists(Path.Combine(itemsFolder, editedItem.IdString + ".png")))
        {
            return true;
        }

        if (string.IsNullOrEmpty(editedItem.Name)) return false;

        var byName = editedItem.Name.ToLower().Replace(" ", "-").Replace("'", "") + ".png";
        return File.Exists(Path.Combine(itemsFolder, byName));
    }

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        var browserFile = e.File;

        if (e.File.ContentType != "image/png")
        {
            updateError = "Only PNG images are supported.";
            return;
        }

        var fileName = editedItem.Id + ".png";
        if (!string.IsNullOrEmpty(editedItem.Name))
            fileName = editedItem.Name.ToLower().Replace(" ", "-").Replace("'", "") + ".png";
        var path = Path.Combine(Environment.WebRootPath, "imgs", "items", fileName);
        if (File.Exists(path))
        {
            bool confirm = await JsRuntime.InvokeAsync<bool>("confirm", "An existing image already exists and this action will replace it. Are you sure?");
            if (!confirm)
            {
                return;
            }
        }

        await using FileStream fs = new(path, FileMode.Create);
        await browserFile.OpenReadStream().CopyToAsync(fs);

        StateHasChanged();
    }

    private void CreateNewItem()
    {
        var id = Guid.NewGuid();
        editedItem = new ItemEdit()
            {
                Id = id,
            };

        CreateContext();
        ItemEditorVisible = true;
    }
    private void EditItem(RavenNest.Models.Item item)
    {
        editedItem = DataMapper.Map<ItemEdit>(DataMapper.Clone(item));

        if (editedItem.ShopBuyPrice <= 0)
        {
            // The formula price, with no market anchor on purpose. This seeds a value that gets
            // stored on the item, and a market price is a live reading taken fresh at the till.
            // Baking one in here would freeze this week's trades into the item's own data, where it
            // would outlive them and quietly become the floor for everything after.
            editedItem.ShopBuyPrice = GameMath.CalculateVendorBuyPrice(item, 0, marketAnchor: 0);
        }

        CreateContext();
        ItemEditorVisible = true;
    }
    private bool CanHaveDefensiveStats()
    {
        return editedItem.Category == ItemCategory.Ring || editedItem.Category == ItemCategory.Amulet || editedItem.Category == ItemCategory.Armor || editedItem.Category == ItemCategory.Skin;
    }

    private bool CanHaveOffensiveStats()
    {
        return editedItem.Category == ItemCategory.Ring || editedItem.Category == ItemCategory.Amulet || editedItem.Category == ItemCategory.Weapon || editedItem.Category == ItemCategory.Skin;
    }

    private bool CanBeEquipped()
    {
        return editedItem.Category == ItemCategory.Ring || editedItem.Category == ItemCategory.Cosmetic || editedItem.Category == ItemCategory.Amulet || editedItem.Category == ItemCategory.Weapon || editedItem.Category == ItemCategory.Armor || editedItem.Category == ItemCategory.Skin;
    }


    private async void HandleSaveItem()
    {
        //if (context.IsModified())
        {
            if (!string.IsNullOrEmpty(editedItem.IdString) && Guid.TryParse(editedItem.IdString, out var newId))
            {
                editedItem.Id = newId;
            }

            var result = await ItemService.AddOrUpdateItemAsync(editedItem);
            if (result)
            {
                await LoadItems();
                updateError = "";
            }
            else
            {
                updateError = "Failed to update or create item";
            }

            ItemEditorVisible = false;
            StateHasChanged();
        }
    }

    private async Task LoadItems()
    {
        availableItems = new Models.ItemCollection((await ItemService.GetItemsAsync()).OrderBy(x => x.Name));

        if (itemFilter == ItemFilter.All)
        {
            items = new Models.ItemCollection(availableItems.OrderBy(x => x.Name));
            return;
        }

        SelectItemFilter(itemFilter);
    }

    private bool Filter(Models.Item item)
    {
        return ItemService.Filter(itemFilter, item);
    }

    public class ItemEdit : RavenNest.Models.Item
    {
        public string IdString
        {
            get => Id.ToString();
            set
            {
                if (!string.IsNullOrEmpty(value) && Guid.TryParse(value, out var newId))
                {
                    Id = newId;
                }
            }
        }
    }

    public enum ItemEditTab
    {
        Form,
        Json
    }
}