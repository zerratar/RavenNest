@layout AdminLayout
@page "/admin/players"
@using RavenNest
@using RavenNest.BusinessLogic.Extended
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.PlayerService PlayerService
@inject NavigationManager NavigationManager

<header class="rf-page-head">
    <h1 class="rf-page-title">Characters</h1>
    <p class="rf-page-subtitle">
        Every character in the game, newest page first. Search matches an id, a username or a
        character name.
    </p>
</header>

<div class="rf-toolbar">
    <EditForm Model="searchModel" OnSubmit="Filter">
        <input type="search"
               class="rf-input rf-search"
               placeholder="Search for id, username or name"
               aria-label="Search characters"
               @bind="searchModel.Query" />
    </EditForm>

    <div class="rf-actions">
        <button type="button" class="rf-btn rf-btn--small" disabled="@(pageIndex == 0)" @onclick="PreviousPage">
            <i class="fas fa-chevron-left" aria-hidden="true"></i> Previous
        </button>
        <span class="rf-meta">Page @(pageIndex + 1) of @pageCount</span>
        @*
            Next used to increment the page index with no upper bound, so you could page past the
            end of the table into an empty screen and had to guess your way back.
        *@
        <button type="button" class="rf-btn rf-btn--small" disabled="@(pageIndex + 1 >= pageCount)" @onclick="NextPage">
            Next <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </button>
    </div>

    <span class="rf-meta">@totalCount.ToString("N0") characters</span>
</div>

@if (players == null || loading)
{
    @* This used to sit inside the tbody, which is not somewhere a div can go: the browser hoists
       it out of the table and the loading state rendered above the header row. *@
    <LoadIndicator></LoadIndicator>
}
else if (players.Count == 0)
{
    <div class="rf-panel">
        <p class="rf-meta">No characters match that search.</p>
    </div>
}
else
{
    <div class="rf-panel">
        <div class="rf-scroll-x">
            <table class="rf-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="rf-th rf-th--static">Character</span></th>
                        <th scope="col"><span class="rf-th rf-th--static">Level</span></th>
                        <th scope="col"><span class="rf-th rf-th--static">Playing on</span></th>
                        <th scope="col"><span class="rf-th rf-th--static">Roles</span></th>
                        <th scope="col"><span class="rf-th rf-th--static">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in players)
                    {
                        <tr>
                            <td>
                                <div class="rf-item">
                                    <span class="rf-item__body">
                                        <a class="rf-item__name" href="/inspect/@player.Id" target="_blank">
                                            @(player.Name ?? player.UserName)
                                        </a>
                                        <span class="rf-item__meta">
                                            <span>@player.UserName #@player.CharacterIndex</span>
                                            @*
                                                The alias is what a viewer types after !join to pick this
                                                character. It is the one identifier support questions are
                                                actually about and it was on the row already.
                                            *@
                                            @if (!string.IsNullOrEmpty(player.Identifier))
                                            {
                                                <span class="rf-item__mark" title="Joined in chat with this alias">@player.Identifier</span>
                                            }
                                        </span>
                                    </span>
                                </div>
                            </td>
                            <td class="rf-table__quiet">@player.CombatLevel</td>
                            <td>
                                @if (string.IsNullOrEmpty(player.SessionName))
                                {
                                    <span class="rf-meta">Not on a stream</span>
                                }
                                else
                                {
                                    <a class="rf-chip" href="https://www.twitch.tv/@player.SessionName" target="_blank" rel="noopener">
                                        <i class="fab fa-twitch" aria-hidden="true"></i>@player.SessionName
                                    </a>
                                }
                            </td>
                            <td>
                                @if (player.IsAdmin)
                                {
                                    <span class="rf-badge rf-badge--gold">Admin</span>
                                }
                                @if (player.IsModerator)
                                {
                                    <span class="rf-badge rf-badge--gold">Mod</span>
                                }
                                @if (!player.IsAdmin && !player.IsModerator)
                                {
                                    <span class="rf-meta">Player</span>
                                }
                            </td>
                            <td>
                                @*
                                    Four icon only buttons with a title attribute, two of which were
                                    the same shade of red for "kick from the session" and "delete the
                                    character for ever". Words now, and the two that cannot be undone
                                    ask first.
                                *@
                                <div class="rf-actions">
                                    @if (NameDiffersFromUsername(player))
                                    {
                                        <button type="button" class="rf-btn rf-btn--small" @onclick="() => MakeNameMatchUsername(player)">
                                            Rename to @player.UserName
                                        </button>
                                    }

                                    @if (!string.IsNullOrEmpty(player.SessionName))
                                    {
                                        <button type="button" class="rf-btn rf-btn--small" @onclick="() => ConfirmKick(player)">Kick</button>
                                    }

                                    @if (CanAddToMySession(player))
                                    {
                                        <button type="button" class="rf-btn rf-btn--small" @onclick="() => AddToMyGame(player)">Add to my stream</button>
                                    }

                                    <button type="button" class="rf-btn rf-btn--small rf-btn--danger" @onclick="() => DeletePlayer(player)">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (confirmDeletePlayer && playerToDelete != null)
{
    <div class="rf-modal-backdrop" @onclick="CancelDeletePlayer">
        <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Delete character" @onclick:stopPropagation="true">
            <div class="rf-modal__head">
                <h2 class="rf-modal__title">Delete this character?</h2>
                <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CancelDeletePlayer">&times;</button>
            </div>
            <p>
                <b>@(playerToDelete.Name ?? playerToDelete.UserName)</b> (@playerToDelete.UserName
                #@playerToDelete.CharacterIndex, combat level @playerToDelete.CombatLevel) and
                everything on it goes away. This cannot be undone.
            </p>
            <div class="rf-modal__foot">
                <button type="button" class="rf-btn" @onclick="CancelDeletePlayer">Keep it</button>
                <button type="button" class="rf-btn rf-btn--danger" @onclick="ConfirmDeletePlayer">Delete the character</button>
            </div>
        </div>
    </div>
}

@if (playerToKick != null)
{
    <div class="rf-modal-backdrop" @onclick="CancelKick">
        <div class="rf-modal" role="dialog" aria-modal="true" aria-label="Kick from session" @onclick:stopPropagation="true">
            <div class="rf-modal__head">
                <h2 class="rf-modal__title">Kick from the stream?</h2>
                <button type="button" class="rf-modal__close" aria-label="Close" @onclick="CancelKick">&times;</button>
            </div>
            <p>
                <b>@(playerToKick.Name ?? playerToKick.UserName)</b> leaves
                <b>@playerToKick.SessionName</b> and stops training until they join again.
            </p>
            <div class="rf-modal__foot">
                <button type="button" class="rf-btn" @onclick="CancelKick">Cancel</button>
                <button type="button" class="rf-btn rf-btn--danger" @onclick="ApplyKick">Kick</button>
            </div>
        </div>
    </div>
}

@code {
    private bool loading = false;
    private PlayerSearchModel searchModel = new PlayerSearchModel();
    private RavenNest.Models.SessionInfo session;
    private IReadOnlyList<WebsiteAdminPlayer> players;
    private int pageIndex = 0;
    private int pageSize = 50;
    private int pageCount = 1;
    private long totalCount = 0;

    private bool confirmDeletePlayer;
    private WebsiteAdminPlayer playerToDelete;
    private WebsiteAdminPlayer playerToKick;

    /// <summary>
    ///     Both of these used to call Equals on a name that can be null, so one character with no
    ///     username took the whole page down rather than one row.
    /// </summary>
    private static bool NameDiffersFromUsername(WebsiteAdminPlayer player)
    {
        return !string.IsNullOrEmpty(player.UserName)
            && !string.Equals(player.UserName, player.Name, StringComparison.OrdinalIgnoreCase);
    }

    private bool CanAddToMySession(WebsiteAdminPlayer player)
    {
        return string.IsNullOrEmpty(player.SessionName)
            || !string.Equals(player.SessionName, session?.UserName, StringComparison.OrdinalIgnoreCase);
    }

    private async Task ConfirmDeletePlayer()
    {
        if (playerToDelete == null) return;
        await PlayerService.DeletePlayerAsync(playerToDelete.Id);
        confirmDeletePlayer = false;
        playerToDelete = null;
        await LoadPlayerPageAsync(pageIndex, pageSize);
    }

    private void CancelDeletePlayer()
    {
        playerToDelete = null;
        confirmDeletePlayer = false;
    }

    private void DeletePlayer(WebsiteAdminPlayer player)
    {
        playerToDelete = player;
        confirmDeletePlayer = true;
    }

    protected override async Task OnInitializedAsync()
    {
        session = AuthService.GetSession();
        await LoadPlayerPageAsync(pageIndex, pageSize);
    }

    private void ConfirmKick(WebsiteAdminPlayer player)
    {
        playerToKick = player;
    }

    private void CancelKick()
    {
        playerToKick = null;
    }

    private async Task ApplyKick()
    {
        var player = playerToKick;
        playerToKick = null;
        if (player == null) return;

        PlayerService.Kick(player);
        await LoadPlayerPageAsync(pageIndex, pageSize);
    }

    private async Task AddToMyGame(WebsiteAdminPlayer player)
    {
        PlayerService.AddToMySession(player);
        await LoadPlayerPageAsync(pageIndex, pageSize);
    }

    private async Task MakeNameMatchUsername(WebsiteAdminPlayer player)
    {
        PlayerService.MakeNameMatchUsername(player);
        await LoadPlayerPageAsync(pageIndex, pageSize);
    }

    private async Task Filter()
    {
        pageIndex = 0;
        await LoadPlayerPageAsync(pageIndex, pageSize);
    }

    private async Task NextPage()
    {
        if (pageIndex + 1 >= pageCount) return;
        ++pageIndex;
        await LoadPlayerPageAsync(pageIndex, pageSize);
    }

    private async Task PreviousPage()
    {
        if (pageIndex == 0) return;
        --pageIndex;
        await LoadPlayerPageAsync(pageIndex, pageSize);
    }

    private async Task LoadPlayerPageAsync(int index, int take)
    {
        loading = true;
        var filter = searchModel.Query;
        var result = await PlayerService.GetPlayerPageAsync(filter, index, take);
        players = result.Items;
        totalCount = result.TotalSize;
        // Was floor(total / pageSize) + 1, which claims one page too many whenever the total
        // divides evenly: 100 characters over 50 a page reported three pages.
        pageCount = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    public class PlayerSearchModel
    {
        public string Query { get; set; }
    }
}
