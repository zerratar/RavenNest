@layout MainLayout
@page "/password"
@using RavenNest.Blazor.Services.Models
@inject RavenNest.Blazor.Services.AccountService AccountService
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject NavigationManager NavigationManager

<div class="top-section">
    <div class="hero-text">
        @*
            The heading used to be down in the body with an empty hero above it, so the page opened
            with 20rem of photograph and no title on it.
        *@
        <h1>@(RequiresPassword ? "Set a password" : "Change your password")</h1>
    </div>
</div>

<div class="white-section-break"></div>
<div class="page-content">
    <div class="section">
        @if (session == null)
        {
            <LoadIndicator></LoadIndicator>
        }
        else
        {
            <div class="rf-narrow">
                <div class="rf-panel">
                    <p class="rf-meta">
                        @if (RequiresPassword)
                        {
                            <span>
                                This is the password the Ravenfall client signs in with, and you need
                                one to run the game on your own stream.
                            </span>
                        }
                        else
                        {
                            <span>
                                This is the password the Ravenfall client signs in with. Setting a new
                                one replaces whatever you had before.
                            </span>
                        }
                        You do not need it to play in somebody else's stream, only to run the game
                        yourself.
                    </p>

                    <dl class="rf-facts">
                        <dt>Sign in as</dt>
                        <dd>@session.UserName</dd>
                    </dl>

                    @if (failed)
                    {
                        @*
                            SetPasswordAsync returns false when the session has gone or the account
                            cannot be found, and nothing looked at the result: the button did nothing
                            at all and the page gave no reason.
                        *@
                        <div class="rf-banner rf-banner--bad" role="alert">
                            <p class="rf-banner__title">The password was not saved</p>
                            <p>
                                Your sign in may have expired. <a href="/login">Sign in again</a> and
                                try once more.
                            </p>
                        </div>
                    }

                    <EditForm Model="@createPassword" OnValidSubmit="@SignupAsync">
                        <DataAnnotationsValidator />

                        <label class="rf-field">
                            <span class="rf-label">New password</span>
                            <InputText class="rf-input" id="password" type="password"
                                       autocomplete="new-password" @bind-Value="createPassword.Password" />
                            @*
                                The limits were half in a placeholder that disappears as soon as you
                                type, and the maximum was nowhere at all until the form rejected you.
                            *@
                            <span class="rf-meta">Between 6 and 32 characters.</span>
                        </label>

                        <ValidationSummary />

                        <button type="submit" class="rf-btn rf-btn--primary rf-btn--block" disabled="@saving">
                            @(saving ? "Saving" : "Save password")
                        </button>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private RavenNest.Models.SessionInfo session;
    private CreatePassword createPassword = new CreatePassword();
    private bool failed;
    private bool saving;

    private bool RequiresPassword => session != null && session.RequiresPasswordChange;

    protected override void OnInitialized()
    {
        session = AuthService.GetSession();
    }

    private async Task SignupAsync()
    {
        failed = false;
        saving = true;
        try
        {
            if (await AccountService.SetPasswordAsync(createPassword))
            {
                NavigationManager.NavigateTo("/dashboard");
                return;
            }

            failed = true;
        }
        finally
        {
            saving = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (session == null || !session.Authenticated)
        {
            NavigationManager.NavigateTo("/login/redirect/password");
        }
    }
}
