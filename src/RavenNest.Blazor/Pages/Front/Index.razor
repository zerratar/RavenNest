@page "/"
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject RavenNest.Blazor.Services.TwitchService TwitchService
@inject RavenNest.Blazor.Services.NewsService NewsService
@inject NavigationManager NavigationManager

@* The one hero that carries a paragraph and two buttons, and the one place a large image of the
   world is the point of the page. Every other hero is the shared height. *@
<div class="top-section top-section--tall">
    <div class="hero-text">
        <b>Ravenfall</b> is a <b>Twitch</b> Integrated Idle game you can play with your viewers. The viewers control their characters using chat commands to train their characters in various skills and competing in the leaderboard or helping out fighting huge bosses together.
    </div>
    <div class="rf-herobtns">
        <RavenLink Href="/download" Target="_self" CssClass="blue download-btn"><i class="fa-solid fa-download"></i>&nbsp;Download the game</RavenLink>
        <RavenLink Href="https://discord.gg/gtfDts7"><i class="fa-brands fa-discord"></i>&nbsp;Join the Community</RavenLink>
    </div>
</div>

<div class="white-section-break"></div>

<div class="page-content">
    <div class="section">
        <h1>Features</h1>
        <a id="features" name="features"></a>

        @*
            Was a grid of images with a sentence under each, and the sentence had to carry the
            whole idea because nothing named the feature. Each one leads with what it is now, so
            the list can be skimmed rather than read.
        *@
        <div class="rf-features">
            <div class="rf-feature">
                <img class="rf-feature__img" src="/imgs/users.png" alt="" loading="lazy" />
                <h3 class="rf-feature__title">Loyalty rewards</h3>
                <p class="rf-feature__body">Engage and retain your viewers with rewards for the time they play on your stream.</p>
            </div>

            <div class="rf-feature">
                <img class="rf-feature__img" src="/imgs/customization.png" alt="" loading="lazy" />
                <h3 class="rf-feature__title">Clans and customisation</h3>
                <p class="rf-feature__body">Adjust the experience with clans your viewers join and characters they make their own.</p>
            </div>

            <div class="rf-feature">
                <img class="rf-feature__img" src="/imgs/twitch.png" alt="" loading="lazy" />
                <h3 class="rf-feature__title">Channel point events</h3>
                <p class="rf-feature__body">Use the Twitch channel points system to trigger unique events in the game.</p>
            </div>

            <div class="rf-feature">
                <img class="rf-feature__img" src="/imgs/strength.png" alt="" loading="lazy" />
                <h3 class="rf-feature__title">Raids and bosses</h3>
                <p class="rf-feature__body">Play along with your viewers to bring down enormous bosses together.</p>
            </div>

            <div class="rf-feature">
                <img class="rf-feature__img" src="/imgs/attack.png" alt="" loading="lazy" />
                <h3 class="rf-feature__title">Twenty skills</h3>
                <p class="rf-feature__body">Players specialise in different skills and compete with each other on the leaderboards.</p>
            </div>

            <div class="rf-feature">
                <img class="rf-feature__img" src="/imgs/marketplace.png" alt="" loading="lazy" />
                <h3 class="rf-feature__title">Trading</h3>
                <p class="rf-feature__body">Players trade directly with each other or list what they find on the global marketplace.</p>
            </div>

            <div class="rf-feature">
                <img class="rf-feature__img" src="/imgs/crafting.png" alt="" loading="lazy" />
                <h3 class="rf-feature__title">Crafting</h3>
                <p class="rf-feature__body">Craft armour and weapons from materials gathered by mining, woodcutting and dungeon drops.</p>
            </div>
        </div>
    </div>

    <div class="section">
        <h1>Streaming now</h1>
        @if (twitchStreams == null)
        {
            <LoadIndicator></LoadIndicator>
        }
        else if (twitchStreams.Count == 0)
        {
            <p class="rf-lead">
                The ravens are chasing something shiny right now, check back in a bit.
                Want to be featured here? Stream Ravenfall.
            </p>
        }
        else
        {
            <p class="rf-lead">
                Want to get a feel for the game? Here is who is playing it right now.
            </p>

            @*
                The same stream card /streams uses, not a second one. Building another here is how
                the stash and the inventory ended up as two implementations of one screen with
                different labels for the same thing.
            *@
            <div class="rf-streams__grid">
                @foreach (var stream in twitchStreams)
                {
                    <div class="rf-stream">
                        @if (stream.IsVisible)
                        {
                            <iframe class="rf-stream__player"
                                    title="@stream.TwitchUserName on Twitch"
                                    src="https://player.twitch.tv/?channel=@(stream.TwitchUserName)&autoplay=false&parent=www.ravenfall.stream&parent=ravenfall.stream&parent=www.ravenfall.gg&parent=ravenfall.gg&parent=localhost"
                                    height="180" width="320" frameborder="0" scrolling="no"
                                    allowfullscreen="true">
                            </iframe>
                        }
                        else
                        {
                            <button type="button"
                                    class="rf-stream__preview"
                                    aria-label="Watch @stream.TwitchUserName here"
                                    style="background-image: url('@("https://static-cdn.jtvnw.net/previews-ttv/live_user_" + stream.TwitchUserName + "-320x180.jpg")')"
                                    @onclick="() => ShowStream(stream)">
                                <span class="rf-stream__play"><i class="fas fa-play" aria-hidden="true"></i></span>
                            </button>
                        }

                        <div class="rf-stream__body">
                            <a class="rf-stream__name" href="https://www.twitch.tv/@stream.TwitchUserName" target="_blank" rel="noopener">
                                <i class="fab fa-twitch" aria-hidden="true"></i> @stream.TwitchUserName
                            </a>
                            @if (!string.IsNullOrEmpty(stream.UserTitle))
                            {
                                <span class="rf-stream__title" title="@stream.UserTitle">@stream.UserTitle</span>
                            }
                            <span class="rf-stream__meta">
                                <span class="rf-badge rf-badge--good">Live</span>
                                <span>@stream.PlayerCount @(stream.PlayerCount == 1 ? "player" : "players")</span>
                            </span>
                        </div>
                    </div>
                }
            </div>

            <div class="rf-actions rf-actions--centred">
                <RavenButton CssClass="twitch" NavigateTo="/streams"><i class="fab fa-twitch"></i>&nbsp;All streams</RavenButton>
            </div>
        }
    </div>

    <div class="section">
        <h1>Patreon</h1>
        <div class="rf-patron-cta">
            <p class="rf-patron-cta__kicker">Made possible by you</p>
            <p class="rf-patron-cta__body">
                Our community supports Ravenfall through Patreon. Support the game from
                <b>$5 a month</b> and you get a patron-only channel on Discord with exclusive
                updates and surveys, and rewards in game that grow with your tier.
            </p>
            <div class="rf-actions rf-actions--centred">
                <RavenLink Href="https://www.patreon.com/ravenfall"><i class="fab fa-patreon"></i>&nbsp;Become a patron</RavenLink>
                <RavenLink Href="/tiers" Target="_self" CssClass="blue">See what each tier unlocks</RavenLink>
            </div>
        </div>
    </div>
</div>
