@page "/login"
@page "/login/redirect/{*redirectUrl}"
@page "/login/twitch/{*redirectUrl}"
@page "/login/kick/{*redirectUrl}"
@using RavenNest.Blazor.Services.Models
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager
@inject RavenNest.Blazor.Services.AuthService AuthService
@inject IJSRuntime JS

@*
    Two quite different pages share this route.

    One is the popup the game client and the Twitch redirect land in, which exists only to say what
    is happening and then close itself.

    The other is the sign in page a person navigates to, and it has no hero. Every other front page
    opens with a photograph and a torn edge under it, which is right for a page you browse and
    wrong for one with a single job: it pushed the only thing on the page most of a screen down and
    put a lot of noise behind a form. One column, centred, nothing else on it.

    Kick is not offered. The route and the token exchange stay because the server side works, but
    nothing on the site points at it until it is a thing we support.
*@

@if (IsHandingOff)
{
    <div class="rf-narrow rf-narrow--pad">
        <div class="rf-panel">
            @if (tokenGenerationComplete)
            {
                <h1 class="rf-panel__title">Signed in</h1>
                <p class="rf-meta">You can close this window now.</p>
            }
            else if (loginFailed)
            {
                <h1 class="rf-panel__title">That did not work</h1>
                <p class="rf-meta">@(string.IsNullOrEmpty(loginFailedError) ? "Twitch returned an error." : loginFailedError)</p>
                <div class="rf-actions">
                    <a class="rf-btn" href="/login">Try again</a>
                </div>
            }
            else
            {
                <h1 class="rf-panel__title">Signing you in</h1>
                <p class="rf-meta">This window closes itself when it is done.</p>
                <LoadIndicator></LoadIndicator>
            }
        </div>
    </div>
}
else
{
    <div class="rf-auth">
        <a class="rf-auth__brand" href="/" aria-label="Ravenfall home">
            <img src="/imgs/logo.png" alt="Ravenfall" />
        </a>

        @if (IsAuthenticated)
        {
            @*
                Was a bare "Welcome back, name" with nothing to click, on the one page a signed in
                person only reaches by mistake.
            *@
            <h1 class="rf-auth__title">You are signed in</h1>
            <p class="rf-auth__lead">as <b>@session.UserName</b></p>

            <div class="rf-auth__card">
                <a class="rf-btn rf-btn--primary rf-btn--block" href="/dashboard">Go to your dashboard</a>
                <a class="rf-btn rf-btn--block" href="/characters">Your characters</a>
            </div>
        }
        else
        {
            <h1 class="rf-auth__title">Sign in</h1>
            <p class="rf-auth__lead">Your characters belong to your Twitch account.</p>

            <div class="rf-auth__card">
                @*
                    Twitch first, and in Twitch's own colour. Almost nobody has a Ravenfall password
                    until they want to run the client, and this page used to put the password form
                    at the top with the Twitch button underneath it as though it were the fallback.
                *@
                <button type="button" class="rf-btn rf-btn--twitch rf-btn--block rf-btn--tall" @onclick="LoginWithTwitch">
                    <i class="fab fa-twitch" aria-hidden="true"></i> Continue with Twitch
                </button>

                <div class="rf-or"><span>or use a Ravenfall password</span></div>

                @if (loginFailed)
                {
                    @*
                        Was "Whops. Wrong username or password.", which manages to be both a typo
                        and unhelpful about the likeliest cause: most people who fail here never had
                        a Ravenfall password in the first place.
                    *@
                    <div class="rf-banner rf-banner--bad" role="alert">
                        <p class="rf-banner__title">That did not match</p>
                        <p>
                            This is the password you set for the game client, not your Twitch
                            password. If you have never set one, use Twitch above.
                        </p>
                    </div>
                }

                <EditForm Model="@loginModel" OnValidSubmit="@HandleValidSubmit">
                    <DataAnnotationsValidator />

                    @*
                        Placeholders were doing the work of labels, so the fields were unnamed once
                        you had typed in them and no password manager had anything to go on.
                    *@
                    <label class="rf-field">
                        <span class="rf-label">Username</span>
                        <InputText class="rf-input" id="username" autocomplete="username" @bind-Value="loginModel.Username" />
                    </label>

                    <label class="rf-field">
                        <span class="rf-label">Password</span>
                        <InputText class="rf-input" type="password" id="password" autocomplete="current-password" @bind-Value="loginModel.Password" />
                    </label>

                    <ValidationSummary />

                    <button type="submit" class="rf-btn rf-btn--block">
                        <i class="fas fa-key" aria-hidden="true"></i> Sign in
                    </button>
                </EditForm>

                <p class="rf-auth__hint">
                    The password the game client signs in with, not your Twitch one. Forgotten it?
                    Use Twitch above, then <a href="/password">set a new one</a>.
                </p>
            </div>

            @*
                Said "there is nothing to sign up for", which is not what happens. Signing in with
                Twitch is the sign up: TwitchLoginAsync calls CreatePlayerIfNotExists, so a first
                time visitor who presses the button above comes out the other side with an account.
            *@
            <p class="rf-auth__foot">
                New here? Signing in with Twitch creates your account, there is nothing to fill in.
                You can also start playing without any of this, by typing
                <span class="rf-cmd">!join</span> in the chat of any
                <a href="/streams">stream running Ravenfall</a>.
            </p>
        }
    </div>
}

@code {
    [Parameter]
    public string RedirectUrl { get; set; }

    private bool isAfterRender;
    private UserLoginModel loginModel = new UserLoginModel();
    private RavenNest.Models.SessionInfo session;
    private bool loginFailed = false;
    private string loginFailedError = "";
    private bool userInitiatedLogin = false;
    private bool twitchLoginInitiated = false;
    private bool IsAuthenticated => session != null && session.UserName != null;
    private bool IsLoggingIn => !IsAuthenticated && (userInitiatedLogin || HasQueryParams());

    // The route still exists and the token exchange below still handles it, but nothing offers it.
    private bool IsKickLogin => NavigationManager.Uri.Contains("login/kick", StringComparison.OrdinalIgnoreCase);
    private bool IsTwitchLogin => twitchLoginInitiated || NavigationManager.Uri.Contains("login/twitch", StringComparison.OrdinalIgnoreCase);
    private bool tokenGenerationComplete = false;

    /// <summary>
    ///     True while this page is a popup handing a token back rather than a page somebody is
    ///     reading. Same three conditions the markup used to test one after another.
    /// </summary>
    private bool IsHandingOff => IsKickLogin || IsTwitchLogin || IsLoggingIn;

    protected override async Task OnInitializedAsync()
    {
        isAfterRender = false;
        await HandleOAuthLoginAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        isAfterRender = true;
        if (!await UpdateGameClientLoginStateAsync())
        {
            await NavigateToLastPageOrHomeIfAuthenticated();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private bool HasQueryParams()
    {
        string fragment = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Fragment;
        if (!string.IsNullOrEmpty(fragment))
            return fragment.Substring(0, 1).Contains("?") || fragment.Substring(0, 1).Contains("#");

        return false;
    }

    private async Task<bool> UpdateGameClientLoginStateAsync()
    {
        try
        {
            if (await JS.InvokeAsync<bool>("updateGameClientLoginStateAsync", new object[] { }))
            {
                await CloseWindow();
                return true;
            }

        }
        catch { }

        return false;
    }

    private async Task CloseWindow()
    {
        try
        {
            await JS.InvokeVoidAsync("window.close");
        }
        catch { }
        try
        {
            tokenGenerationComplete = true;
            this.StateHasChanged();
        }
        catch { }
    }

    private async Task HandleOAuthLoginAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var queryString = uri.Fragment;
        if (string.IsNullOrEmpty(queryString))
        {
            queryString = uri.Query;
        }
        bool pubsub = false;

        loginFailed = false;
        loginFailedError = "";

        if (string.IsNullOrEmpty(queryString))
        {
            session = AuthService.GetSession();
            userInitiatedLogin = false;
            return;
        }

        if (queryString.StartsWith("?") || queryString.StartsWith("#"))
        {
            queryString = queryString.Substring(1);
        }

        var parsedQuery = System.Web.HttpUtility.ParseQueryString(queryString);

        userInitiatedLogin = true;
        var state = parsedQuery.Get("state");

        var error = parsedQuery.Get("error");
        var error_description = parsedQuery.Get("error_description");


        // check if we already have a session
        session = AuthService.GetSession();

        if (!string.IsNullOrEmpty(error))
        {
            loginFailed = true;
            loginFailedError = error_description;
            return;
        }

        var code_verifier = "";
        var code_challenge = "";
        var scope = "";

        if (!string.IsNullOrEmpty(state))
        {

            var objects = AuthService.GetDecodedObjectFromState(state, uri.ToString());
            foreach (var parameter in objects)
            {
                switch (parameter.ParametersName)
                {
                    case "pubsub":
                        pubsub = parameter.ParametersValue.Equals("true");
                        break;
                    case "redirect":
                        RedirectUrl = parameter.ParametersValue;
                        break;
                    case "scope":
                        scope = parameter.ParametersValue;
                        break;
                    case "code_verifier":
                        code_verifier = parameter.ParametersValue;
                        break;
                    case "code_challenge":
                        code_challenge = parameter.ParametersValue;
                        break;
                    case "state_token":
                        break;
                }
            }
        }

        if (pubsub)
        {
            var token = parsedQuery.Get("access_token");
            await AuthService.GrantPubSubAccessAsync(token);
            await CloseWindow();
            return;
        }

        if (session == null || !session.Authenticated)
        {
            if (uri.AbsolutePath.Contains("kick", StringComparison.OrdinalIgnoreCase))
            {
                var code = parsedQuery.Get("code");
                session = await AuthService.KickLoginAsync(code, scope, code_verifier, code_challenge, NavigationManager.BaseUri);
            }
            else
            {
                var token = parsedQuery.Get("access_token");
                session = await AuthService.TwitchLoginAsync(token);
            }

            if (session == null)
            {
                loginFailed = true;
                return;
            }
        }

        userInitiatedLogin = false;
        loginFailed = !IsAuthenticated;
        await NavigateToLastPageOrHomeIfAuthenticated();
    }

    private async Task HandleValidSubmit()
    {
        userInitiatedLogin = true;
        session = await AuthService.LoginAsync(loginModel);

        // A failed sign in used to leave userInitiatedLogin set on one path and clear on another,
        // which is what decided whether the page showed the form again or the "logging in" state.
        if (session == null || string.IsNullOrEmpty(session.UserName))
        {
            session = null;
            userInitiatedLogin = false;
            loginFailed = true;
            return;
        }

        loginFailed = false;
        await NavigateToLastPageOrHomeIfAuthenticated();
    }

    private async Task LoginWithTwitch()
    {
        userInitiatedLogin = true;
        twitchLoginInitiated = true;
        var url = AuthService.GetTwitchLoginUrl(RedirectUrl ?? "", NavigationManager.BaseUri);
        if (!string.IsNullOrEmpty(url))
        {
            await JS.InvokeVoidAsync("window.navigateTo", url);
        }
    }

    private async Task NavigateToLastPageOrHomeIfAuthenticated()
    {
        if (!IsAuthenticated || !isAfterRender)
            return;

        try
        {
            loginFailed = false;
            userInitiatedLogin = false;
            MainLayout.Instance.UpdateSession();
            if (!string.IsNullOrEmpty(RedirectUrl))
            {
                await JS.InvokeVoidAsync("window.navigateTo", RedirectUrl);
            }
            else if (session.UserNameChanged)
            {
                await JS.InvokeVoidAsync("window.navigateTo", "/username-changed");
            }
            else if (session.RequiresPasswordChange)
            {
                await JS.InvokeVoidAsync("window.navigateTo", "/password");
            }
            else
            {
                NavigationManager.NavigateTo("", true); // "/"
            }
        }
        catch { }
    }
}
