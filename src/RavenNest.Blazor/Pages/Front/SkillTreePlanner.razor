@page "/skill-trees"
@using RavenNest.Blazor.Extensions
@using RavenNest.Combat
@inject IJSRuntime JS
@inject NavigationManager Navigation

@*
    The skill tree planner (combat v2, the game's docs/combat-skills-design.md): anyone, signed in or not, sets the
    combat levels they have in mind and tries a build on the same map the character page shows (js/rf-skill-tree.js),
    with the same rules (RavenNest.Combat.SkillBuild): points from the levels, nodes opened by their tree's level, the
    loadout. Nothing is saved; the address carries the build and the levels, so a build can be shared as a link.
*@
<div class="top-section">
    <div class="hero-text">
        <h1>Skill tree planner</h1>
    </div>
</div>

<div class="white-section-break"></div>
<div class="page-content">
    <div class="section rf-trees">
        <p class="rf-meta">
            Set the combat levels you have in mind (Levels, in the map's corner), then tap stars to learn them. Nothing here
            changes a character: Copy link shares the build, Save keeps it in this browser. Signed in, your character page's
            Skill trees tab has the same planner beside your real build.
        </p>
        <div class="rf-trees__wide">
            <SkillTreeStage Build="build" Levels="LevelOf" Earned="earned" CanEdit="true" Planner="true"
                            LevelValues="levelValues" OnLevels="SetLevels" OnReset="Reset" OnLoadPlan="LoadPlan" ShareLink="Link"
                            OnLearn="Learn" OnLower="Lower" OnSlot="Slot" OnRule="Rule" />
        </div>
        <p class="rf-meta rf-trees__hint">Drag to move, scroll or pinch to zoom, tap a star to see its skill. Diamonds are active skills, circles passives, hexagons the special ones.</p>

        <div class="rf-panel">
            <h3 class="rf-panel__title">What the build gives</h3>
            @{ var passives = build.Passives(); }
            @if (passives.IsEmpty)
            {
                <p class="rf-meta">No passives yet.</p>
            }
            else
            {
                <div class="rf-chips">
                    @for (var s = 0; s < GearStats.Count; ++s)
                    {
                        var stat = (GearStat)s;
                        var v = passives[stat];
                        if (v == 0) continue;
                        <span class="rf-chip">@GearStats.Label(stat) @(GearStats.IsShare(stat) ? (v * 100).ToString("0.#") + "%" : v.ToString("0"))</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "build")] public string BuildText { get; set; }
    [SupplyParameterFromQuery(Name = "levels")] public string LevelsText { get; set; }

    private SkillBuild build = new SkillBuild();
    private int[] levelValues = Enumerable.Repeat(100, 8).ToArray();
    private int earned;

    private int LevelOf(CombatSkill skill) => levelValues[(int)skill];

    protected override void OnInitialized()
    {
        build = SkillBuild.Parse(BuildText);
        if (!string.IsNullOrEmpty(LevelsText))
        {
            var parts = LevelsText.Split(',');
            for (var i = 0; i < Math.Min(parts.Length, 8); ++i)
                if (int.TryParse(parts[i], out var v)) levelValues[i] = Math.Clamp(v, 1, 999);
        }
        Recount();
    }

    private void Recount() => earned = RavenNest.Combat.SkillTrees.EarnedPoints(levelValues.Sum());

    private string Link() => Navigation.GetUriWithQueryParameters(new Dictionary<string, object>
    {
        ["build"] = build.Spent > 0 ? build.ToString() : null,
        ["levels"] = string.Join(",", levelValues),
    });

    private void Changed()
    {
        Recount();
        // replaceState, not NavigateTo: a navigation would scroll the page to the top at every click
        _ = JS.InvokeVoidAsync("history.replaceState", null, "", Link()).AsTask();
    }

    private void Learn(string id)
    {
        if (build.Raise(id, LevelOf, earned) != null) return;
        var node = RavenNest.Combat.SkillTrees.Get(id);
        if (node.IsActive && build.Rank(id) == 1) RavenNest.Blazor.Components.PlayerSkillTrees.FillFreeSlot(build, id);
        Changed();
    }

    private void Lower(string id) { build.Lower(id); Changed(); }

    private void Slot((int Slot, string Id) pick)
    {
        if (string.IsNullOrEmpty(pick.Id)) build.ClearSlot(pick.Slot); else build.SetLoadout(pick.Slot, pick.Id);
        Changed();
    }

    private void Rule((string Id, SkillUse Rule) pick) { build.SetRule(pick.Id, pick.Rule); Changed(); }

    private void SetLevels(int[] next) { levelValues = next; Changed(); }

    private void LoadPlan(string text) { build = SkillBuild.Parse(text); Changed(); }

    private void Reset() { build.Reset(); Changed(); }
}
