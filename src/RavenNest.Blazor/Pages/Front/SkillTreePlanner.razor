@page "/skill-trees"
@using RavenNest.Blazor.Extensions
@using RavenNest.Combat
@inject IJSRuntime JS
@inject NavigationManager Navigation

@*
    The skill tree planner (combat v2, the game's docs/combat-skills-design.md): anyone, signed in or not, sets the
    levels they have in mind (the eight combat skills, Taming for Beastmaster, and the nine trade skills for the trade
    trees) and tries a build on the same map the character page shows (js/rf-skill-tree.js),
    with the same rules (RavenNest.Combat.SkillBuild): points from the levels, nodes opened by their tree's level, the
    loadout. Nothing is saved; the address carries the build, the levels (eighteen numbers; older links have eight or
    nine and still open) and the tab, so a build can be shared as a link.
*@
<div class="top-section">
    <div class="hero-text">
        <h1>Skill tree planner</h1>
    </div>
</div>

<div class="white-section-break"></div>
<div class="page-content">
    <div class="section rf-trees">
        <p class="rf-meta">
            Set the levels you have in mind (Levels, in the map's corner: the eight combat skills, Taming for the Beastmaster tree, and the nine trade skills), then tap stars to learn them.
            <b>Combat</b> shows the nine trees for fighting, <b>Trade</b> the two for gathering and making things; every level earns into one pool of points that pays for both. Nothing here
            changes a character: Copy link shares the build, Save keeps it in this browser. Signed in, your character page's
            Skill trees tab has the same planner beside your real build.
        </p>
        <div class="rf-trees__wide">
            <SkillTreeStage Build="build" Levels="LevelOf" Earned="earned" CanEdit="true" Planner="true"
                            LevelValues="levelValues" OnLevels="SetLevels" OnReset="Reset" OnLoadPlan="LoadPlan" ShareLink="Link"
                            StartOnTrade="trade" OnTradeView="SetTrade"
                            OnLearn="Learn" OnLower="Lower" OnSlot="Slot" OnRule="Rule" />
        </div>
        <p class="rf-meta rf-trees__hint">Drag to move, scroll or pinch to zoom, tap a star to see its skill. Diamonds are active skills, circles passives, hexagons the special ones, and the three crowned ones at the end of each combat tree are its endings for a maxed skill (level 999): pick one, the other two stay closed. The trade trees are passives only: they work by themselves while you gather, cook, craft and brew.</p>

        <div class="rf-panel">
            <h3 class="rf-panel__title">What the build gives</h3>
            @{ var passives = build.Passives(petOut: true); }
            @if (passives.IsEmpty)
            {
                <p class="rf-meta">No passives yet.</p>
            }
            else
            {
                <div class="rf-chips">
                    @for (var s = 0; s < GearStats.Count; ++s)
                    {
                        var stat = (GearStat)s;
                        var v = passives[stat];
                        // what a tree's ending does beyond plain stats is said under its own name, below
                        if (v == 0 || stat >= GearStat.FirstStrike) continue;
                        <span class="rf-chip">@GearStats.Label(stat) @(GearStats.IsShare(stat) ? (v * 100).ToString("0.#") + "%" : v.ToString("0"))</span>
                    }
                </div>
            }
            @* the endings chosen (one a tree), each with what it does *@
            @{ var endings = RavenNest.Combat.SkillTrees.Trees(trade: false).Select(build.CapstoneOf).Where(n => n != null).ToList(); }
            @if (endings.Count > 0)
            {
                <h3 class="rf-panel__title">Endings chosen</h3>
                <div class="rf-chips">
                    @foreach (var n in endings)
                    {
                        <span class="rf-chip" title="@n.Description">@n.Tree: @n.Name@(string.IsNullOrEmpty(n.EffectText()) ? "" : " (" + n.EffectText() + ")")</span>
                    }
                </div>
            }
            @* the trade trees' nodes are no stats of a fight: each by its name and what it is worth now *@
            @{ var tradeNodes = RavenNest.Combat.SkillTrees.Trees(trade: true).SelectMany(RavenNest.Combat.SkillTrees.Of).Where(n => n.Trade != TradeEffect.None && build.Has(n.Id)).ToList(); }
            @if (tradeNodes.Count > 0)
            {
                <h3 class="rf-panel__title">While gathering and making</h3>
                <div class="rf-chips">
                    @foreach (var n in tradeNodes)
                    {
                        <span class="rf-chip" title="@n.Description">@n.Name@(n.TradeAmount > 0 && n.MaxRank > 1 ? " " + SkillTexts.Share(n.TradeAmount * build.Rank(n.Id)) : "")</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "build")] public string BuildText { get; set; }
    [SupplyParameterFromQuery(Name = "levels")] public string LevelsText { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string Tab { get; set; }

    private bool trade;

    private SkillBuild build = new SkillBuild();
    private int[] levelValues = Enumerable.Repeat(100, RavenNest.Combat.SkillTrees.TreeSkills).ToArray();
    private int earned;

    private int LevelOf(CombatSkill skill) => levelValues[(int)skill];

    protected override void OnInitialized()
    {
        build = SkillBuild.Parse(BuildText);
        trade = string.Equals(Tab, "trade", StringComparison.OrdinalIgnoreCase);
        if (!string.IsNullOrEmpty(LevelsText))
        {
            var parts = LevelsText.Split(',');
            // a link from before Beastmaster has eight levels: Taming stays at the planner's 100
            for (var i = 0; i < Math.Min(parts.Length, levelValues.Length); ++i)
                if (int.TryParse(parts[i], out var v)) levelValues[i] = Math.Clamp(v, 1, 999);
            // a link from before the trade trees has no trade levels: they count as nothing (level 1, no points),
            // so the link's points are what they were when it was made
            for (var i = Math.Max(parts.Length, (int)CombatSkill.Woodcutting); i < levelValues.Length; ++i) levelValues[i] = 1;
        }
        Recount();
    }

    private void SetTrade(bool on) { trade = on; Changed(); }

    private void Recount() => earned = RavenNest.Combat.SkillTrees.EarnedPoints(levelValues);

    private string Link() => Navigation.GetUriWithQueryParameters(new Dictionary<string, object>
    {
        ["build"] = build.Spent > 0 ? build.ToString() : null,
        ["levels"] = string.Join(",", levelValues),
        ["tab"] = trade ? "trade" : null,
    });

    private void Changed()
    {
        Recount();
        // replaceState, not NavigateTo: a navigation would scroll the page to the top at every click
        _ = JS.InvokeVoidAsync("history.replaceState", null, "", Link()).AsTask();
    }

    private void Learn(string id)
    {
        if (build.Raise(id, LevelOf) != null) return;
        var node = RavenNest.Combat.SkillTrees.Get(id);
        if (node.IsActive && build.Rank(id) == 1) RavenNest.Blazor.Components.PlayerSkillTrees.FillFreeSlot(build, id);
        Changed();
    }

    private void Lower(string id) { build.Lower(id); Changed(); }

    private void Slot((int Slot, string Id) pick)
    {
        if (string.IsNullOrEmpty(pick.Id)) build.ClearSlot(pick.Slot); else build.SetLoadout(pick.Slot, pick.Id);
        Changed();
    }

    private void Rule((string Id, SkillUse Rule) pick) { build.SetRule(pick.Id, pick.Rule); Changed(); }

    private void SetLevels(int[] next) { levelValues = next; Changed(); }

    private void LoadPlan(string text) { build = SkillBuild.Parse(text); Changed(); }

    private void Reset() { build.Reset(); Changed(); }
}
