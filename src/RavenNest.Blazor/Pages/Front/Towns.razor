@*
    /town used to be a second route onto this page. It is the dashboard's own town page now, and
    nothing linked to the alias: the front page nav and footer both point at /towns.
*@
@page "/towns"
@using RavenNest.Blazor.Services.Models
@using Microsoft.AspNetCore.WebUtilities
@using RavenNest.Blazor.Services
@using RavenNest.BusinessLogic.Net
@inject NavigationManager NavigationManager
@inject TownService TownService
@inject AuthService AuthService

<div class="top-section">
    <div class="hero-text">
        <h1>Town bonuses</h1>
    </div>
</div>

<div class="white-section-break"></div>
<div class="page-content">
    <div class="section">
        <p class="rf-lead">
            Every stream running right now has a town, and its plots boost skills for everyone
            playing there. See them all, or pick a skill to see which stream is the best place to
            train it.
        </p>

        @if (data == null)
        {
            <LoadIndicator></LoadIndicator>
        }
        else if (towns.Count == 0)
        {
            @*
                The page used to render an empty div here, so "no streams are live" and "the page
                is broken" looked identical. They are not the same thing and it should say which.
            *@
            <div class="rf-prose">
                <h2 class="rf-panel__title">No towns right now</h2>
                <p>
                    This lists towns in streams that are running at this moment, and nobody is live.
                </p>
                <div class="rf-actions">
                    <a class="rf-btn rf-btn--primary" href="/streams">See who is streaming</a>
                    <a class="rf-btn" href="/download">Run it yourself</a>
                </div>
            </div>
        }
        else
        {
            @*
                Was fourteen stacked tables, one per skill, each with its own header, and you
                scrolled to find the one you cared about. The question this page answers is "where
                do I go to train X", so X is the control.
            *@
            <div class="rf-filters" role="group" aria-label="Filter by skill">
                @*
                    Every live town at once, with everything it boosts — for "where is everyone"
                    rather than "where do I train X", and the only view of a town nobody has
                    assigned a plot in yet.
                *@
                <button type="button"
                        class="rf-filter @(selectedType == null ? "is-active" : "")"
                        aria-pressed="@(selectedType == null)"
                        @onclick="() => SelectType(null)">
                    <i class="fa-solid fa-list" aria-hidden="true"></i>
                    <span>All</span>
                    <b>@towns.Count</b>
                </button>
                @foreach (var type in TypesWithBonus)
                {
                    var option = TownHouseTypes.Get(type);
                    <button type="button"
                            class="rf-filter @(selectedType == type ? "is-active" : "")"
                            aria-pressed="@(selectedType == type)"
                            @onclick="() => SelectType(type)">
                        <i class="@TownHouseTypes.IconOf(type)" aria-hidden="true"></i>
                        <span>@TownHouseTypes.LabelOf(type)</span>
                        <b>@data[type].Count</b>
                    </button>
                }
            </div>

            @if (selectedType == null)
            {
                <div class="rf-prose rf-prose--wide">
                    <h2 class="rf-panel__title">Every live town</h2>
                    <p class="rf-meta">
                        Each town with the skills its plots boost right now, most bonuses first.
                    </p>

                    <div class="rf-scroll-x">
                        <table class="rf-table">
                            <thead>
                                <tr>
                                    <th scope="col"><span class="rf-th rf-th--static">Streamer</span></th>
                                    <th scope="col"><span class="rf-th rf-th--static">Bonuses</span></th>
                                    <th scope="col"><span class="rf-th rf-th--static">Town level</span></th>
                                    <th scope="col"><span class="rf-th rf-th--static">Plots counting</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var town in AllTowns)
                                {
                                    var bonuses = BonusesOf(town);
                                    <tr>
                                        <td>
                                            <a class="rf-item__name"
                                               href="https://www.twitch.tv/@town.Owner.UserName"
                                               target="_blank" rel="noopener">
                                                <i class="fab fa-twitch" aria-hidden="true"></i> @town.Owner.UserName
                                            </a>
                                            <ClientVersionBadge Version="@town.ClientVersion" IsLatest="@town.IsLatestVersion" Latest="@town.LatestVersion" />
                                        </td>
                                        <td>
                                            @if (bonuses.Count == 0)
                                            {
                                                <span class="rf-table__quiet">None yet</span>
                                            }
                                            else
                                            {
                                                <div class="rf-chips">
                                                    @foreach (var (type, bonus) in bonuses)
                                                    {
                                                        <span class="rf-chip" title="@TownHouseTypes.LabelOf(type)">
                                                            <i class="@TownHouseTypes.IconOf(type)" aria-hidden="true"></i>
                                                            @TownHouseTypes.LabelOf(type) <b>@Percent(bonus)</b>
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td class="rf-table__quiet">@town.Level</td>
                                        <td class="rf-table__quiet">
                                            @town.ActiveSlotCount of @town.TotalSlotCount
                                            @if (town.UsedSlotCount > town.ActiveSlotCount)
                                            {
                                                <span class="rf-meta">
                                                    &middot; @(town.UsedSlotCount - town.ActiveSlotCount) filled but away
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
            var selected = selectedType.Value;
            <div class="rf-prose rf-prose--wide">
                <h2 class="rf-panel__title">
                    Best streams for @TownHouseTypes.LabelOf(selected).ToLowerInvariant()
                </h2>
                <p class="rf-meta">
                    A @TownHouseTypes.LabelOf(selected).ToLowerInvariant() plot is driven by its
                    occupant's @SelectedSkillName level, and the bonus below is every counting plot
                    of that kind added together.
                </p>

                <div class="rf-scroll-x">
                    <table class="rf-table">
                        <thead>
                            <tr>
                                <th scope="col"><span class="rf-th rf-th--static">Streamer</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Bonus</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Town level</span></th>
                                <th scope="col"><span class="rf-th rf-th--static">Plots counting</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var town in data[selected])
                            {
                                <tr>
                                    <td>
                                        <a class="rf-item__name"
                                           href="https://www.twitch.tv/@town.Owner.UserName"
                                           target="_blank" rel="noopener">
                                            <i class="fab fa-twitch" aria-hidden="true"></i> @town.Owner.UserName
                                        </a>
                                        <ClientVersionBadge Version="@town.ClientVersion" IsLatest="@town.IsLatestVersion" Latest="@town.LatestVersion" />
                                    </td>
                                    <td><b class="rf-loyalty__points">@Percent(town.GetActiveBonus(selected))</b></td>
                                    <td class="rf-table__quiet">@town.Level</td>
                                    <td class="rf-table__quiet">
                                        @town.ActiveSlotCount of @town.TotalSlotCount
                                        @if (town.UsedSlotCount > town.ActiveSlotCount)
                                        {
                                            <span class="rf-meta">
                                                &middot; @(town.UsedSlotCount - town.ActiveSlotCount) filled but away
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            }
        }
    </div>
</div>

@code {
    private Dictionary<TownHouseSlotType, List<TownData>> data = null;
    private List<TownData> towns = new List<TownData>();
    private List<TownHouseSlotType> slotTypes = null;
    /// <summary>The skill being looked at, or null for every town.</summary>
    private TownHouseSlotType? selectedType;

    /// <summary>Every live town, the ones boosting the most skills first, then by level.</summary>
    private List<TownData> AllTowns =>
        towns.OrderByDescending(t => BonusesOf(t).Count)
             .ThenByDescending(t => t.Level)
             .ThenBy(t => t.Owner?.UserName)
             .ToList();

    /// <summary>What a town boosts right now, biggest bonus first.</summary>
    private List<(TownHouseSlotType Type, double Bonus)> BonusesOf(TownData town) =>
        slotTypes.Select(t => (Type: t, Bonus: (double)town.GetActiveBonus(t)))
                 .Where(x => x.Bonus > 0)
                 .OrderByDescending(x => x.Bonus)
                 .ToList();

    /// <summary>Only the skills some live town is actually boosting, biggest list first.</summary>
    private List<TownHouseSlotType> TypesWithBonus =>
        data == null
            ? new List<TownHouseSlotType>()
            : data.Where(x => x.Value.Count > 0)
                  .OrderByDescending(x => x.Value.Count)
                  .ThenBy(x => TownHouseTypes.LabelOf(x.Key))
                  .Select(x => x.Key)
                  .ToList();

    private string SelectedSkillName =>
        selectedType == null ? "the skill" : TownHouseTypes.Get(selectedType.Value)?.SkillName ?? "the skill";

    protected override void OnInitialized()
    {
        slotTypes = Enum.GetValues(typeof(TownHouseSlotType)).Cast<TownHouseSlotType>()
            .Where(x => x != TownHouseSlotType.Undefined && x != TownHouseSlotType.NoSkill)
            .ToList();
        LoadTownDataAsync();
    }

    private async Task LoadTownDataAsync()
    {
        var result = await TownService.GetTownsAsync();
        towns = result?.ToList() ?? new List<TownData>();

        data = new Dictionary<TownHouseSlotType, List<TownData>>();
        foreach (var st in slotTypes)
        {
            var hasBonus = result.Select(x => new { Town = x, TypeBonus = x.GetActiveBonus(st) })
                                 .Where(x => x.TypeBonus > 0)
                                 .ToList();
            data[st] = hasBonus.OrderByDescending(x => x.TypeBonus).Select(x => x.Town).ToList();
        }

        // Every town first: the overview, and the only view that is never empty while
        // anyone is live.
        selectedType = null;

        StateHasChanged();
    }

    private void SelectType(TownHouseSlotType? type)
    {
        selectedType = type;
    }

    /// <summary>
    ///     The bonus was printed straight from a float, so it rendered as 142.34567% and would
    ///     have used a comma as the separator under a Swedish locale.
    /// </summary>
    private static string Percent(double value)
    {
        return Math.Round(value, 1).ToString("0.#", System.Globalization.CultureInfo.CurrentCulture) + "%";
    }
}
