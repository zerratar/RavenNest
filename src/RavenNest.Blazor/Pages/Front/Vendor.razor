@page "/vendor"

@using RavenNest.Blazor.Services
@inject NavigationManager NavigationManager
@inject AuthService AuthService

@*
    The public catalogue: what the vendor has and what it charges, readable without an account.
    Buying happens on the dashboard shop, which renders the same component with CanBuy set, so the
    two cannot disagree about a price.
*@

<div class="top-section">
    <div class="hero-text">
        <h1>The vendor</h1>
        <p>Everything players have sold, and what it would cost to buy back.</p>
    </div>
</div>

<div class="white-section-break"></div>
<div class="page-content">
    <div class="section">
        <p class="rf-lead">
            The vendor stocks whatever players sell to it, so this changes through the day. The
            more of something it holds, the less it charges for each one and the less it pays for
            the next.
        </p>

        <div class="rf-actions rf-vendor__cta">
            @if (IsAuthenticated)
            {
                <a class="rf-btn rf-btn--primary" href="/shop">
                    <i class="fa-solid fa-shop" aria-hidden="true"></i> Buy from the vendor
                </a>
            }
            else
            {
                <a class="rf-btn rf-btn--primary" href="/login/redirect/shop">Sign in to buy</a>
            }
            <a class="rf-btn" href="/marketplace">Buy from other players instead</a>
        </div>

        <VendorList CanBuy="false"></VendorList>
    </div>
</div>

@code {
    private RavenNest.Models.SessionInfo session;

    private bool IsAuthenticated => session != null && session.Authenticated;

    protected override void OnInitialized()
    {
        session = AuthService.GetSession();
    }
}
