@page "/items"
@page "/items/{Id}"

@using RavenNest.BusinessLogic.Game
@using RavenNest.Blazor.Services
@using RavenNest.DataModels
@using ItemFilter = RavenNest.Models.ItemFilter;
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject ItemService ItemService
@inject IJSRuntime JS

<div class="top-section">
    <div class="hero-text">
        <h1>Items</h1>
    </div>
</div>

<div class="white-section-break"></div>
<div class="page-content">
    <div class="section">

        @if (items == null)
        {
            <LoadIndicator></LoadIndicator>
        }
        else
        {
            @*
                Search. Every item in the game was on one page with no way to look one up short of
                the browser's own find, and the browser cannot find what it has not rendered.
            *@
            <div class="rf-toolbar">
                <SearchBox Placeholder="Search by name or description"
                           AriaLabel="Search items by name or description"
                           Value="@search"
                           ValueChanged="OnSearchChanged"
                           ClearSignal="@clearSignal" />
                @if (!string.IsNullOrWhiteSpace(search) || itemFilter != ItemFilter.All)
                {
                    <button type="button" class="rf-btn rf-btn--small" @onclick="ClearFilters">Clear filters</button>
                }
                <span class="rf-meta">Showing @items.Count.ToString("N0") of @allItems.Count.ToString("N0")</span>
            </div>

            @*
                Was nineteen hand written blocks here, and nineteen more in the stash page and in
                PlayerInventory, which is how they came to disagree about whether the category is
                called Armor or Armors. One list, one place.
            *@
            <div class="rf-filters" role="group" aria-label="Filter items by category">
                @foreach (var f in ItemFilterOptions.All)
                {
                    <button type="button"
                            class="rf-filter @(itemFilter == f.Filter ? "is-active" : "")"
                            aria-pressed="@(itemFilter == f.Filter)"
                            @onclick="() => SelectItemFilter(f.Filter)">
                        <i class="@f.Icon" aria-hidden="true"></i>
                        <span>@f.Label</span>
                    </button>
                }
            </div>

            @if (items.Count == 0)
            {
                <div class="rf-panel">
                    <p class="rf-meta">Nothing matches that. Try a different category or clear the search.</p>
                </div>
            }
            else
            {
                <div class="rf-panel">
                    <div class="rf-scroll-x">
                        <table class="rf-table">
                            <thead>
                                <tr>
                                    <th scope="col" aria-sort="@AriaSort("name")">
                                        <button type="button" class="rf-th" @onclick="SortByName">Item @(Indicator("name"))</button>
                                    </th>
                                    <th scope="col" aria-sort="@AriaSort("stats")">
                                        <button type="button" class="rf-th" @onclick="SortByStats">Stats @(Indicator("stats"))</button>
                                    </th>
                                    <th scope="col" aria-sort="@AriaSort("lev-req")">
                                        <button type="button" class="rf-th" @onclick="SortByLevelReq">Requires @(Indicator("lev-req"))</button>
                                    </th>
                                    <th scope="col" aria-sort="@AriaSort("material")">
                                        <button type="button" class="rf-th" @onclick="SortByMaterial">Material @(Indicator("material"))</button>
                                    </th>
                                    <th scope="col" aria-sort="@AriaSort("enchantment")">
                                        <button type="button" class="rf-th" @onclick="SortByEnchantmentSlots">Enchants @(Indicator("enchantment"))</button>
                                    </th>
                                    @*
                                        Was headed "Vendor Price", which does not say in which direction. The
                                        number is ShopSellPrice, and that is what PlayerManager pays you when
                                        you sell one, so the heading says so.
                                    *@
                                    <th scope="col" aria-sort="@AriaSort("vendor")">
                                        <button type="button" class="rf-th" @onclick="SortByVendorPrice">Vendor pays @(Indicator("vendor"))</button>
                                    </th>
                                    <th scope="col"><span class="rf-th rf-th--static">Where it comes from</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in items)
                                {
                                    var source = sources[item.Id];
                                    <tr id="@item.Id" class="@(Id == item.Id.ToString() ? "is-selected" : null)">
                                        <td>
                                            <div class="rf-item">
                                                <span class="rf-item__img">
                                                    <img src="@(ItemService.GetItemImage(item.Id.ToString(), item.Name))" alt="" loading="lazy" />
                                                </span>
                                                <span class="rf-item__body">
                                                    <span class="rf-item__name @ItemService.GetRarityClass(item)">@item.Name</span>
                                                    <span class="rf-item__meta">
                                                        <span>@ItemService.GetTypeName(item)</span>
                                                        @if (item.Soulbound)
                                                        {
                                                            <span class="rf-item__mark" title="Cannot be traded or sold"><i class="fa-solid fa-link" aria-hidden="true"></i> Soulbound</span>
                                                        }
                                                        @*
                                                            The vendor's stock was already on the server and shown
                                                            nowhere. It is the difference between "this exists" and
                                                            "you can go and buy this right now".
                                                        *@
                                                        @if (vendorStock.TryGetValue(item.Id, out var stocked))
                                                        {
                                                            <span class="rf-item__mark" title="@stocked.Stock.ToString("N0") in stock, @stocked.Price.ToString("N0") coins each">
                                                                <i class="fa-solid fa-shop" aria-hidden="true"></i> At the vendor
                                                            </span>
                                                        }
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                                    {
                                                        <span class="rf-item__desc" title="@item.Description">@item.Description</span>
                                                    }
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="rf-chips">
                                                @if (item.WeaponAim > 0)
                                                {
                                                    <span class="rf-chip" title="Weapon aim, increases your hit rate in melee"><i class="fas fa-crosshairs" aria-hidden="true"></i>@item.WeaponAim</span>
                                                }
                                                @if (item.WeaponPower > 0)
                                                {
                                                    <span class="rf-chip" title="Weapon power, increases your maximum damage in melee"><i class="fas fa-swords" aria-hidden="true"></i>@item.WeaponPower</span>
                                                }
                                                @if (item.RangedAim > 0)
                                                {
                                                    <span class="rf-chip" title="Ranged aim, increases your ranged hit rate"><i class="fas fa-crosshairs" aria-hidden="true"></i>@item.RangedAim</span>
                                                }
                                                @if (item.RangedPower > 0)
                                                {
                                                    <span class="rf-chip" title="Ranged power, increases your ranged maximum damage"><i class="fas fa-bow-arrow" aria-hidden="true"></i>@item.RangedPower</span>
                                                }
                                                @if (item.MagicAim > 0)
                                                {
                                                    <span class="rf-chip" title="Magic aim, increases your magic hit rate"><i class="fas fa-wand" aria-hidden="true"></i>@item.MagicAim</span>
                                                }
                                                @if (item.MagicPower > 0)
                                                {
                                                    <span class="rf-chip" title="Magic power, increases your magic maximum damage"><i class="fas fa-hand-holding-magic" aria-hidden="true"></i>@item.MagicPower</span>
                                                }
                                                @if (item.ArmorPower > 0)
                                                {
                                                    <span class="rf-chip" title="Armour power, decreases the hit rate of your attacker"><i class="fas fa-shield" aria-hidden="true"></i>@item.ArmorPower</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="rf-chips">
                                                @if (item.RequiredSlayerLevel > 0)
                                                {
                                                    <span class="rf-chip" title="Required slayer level"><i class="fas fa-skull" aria-hidden="true"></i>@item.RequiredSlayerLevel</span>
                                                }
                                                @if (item.RequiredAttackLevel > 0)
                                                {
                                                    <span class="rf-chip" title="Required attack level"><i class="fas fa-swords" aria-hidden="true"></i>@item.RequiredAttackLevel</span>
                                                }
                                                @if (item.RequiredDefenseLevel > 0)
                                                {
                                                    <span class="rf-chip" title="Required defense level"><i class="fas fa-shield" aria-hidden="true"></i>@item.RequiredDefenseLevel</span>
                                                }
                                                @if (item.RequiredMagicLevel > 0)
                                                {
                                                    <span class="rf-chip" title="Required magic or healing level"><i class="fas fa-hand-holding-magic" aria-hidden="true"></i>@item.RequiredMagicLevel</span>
                                                }
                                                @if (item.RequiredRangedLevel > 0)
                                                {
                                                    <span class="rf-chip" title="Required ranged level"><i class="fas fa-bow-arrow" aria-hidden="true"></i>@item.RequiredRangedLevel</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="rf-table__quiet">@ItemService.GetMaterialName(item)</td>
                                        <td class="rf-table__quiet">
                                            @if (source.EnchantmentSlots > 0)
                                            {
                                                <span>@source.EnchantmentSlots</span>
                                            }
                                            else
                                            {
                                                <span title="This item cannot be enchanted">-</span>
                                            }
                                        </td>
                                        <td class="rf-table__num">@item.ShopSellPrice.ToString("N0")</td>
                                        <td>
                                            @*
                                                Three separate blocks that each used to be a div of unlabelled
                                                text. They answer three different questions, so each says which
                                                question it is answering.
                                            *@
                                            @if (source.Drop != null)
                                            {
                                                <div class="rf-source">
                                                    <span class="rf-source__label">Dropped by</span>
                                                    <span class="rf-chips">
                                                        <span class="rf-chip">@source.Drop.RequiredSkill level <b>@source.Drop.LevelRequirement</b></span>
                                                        @if (source.Drop.DropChance > 0)
                                                        {
                                                            <span class="rf-chip" title="Chance per gathering attempt">@DropChance(source.Drop.DropChance)</span>
                                                        }
                                                    </span>
                                                </div>
                                            }

                                            @if (source.Recipe != null)
                                            {
                                                <div class="rf-source">
                                                    <span class="rf-source__label">Made with</span>
                                                    <span class="rf-chips">
                                                        <span class="rf-chip">@source.Recipe.RequiredSkill level <b>@source.Recipe.RequiredLevel</b></span>
                                                        @foreach (var req in source.Recipe.Ingredients)
                                                        {
                                                            @*
                                                                Was .First(...), which throws rather than returning null when a
                                                                recipe names an ingredient that has since been deleted. This is
                                                                the public item list, so one such recipe took the page down for
                                                                everybody. The admin item list had the same fault.
                                                            *@
                                                            var reqItem = itemLookup.TryGetValue(req.ItemId, out var found) ? found : null;
                                                            <a class="rf-chip" href="/items/@req.ItemId">@(reqItem?.Name ?? "Unknown item") <b>&times;@req.Amount</b></a>
                                                        }
                                                    </span>
                                                </div>
                                            }

                                            @if (source.IngredientIn.Count > 0)
                                            {
                                                <div class="rf-source">
                                                    <span class="rf-source__label">Used to make</span>
                                                    <span class="rf-chips">
                                                        @foreach (var r in source.IngredientIn)
                                                        {
                                                            <a class="rf-chip" href="/items/@r.ItemId">@r.Name</a>
                                                        }
                                                    </span>
                                                </div>
                                            }

                                            @if (source.Drop == null && source.Recipe == null && source.IngredientIn.Count == 0)
                                            {
                                                <span class="rf-table__quiet">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</div>
@code {

    [Parameter]
    public string Id { get; set; }

    private RavenNest.Models.ItemCollection allItems;
    private RavenNest.Models.ItemCollection items;
    private Dictionary<Guid, RavenNest.Models.Item> itemLookup = new();

    /// <summary>
    ///     Where an item comes from and what it goes into, worked out once when the page loads.
    ///
    ///     This used to be four service calls per row evaluated inside the render tree, so every
    ///     keystroke in a filter re-ran them for every item in the game. None of it changes while
    ///     the page is open.
    /// </summary>
    private sealed class ItemSource
    {
        public RavenNest.Models.ResourceItemDrop Drop { get; set; }
        public RavenNest.Models.ItemRecipe Recipe { get; set; }
        public IReadOnlyList<RavenNest.Models.ItemRecipe> IngredientIn { get; set; } = Array.Empty<RavenNest.Models.ItemRecipe>();
        public int EnchantmentSlots { get; set; }
    }

    private Dictionary<Guid, ItemSource> sources = new();

    /// <summary>What the vendor has on the shelf right now, and what it is asking for one.</summary>
    private Dictionary<Guid, (long Stock, long Price)> vendorStock = new();

    private string sort = "name";
    private Func<Models.Item, IComparable> sortSelector = x => x.Name;
    private BusinessLogic.Game.SortDirection sortDirection;
    private RavenNest.Models.ItemFilter itemFilter = RavenNest.Models.ItemFilter.All;
    private string search = "";

    protected override async Task OnInitializedAsync()
    {
        allItems = await ItemService.GetItemsAsync();
        itemLookup = allItems.GroupBy(x => x.Id).ToDictionary(x => x.Key, x => x.First());

        sources = allItems.ToDictionary(x => x.Id, x => new ItemSource
        {
            Drop = ItemService.GetResourceItemDrop(x.Id),
            Recipe = ItemService.GetItemRecipe(x.Id),
            IngredientIn = ItemService.GetItemRecipesByIngredient(x.Id) ?? (IReadOnlyList<RavenNest.Models.ItemRecipe>)Array.Empty<RavenNest.Models.ItemRecipe>(),
            EnchantmentSlots = EnchantmentManager.CanBeEnchanted(x)
                ? GameMath.GetMaxEnchantingAttributeCount(GameMath.GetItemLevel(x))
                : 0
        });

        foreach (var record in await ItemService.GetVendorItemsAsync())
        {
            if (record?.Item == null || record.VendorItem == null) continue;
            vendorStock[record.Item.Id] = (record.VendorItem.Stock, record.BuyFromVendorPrice);
        }

        ApplyFilters();
    }

    /// <summary>
    ///     An ingredient link lands here with an item id. It used to only scroll, so following a
    ///     link to something outside the category you were filtered to scrolled to a row that was
    ///     not rendered and looked like a dead link.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Id) || allItems == null)
        {
            return;
        }

        if (items != null && items.Any(x => x.Id.ToString() == Id))
        {
            return;
        }

        search = "";
        itemFilter = ItemFilter.All;
        ApplyFilters();
    }

    private void SelectItemFilter(ItemFilter newItemFilter)
    {
        itemFilter = newItemFilter;
        ApplyFilters();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    ///     Bumped to empty the search box. A counter rather than a value, because the box
    ///     is only ever written by the server on a deliberate clear. See SearchBox.
    /// </summary>
    private int clearSignal;

    private void OnSearchChanged(string value)
    {
        search = value ?? "";
        ApplyFilters();
    }

    private void ClearFilters()
    {
        clearSignal++;
        search = "";
        itemFilter = ItemFilter.All;
        ApplyFilters();
    }

    /// <summary>
    ///     Filters and sorts in one pass, so that changing the category or typing in the search
    ///     keeps whatever you had sorted by. Rebuilding the list from the name order instead would
    ///     have thrown the sort away on every keystroke.
    /// </summary>
    private void ApplyFilters()
    {
        var matching = allItems.Where(Filter);
        items = new Models.ItemCollection(
            sortDirection == BusinessLogic.Game.SortDirection.Descending
                ? matching.OrderByDescending(sortSelector)
                : matching.OrderBy(sortSelector));
    }

    private bool Filter(Models.Item item)
    {
        if (!ItemService.Filter(itemFilter, item))
            return false;

        if (string.IsNullOrWhiteSpace(search))
            return true;

        var term = search.Trim();
        return (item.Name != null && item.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (item.Description != null && item.Description.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (!string.IsNullOrEmpty(Id))
            ScrollToElementId(Id);
    }

    /// <summary>
    ///     Drop chances run from a few percent down to fractions of one, so a whole number would
    ///     print most of them as 0%.
    /// </summary>
    private static string DropChance(double chance)
    {
        var percent = chance * 100d;
        var rounded = percent >= 1 ? Math.Round(percent, 1) : Math.Round(percent, 2);
        return rounded.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture) + "% drop";
    }

    private MarkupString Indicator(string value)
    {
        if (value != sort)
        {
            return (MarkupString)"";
        }

        return (MarkupString)(sortDirection == BusinessLogic.Game.SortDirection.Ascending ? "&uarr;" : "&darr;");
    }

    private string AriaSort(string value)
    {
        if (value != sort) return "none";
        return sortDirection == BusinessLogic.Game.SortDirection.Ascending ? "ascending" : "descending";
    }

    private void SortByName() => SortBy("name", x => x.Name);

    private void SortByLevelReq() => SortBy("lev-req",
        x => x.RequiredAttackLevel + x.RequiredDefenseLevel + x.RequiredMagicLevel + x.RequiredRangedLevel + x.RequiredSlayerLevel);

    private void SortByMaterial() => SortBy("material", x => ItemService.GetMaterialIndex(x));

    private void SortByVendorPrice() => SortBy("vendor", x => x.ShopSellPrice);

    private void SortByEnchantmentSlots() => SortBy("enchantment",
        x => sources.TryGetValue(x.Id, out var s) ? s.EnchantmentSlots : 0);

    private void SortByStats() => SortBy("stats",
        x => x.ArmorPower + x.MagicPower + x.RangedPower + x.WeaponPower + x.MagicAim + x.RangedAim + x.WeaponAim);

    private void SortBy(string key, Func<Models.Item, IComparable> selector)
    {
        if (sort != key)
        {
            sortDirection = BusinessLogic.Game.SortDirection.Ascending;
        }
        else
        {
            sortDirection = (BusinessLogic.Game.SortDirection)(((int)sortDirection + 1) % Enum.GetValues(typeof(BusinessLogic.Game.SortDirection)).Length);
        }

        sort = key;
        sortSelector = selector;
        ApplyFilters();
    }

    private async void ScrollToElementId(string elementId)
    {
        await JS.InvokeAsync<bool>("scrollToElementId", new object[] { elementId, 5 });
    }
}
